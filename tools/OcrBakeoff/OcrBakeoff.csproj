<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Slice 1's OCR bake-off: Windows OCR against Tesseract 5 (fast and best models) on the same rendered pages.
    Windows only. Run it on your own books; its output stays on your machine (see README.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BibTfm)-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowFileWrites>true</AllowFileWrites>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bibliotaph.Pdf.Host\Bibliotaph.Pdf.Host.csproj" />
    <BundledExe Include="..\..\src\Bibliotaph.PdfWorker\Bibliotaph.PdfWorker.csproj" Folder="pdfworker" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" />
  </ItemGroup>
</Project>
