<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BibTfm)</TargetFramework>
    <RootNamespace>Bibliotaph.Spike.Harness</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spike.Contracts\Spike.Contracts.csproj" />
    <ProjectReference Include="..\Spike.WorkerHost\Spike.WorkerHost.csproj" />
