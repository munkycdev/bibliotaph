@page "/home"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation
@inject LibraryActivity Activity
@inject Pins Pins
@inject TourGuide Tour

<PageTitle>Bibliotaph</PageTitle>
@if (_summary is null)
{
    <div class="bt-loading">Opening your library…</div>
}
else if (!HasLibrary)
{
    @* First run, as the Windows app's Home: what Bibliotaph does, and that the files stay put. A library that came
       from a connected PC, or holds only books owned elsewhere, is past its first run without a folder here. *@
    <div class="bt-welcome">
        <span class="bt-eyebrow bt-eyebrow-block">WELCOME TO BIBLIOTAPH</span>
        <h1 tabindex="-1">Good stories begin with something you already own.</h1>
        <p class="bt-copy">
            Bibliotaph builds a catalog of the RPG books, maps and handouts already in your storage, then helps you find the
            right book and the right page. Your files stay exactly where they are: nothing is moved, renamed or changed.
        </p>
        <div class="bt-actions">
            <a class="bt-button primary" href="settings#library" data-tour="add-folder"><Icon Name="FolderPlus" />Add a folder</a>
        </div>
        <p class="bt-note"><Icon Name="ShieldCheck" />Your catalog, notes and collections are kept in your Bibliotaph account. Your books stay in your storage.</p>
    </div>
}
else
{
    <span class="bt-eyebrow bt-eyebrow-block">YOUR NEXT GOOD STORY</span>
    <h1 tabindex="-1">Welcome back.</h1>
    <div class="bt-subtitle">A familiar shelf. A few places you haven't been.</div>
    @if (_summary.Totals is { } totals)
    {
        @* The library's size, and the way to the Summary page that says more. *@
        <div class="bt-hometotals"><span class="bt-small">@totals</span><a href="summary"><Icon Name="ChartNoAxesColumn" Size="13" />@Bibliotaph.Core.SummaryText.SeeIt</a></div>
    }
    @if (_shelves is { AskAboutAi: true } && !_aiLater)
    {
        @* The Windows app's first run, once folders are in: AI now or later. Everything works without it. *@
        <div class="bt-aistep">
            <div class="bt-row">Fill in the catalog with AI?</div>
            <p class="bt-copy">
                A model service of your own can suggest each book's system, type, levels and more, quoting the page it found
                them on: any service that speaks the OpenAI chat API, with your key. You review the suggestions. It is off until
                you set it up, and you can do that later in Settings.
            </p>
            <div class="bt-actions">
                <a class="bt-button primary" href="settings#ai">Set up AI</a>
                <button class="bt-button" @onclick="AiLaterAsync">Not now</button>
            </div>
        </div>
    }
    @if (_note is not null)
    {
        <div class="bt-librarynote bt-pagenote">
            <DoneNote Result="_note" UndoName="Undo" Dismissed="() => _note = null" Undone="LoadAsync" />
        </div>
    }
    @if (_shelves is { } shelves)
    {
        @if (shelves.Added.Count == 0)
        {
            <EmptyState Title="Indexing your library." Message="@($"{shelves.Status}. Books appear here and in the Library as they are read.")"
                        ActionText="Manage folders" ActionIcon="Folder" ActionHref="settings#library" />
        }
        else
        {
            @if (shelves.Preparing is { } preparing)
            {
                @* The binder worked on last that's for a game. *@
                <div class="bt-sectionline">
                    <strong>Continue preparing</strong>
                    <a class="bt-link bt-inline" href="binders">All binders<Icon Name="ArrowRight" Size="13" /></a>
                </div>
                <div class="bt-collectioncards" aria-label="Continue preparing"><BinderTile Card="preparing" /></div>
            }
            @if (shelves.Opened.Count > 0)
            {
                <div class="bt-sectionline">
                    <strong>Recently opened</strong>
                    <a class="bt-link bt-inline" href="library">Browse your library<Icon Name="ArrowRight" Size="13" /></a>
                </div>
                <Shelf Books="shelves.Opened" Label="Recently opened" Open="ShowDetails" Correct="CorrectBook" Changed="LoadAsync" Done="r => _note = r" />
            }
            <div class="bt-sectionline">
                <strong>Recently added</strong>
                @if (shelves.Opened.Count == 0)
                {
                    <a class="bt-link bt-inline" href="library">Browse your library<Icon Name="ArrowRight" Size="13" /></a>
                }
            </div>
            <div data-tour="first-books">
                <Shelf Books="shelves.Added" Label="Recently added" Open="ShowDetails" Correct="CorrectBook" Changed="LoadAsync" Done="r => _note = r" />
            </div>
        }
        @if (Pins.Items.Count > 0)
        {
            @* The sidebar's pins, in its order. *@
            <div class="bt-sectionline">
                <strong>Pinned</strong>
                <a class="bt-link bt-inline" href="collections">All collections<Icon Name="ArrowRight" Size="13" /></a>
            </div>
            <div class="bt-homepins" role="list" aria-label="Pinned">
                @foreach (var pin in Pins.Items)
                {
                    <a class="bt-button @(pin.Dimmed ? "dimmed" : "")" role="listitem" href="@pin.Href" title="@pin.Tip" aria-label="@pin.Label"><Icon Name="@pin.Icon" />@pin.Label</a>
                }
            </div>
        }
    }
}

@code {
    LibraryOverview? _summary;
    HomeShelves? _shelves;
    ActionResult? _note;
    bool _wasBusy;
    DateTime _loaded;
    bool _aiLater;

    async Task AiLaterAsync()
    {
        _aiLater = true;
        try
        {
            await Api.AiLaterAsync();
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            // Hidden for now; it asks again next time.
        }
    }

    bool HasLibrary => _summary is { Folders: > 0 } or { Books: > 0 };

    protected override async Task OnInitializedAsync()
    {
        _summary = await Api.LibraryOverviewAsync();
        if (HasLibrary) await LoadAsync();
        // The tour's first chapter, before any folder; its second once books show, here or in the Library.
        else await Tour.OfferFoldersAsync();
        Tour.HomeLoaded();
        Activity.Changed += OnActivityChanged;
        Pins.Changed += OnPinsChanged;
    }

    void OnPinsChanged() => InvokeAsync(StateHasChanged);

    async Task LoadAsync()
    {
        _shelves = await Api.HomeAsync();
        _loaded = DateTime.UtcNow;
        if (_shelves.Added.Count > 0) await Tour.OfferBooksAsync();
    }

    /// <summary>The rows follow the books being read, as the Library's cards do: every so often, and once more when it's done.</summary>
    void OnActivityChanged()
    {
        var busy = Activity.Current?.Busy == true;
        var finished = _wasBusy && !busy;
        _wasBusy = busy;
        if (!HasLibrary || !finished && !(busy && DateTime.UtcNow - _loaded > TimeSpan.FromSeconds(15))) return;
        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    /// <summary>A cover: the Library with that book's details open, as on Windows.</summary>
    void ShowDetails(BookCard book) => Navigation.NavigateTo($"library?book={book.EntryId}");

    void CorrectBook(BookCard book) => Navigation.NavigateTo($"library?book={book.EntryId}&correct=true");
    public void Dispose()
    {
        Activity.Changed -= OnActivityChanged;
        Pins.Changed -= OnPinsChanged;
    }
}
