@page "/settings"
@implements IDisposable
@inject Session Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Settings: a list of sections beside the one chosen. The address's #library names the section,
   so links can open one and Back returns to the last. *@
<PageHeading Title="Make yourself at home." TabTitle="Settings" />

@if (_me is not null)
{
    <div class="bt-settings">
        <nav class="bt-settingslist" aria-label="Settings sections">
            @foreach (var group in Sections.GroupBy(s => s.Group))
            {
                <span class="bt-eyebrow bt-settingsgroup" aria-hidden="true">@group.Key</span>
                @foreach (var (_, id, label) in group)
                {
                    <a class="bt-settingsentry @(id == _selected ? "active" : "")" href="@($"settings#{id}")"
                       aria-current="@(id == _selected ? "page" : null)" @onclick="() => ChooseAsync(id)" @onclick:preventDefault="true">@label</a>
                }
            }
            <div class="bt-settingsrule"></div>
            <button class="bt-settingsentry" @onclick="() => _about = true">About Bibliotaph</button>
            <button class="bt-settingsentry" title="Ctrl+/" @onclick="() => _shortcuts = true">Keyboard shortcuts</button>
        </nav>
        <div class="bt-settingsbody">
            <CascadingValue Name="ChooseSettingsSection" Value="_choose" IsFixed="true">
            @switch (_selected)
            {
                case "library":
                    <h2 class="bt-sectionhead" id="library-heading">Library</h2>
                    <SettingsStorage Problem="@Problem" ProblemProvider="@ProblemProvider" Changed="() => _storageChanges++" />
                    <SettingsLibrary @key="_storageChanges" />
                    break;
                case "online": <SettingsOnline /> break;
                case "devices":
                    <h2 class="bt-sectionhead" id="devices-heading">Devices</h2>
                    <SettingsDevices />
                    <BrowserBooks />
                    break;
                case "processing": <SettingsProcessing /> break;
                case "ai": <AiSection /> break;
                case "vocabulary": <SettingsVocabulary /> break;
                case "preferences": <SettingsPreferences /> break;
                case "passwords": <SettingsPasswords /> break;
                case "backup": <SettingsBackup /> break;
                case "account": <SettingsAccount Me="_me" Problem="@Problem" /> break;
                case "members":
                    <h2 class="bt-sectionhead" id="members-heading">Members</h2>
                    <SettingsInvitations />
                    <SettingsAccounts />
                    break;
            }
            </CascadingValue>
        </div>
    </div>
}

@if (_about)
{
    <AboutDialog Closed="() => _about = false" />
}

@if (_shortcuts)
{
    <ShortcutsDialog Closed="() => _shortcuts = false" />
}

@code {
    CurrentUser? _me;
    string _selected = "library";
    int _storageChanges;
    Func<string, Task> _choose = null!;
    bool _about;
    bool _shortcuts;

    [SupplyParameterFromQuery(Name = "problem")] public string? Problem { get; set; }

    /// <summary>The storage whose connecting didn't finish, as its callback reports it.</summary>
    [SupplyParameterFromQuery(Name = "provider")] public string? ProblemProvider { get; set; }

    /// <summary>
    /// In the Windows app's order and groups: where the books are first, then what reads them and how, then this
    /// person's own choices and secrets with the account last, and what only admins see after it.
    /// </summary>
    IEnumerable<(string Group, string Id, string Label)> Sections
    {
        get
        {
            yield return ("BOOKS", "library", "Library");
            yield return ("BOOKS", "online", "Online libraries");
            yield return ("BOOKS", "devices", "Devices");
            yield return ("CATALOGUING", "processing", "Processing");
            yield return ("CATALOGUING", "ai", "AI");
            yield return ("CATALOGUING", "vocabulary", "Vocabulary");
            yield return ("YOU", "preferences", "Preferences");
            yield return ("YOU", "passwords", "Passwords");
            yield return ("YOU", "backup", "Backup");
            yield return ("YOU", "account", "Account");
            if (_me?.IsAdmin != true) yield break;
            yield return ("ADMIN", "members", "Members");
        }
    }

    /// <summary>Sections since folded into another, so a bookmark or an older link still opens where it meant.</summary>
    static readonly Dictionary<string, string> Moved = new()
    {
        ["storage"] = "library",
        ["browser"] = "devices",
        ["appearance"] = "preferences",
        ["review"] = "preferences",
        ["invitations"] = "members",
        ["accounts"] = "members",
    };

    protected override async Task OnInitializedAsync()
    {
        _choose = ChooseAsync;
        Navigation.LocationChanged += OnLocationChanged;
        _me = await Session.MeAsync();
        _selected = Chosen(Navigation.Uri);
    }

    /// <summary>The section the address names, or the one a problem belongs to, or Library, where a library starts.</summary>
    string Chosen(string uri)
    {
        var named = new Uri(uri).Fragment.TrimStart('#');
        if (Moved.TryGetValue(named, out var now)) named = now;
        if (Sections.Any(s => s.Id == named)) return named;
        return Problem == "taken" ? "account" : "library";
    }

    /// <summary>
    /// A section chosen in the list. The browser alone wouldn't tell the page about a change of #, so the list chooses
    /// the section itself and adds the address to the history, which Back then returns along.
    /// </summary>
    async Task ChooseAsync(string id)
    {
        if (id == _selected) return;
        Navigation.NavigateTo($"settings#{id}");
        await ShowAsync(id);
    }

    async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (Chosen(e.Location) is var chosen && chosen != _selected) await ShowAsync(chosen);
    }

    async Task ShowAsync(string id)
    {
        _selected = id;
        StateHasChanged();
        try
        {
            // As the Windows app's section scrolls back to its top when another is chosen.
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (JSException)
        {
            // The page stays where it was.
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
