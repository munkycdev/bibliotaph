@page "/settings"
@inject ApiClient Api
@inject Session Session
@inject NavigationManager Navigation
@inject LibraryActivity Activity

<PageHeading Title="Settings" />

@if (Problem == "taken")
{
    <div class="bt-message" role="status">That sign-in already belongs to another Bibliotaph account, so it wasn't linked to this one.</div>
}
else if (Problem == "storage")
{
    <div class="bt-message" role="status">Connecting OneDrive didn't finish. Try again, and allow Bibliotaph to read your files when Microsoft asks.</div>
}

@if (_me is not null)
{
    <section class="bt-section" aria-labelledby="account">
        <h2 id="account">Account</h2>
        <div class="bt-settingrow">
            <div>@_me.Name<small>@(_me.Email ?? "No email address from your sign-in")</small></div>
            <button class="bt-button" @onclick="SignOut"><Icon Name="ArrowUpRight" />Sign out</button>
        </div>
        <table class="bt-table">
            <thead><tr><th>SIGN-IN</th><th>ACCOUNT</th><th>ADDED</th></tr></thead>
            <tbody>
                @foreach (var signIn in _me.SignIns)
                {
                    <tr><td>@ProviderName(signIn.Provider)</td><td>@(signIn.Email ?? "")</td><td>@signIn.Added.ToString("d MMM yyyy")</td></tr>
                }
            </tbody>
        </table>
        @if (Unlinked.Any())
        {
            <div class="bt-actions">
                @foreach (var provider in Unlinked)
                {
                    <ServerLink Href="@($"auth/signin/{provider.Id}?returnUrl=%2Fsettings")"><Icon Name="Plus" />Link a @provider.Name sign-in</ServerLink>
                }
            </div>
        }
    </section>

    <section class="bt-section" id="storage" aria-labelledby="storage-heading">
        <h2 id="storage-heading">Storage</h2>
        <p class="bt-copy">Connect the storage where your books are, then add folders from it to your library. Bibliotaph reads them
            there and never changes them; books you import are saved to one folder of its own.</p>
        @foreach (var account in _storage)
        {
            <div class="bt-source bt-sourcerow">
                <Icon Name="Cloud" />
                <div>@account.Name<small>@(account.NeedsReconnect
                    ? "Needs connecting again: Microsoft no longer lets Bibliotaph read it. Its books stay in your library."
                    : $"Connected {account.Added:d MMMM yyyy}")</small></div>
                @if (account.NeedsReconnect)
                {
                    <ServerLink Href="@ConnectLink"><Icon Name="RotateCcw" />Connect again</ServerLink>
                }
                <button class="bt-icon" title="Disconnect" aria-label="@($"Disconnect {account.Name}")" @onclick="() => Disconnect(account)"><Icon Name="X" /></button>
            </div>
        }
        @if (_storage.Count == 0)
        {
            <p class="bt-sample">No storage connected yet.</p>
        }
        <div class="bt-actions">
            <ServerLink Href="@ConnectLink" Class="@(_storage.Count == 0 ? "bt-button primary" : "bt-button")"><Icon Name="Plus" />Connect OneDrive</ServerLink>
        </div>
        <p class="bt-sample">Disconnecting keeps your notes, collections and corrections. Its books come back when you connect it again.</p>
    </section>

    <section class="bt-section" id="library" aria-labelledby="library-heading">
        <h2 id="library-heading">Library folders</h2>
        <p class="bt-copy">Bibliotaph reads your folders. Your books stay exactly where you put them.</p>
        @foreach (var folder in _folders)
        {
            <div class="bt-source bt-sourcerow">
                <Icon Name="Folder" />
                <div>@folder.Location<small>@folder.Detail</small></div>
                <button class="bt-icon" title="Remove from library" aria-label="@($"Remove {folder.Location} from the library")" @onclick="() => Remove(folder)"><Icon Name="X" /></button>
            </div>
        }
        @if (_folders.Count == 0 && _pending is null)
        {
            <p class="bt-sample">No folders yet.</p>
        }
        @if (_pending is not null)
        {
            <div class="bt-source bt-pending">
                <div class="bt-sourcerow">
                    <Icon Name="FolderPlus" />
                    <div>@_pending.Location<small>@_pending.Detail</small></div>
                </div>
                <div class="bt-actions">
                    <button class="bt-button primary" @onclick="ConfirmAdd"><Icon Name="Check" />Add to library</button>
                    <button class="bt-button" @onclick="() => _pending = null">Cancel</button>
                </div>
            </div>
        }
        @if (_folderProblem is not null)
        {
            <div class="bt-message" role="alert">@_folderProblem</div>
        }
        <div class="bt-actions">
            <button class="bt-button primary" disabled="@(_storage.Count == 0)" title="@(_storage.Count == 0 ? "Connect your storage first." : null)"
                    @onclick="() => _picking = true"><Icon Name="FolderPlus" />Add a folder</button>
            @if (_folders.Count > 0)
            {
                <button class="bt-button" @onclick="Rescan"><Icon Name="RotateCcw" />Look for changes</button>
            }
        </div>
        <p class="bt-sample">Removing a folder keeps your notes, collections and corrections. Files are never deleted.</p>
    </section>

    <BrowserBooks />

    @if (_picking)
    {
        <FolderPicker Storage="_storage" Picked="Picked" Cancelled="() => _picking = false" />
    }

    @if (_me.IsAdmin)
    {
        <section class="bt-section" aria-labelledby="invites">
            <h2 id="invites">Invitations</h2>
            <p class="bt-copy">Bibliotaph is invite-only. Each link makes one account and expires after 14 days.</p>
            <div class="bt-filterbar">
                <label class="bt-field">Who it's for (only you see this)<input @bind="_note" maxlength="100" /></label>
                <label class="bt-check"><input type="checkbox" @bind="_admin" />Can invite others</label>
                <button class="bt-button primary bt-end" @onclick="CreateInvite"><Icon Name="Plus" />New invitation</button>
            </div>
            @if (_created is not null)
            {
                <div class="bt-linkbox" role="status"><Icon Name="Copy" Size="15" /><span>@_created.Link</span></div>
                <p class="bt-sample bt-shown-once">Copy it now: it's shown only once.</p>
            }
            @if (_invites is { Count: > 0 })
            {
                <table class="bt-table">
                    <thead><tr><th>FOR</th><th>MADE</th><th>STATE</th></tr></thead>
                    <tbody>
                        @foreach (var invite in _invites)
                        {
                            <tr>
                                <td>@(invite.Note ?? "—")@(invite.Admin ? " (can invite)" : "")</td>
                                <td>@invite.Created.ToString("d MMM yyyy")</td>
                                <td>@State(invite)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
}

@code {
    CurrentUser? _me;
    IReadOnlyList<SignInProvider> _providers = [];
    IReadOnlyList<InviteInfo>? _invites;
    CreatedInvite? _created;
    string? _note;
    bool _admin;
    IReadOnlyList<StorageAccount> _storage = [];
    IReadOnlyList<LibraryFolder> _folders = [];
    PickedFolder? _pending;
    string? _folderProblem;
    bool _picking;

    const string ConnectLink = "storage/connect/onedrive?returnUrl=%2Fsettings%23library";

    [SupplyParameterFromQuery(Name = "problem")] public string? Problem { get; set; }

    IEnumerable<SignInProvider> Unlinked => _providers.Where(p => _me?.SignIns.All(s => s.Provider != p.Id) == true);

    string ProviderName(string id) => _providers.FirstOrDefault(p => p.Id == id)?.Name ?? id;

    protected override async Task OnInitializedAsync()
    {
        _me = await Session.MeAsync();
        _providers = await Api.ProvidersAsync();
        _storage = await Api.StorageAsync();
        _folders = await Api.LibraryFoldersAsync();
        if (_me?.IsAdmin == true) _invites = await Api.InvitesAsync();
    }

    async Task CreateInvite()
    {
        _created = await Api.CreateInviteAsync(new CreateInvite(_note, _admin));
        _note = null;
        _admin = false;
        _invites = await Api.InvitesAsync();
    }

    void Picked(PickedFolder folder)
    {
        _picking = false;
        _folderProblem = null;
        _pending = folder;
    }

    async Task ConfirmAdd()
    {
        if (_pending is null) return;
        try
        {
            _folders = await Api.AddLibraryFolderAsync(new AddLibraryFolder(_pending.Storage.Id, _pending.Path));
            Activity.Refresh();
        }
        catch (ApiProblemException problem)
        {
            _folderProblem = problem.Message;
        }
        _pending = null;
    }

    async Task Remove(LibraryFolder folder)
    {
        _folders = await Api.RemoveLibraryFolderAsync(folder.Id);
        Activity.Refresh();
    }

    async Task Rescan()
    {
        await Api.RescanAsync();
        Activity.Refresh();
    }

    async Task Disconnect(StorageAccount account)
    {
        await Api.DisconnectStorageAsync(account.Id);
        _storage = await Api.StorageAsync();
        _folders = await Api.LibraryFoldersAsync();
        Activity.Refresh();
    }

    async Task SignOut()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("", forceLoad: true);
    }

    static string State(InviteInfo invite) =>
        invite.Redeemed is { } used ? $"Used {used:d MMM yyyy}"
        : invite.Expires <= DateTimeOffset.UtcNow ? "Expired"
        : $"Open until {invite.Expires:d MMM yyyy}";
}
