@page "/read/{EntryId:long}"
@* A book on a page of its own: the reader, at the file, page, search or binder item the address says. *@

<ReaderView EntryId="EntryId" Doc="Doc" Page="Page" Q="@Q" Keep="Keep" Popout="Popout" Item="Item" Ask="Ask" />

@code {
    [Parameter] public long EntryId { get; set; }
    [SupplyParameterFromQuery] public long? Doc { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public bool? Keep { get; set; }
    [SupplyParameterFromQuery] public bool? Popout { get; set; }

    /// <summary>A binder's item opened from its binder's list, with its banner when its pages changed.</summary>
    [SupplyParameterFromQuery] public long? Item { get; set; }

    /// <summary>Opened from Ask this book, with the Ask panel showing.</summary>
    [SupplyParameterFromQuery] public bool? Ask { get; set; }
}
