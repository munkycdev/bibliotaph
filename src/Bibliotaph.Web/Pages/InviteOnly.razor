@page "/invite-only"
@layout PublicLayout

<PageTitle>Invitation needed · Bibliotaph</PageTitle>
<div class="bt-signin">
    <div class="bt-signin-card">
        <div class="bt-brand"><span class="bt-monogram">b.</span><span>Bibliotaph</span></div>
        <h1 tabindex="-1">@(Problem == "invite" ? "That invitation can't be used." : "Bibliotaph is invite-only for now.")</h1>
        <p class="bt-copy">
            @if (Problem == "invite")
            {
                <text>It has been used already, or it has expired. Ask whoever sent it for a new one.</text>
            }
            else
            {
                <text>There's no account for that sign-in. If you have an invitation link, open it to start your library. If you
                already have an account, sign in the way you did before.</text>
            }
        </p>
        <div class="bt-actions"><a class="bt-button" href="signin">Back to sign-in</a></div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "problem")] public string? Problem { get; set; }
}
