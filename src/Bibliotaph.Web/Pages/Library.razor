@page "/library"
@implements IAsyncDisposable
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LibraryActivity Activity
@inject CollectionActions Collections
@inject CollectionDialogs Dialogs
@inject Pins Pins

@* The Windows app's Library page: its heading, the toolbar (results tabs while searching, filters, order, covers or
   list, packs or each file), the filter panel and its chips, the count, then the covers, the list or the matching pages. *@
<PageHeading Title="@Heading" Subtitle="@Subtitle">
    <Actions>
        @if (_view is { } view)
        {
            @* A saved search's own actions. Deleting it never deletes a book. *@
            <div class="bt-headbuttons">
                <button class="bt-button" aria-label="Rename the saved search" @onclick="RenameSearchAsync"><Icon Name="Pencil" />Rename</button>
                <button class="bt-button" title="Pinned searches show in the sidebar and on Home" aria-label="@($"{PinLabel(PinKinds.Search, view.Id)} the saved search")"
                        @onclick="() => Pins.ToggleAsync(PinKinds.Search, view.Id)"><Icon Name="Pin" />@PinLabel(PinKinds.Search, view.Id)</button>
                <button class="bt-icon" title="Delete the saved search. Your books stay as they are, and Undo brings it back." aria-label="Delete the saved search"
                        @onclick="DeleteSearchAsync"><Icon Name="Trash2" Size="15" /></button>
            </div>
        }
        else if (_collection is { } open)
        {
            @* A collection's own actions. Deleting it never deletes its books. *@
            <div class="bt-headbuttons">
            <button class="bt-button" title="Make a collection inside this one" @onclick="NewInsideAsync"><Icon Name="FolderPlus" />New collection</button>
            <button class="bt-button" title="Change its name or description" aria-label="Rename the collection" @onclick="RenameAsync"><Icon Name="Pencil" />Rename</button>
            <button class="bt-button" title="Put it inside another collection, or at the top" aria-label="Move the collection" @onclick="MoveAsync"><Icon Name="FolderInput" />Move to…</button>
            <button class="bt-button" title="Pinned collections show in the sidebar, on Home, and first on Collections" @onclick="() => Pins.ToggleAsync(PinKinds.Collection, open.Collection.Id)"><Icon Name="Pin" />@PinLabel(PinKinds.Collection, open.Collection.Id)</button>
            <button class="bt-icon" title="Delete the collection. Its books stay in your library, and Undo brings it back." aria-label="Delete the collection" @onclick="DeleteAsync"><Icon Name="Trash2" Size="15" /></button>
            </div>
        }
        else if (IsFavorites)
        {
            <button class="bt-button" title="Pinned, Favorites shows in the sidebar and on Home" aria-label="@($"{PinLabel(PinKinds.Favorites, null)} Favorites")"
                    @onclick="() => Pins.ToggleAsync(PinKinds.Favorites)"><Icon Name="Pin" />@PinLabel(PinKinds.Favorites, null)</button>
        }
        else if (_query.Collection is null && _viewId is null)
        {
            <a class="bt-button" href="settings#library"><Icon Name="FolderPlus" />Add folder</a>
        }
    </Actions>
</PageHeading>

@if (_results is null)
{
    <div class="bt-loading">Opening your library…</div>
    return;
}

@if (_hasFolders)
{
    <div class="bt-toolbar">
        @if (_query.IsSearching)
        {
            <div class="bt-tabs" role="tablist" aria-label="Results">
                <button class="bt-tab @(_query.IsPagesTab ? "" : "active")" role="tab" aria-selected="@(!_query.IsPagesTab)" @onclick='() => ShowTab(null)'>@_results.DocumentsTab</button>
                <button class="bt-tab @(_query.IsPagesTab ? "active" : "")" role="tab" aria-selected="@_query.IsPagesTab" @onclick='() => ShowTab("pages")'>@_results.PagesTab</button>
            </div>
        }
        <div class="bt-tools">
            @if (!_query.IsPagesTab && !_selecting)
            {
                <button class="bt-button" title="Tick books to edit their metadata together" aria-label="Select books" @onclick="StartSelectingAsync"><Icon Name="CopyCheck" />Select</button>
            }
            @if (CanSaveSearch)
            {
                <button class="bt-button" title="Keep this search, its filters and order, pinned in the sidebar" @onclick="SaveSearchAsync"><Icon Name="Plus" />Save search</button>
            }
            @if (_searches is { Count: > 0 } searches)
            {
                @* Every saved search, pinned or not, each with its pin, Rename and Delete. *@
                <div class="bt-menuanchor">
                    <button class="bt-button" title="Every search you've saved, pinned or not" aria-haspopup="true" aria-expanded="@_showSearches"
                            @onclick="() => _showSearches = !_showSearches"><Icon Name="List" />Saved searches</button>
                    @if (_showSearches)
                    {
                        <div class="bt-backdrop fixed bt-menuback" @onclick="() => _showSearches = false"></div>
                        <div class="bt-menu bt-searchlist" aria-label="Saved searches">
                            <span class="bt-eyebrow bt-eyebrow-block">SAVED SEARCHES</span>
                            @foreach (var search in searches)
                            {
                                var pinned = Pins.IsPinned(PinKinds.Search, search.Id);
                                var pinAction = pinned ? "Unpin from the sidebar" : "Pin to the sidebar";
                                <div class="bt-searchrow" @key="search.Id">
                                    <a class="bt-nav" href="@($"library?view={search.Id}")" title="@search.Name" @onclick="() => _showSearches = false"><Icon Name="SlidersHorizontal" /><span class="bt-navlabel">@search.Name</span></a>
                                    <button class="bt-icon bt-pinbutton @(pinned ? "on" : "")" title="@pinAction" aria-label="@($"{pinAction}: {search.Name}")" aria-pressed="@pinned"
                                            @onclick="() => Pins.ToggleAsync(PinKinds.Search, search.Id)"><Icon Name="Pin" Size="14" /></button>
                                    <button class="bt-icon" title="Rename" aria-label="@($"Rename {search.Name}")" @onclick="() => RenameSearchAsync(search)"><Icon Name="Pencil" Size="14" /></button>
                                    <button class="bt-icon" title="Delete. Your books stay as they are, and Undo brings it back." aria-label="@($"Delete {search.Name}")"
                                            @onclick="() => DeleteSearchAsync(search)"><Icon Name="Trash2" Size="14" /></button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <button class="bt-button @(_showFilters ? "on" : "")" aria-expanded="@_showFilters" aria-label="Filters" @onclick="() => _showFilters = !_showFilters">
                <Icon Name="SlidersHorizontal" />@FiltersLabel
            </button>
            <select class="bt-select" aria-label="Sort" value="@Sort" @onchange="ChangeSort">
                @foreach (var choice in _query.IsSearching ? LibraryChoices.SearchSorts : LibraryChoices.BrowseSorts)
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
            @if (!_query.IsPagesTab)
            {
                <div class="bt-viewtoggle" role="group" aria-label="Layout">
                    <button class="bt-icon @(_list ? "" : "active")" title="Covers" aria-label="Show covers" aria-pressed="@(!_list)" @onclick="() => SetLayout(false)"><Icon Name="LayoutGrid" Size="15" /></button>
                    <button class="bt-icon @(_list ? "active" : "")" title="List" aria-label="Show a list" aria-pressed="@_list" @onclick="() => SetLayout(true)"><Icon Name="List" Size="15" /></button>
                </div>
            }
            @* Packs as one card each, or every file in them on a card of its own; the matching pages follow it too. *@
            <div class="bt-viewtoggle" role="group" aria-label="Packs">
                <button class="bt-icon @(_eachFile ? "" : "active")" title="Packs" aria-label="Show packs" aria-pressed="@(!_eachFile)" @onclick="() => SetEachFile(false)"><Icon Name="Package" Size="15" /></button>
                <button class="bt-icon @(_eachFile ? "active" : "")" title="Each file" aria-label="Show each file" aria-pressed="@_eachFile" @onclick="() => SetEachFile(true)"><Icon Name="Files" Size="15" /></button>
            </div>
        </div>
    </div>

    @if (_showFilters)
    {
        var menus = _results.Menus;
        <div class="bt-filters">
            <div class="bt-filterrow">
                <Menu Label="Game system" Choices="menus.Systems" Value="@_query.System" Changed='v => Filter(_query with { System = v })' />
                <Menu Label="Type" Choices="menus.Types" Value="@_query.Type" Changed='v => Filter(_query with { Type = v })' />
                <div class="bt-field narrow">
                    <span>Character level</span>
                    <div class="bt-inline">
                        <select aria-label="Character level" value="@Text(_query.Level)" @onchange='e => Filter(_query with { Level = Number(e.Value) })'>
                            @foreach (var choice in LibraryChoices.Levels) { <option value="@choice.Value">@choice.Label</option> }
                        </select>
                        @if (_query.Level is not null)
                        {
                            <label class="bt-check small"><input type="checkbox" checked="@_query.UnknownLevels" @onchange='e => Filter(_query with { UnknownLevels = e.Value is true })' />Include unknown levels</label>
                        }
                    </div>
                </div>
                <div class="bt-field narrow" title="Books written for this many players">
                    <span>Players</span>
                    <select aria-label="Players" value="@Text(_query.Players)" @onchange='e => Filter(_query with { Players = Number(e.Value) })'>
                        @foreach (var choice in LibraryChoices.Players) { <option value="@choice.Value">@choice.Label</option> }
                    </select>
                </div>
                <button class="bt-link bt-end" title="Style, duration, where books live, and housekeeping" @onclick="() => _showMore = !_showMore">@MoreFiltersLabel</button>
                <button class="bt-button bt-end" @onclick="ClearFilters">Clear filters</button>
            </div>
            @if (_showMore)
            {
                @if (menus.ShowStyle || menus.ShowDuration)
                {
                    <span class="bt-eyebrow bt-eyebrow-block">THE ADVENTURE</span>
                    <div class="bt-filterrow">
                        @if (menus.ShowStyle)
                        {
                            <Menu Label="Style" Choices="menus.Styles" Value="@_query.Style" Changed='v => Filter(_query with { Style = v })'
                                  Hint="The kind of adventure: a heist, a dungeon crawl, a hexcrawl" />
                        }
                        @if (menus.ShowDuration)
                        {
                            <Menu Label="Duration" Choices="menus.Durations" Value="@_query.Duration" Changed='v => Filter(_query with { Duration = v })'
                                  Hint="How long it takes to play: a one-shot, a few sessions, a campaign" />
                        }
                    </div>
                }
                @if (menus.Boxes.Any(b => b.Offered))
                {
                    @* Type-ahead filters for fields with too many values for a menu. A box's chips widen it; the boxes narrow together. *@
                    <span class="bt-eyebrow bt-eyebrow-block">ABOUT THE BOOK</span>
                    <div class="bt-filterrow bt-boxes" aria-label="About the book">
                        @foreach (var box in menus.Boxes.Where(b => b.Offered))
                        {
                            <TypeAheadBox @key="box.Key" Box="box" Query="_query with { EachFile = _eachFile }" Picked='v => Filter(_query with { Picked = PickedText.Add(_query.Picked, box.Key, v) })'
                                          Removed='v => Filter(_query with { Picked = PickedText.Remove(_query.Picked, box.Key, v) })' />
                        }
                    </div>
                }
                <span class="bt-eyebrow bt-eyebrow-block">WHERE IT LIVES</span>
                <div class="bt-filterrow">
                    <Menu Label="Source folder" Choices="menus.Folders" Value="@Text(_query.Folder)" Changed='v => Filter(_query with { Folder = long.TryParse(v, out var id) ? id : null })' />
                    @if (menus.ShowOwn)
                    {
                        <Menu Label="Also own" Choices="menus.Owns" Value="@_query.Own" Changed='v => Filter(_query with { Own = v })'
                              Hint="Books you also own in print or on a virtual tabletop" />
                    }
                    @if (menus.ShowStore)
                    {
                        <Menu Label="Get it from" Choices="menus.Stores" Value="@_query.Store" Changed='v => Filter(_query with { Store = v })'
                              Hint="Where you got it, or can get it again" />
                    }
                </div>
                <span class="bt-eyebrow bt-eyebrow-block">HOUSEKEEPING</span>
                <div class="bt-filterrow">
                    <Menu Label="Kind" Choices="LibraryChoices.Kinds" Value="@_query.Kind" Changed='v => Filter(_query with { Kind = v })' />
                    @if (menus.ShowAi)
                    {
                        <Menu Label="AI" Choices="LibraryChoices.Ai" Value="@_query.Ai" Changed='v => Filter(_query with { Ai = v })' Hint="Books a model has read and catalogued" />
                    }
                    @if (menus.ShowCopies)
                    {
                        <Menu Label="Copies" Choices="LibraryChoices.Copies" Value='@(_query.Copies ? "true" : "")' Changed='v => Filter(_query with { Copies = v == "true" })'
                              Hint="Books that are in more than one file" />
                    }
                    @if (menus.ShowAdventures)
                    {
                        <Menu Label="Adventures inside files" Choices="LibraryChoices.Adventures" Value="@_query.Adventures" Changed='v => Filter(_query with { Adventures = v })'
                              Hint="Adventures marked inside a compilation: inside their book, where a search still finds them; as cards of their own; or hidden" />
                    }
                    @if (menus.ShowCollections)
                    {
                        <Menu Label="Collection" Choices="LibraryChoices.Collections" Value="@_query.Collections" Changed='v => Filter(_query with { Collections = v })'
                              Hint="Books you've put in a collection, or those in none yet" />
                    }
                </div>
            }
        </div>
    }

    <div class="bt-sectionline-top">
        @if (ScopeChip is { } scopeChip)
        {
            @* The part of the library shown; its × shows the whole library, with the same search and filters. *@
            <span class="bt-chip on bt-scopechip">@scopeChip<button class="bt-chipx" title="Show your whole library" aria-label="Show your whole library" @onclick="ClearScope"><Icon Name="X" Size="12" /></button></span>
        }
        @if (Chips is { Count: > 0 } chips)
        {
            <div class="bt-chips" aria-label="Filters on">
                @foreach (var chip in chips)
                {
                    <span class="bt-chip on">@chip.Label<button class="bt-chipx" title="@chip.Name" aria-label="@chip.Name" @onclick="() => Filter(chip.Clear(_query))"><Icon Name="X" Size="12" /></button></span>
                }
                @if (chips.Count > 1)
                {
                    <button class="bt-link" @onclick="ClearFilters">Clear filters</button>
                }
            </div>
        }
        @if (_collection is { Children.Count: > 0 } parent)
        {
            @* Its sub-collections, as cards above its books, and the switch that leaves their books out. *@
            <div class="bt-collectioncards bt-subcollections" aria-label="Collections inside this one">
                @foreach (var card in parent.Children)
                {
                    <CollectionTile @key="card.Id" Card="card" />
                }
            </div>
            <label class="bt-check small bt-addedhere" title="Leave out the books that are only in the collections inside this one">
                <input type="checkbox" checked="@_query.AddedHere" @onchange='e => Filter(_query with { AddedHere = e.Value is true })' />Only books added here
            </label>
        }
        @if (ViewChanged && _view is { } changed)
        {
            @* A saved search whose search, filters or order were changed: keep the change in it, or as a new one. *@
            <div class="bt-viewchanged">
                <span class="bt-small">@changed.ChangedText</span>
                <div class="bt-inline">
                    <button class="bt-button primary" title="The saved search keeps the search, filters and order shown now" @onclick="UpdateSearchAsync">Update saved search</button>
                    <button class="bt-button" title="Keep both: a new saved search, and this one as it was" @onclick="SaveAsNewAsync">Save as new</button>
                </div>
            </div>
        }
        @if (_view?.Note is { } viewNote)
        {
            <div class="bt-small bt-viewnote">@viewNote</div>
        }
        @if (_selecting)
        {
            @* Select mode: how many are ticked, and what can be done to them all. *@
            <div class="bt-selectbar" role="toolbar" aria-label="Selection">
                <span class="bt-selectsummary" role="status">@(_selection?.Summary ?? "")</span>
                <button class="bt-button primary" title="Change fields on every selected book at once" disabled="@(_ticked.Count == 0 || _working)"
                        @onclick="EditSelectedAsync"><Icon Name="Pencil" />Edit metadata</button>
                <div class="bt-menuanchor">
                    <button class="bt-button" title="Add every selected book to a collection" aria-haspopup="menu" aria-expanded="@(_selectionMenu is not null)"
                            disabled="@(_ticked.Count == 0)" @onclick="ToggleCollectionMenuAsync"><Icon Name="FolderPlus" />Add to collection</button>
                    @if (_selectionMenu is { } menu)
                    {
                        <div class="bt-backdrop fixed bt-menuback" @onclick="() => _selectionMenu = null"></div>
                        <div class="bt-menu bt-menuleft" role="menu" aria-label="Add to collection">
                            @foreach (var item in menu)
                            {
                                <button class="bt-menuitem" role="menuitem" title="@item.Path" @onclick="() => AddSelectedToCollectionAsync(item)">@item.Label</button>
                            }
                        </div>
                    }
                </div>
                @if (_selection is { CanJoin: true })
                {
                    <button class="bt-button" title="Join the selected cards as one book: copies, or versions of it" aria-label="Join the selected cards as one book"
                            disabled="@_working" @onclick="JoinSelectedAsync"><Icon Name="Copy" />Same book</button>
                }
                @if (_selection is { CanPack: true })
                {
                    <button class="bt-button" title="Put the selected images and packs into one pack" aria-label="Put the selected images and packs into one pack"
                            disabled="@_working" @onclick="PackSelectedAsync"><Icon Name="LayoutGrid" />Pack together</button>
                }
                @if (_selection is { CanRemoveAdventures: true })
                {
                    <button class="bt-button" title="Take away the selected adventures' cards. Their pages stay in their files." aria-label="Remove the selected adventures"
                            disabled="@_working" @onclick="RemoveSelectedAdventuresAsync"><Icon Name="Trash2" />Remove adventures</button>
                }
                @if (_query.Collection is not null)
                {
                    <button class="bt-button" title="Take the selected books out of this collection. They stay in your library."
                            disabled="@(_ticked.Count == 0 || _working)" @onclick="RemoveSelectedFromCollectionAsync">Remove from collection</button>
                }
                <button class="bt-button" title="Save the selected books as a CSV file, for a spreadsheet" aria-label="Export the selected books"
                        disabled="@(_ticked.Count == 0 || _working)" @onclick="ExportSelectedAsync"><Icon Name="SquareArrowOutUpRight" />Export these</button>
                <button class="bt-button" aria-label="Clear the selection" disabled="@(_ticked.Count == 0)" @onclick="ClearSelectionAsync">Clear</button>
                <button class="bt-button" title="Leave Select mode (Esc)" aria-label="Done selecting" @onclick="StopSelectingAsync">Done</button>
            </div>
        }
        @if (_results.Empty is null)
        {
            <div class="bt-countline">
                <span><strong>@_results.CountText</strong> @_results.CountLabel</span>
                @if (_results.Coverage is not null) { <span class="bt-coverage">@_results.Coverage</span> }
            </div>
        }
        @if (_results.Issue is not null)
        {
            <div class="bt-issue">@_results.Issue</div>
        }
    </div>
}

@if (_done is not null)
{
    <div class="bt-librarynote">
        <DoneNote Result="_done" Dismissed="() => _done = null" Undone="UndoneAsync" />
    </div>
}

@if (_results.Empty is { } empty)
{
    @if (empty.Action is "add-folder" or "manage-folders")
    {
        <EmptyState Title="@empty.Title" Message="@empty.Message" ActionText="@empty.ActionText" ActionIcon='@(empty.Action == "add-folder" ? "FolderPlus" : null)' ActionHref="settings#library" />
    }
    else
    {
        <EmptyState Title="@empty.Title" Message="@empty.Message" ActionText="@empty.ActionText" Action="() => EmptyAction(empty.Action)" />
    }
}
else if (_query.IsPagesTab)
{
    <div class="bt-hits" aria-label="Matching pages">
        @foreach (var match in _results.Matches.Take(_shown))
        {
            <div class="bt-hit">
                <div class="bt-hitcover"><BookCover Book="match.Book" /></div>
                <div>
                    <h3><button class="bt-titlelink" aria-label="Details for @match.Book.Title" @onclick="() => ShowDetails(match.Book)">@match.Book.Title</button></h3>
                    <div class="bt-bookmeta">@match.Book.Meta</div>
                    @foreach (var hit in match.Pages)
                    {
                        <div class="bt-hitpage">
                            <div class="bt-hitwhere">@hit.Where</div>
                            <p>@foreach (var (text, marked) in Snippet(hit.Snippet)) { if (marked) { <mark>@text</mark> } else { @text } }</p>
                            <span class="bt-chip">@hit.Source</span>
                        </div>
                    }
                    @if (match.More.Length > 0) { <div class="bt-bookmeta bt-more">@match.More</div> }
                </div>
            </div>
        }
    </div>
}
else if (_list)
{
    <div class="bt-booklist" aria-label="Books">
        @foreach (var book in _results.Books.Take(_shown))
        {
            <button class="bt-listrow @(_selecting ? "selecting" : "")" @key="book.Id" title="@book.Title" aria-label="@CardLabel(book)" aria-pressed="@Pressed(book)"
                    @onclick="e => CardClickAsync(book, e)">
                @if (_selecting) { <Tick On="IsTicked(book)" /> }
                <div class="bt-thumb"><BookCover Book="book" Marks="false" /></div>
                <div class="bt-listtitle">
                    <div class="bt-booktitle">@book.Title</div>
                    <div class="bt-bookmeta">@book.Byline</div>
                </div>
                <div class="bt-listfield wide" title="Game system">@book.System</div>
                <div class="bt-listfield wide" title="Type">@book.Kind</div>
                <div class="bt-listfield wide">
                    <div title="Character levels">@book.Levels</div>
                    @if (book.Players.Length > 0) { <div title="Players">@book.Players</div> }
                </div>
                <div class="bt-listfield">
                    <div>@book.Size</div>
                    @if (book.Copies.Length > 0) { <div title="Files of this book in your library">@book.Copies</div> }
                    @if (book.Availability.Length > 0) { <div title="@book.AvailabilityTip">@book.Availability</div> }
                </div>
                <div class="bt-heart @(book.Favorite ? "on" : "")">@if (book.Favorite) { <span role="img" aria-label="Favorite"><Icon Name="Heart" Size="14" /></span> }</div>
                <div class="bt-chevron"><Icon Name="ChevronRight" Size="15" /></div>
            </button>
        }
    </div>
}
else
{
    <div class="bt-books" aria-label="Books">
        @foreach (var book in _results.Books.Take(_shown))
        {
            <div class="bt-book" @key="book.Id" title="@book.Title">
                <button class="bt-bookbutton @(_selecting ? "selecting" : "")" aria-label="@CardLabel(book)" aria-pressed="@Pressed(book)" @onclick="e => CardClickAsync(book, e)">
                <div class="bt-coverarea">
                    <BookCover Book="book" />
                    @if (_selecting) { <Tick On="IsTicked(book)" /> }
                    @if (book.Favorite) { <span class="bt-heart cover on" role="img" aria-label="Favorite"><Icon Name="Heart" Size="13" /></span> }
                </div>
                <div class="bt-booktitle">@book.Title</div>
                <div class="bt-bookmeta">@book.Meta</div>
                </button>
            </div>
        }
    </div>
}
<div @ref="_end" class="bt-end-of-results"></div>
@if (_sameBook is { } sameBook)
{
    <SameBookDialog Preview="sameBook" Books="_ticked" Closed="SameBookClosedAsync" />
}
@if (_bulk is { } bulk)
{
    <BulkEditDialog Form="bulk" Books="_ticked" Closed="BulkClosedAsync" />
}
@if (_packing is { } packing)
{
    <PackTogetherDialog Preview="packing" Books="_ticked" Closed="PackClosedAsync" />
}
@if (_details is { } entryId)
{
    <BookDetailsDrawer @ref="_drawer" EntryId="entryId" Closed="CloseDetails" ShowEntry="id => _details = id" Changed="ReloadAsync" Done="ShowDone" />
}

@code {
    /// <summary>Cards drawn at first, and each time the end of them comes into view.</summary>
    const int Batch = 120;

    LibraryQuery _query = new();
    LibraryResults? _results;
    bool _hasFolders = true;
    bool _showFilters;
    bool _showMore;
    bool _list;
    bool _eachFile;
    string? _searchSort;
    string? _browseSort;
    int _shown = Batch;
    int _version;
    bool _wasBusy;
    DateTime _loaded;
    CancellationTokenSource? _loading;
    ElementReference _end;
    DotNetObjectReference<Library>? _self;
    IJSObjectReference? _watch;
    long? _details;
    BookDetailsDrawer? _drawer;
    ActionResult? _done;
    CollectionPage? _collection;
    bool _prefList;
    string? _settled;
    long? _viewId;
    bool _edited;
    SavedSearch? _view;
    List<SavedSearchInfo>? _searches;
    bool _showSearches;
    bool _selecting;
    readonly List<long> _ticked = [];
    long? _anchor;
    SelectionInfo? _selection;
    int _selectionVersion;
    IReadOnlyList<CollectionMenuItem>? _selectionMenu;
    SameBookPreview? _sameBook;
    PackTogetherPreview? _packing;
    BulkEditForm? _bulk;
    bool _working;

    /// <summary>A saved search keeps its own order; elsewhere the order is the browser's to remember.</summary>
    string Sort => _query.Sort ?? (_viewId is null ? _query.IsSearching ? _searchSort : _browseSort : null) ?? (_query.IsSearching ? "Relevance" : "RecentlyAdded");

    bool IsFavorites => _query.Favorites && _query.Collection is null;

    string Heading => _view?.Name ?? (_viewId is not null ? ""
        : _query.IsSearching ? "Search results" : _collection?.Collection.Name ?? _results?.Scope?.Heading ?? (_query.Collection is null ? "Your library" : ""));

    string Subtitle => _view?.Subtitle ?? (_viewId is not null ? ""
        : _query.IsSearching
            ? _collection is { } scope ? $"In {scope.Collection.Name}, across titles, file details and the pages within." : "Across titles, file details and the pages within."
            : _collection?.Subtitle ?? _results?.Scope?.Subtitle ?? (_query.Collection is null ? "Good stories begin with something you already own." : ""));

    /// <summary>The scope chip: the collection shown, or Favorites.</summary>
    string? ScopeChip => _collection is { } open ? $"In {open.Collection.Path}" : _query.Collection is null ? _results?.Scope?.Chip : null;

    /// <summary>Save search, while a search, a filter or a scope is in use and no saved search is shown, as in the Windows app.</summary>
    bool CanSaveSearch => _viewId is null && (_query.IsSearching || Chips.Count > 0 || _query.Collection is not null || IsFavorites);

    /// <summary>The search, filters, order or layout differ from the saved search's: Update and Save as new show.</summary>
    bool ViewChanged => _view is { } view && _edited
        && (Comparable(_query) != Comparable(view.Query) || Sort != view.Query.Sort || _list != view.List);

    /// <summary>The query as it filters, so two that show the same books compare equal.</summary>
    static LibraryQuery Comparable(LibraryQuery q)
    {
        var searching = q.IsSearching;
        return q with
        {
            Q = searching ? q.Q!.Trim() : null,
            Tab = searching && q.IsPagesTab ? "pages" : null,
            Sort = null,
            EachFile = false,
            UnknownLevels = q.Level is not null && q.UnknownLevels,
            AddedHere = q.Collection is not null && q.AddedHere,
            Favorites = q.Favorites && q.Collection is null,
            Picked = PickedText.Canonical(q.Picked),
        };
    }

    string PinLabel(string kind, long? id) => Pins.PinLabel(kind, id);

    int ResultCount => _results is null ? 0 : _query.IsPagesTab ? _results.Matches.Count : _results.Books.Count;

    protected override async Task OnInitializedAsync()
    {
        _prefList = _list = await PrefAsync("library.layout") == "list";
        _eachFile = await PrefAsync("library.pack-view") == "files";
        _searchSort = await PrefAsync("library.sort.search");
        _browseSort = await PrefAsync("library.sort.browse");
        _details = LibraryUrl.Book(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
        Activity.Changed += OnActivityChanged;
        Pins.Changed += OnPinsChanged;
        // After a change made elsewhere, such as a collection made from Collections: the note saying so.
        _done = Collections.Pending;
        Collections.Pending = null;
        await Task.WhenAll(ShowAddressAsync(Navigation.Uri), LoadSearchesAsync());
    }

    /// <summary>
    /// What the address asks for: a search and filters, or a saved search as it was saved, or as changed since. Opening
    /// the details of a book, or closing them, changes nothing else.
    /// </summary>
    async Task ShowAddressAsync(string uri)
    {
        var settled = LibraryUrl.Settled(uri);
        if (settled == _settled) return;
        _settled = settled;
        var query = LibraryUrl.Parse(uri);
        var viewId = LibraryUrl.View(uri);
        var edited = LibraryUrl.Edited(uri);
        if (viewId != _viewId) _view = null;
        _viewId = viewId;
        _edited = edited;
        _shown = Batch;
        if (viewId is { } id)
        {
            var view = _view ?? await Api.SavedSearchAsync(id);
            if (_settled != settled) return;
            if (view is null)
            {
                // Deleted meanwhile, perhaps in the Windows app: the library, with what the address had.
                _viewId = null;
                Navigation.NavigateTo("library" + LibraryUrl.QueryString(query, forApi: false), replace: true);
                return;
            }
            _view = view;
            if (!edited)
            {
                query = view.Query;
                _list = view.List;
            }
            else _list = LibraryUrl.List(uri) ?? view.List;
        }
        else _list = _prefList;
        _query = query;
        await Task.WhenAll(LoadAsync(), LoadCollectionAsync());
        if (_settled == settled) await DoAsync(uri);
    }

    /// <summary>Rename… or Delete from a pinned search's menu in the sidebar, once its page is open.</summary>
    async Task DoAsync(string uri)
    {
        if (LibraryUrl.Do(uri) is not { } action || _view is null) return;
        Navigation.NavigateTo(CurrentAddress(), replace: true);
        if (action == "rename") await RenameSearchAsync();
        else if (action == "delete") await DeleteSearchAsync();
        StateHasChanged();
    }

    /// <summary>Where the page is now: a saved search as saved by its number alone, or with what was changed.</summary>
    string CurrentAddress() => _viewId is { } id && !_edited ? $"library?view={id.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : Address(_query);

    string Address(LibraryQuery next)
    {
        var address = "library" + LibraryUrl.QueryString(next, forApi: false);
        if (_viewId is not { } id) return address;
        var sort = next.Sort ?? Sort;
        // Relevance orders search results only; without a search the books go newest first.
        if (!next.IsSearching && sort == "Relevance") sort = "RecentlyAdded";
        return LibraryUrl.ChangedView(address, id, sort, _list);
    }

    async Task LoadSearchesAsync()
    {
        try
        {
            _searches = await Api.SavedSearchesAsync();
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            // The toolbar goes without the list until the page opens again.
        }
    }

    void OnPinsChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_watch is not null || _results is null) return;
        _self ??= DotNetObjectReference.Create(this);
        try
        {
            _watch = await JS.InvokeAsync<IJSObjectReference?>("bibliotaphMore.watch", _end, _self);
        }
        catch (JSException)
        {
            // Without the watcher every card is drawn at once.
            _shown = int.MaxValue;
        }
    }

    [JSInvokable]
    public void ShowMore()
    {
        if (_shown >= ResultCount) return;
        _shown += Batch;
        StateHasChanged();
    }

    async Task LoadAsync()
    {
        var version = ++_version;
        _loading?.Cancel();
        _loading = new CancellationTokenSource();
        try
        {
            var results = await Api.LibraryAsync(_query with { Sort = Sort, EachFile = _eachFile }, _loading.Token);
            if (version != _version) return;
            _results = results;
            _loaded = DateTime.UtcNow;
            _hasFolders = results.Empty?.Action != "add-folder";
            if (_selecting) await UpdateSelectionAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>The collection shown, with its sub-collections; one deleted meanwhile leaves the whole library.</summary>
    async Task LoadCollectionAsync()
    {
        if (_query.Collection is not { } id)
        {
            _collection = null;
            return;
        }
        var page = await Api.CollectionAsync(id);
        if (_query.Collection != id) return;
        _collection = page;
        if (page is null) await ClearScope();
        // With none inside it any more, there are no books to leave out.
        else if (page.Children.Count == 0 && _query.AddedHere) await Filter(_query with { AddedHere = false });
    }

    /// <summary>A search typed in the top bar, or Back to an earlier search, arrives as a new address.</summary>
    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!Navigation.ToBaseRelativePath(e.Location).StartsWith("library", StringComparison.Ordinal)) return;
        InvokeAsync(async () =>
        {
            await ShowAddressAsync(e.Location);
            StateHasChanged();
        });
    }

    /// <summary>
    /// While books are being read, the cards follow, as the Windows app's do: every so often rather than on each
    /// status, since a large library's cards are a lot to send, and once more when the reading is done.
    /// </summary>
    void OnActivityChanged()
    {
        var busy = Activity.Current?.Busy == true;
        var finished = _wasBusy && !busy;
        _wasBusy = busy;
        if (!finished && !(busy && DateTime.UtcNow - _loaded > TimeSpan.FromSeconds(15))) return;
        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
            if (_drawer is not null) await _drawer.RefreshAsync();
        });
    }

    /// <summary>After a change in the details, the cards as they are now.</summary>
    Task ReloadAsync() => Task.WhenAll(LoadAsync(), LoadCollectionAsync());

    /// <summary>What a change from the details did, over the cards, with its Undo.</summary>
    async Task ShowDone(ActionResult result)
    {
        _done = result;
        await ReloadAsync();
    }

    async Task UndoneAsync()
    {
        // An Undo of a saved search's change brings back what it was; one of a deletion, the search itself.
        await Task.WhenAll(LoadSearchesAsync(), Pins.LoadAsync());
        if (_viewId is { } id && !_edited && await Api.SavedSearchAsync(id) is { } view)
        {
            _view = view;
            _query = view.Query;
            _list = view.List;
        }
        await ReloadAsync();
        if (_drawer is not null) await _drawer.RefreshAsync();
    }

    /// <summary>A card's details, over the page.</summary>
    void ShowDetails(BookCard book) => _details = book.EntryId;

    void CloseDetails()
    {
        _details = null;
        _drawer = null;
        // Opened from Home: the address forgets the book, so reloading doesn't open it again.
        if (LibraryUrl.Book(Navigation.Uri) is not null) Navigation.NavigateTo(CurrentAddress(), replace: true);
    }

    /// <summary>Shows a changed search or filter, at an address of its own.</summary>
    Task Filter(LibraryQuery next)
    {
        if (next.Level is null) next = next with { UnknownLevels = false };
        if (string.IsNullOrWhiteSpace(next.Q)) next = next with { Q = null, Tab = null };
        Navigation.NavigateTo(Address(next), replace: true);
        return Task.CompletedTask;
    }

    Task ShowTab(string? tab) => Filter(_query with { Tab = tab });

    /// <summary>Filters off; the search and the part of the library shown stay.</summary>
    Task ClearFilters() => Filter(new LibraryQuery
    {
        Q = _query.Q, Tab = _query.Tab, Sort = _query.Sort, Collection = _query.Collection, AddedHere = _query.AddedHere, Favorites = _query.Favorites,
    });

    Task ClearScope() => Filter(_query with { Collection = null, AddedHere = false, Favorites = false });

    Task EmptyAction(string action) => action switch
    {
        "clear-filters" => ClearFilters(),
        "clear-scope" => ClearScope(),
        "clear-search" or "clear-all" => Filter(action == "clear-search" ? _query with { Q = null, Tab = null }
            : new LibraryQuery { Sort = _query.Sort, Collection = _query.Collection, AddedHere = _query.AddedHere, Favorites = _query.Favorites }),
        "show-documents" => ShowTab(null),
        _ => Task.CompletedTask,
    };

    /// <summary>A collection made inside this one opens at once, ready for books.</summary>
    async Task NewInsideAsync()
    {
        if (_collection is not { } open) return;
        if (await Collections.CreateAsync(open.Collection) is { } created) Navigation.NavigateTo($"library?collection={created.Id}");
        else if (Collections.Pending is { } problem)
        {
            _done = problem;
            Collections.Pending = null;
        }
    }

    async Task RenameAsync()
    {
        if (_collection is { } open && await Collections.RenameAsync(open.Collection) is { } result) await ShowDone(result);
    }

    async Task MoveAsync()
    {
        if (_collection is { } open && await Collections.MoveAsync(open.Collection) is { } result) await ShowDone(result);
    }

    /// <summary>Deleted, the collection's page goes; Collections says so, with Undo.</summary>
    async Task DeleteAsync()
    {
        if (_collection is not { } open || await Collections.DeleteAsync(open.Collection.Id) is not { } result) return;
        if (result.Undo is null)
        {
            _done = result;
            return;
        }
        Collections.Pending = result;
        Navigation.NavigateTo("collections");
    }

    // Select mode, as the Windows Library's: ticks are kept by book while the search and filters change, so books can
    // be gathered from several searches; the files of a pack, each on a card of its own, are ticked as their pack.

    bool IsTicked(BookCard book) => _ticked.Contains(book.EntryId);

    string CardLabel(BookCard book) => _selecting ? $"Select {book.Title}" : $"Details for {book.Title}";

    string? Pressed(BookCard book) => _selecting ? IsTicked(book) ? "true" : "false" : null;

    /// <summary>The books the results show now, in order: what Ctrl+A and Shift+click tick.</summary>
    IReadOnlyList<long> ShownBooks => _results is null ? [] : _query.IsPagesTab
        ? [.. _results.Matches.Select(m => m.Book.EntryId).Distinct()]
        : [.. _results.Books.Select(b => b.EntryId).Distinct()];

    async Task StartSelectingAsync()
    {
        _selecting = true;
        _self ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("bibliotaphSelect.start", _self);
        }
        catch (JSException)
        {
            // Without library.js, Ctrl+A and Esc are left to the browser; the bar's buttons still work.
        }
        await UpdateSelectionAsync();
    }

    /// <summary>Esc in Select mode, outside a box or a dialog.</summary>
    [JSInvokable]
    public async Task StopSelecting()
    {
        await StopSelectingAsync();
        StateHasChanged();
    }

    /// <summary>Done, or Esc: leaves Select mode, and the ticks with it.</summary>
    async Task StopSelectingAsync()
    {
        _selecting = false;
        _ticked.Clear();
        _anchor = null;
        _selection = null;
        _selectionMenu = null;
        try
        {
            await JS.InvokeVoidAsync("bibliotaphSelect.stop");
        }
        catch (JSException)
        {
        }
    }

    /// <summary>Ctrl+A in Select mode: ticks every book in the current results, keeping the ticks from earlier searches.</summary>
    [JSInvokable]
    public async Task SelectAll()
    {
        if (!_selecting || _query.IsPagesTab) return;
        foreach (var id in ShownBooks.Where(id => !_ticked.Contains(id))) _ticked.Add(id);
        await UpdateSelectionAsync();
        StateHasChanged();
    }

    /// <summary>In Select mode a click ticks a book, and Shift+click every book from the last one clicked to this one.</summary>
    async Task CardClickAsync(BookCard book, MouseEventArgs e)
    {
        if (!_selecting)
        {
            ShowDetails(book);
            return;
        }
        var shown = ShownBooks;
        var from = _anchor is { } anchor ? IndexOf(shown, anchor) : -1;
        var to = IndexOf(shown, book.EntryId);
        if (e.ShiftKey && from >= 0 && to >= 0)
        {
            for (var i = Math.Min(from, to); i <= Math.Max(from, to); i++)
                if (!_ticked.Contains(shown[i])) _ticked.Add(shown[i]);
        }
        else if (!_ticked.Remove(book.EntryId)) _ticked.Add(book.EntryId);
        _anchor = book.EntryId;
        await UpdateSelectionAsync();
    }

    static int IndexOf(IReadOnlyList<long> shown, long id)
    {
        for (var i = 0; i < shown.Count; i++)
            if (shown[i] == id) return i;
        return -1;
    }

    async Task ClearSelectionAsync()
    {
        _ticked.Clear();
        _anchor = null;
        await UpdateSelectionAsync();
    }

    /// <summary>What the Select bar says and offers for the ticks as they are now; a later tick's answer wins.</summary>
    async Task UpdateSelectionAsync()
    {
        var version = ++_selectionVersion;
        var shown = ShownBooks.ToHashSet();
        try
        {
            var info = await Api.SelectionAsync(new SelectionQuery([.. _ticked], _ticked.Count(id => !shown.Contains(id))));
            if (version == _selectionVersion && _selecting) _selection = info;
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            // The bar keeps what it said; the next tick asks again.
        }
    }

    async Task ToggleCollectionMenuAsync()
    {
        if (_selectionMenu is not null)
        {
            _selectionMenu = null;
            return;
        }
        if (await SearchActionAsync(() => Api.CollectionsAsync()) is { } list) _selectionMenu = list.Menu;
    }

    async Task AddSelectedToCollectionAsync(CollectionMenuItem item)
    {
        _selectionMenu = null;
        if (_selection is not { } selection) return;
        if (await Collections.AddAsync([.. _ticked], selection.Books, item) is { } result) await ShowDone(result);
        else if (Collections.Pending is { } problem)
        {
            _done = problem;
            Collections.Pending = null;
        }
    }

    async Task RemoveSelectedFromCollectionAsync()
    {
        if (_query.Collection is not { } id || _selection is not { } selection) return;
        if (await Collections.RemoveAsync([.. _ticked], selection.Books, id) is not { } result) return;
        _ticked.Clear();
        await ShowDone(result);
        await UpdateSelectionAsync();
    }

    /// <summary>Edit metadata: the bulk editor for the ticked books, shown or not.</summary>
    async Task EditSelectedAsync()
    {
        CloseDetails();
        _working = true;
        _bulk = await SearchActionAsync(() => Api.BulkEditAsync([.. _ticked]));
        _working = false;
    }

    /// <summary>As in the Windows app, the books stay ticked after an edit, so another can follow.</summary>
    async Task BulkClosedAsync(ActionResult? result)
    {
        _bulk = null;
        if (result is not null) await ShowDone(result);
    }

    /// <summary>Same book: the dialog for which file opens, then the ticked cards become one book.</summary>
    async Task JoinSelectedAsync()
    {
