    Task RenameSearchAsync() => _view is { } view ? RenameSearchAsync(view.Id, view.Name) : Task.CompletedTask;

    Task RenameSearchAsync(SavedSearchInfo search) => RenameSearchAsync(search.Id, search.Name);

    async Task RenameSearchAsync(long id, string current)
    {
        _showSearches = false;
        if (await Dialogs.NameSearchAsync("Rename saved search", "Save", current) is not { } name || name == current) return;
        if (await SearchActionAsync(() => Api.RenameSearchAsync(id, name)) is null) return;
        if (id == _viewId && await Api.SavedSearchAsync(id) is { } renamed) _view = renamed;
        await Task.WhenAll(LoadSearchesAsync(), Pins.LoadAsync());
    }

    Task DeleteSearchAsync() => _view is { } view ? DeleteSearchAsync(view.Id) : Task.CompletedTask;

    Task DeleteSearchAsync(SavedSearchInfo search) => DeleteSearchAsync(search.Id);

    /// <summary>Deleted, the saved search's page becomes the library with the same search and filters, and the note has Undo.</summary>
    async Task DeleteSearchAsync(long id)
    {
        _showSearches = false;
        if (await SearchActionAsync(() => Api.DeleteSearchAsync(id)) is not { } result) return;
        _done = result;
        await Task.WhenAll(LoadSearchesAsync(), Pins.LoadAsync());
        if (id != _viewId) return;
        var query = _query;
        _viewId = null;
        _view = null;
        Navigation.NavigateTo("library" + LibraryUrl.QueryString(query, forApi: false));
    }

    /// <summary>A saved search change, its problem shown over the cards when it fails.</summary>
    async Task<T?> SearchActionAsync<T>(Func<Task<T>> action) where T : class
    {
        try
        {
            return await action();
        }
        catch (ApiProblemException e)
        {
            _done = new ActionResult(e.Message);
        }
        catch (HttpRequestException)
        {
            _done = new ActionResult("That didn't work. Check your connection and try again.");
        }
        return null;
    }

    async Task ChangeSort(ChangeEventArgs e)
    {
        var sort = e.Value as string;
        if (_viewId is not null)
        {
            await Filter(_query with { Sort = sort });
            return;
        }
        if (_query.IsSearching) _searchSort = sort;
        else _browseSort = sort;
        await SetPrefAsync(_query.IsSearching ? "library.sort.search" : "library.sort.browse", sort ?? "");
        await LoadAsync();
    }

    async Task SetLayout(bool list)
    {
        _list = list;
        // A saved search keeps its own layout, so the change is the search's to keep or not.
        if (_viewId is not null)
        {
            await Filter(_query);
            return;
        }
        _prefList = list;
        await SetPrefAsync("library.layout", list ? "list" : "covers");
    }

    async Task SetEachFile(bool eachFile)
    {
        if (_eachFile == eachFile) return;
        _eachFile = eachFile;
        await SetPrefAsync("library.pack-view", eachFile ? "files" : "packs");
        await LoadAsync();
    }

    /// <summary>"Filters", or "Filters · 2" with two on.</summary>
    string FiltersLabel => Chips.Count > 0 ? $"Filters · {Chips.Count}" : "Filters";

    /// <summary>"More filters", with how many of them are on while they are folded away.</summary>
    string MoreFiltersLabel => _showMore ? "Fewer filters" : Chips.Count(c => c.Folded) is var n and > 0 ? $"More filters · {n}" : "More filters";

    sealed record Chip(string Label, string Name, Func<LibraryQuery, LibraryQuery> Clear, bool Folded = false);

    /// <summary>The filters that are on, common ones first, in the Windows app's words; each chip's × turns its filter off.</summary>
    List<Chip> Chips
    {
        get
        {
            List<Chip> chips = [];
            if (_results is not { Menus: var m }) return chips;
            void Add(bool on, string label, string filter, Func<LibraryQuery, LibraryQuery> clear, bool folded = false)
            {
                if (on) chips.Add(new Chip(label, $"Turn off the {filter} filter", clear, folded));
            }
            Add(_query.System is not null, Label(m.Systems, _query.System), "game system", q => q with { System = null });
            Add(_query.Type is not null, Label(m.Types, _query.Type), "type", q => q with { Type = null });
            Add(_query.Level is not null, $"Level {_query.Level}{(_query.UnknownLevels ? " or unknown" : "")}", "character level", q => q with { Level = null });
            Add(_query.Players is not null, Label(LibraryChoices.Players, Text(_query.Players)), "players", q => q with { Players = null });
            Add(_query.Style is not null, Label(m.Styles, _query.Style), "style", q => q with { Style = null }, true);
            Add(_query.Duration is not null, Label(m.Durations, _query.Duration), "duration", q => q with { Duration = null }, true);
            foreach (var box in m.Boxes)
                foreach (var pick in box.Picked)
                {
                    var label = $"{box.Label}: {pick.Label}";
                    chips.Add(new Chip(label, $"Remove {label}", q => q with { Picked = PickedText.Remove(q.Picked, box.Key, pick.Value) }, true));
                }
            Add(_query.Folder is not null, $"Folder: {Label(m.Folders, Text(_query.Folder))}", "source folder", q => q with { Folder = null }, true);
            Add(_query.Own is not null, $"Also own: {Label(m.Owns, _query.Own)}", "also own", q => q with { Own = null }, true);
            Add(_query.Store is not null, $"Get it from: {Label(m.Stores, _query.Store)}", "get it from", q => q with { Store = null }, true);
            Add(_query.Kind is not null, Label(LibraryChoices.Kinds, _query.Kind), "kind", q => q with { Kind = null }, true);
            Add(_query.Ai is not null, Label(LibraryChoices.Ai, _query.Ai), "AI", q => q with { Ai = null }, true);
            Add(_query.Copies, Label(LibraryChoices.Copies, "true"), "copies", q => q with { Copies = false }, true);
            Add(_query.Adventures is not null, _query.Adventures == "Hidden" ? "Adventures inside files hidden" : "Adventures as cards", "adventures inside files",
                q => q with { Adventures = null }, true);
            Add(_query.Collections is not null, Label(LibraryChoices.Collections, _query.Collections), "collection", q => q with { Collections = null }, true);
            return chips;
        }
    }

    /// <summary>A choice's label without its count: "D&amp;D 5e (12)" reads "D&amp;D 5e" on its chip.</summary>
    static string Label(IReadOnlyList<FilterChoice> menu, string? value)
    {
        var label = menu.FirstOrDefault(c => c.Value == value)?.Label ?? value ?? "";
        return label.EndsWith(')') && label.LastIndexOf(" (", StringComparison.Ordinal) is var i and > 0 ? label[..i] : label;
    }

    /// <summary>A snippet's text, split where its hits start and end.</summary>
    static IEnumerable<(string Text, bool Hit)> Snippet(string snippet)
    {
        var hit = false;
        var start = 0;
        for (var i = 0; i <= snippet.Length; i++)
        {
            if (i < snippet.Length && snippet[i] != LibraryChoices.HitStart && snippet[i] != LibraryChoices.HitEnd) continue;
            if (i > start) yield return (snippet[start..i], hit);
            if (i < snippet.Length) hit = snippet[i] == LibraryChoices.HitStart;
            start = i + 1;
        }
    }

    static string Text(long? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    static int? Number(object? value) => int.TryParse(value as string, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;

    async Task<string?> PrefAsync(string key)
    {
        try
        {
            return await JS.InvokeAsync<string?>("bibliotaphPrefs.get", key);
        }
        catch (JSException)
        {
            return null;
        }
    }

    async Task SetPrefAsync(string key, string value)
    {
        try
        {
            await JS.InvokeVoidAsync("bibliotaphPrefs.set", key, value);
        }
        catch (JSException)
        {
            // library.js didn't load; the choice holds until the page is left.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Activity.Changed -= OnActivityChanged;
        Pins.Changed -= OnPinsChanged;
        _loading?.Cancel();
        if (_selecting)
        {
            try
            {
                await JS.InvokeVoidAsync("bibliotaphSelect.stop");
            }
            catch (JSDisconnectedException)
            {
            }
        }
        if (_watch is not null)
        {
            try
            {
                await _watch.InvokeVoidAsync("stop");
                await _watch.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _self?.Dispose();
    }
}
