    /// <summary>Export these: the ticked books as CSV, the rows Settings › Backup's Export CSV writes, saved as a download.</summary>
    async Task ExportSelectedAsync()
    {
        _working = true;
        var csv = await SearchActionAsync(() => Api.ExportAsync([.. _ticked]));
        _working = false;
        if (csv is null) return;
        try
        {
            await JS.InvokeVoidAsync("bibliotaphSave", csv.Name, "text/csv;charset=utf-8", csv.Csv);
            _done = new ActionResult(csv.Message);
