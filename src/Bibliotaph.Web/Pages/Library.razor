    /// <summary>What the Library shows, as a saved search keeps it.</summary>
    LibraryQuery Saving => _query with { Sort = Sort, EachFile = false };

    /// <summary>Saved, the search opens as itself, pinned in the sidebar.</summary>
    async Task SaveSearchAsync()
    {
        if (await Dialogs.NameSearchAsync("Save search", "Save") is not { } name) return;
        await SaveNewAsync(name);
    }

    async Task SaveAsNewAsync()
    {
        if (_view is not { } view || await Dialogs.NameSearchAsync("Save as a new search", "Save", view.CopyName) is not { } name) return;
        await SaveNewAsync(name);
    }

    async Task SaveNewAsync(string name)
    {
        if (await SearchActionAsync(() => Api.SaveSearchAsync(new SavedSearchSave(name, Saving, _list))) is not { } created) return;
        _done = created.Result;
        _view = created.Search;
        await Task.WhenAll(LoadSearchesAsync(), Pins.LoadAsync());
        Navigation.NavigateTo($"library?view={created.Search.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
    }

    async Task UpdateSearchAsync()
    {
        if (_view is not { } view || await SearchActionAsync(() => Api.UpdateSearchAsync(view.Id, new SavedSearchChange(Saving, _list))) is not { } result) return;
        _done = result;
        _view = await Api.SavedSearchAsync(view.Id);
        Navigation.NavigateTo($"library?view={view.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)}", replace: true);
