        _working = true;
        _packing = await SearchActionAsync(() => Api.PackPreviewAsync([.. _ticked]));
        _working = false;
    }

    async Task PackClosedAsync(ActionResult? result)
    {
        _packing = null;
        await AfterSelectionChangeAsync(result);
    }

    /// <summary>Remove adventures: each ticked adventure's card goes and its pages are its file's again, with one Undo for them all.</summary>
    async Task RemoveSelectedAdventuresAsync()
    {
        CloseDetails();
        _working = true;
