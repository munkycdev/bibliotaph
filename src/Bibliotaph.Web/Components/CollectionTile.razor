@* .bt-collectioncard, as the Windows app's CollectionCard: the covers of the two books added last, or a folder while it
   has none; its name and how many books and collections it holds. A click opens the Library scoped to it. *@
<a class="bt-collectioncard" href="@($"library?collection={Card.Id}")" title="@Card.Tip" aria-label="@Card.Name">
    <div class="bt-collectionmosaic">
        @if (Card.Covers.Count == 0)
        {
            <Icon Name="Folder" Size="30" />
        }
        else
        {
            <div class="bt-collectioncovers">
                @foreach (var book in Card.Covers)
                {
                    <BookCover Book="book" Marks="false" />
                }
            </div>
        }
        @if (Card.Pinned)
        {
            <span class="bt-collectionpin" title="Pinned"><Icon Name="Pin" Size="13" /></span>
        }
    </div>
    <div class="bt-collectionname">@Card.Name</div>
    <div class="bt-small bt-collectioncount">@Card.Count</div>
</a>

@code {
    [Parameter, EditorRequired] public CollectionCard Card { get; set; } = default!;
}
