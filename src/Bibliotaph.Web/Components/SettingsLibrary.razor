@* Settings › Library, as the Windows app's: the library folders, each with what it holds, adding one picked from
   connected storage, removing one, Look for changes, and the folder rules answered in Needs review. *@
@inject ApiClient Api
@inject LibraryActivity Activity

<section class="bt-section" aria-labelledby="library-heading">
    <h2 id="library-heading">Library folders</h2>
    <p class="bt-copy">Bibliotaph reads your folders. Your books stay exactly where you put them.</p>
    @foreach (var folder in _folders)
    {
        <div class="bt-source bt-sourcerow">
            <Icon Name="Folder" />
            <div>@folder.Location<small>@folder.Detail</small></div>
            <button class="bt-icon" title="Remove from library" aria-label="@($"Remove {folder.Location} from the library")" @onclick="() => Remove(folder)"><Icon Name="X" /></button>
        </div>
    }
    @if (_folders.Count == 0 && _pending is null && _storage is not null)
    {
        <p class="bt-fine">
            No folders yet.
            @if (_storage.Count == 0)
            {
                @:Connect your storage above first.
            }
        </p>
    }
    @if (_pending is not null)
    {
        <div class="bt-source bt-pending">
            <div class="bt-sourcerow">
                <Icon Name="FolderPlus" />
                <div>@_pending.Location<small>@_pending.Detail</small></div>
            </div>
            <div class="bt-actions">
                <button class="bt-button primary" @onclick="ConfirmAdd"><Icon Name="Check" />Add to library</button>
                <button class="bt-button" @onclick="() => _pending = null">Cancel</button>
            </div>
        </div>
    }
    @if (_problem is not null)
    {
        <div class="bt-message" role="alert">@_problem</div>
    }
    <div class="bt-actions">
        <button class="bt-button primary" disabled="@(_storage is not { Count: > 0 })" title="@(_storage is { Count: 0 } ? "Connect your storage above first." : null)"
                @onclick="() => _picking = true"><Icon Name="FolderPlus" />Add a folder</button>
        @if (_folders.Count > 0)
        {
            <button class="bt-button" @onclick="Rescan"><Icon Name="RotateCcw" />Look for changes</button>
        }
    </div>
    <p class="bt-fine">Removing a folder keeps your notes, collections and corrections. Files are never deleted.</p>

    @if (_preferences is { FolderRules.Count: > 0 } preferences)
    {
        <div class="bt-settingshead">Folder rules</div>
        <p class="bt-fine">Rules you answered in Needs review. A rule that's on suggests its value for every file in the folder and its
            subfolders, new ones too. Your own corrections always win.</p>
        @foreach (var rule in preferences.FolderRules)
        {
            <label class="bt-switchrow">
                <input type="checkbox" checked="@rule.Enabled" disabled="@_switching" aria-label="@($"Use the rule for the folder {rule.Folder}")"
                       @onchange="e => SwitchRuleAsync(rule, e.Value is true)" />
                <span><strong>@rule.Folder</strong><span class="bt-arrow"> → </span>@rule.Meaning<small title="@rule.Detail">@rule.Detail</small></span>
            </label>
        }
    }
    @if (_preferencesProblem is not null)
    {
        <div class="bt-message" role="alert">@_preferencesProblem</div>
    }
</section>

@if (_picking && _storage is not null)
{
    <FolderPicker Storage="_storage" Picked="Picked" Cancelled="() => _picking = false" />
}

@code {
    IReadOnlyList<StorageAccount>? _storage;
    IReadOnlyList<LibraryFolder> _folders = [];
    PickedFolder? _pending;
    string? _problem;
    bool _picking;

    LibraryPreferences? _preferences;
    string? _preferencesProblem;
    bool _switching;

    protected override async Task OnInitializedAsync()
    {
        _folders = await Api.LibraryFoldersAsync();
        _storage = await Api.StorageAsync();
        await LoadPreferencesAsync();
    }

    async Task LoadPreferencesAsync() => await ChangeAsync(() => Api.LibraryPreferencesAsync());

    // Each switch reads the hints of the books it touches again before answering, so the others wait for it.
    Task SwitchRuleAsync(FolderRuleSwitch rule, bool enabled) => ChangeAsync(() => Api.SwitchFolderRuleAsync(rule.Id, enabled));

    async Task ChangeAsync(Func<Task<LibraryPreferences>> change)
    {
        _switching = true;
        _preferencesProblem = null;
        try
        {
            _preferences = await change();
            Activity.Refresh();
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException)
        {
            _preferencesProblem = "That couldn't be changed just now. Try again in a moment.";
        }
        _switching = false;
    }

    void Picked(PickedFolder folder)
    {
        _picking = false;
        _problem = null;
        _pending = folder;
    }

    async Task ConfirmAdd()
    {
        if (_pending is null) return;
        try
        {
            _folders = await Api.AddLibraryFolderAsync(new AddLibraryFolder(_pending.Storage.Id, _pending.Path));
            Activity.Refresh();
        }
        catch (ApiProblemException problem)
        {
            _problem = problem.Message;
        }
        _pending = null;
    }

    async Task Remove(LibraryFolder folder)
    {
        _folders = await Api.RemoveLibraryFolderAsync(folder.Id);
        Activity.Refresh();
    }

    async Task Rescan()
    {
        await Api.RescanAsync();
        Activity.Refresh();
    }
}
