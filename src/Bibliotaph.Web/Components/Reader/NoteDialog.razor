@* .bt-dialog: a page note's pages and text, over the reader. Ctrl+Enter saves; Esc, Cancel or a click outside closes it. *@

<div class="bt-backdrop fixed bt-dialogback" @onclick="Close"></div>
<div class="bt-dialog" role="dialog" aria-modal="true" aria-label="@Draft.Heading" @onkeydown="KeyAsync">
    <div class="bt-drawer-head bt-dialoghead">
        <div>
            <span class="bt-eyebrow bt-eyebrow-block">PAGE NOTE</span>
            <h2 class="bt-dialogtitle">@Draft.Heading</h2>
        </div>
        <button class="bt-icon" title="Close (Esc)" aria-label="Close" @onclick="Close"><Icon Name="X" /></button>
    </div>
    <div class="bt-inline bt-notepagefields">
        <label class="bt-field">From page<input aria-label="From page" @bind="Draft.From" @bind:event="oninput" /></label>
        <label class="bt-field">To page (optional)<input aria-label="To page" @bind="Draft.To" @bind:event="oninput" /></label>
    </div>
    @if (Range is null)
    {
        <div class="bt-small bt-notepageproblem">Type pages as the book numbers them, or PDF page numbers.</div>
    }
    <label class="bt-field bt-notefield">Note<textarea aria-label="Note" title="Ctrl+Enter saves" rows="6" @bind="Draft.Text" @bind:event="oninput" @ref="_text"></textarea></label>
    <div class="bt-boxactions end bt-dialogactions">
        <button class="bt-button" @onclick="Close">Cancel</button>
        <button class="bt-button primary" disabled="@(!CanSave)" @onclick="SaveAsync">Save note</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NoteDraft Draft { get; set; } = default!;
    [Parameter, EditorRequired] public ReaderBook Book { get; set; } = default!;

    /// <summary>The note's pages and trimmed text, once both are good.</summary>
    [Parameter] public EventCallback<PageNoteEdit> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    ElementReference _text;

    (int First, int Last)? Range => ReaderPageNumbers.Range(Draft.From, Draft.To, Book.Labels, Book.PageCount);

    bool CanSave => Draft.Text.Trim().Length > 0 && Range is not null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _text.FocusAsync();
    }

    Task Close() => Closed.InvokeAsync();

    Task SaveAsync() => CanSave && Range is { } range ? Saved.InvokeAsync(new PageNoteEdit(range.First, range.Last, Draft.Text.Trim())) : Task.CompletedTask;

    async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
        else if (e.Key == "Enter" && e.CtrlKey) await SaveAsync();
    }
}
