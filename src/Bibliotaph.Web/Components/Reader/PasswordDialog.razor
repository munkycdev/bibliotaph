@* .bt-dialog: a PDF's password, asked before its pages open, with whether to search and remember it. Enter opens;
   Esc or Cancel goes without. *@

<div class="bt-backdrop fixed bt-dialogback"></div>
<div class="bt-dialog" role="dialog" aria-modal="true" aria-label="Password needed" @onkeydown="Key">
    <div class="bt-drawer-head bt-dialoghead">
        <h2 class="bt-dialogtitle">“@Title” needs a password</h2>
    </div>
    <div class="bt-small bt-dialogintro">
        @(Retry ? "That password didn't open it. Check it and try again." : "Enter its password to read it, and to make its text searchable.")
    </div>
    <label class="bt-field">Password<input type="password" aria-label="Password" @bind="_text" @bind:event="oninput" @ref="_box" /></label>
    <label class="bt-check bt-passwordtick"><input type="checkbox" aria-label="Make its text searchable" checked="@Ticks.MakesSearchable"
           disabled="@Ticks.Remember" @onchange="e => Ticks.Searchable = e.Value is true" />Make its text searchable</label>
    <div class="bt-small bt-passwordnote">Bibliotaph reads the book for search now. Untick to only read it.</div>
    <label class="bt-check bt-passwordtick"><input type="checkbox" aria-label="Remember it" checked="@Ticks.Remember"
           @onchange="e => Ticks.Remember = e.Value is true" />Remember it in your web library</label>
    <div class="bt-small bt-passwordnote">Kept encrypted with the server's own keys, never shown. Settings › Passwords forgets it.</div>
    <div class="bt-boxactions end bt-dialogactions">
        <button class="bt-button" @onclick="() => Answer(null)">Cancel</button>
        <button class="bt-button primary" @onclick="() => Answer(_text)">Open</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The last password typed didn't open it.</summary>
    [Parameter] public bool Retry { get; set; }

    [Parameter, EditorRequired] public PasswordTicks Ticks { get; set; } = default!;

    /// <summary>What was typed, or null for Cancel or nothing typed.</summary>
    [Parameter] public EventCallback<string?> Answered { get; set; }

    string _text = "";
    ElementReference _box;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _box.FocusAsync();
    }

    Task Answer(string? password) => Answered.InvokeAsync(string.IsNullOrEmpty(password) ? null : password);

    async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Answer(_text);
        else if (e.Key == "Escape") await Answer(null);
    }
}
