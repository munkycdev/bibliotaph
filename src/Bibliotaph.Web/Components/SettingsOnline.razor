@* Settings › Online libraries: how books come in from outside, the services in two groups (read on
   their own site, or bought from them as files), a library page's preview grouped by what importing does, the import
   with Undo, and the books the page no longer lists. A browser can't hold the service's site as the Windows app's own
   browser does, so the page arrives from the user's browser, sent with its covers by the Send to Bibliotaph bookmark or
   extension (Pages/OnlineReceive.razor opens its preview here, as ?page=). The bookmark is always offered, extension or
   not, since it is the one way in that works in every browser. *@
@using Bibliotaph.Core
@inject BooksClient BooksApi
@inject OnlineClient OnlineApi
@inject LibraryActivity Activity
@inject NavigationManager Navigation
@inject IJSRuntime JS

<section class="bt-section" aria-labelledby="online-heading">
    <h2 id="online-heading">Online libraries</h2>
    <p class="bt-copy">Bring in the books you own outside your folders: books you read on a service's own site, such as D&amp;D Beyond
        and Demiplane, and PDFs you bought from stores, such as Humble Bundle and DriveThruRPG. Bibliotaph never holds your passwords and
        never visits the services itself.</p>

    <h3 class="bt-settingshead">How they come in</h3>
    <div class="bt-settingrow bt-onlineservice">
        <div>Send to Bibliotaph<small>Drag this to your browser's bookmarks bar. Then open your library on a service below, signed in, and click
            the bookmark there: the page comes here with its covers, ready to import. Nothing is imported until you choose.
            @(_extension is { } version
                ? $"The Send to Bibliotaph extension ({version}) is in this browser too: its toolbar button does the same, and brings covers some sites keep from the bookmark."
                : "The Send to Bibliotaph extension for Chrome and Edge does the same from a toolbar button, and brings covers some sites keep from the bookmark.")</small></div>
        <div class="bt-onlineactions">
            @* Clicked here it would only send this page, so it is only for dragging. *@
            <a class="bt-button bt-bookmarklet" href="@_bookmarklet" draggable="true" title="Drag to your bookmarks bar"
               @onclick:preventDefault="true"><Icon Name="Inbox" />Send to Bibliotaph</a>
        </div>
    </div>

    @foreach (var (heading, note, services) in Groups)
    {
        <h3 class="bt-settingshead">@heading</h3>
        <p class="bt-fine">@note</p>
        @foreach (var service in services)
        {
            <div class="bt-settingrow bt-onlineservice">
                <div>@service.Name<small>@service.Explanation</small></div>
                <div class="bt-onlineactions">
                    <a class="bt-button primary" href="@service.LibraryPage" target="_blank" rel="noopener noreferrer"
                       aria-label="@($"Open your {service.Name} library in a new tab")"><Icon Name="SquareArrowOutUpRight" />Open @service.Name</a>
                </div>
            </div>
        }
    }
    @if (_problem is { } problem)
    {
        <div class="bt-problem" role="alert">@problem</div>
    }
    <DoneNote Result="_done" UndoName="Undo the import" Undone="RefreshAsync" Dismissed="() => _done = null" />

    @if (_preview is { } preview)
    {
        <div class="bt-onlinesummary">
            <h3 class="bt-settingshead">@preview.Summary</h3>
            <button class="bt-button primary" disabled="@(_busy || _chosen.Count == 0)" @onclick="ImportAsync">@ImportLabel</button>
        </div>
        @if (preview.CoversFound < preview.Covers)
        {
            <p class="bt-fine bt-onlinecovers">@($"{preview.CoversFound:N0} of {preview.Covers:N0} covers came with the page. The Send to Bibliotaph extension brings covers some sites keep from the bookmark.")</p>
        }
        @foreach (var group in preview.Groups)
        {
            <h3 class="bt-settingshead">@group.Heading</h3>
            <p class="bt-fine">@group.Explanation</p>
            <ul class="bt-onlinerows" aria-label="@group.Heading">
                @foreach (var row in group.Rows)
                {
                    <li>
                        @if (row.CanChoose)
                        {
                            <label class="bt-check"><input type="checkbox" checked="@_chosen.Contains(row.Index)" aria-label="@($"Import {row.Title}")"
                                                           @onchange="e => Choose(row.Index, e.Value is true)" /><span><b>@row.Title</b><small>@row.Detail</small></span></label>
                        }
                        else
                        {
                            <span><b>@row.Title</b><small>@row.Detail</small></span>
                        }
                    </li>
                }
            </ul>
        }
        @if (preview.Missing.Count > 0)
        {
            <h3 class="bt-settingshead">No longer in this library</h3>
            <p class="bt-fine">Books imported before that this page doesn't list. Nothing is removed unless you remove it.</p>
            <ul class="bt-onlinerows" aria-label="No longer in this library">
                @foreach (var book in preview.Missing)
                {
                    <li class="bt-onlinemissing">
                        <span>@book.Title</span>
                        <button class="bt-link" disabled="@_busy" aria-label="@($"Remove {book.Title} from your library")"
                                @onclick="() => RemoveAsync(book)">Remove from library</button>
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    List<OnlineService> _services = [];

    IEnumerable<(string Heading, string Note, List<OnlineService> Services)> Groups =>
        new[]
        {
            (OnlineLibraryGroups.ReadOnline, OnlineLibraryGroups.ReadOnlineNote, _services.Where(s => s.ReadOnline).ToList()),
            (OnlineLibraryGroups.Stores, OnlineLibraryGroups.StoresNote, _services.Where(s => !s.ReadOnline).ToList()),
        }.Where(g => g.Item3.Count > 0);
    OnlinePreview? _preview;
    readonly HashSet<int> _chosen = [];
    ActionResult? _done;
    string? _problem;
    bool _busy;

    string ImportLabel => _chosen.Count switch
    {
        0 => "Import",
        1 => "Import 1 book",
        var n => $"Import {n.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)} books",
    };

    string _bookmarklet = "";
    string? _extension;

    protected override async Task OnInitializedAsync()
    {
        _bookmarklet = SendToBibliotaph.Bookmarklet(new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority));
        _services = await OnlineApi.OnlineServicesAsync();
        try
        {
            _extension = await JS.InvokeAsync<string?>("bibliotaphExtension");
        }
        catch (JSException)
        {
            // Without the page's own script, the bookmark is offered as if there were no extension.
        }
        // A page Send to Bibliotaph brought: its preview, as if it had just been imported here.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        if (query["page"] is { Length: > 0 } token)
            await RunAsync(async () => Show(await OnlineApi.OnlinePreviewAsync(token)));
    }

    void Choose(int row, bool chosen)
    {
        if (chosen) _chosen.Add(row);
        else _chosen.Remove(row);
    }

    async Task ImportAsync()
    {
        if (_preview is not { } preview) return;
        await RunAsync(async () =>
        {
            var imported = await OnlineApi.ImportOnlineAsync(preview.Token, new OnlineImportChoice([.. _chosen]));
            _done = imported.Result;
            Show(imported.Preview);
            Activity.Refresh();
        });
    }

    async Task RemoveAsync(OnlineMissing book)
    {
        await RunAsync(async () =>
        {
            _done = await BooksApi.RemoveElsewhereAsync(book.EntryId);
            await RefreshAsync();
        });
    }

    /// <summary>The preview again, as after an Undo.</summary>
    async Task RefreshAsync()
    {
        if (_preview is not { } preview) return;
        try
        {
            Show(await OnlineApi.OnlinePreviewAsync(preview.Token), keepChoice: true);
        }
        catch (ApiProblemException ex)
        {
            _preview = null;
            _problem = ex.Message;
        }
    }

    /// <summary>Shows a preview with every book that has something to do ticked.</summary>
    void Show(OnlinePreview preview, bool keepChoice = false)
    {
        _preview = preview;
        var choosable = preview.Groups.SelectMany(g => g.Rows).Where(r => r.CanChoose).Select(r => r.Index).ToHashSet();
        if (keepChoice) _chosen.IntersectWith(choosable);
        else
        {
            _chosen.Clear();
            _chosen.UnionWith(choosable);
        }
    }

    async Task RunAsync(Func<Task> work)
    {
        _busy = true;
        _problem = null;
        try
        {
            await work();
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException)
        {
            _problem = ex is ApiProblemException ? ex.Message : "Bibliotaph couldn't do that just now. Try again in a moment.";
        }
        finally
        {
            _busy = false;
        }
    }
}
