@* The reader: the book's title over a toolbar, its pages in a scrolling column with the
   contents beside them and the thumbnails under them, and where the page in view is in the book underneath. The pages
   are read straight from the user's storage; the server never passes a book's bytes on. *@
@using Bibliotaph.Core.Reading
@implements IAsyncDisposable
@inject AskClient AskApi
@inject BindersClient BindersApi
@inject BooksClient BooksApi
@inject ReaderClient ReaderApi
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Pins Pins
@inject Breadcrumb Breadcrumb
@inject BinderActions BinderActions
@inject UnlockedBooks Unlocked

<PageTitle>@(_book?.Title ?? "Reader") · Bibliotaph</PageTitle>

@if (_book is not { } book)
{
    @if (_loadProblem is { } problem)
    {
        <EmptyState Title="@problem.Title" Message="@problem.Message" ActionText="Return to library" ActionIcon="LibraryBig" ActionHref="library" />
    }
    else
    {
        <div class="bt-loading">Opening…</div>
    }
}
else
{
    var problem = book.Problem ?? _problem;
    <div class="bt-reader @(Popout == true ? "popout" : "") @(InBinder ? "inbinder" : "")">
        <div class="bt-reader-head">
            <div class="bt-reader-titles">
                <h1 class="bt-reader-title" title="@book.Title">@book.Title</h1>
                @if (book.Subtitle.Length > 0) { <div class="bt-small bt-reader-subtitle" title="@book.Subtitle">@book.Subtitle</div> }
            </div>
            @if (problem is null)
            {
                <div class="bt-reader-actions">
                    @if (IsPdf)
                    {
                        @* A file whose first page is blank or a title sheet can show a better page on its card. *@
                        <button class="bt-icon" title="Use this page as the cover" aria-label="Use this page as the cover" disabled="@(book.Part is not null || _page == _coverPage)"
                                @onclick="UseAsCoverAsync"><Icon Name="Image" /></button>
                    }
                    @if (PackCoverMember is not null)
                    {
                        <button class="bt-icon" title="Use this image as the pack's cover" aria-label="Use this image as the pack's cover" @onclick="UseAsPackCoverAsync"><Icon Name="Image" /></button>
                    }
                    @if (HasPages)
                    {
                        <button class="bt-button" title="Give pages of this file a card of their own, as an adventure" aria-label="Mark pages as an adventure"
                                @onclick="MarkAdventure"><Icon Name="BookOpen" />Mark as adventure</button>
                        <button class="bt-button" title="Add a note on the page in view" aria-label="Add a note on this page" @onclick="AddNoteAsync"><Icon Name="Pencil" />Note</button>
                    }
                    <AddToBinderButton @key="book.DocumentId" Picked="p => AddPageAsync(p.Menu, p.Choice)" AddPages="AddPagesAsync" Failed="r => _binderDone = r" />
                </div>
            }
        </div>

        @if (problem is not null)
        {
            <EmptyState Title="@problem.Title" Message="@problem.Message" ActionText="@_problemAction" Action="RetryAsync" />
        }
        else
        {
            <div class="bt-reader-toolbar" role="toolbar" aria-label="Reader">
                @if (HasPages)
                {
                <div class="bt-toolgroup">
                    @if (book.Outline.Count > 0)
                    {
                        <button class="bt-icon @(_showOutline ? "on" : "")" title="Show or hide the contents" aria-label="Contents" aria-pressed="@_showOutline"
                                @onclick="() => _showOutline = !_showOutline"><Icon Name="List" Size="15" /></button>
                        <span class="bt-tooldivider"></span>
                    }
                    @if (IsPdf)
                    {
                        var stripAction = _showStrip ? "Hide page thumbnails" : "Show page thumbnails";
                        <button class="bt-icon @(_showStrip ? "on" : "")" title="@stripAction" aria-label="Page thumbnails" aria-pressed="@_showStrip"
                                @onclick="ToggleStripAsync"><Icon Name="PanelBottom" Size="15" /></button>
                        <span class="bt-tooldivider"></span>
                    }
                    <button class="bt-icon" title="Previous page" aria-label="Previous page" disabled="@(_page <= 0)" @onclick="() => GoToAsync(_page - 1)"><Icon Name="ChevronLeft" Size="15" /></button>
                    <label class="bt-pagelabel">Page
                        <input class="bt-page-input" aria-label="Page" title="A printed page number, or the page's place in the book" value="@_pageEntry"
                               @oninput="e => _pageEntry = e.Value?.ToString() ?? string.Empty" @onkeydown="PageKeyAsync" @onfocus="PageFocusAsync" @onblur="PageBlur" @ref="_pageBox" />
                    </label>
                    <span class="bt-small">of @book.PageCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</span>
                    @if (book.Part is { } part)
                    {
                        <span class="bt-small bt-partposition">@part.Position(_page)</span>
                    }
                    <button class="bt-icon" title="Next page" aria-label="Next page" disabled="@(_page >= book.PageCount - 1)" @onclick="() => GoToAsync(_page + 1)"><Icon Name="ChevronRight" Size="15" /></button>
                    @if (_linkBack is { } back)
                    {
                        <button class="bt-link bt-iconlink" title="Go back to the page where you followed the link" @onclick="BackFromLinkAsync">
                            <Icon Name="Undo2" Size="14" />Back to page @ReaderPageNumbers.Display(back, book.Labels)
                        </button>
                    }
                    <span class="bt-tooldivider"></span>
                </div>
                <div class="bt-toolgroup">
                    <button class="bt-link bt-iconlink bt-notestoggle @(_showNotes ? "on" : "")" title="Show or hide the notes on this book's pages" aria-pressed="@_showNotes"
                            @onclick="ToggleNotes"><Icon Name="NotebookPen" Size="14" />@(_notes?.Label ?? "Notes")</button>
                    <span class="bt-tooldivider"></span>
                    @* Ask this book: only while AI is on. *@
                    @if (_ask is { On: true })
                    {
                        <button class="bt-link bt-iconlink bt-notestoggle @(_showAsk ? "on" : "")" title="Ask this book a question" aria-label="Ask this book"
                                aria-pressed="@_showAsk" @onclick="ToggleAsk"><Icon Name="Sparkles" Size="14" />Ask</button>
                        <span class="bt-tooldivider"></span>
                    }
                </div>
                }
                @if (book.Pack.Count > 0)
                {
                    var noun = book.Pack.All(f => f.IsImage) ? "image" : "file";
                    var at = PackIndex;
                    <div class="bt-toolgroup">
                        <button class="bt-icon" title="@(noun == "image" ? "Previous image (Left arrow)" : "Previous file in the pack")" aria-label="Previous @noun"
                                disabled="@(at <= 0)" @onclick="() => StepPack(-1)"><Icon Name="ChevronLeft" Size="15" /></button>
                        <span class="bt-small" aria-label="Place in pack">@((at + 1).ToString("N0", System.Globalization.CultureInfo.CurrentCulture)) of @book.Pack.Count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</span>
                        <button class="bt-icon" title="@(noun == "image" ? "Next image (Right arrow)" : "Next file in the pack")" aria-label="Next @noun"
                                disabled="@(at < 0 || at >= book.Pack.Count - 1)" @onclick="() => StepPack(1)"><Icon Name="ChevronRight" Size="15" /></button>
                        <span class="bt-tooldivider"></span>
                    </div>
                }
                <div class="bt-toolgroup">
                    <button class="bt-icon" title="Zoom out (Ctrl+minus)" aria-label="Zoom out" @onclick="() => ZoomAsync(false)"><Icon Name="Minus" Size="15" /></button>
                    <select class="bt-select bt-zoom" aria-label="Zoom" title="@(IsPdf ? "Zoom (Ctrl+mouse wheel; Ctrl+0 fits the width again)" : "Zoom (Ctrl+mouse wheel; Ctrl+0 fits it again)")" value="@_scale" @onchange="ScaleChosenAsync">
                        @foreach (var (value, label) in Zooms)
                        {
                            <option value="@value">@label</option>
                        }
                        @if (!Zooms.Any(c => c.Value == _scale) && double.TryParse(_scale, System.Globalization.CultureInfo.InvariantCulture, out var shown))
                        {
                            <option value="@_scale">@shown.ToString("P0", System.Globalization.CultureInfo.CurrentCulture)</option>
                        }
                    </select>
                    <button class="bt-icon" title="Zoom in (Ctrl+plus)" aria-label="Zoom in" @onclick="() => ZoomAsync(true)"><Icon Name="Plus" Size="15" /></button>
                    <span class="bt-tooldivider"></span>
                    @{
                        var favoriteAction = _favorite ? "Remove from favorites" : "Add to favorites";
                        var pinned = Pins.IsPinned(PinKinds.Book, book.EntryId);
                        var pinAction = pinned ? "Unpin from the sidebar" : "Pin to the sidebar";
                    }
                    <button class="bt-icon bt-heart @(_favorite ? "on" : "")" title="@favoriteAction" aria-label="@favoriteAction" aria-pressed="@_favorite"
                            @onclick="ToggleFavoriteAsync"><Icon Name="Heart" Size="15" /></button>
                    <button class="bt-icon bt-pinbutton @(pinned ? "on" : "")" title="@pinAction" aria-label="@pinAction" aria-pressed="@pinned"
                            @onclick="() => Pins.ToggleAsync(PinKinds.Book, book.EntryId)"><Icon Name="Pin" Size="15" /></button>
                    @if (_stored)
                    {
                        var offlineAction = !_kept ? "Keep offline: the whole book downloads to this browser, so it opens without the network"
                            : _offlineProgress < 1 ? "Downloading to keep offline. Click to stop and let it go with the other books in this browser"
                            : "Kept offline in this browser. Click to let it go with the other books read here";
                        <button class="bt-icon bt-offline @(_kept ? "on" : "")" title="@offlineAction" aria-label="Keep offline" aria-pressed="@_kept"
                                @onclick="ToggleOfflineAsync"><Icon Name="HardDrive" Size="15" /></button>
                        @if (_kept && _offlineProgress < 1)
                        {
                            <span class="bt-small bt-offlineprogress" role="status">@_offlineProgress.ToString("P0", System.Globalization.CultureInfo.CurrentCulture)</span>
                        }
                    }
                    @* In a binder, the binder pops out as a whole. *@
                    @if (InBinder)
                    {
                    }
                    else if (Popout == true)
                    {
                        <span class="bt-tooldivider"></span>
                        <button class="bt-icon" title="Return to the main window" aria-label="Return to main window" @onclick="ReturnToMainAsync"><Icon Name="SquareArrowDownLeft" Size="15" /></button>
                    }
                    else
                    {
                        <span class="bt-tooldivider"></span>
                        <button class="bt-icon" title="Pop out into a window of its own" aria-label="Pop out" @onclick="PopOutAsync"><Icon Name="SquareArrowOutUpRight" Size="15" /></button>
                    }
                </div>
                @if (HasPages)
                {
                <div class="bt-toolgroup">
                    <input class="bt-findbox" type="search" placeholder="Find in this book (Ctrl+F)" aria-label="Find in this book" value="@_find.Text"
                           @oninput="e => _find.Text = e.Value?.ToString() ?? string.Empty" @onkeydown="FindKeyAsync" />
                    <button class="bt-icon" title="Previous match (Shift+F3)" aria-label="Previous match" @onclick="() => StepAsync(false)"><Icon Name="ChevronLeft" Size="15" /></button>
                    <button class="bt-icon" title="Next match (F3)" aria-label="Next match" @onclick="() => StepAsync(true)"><Icon Name="ChevronRight" Size="15" /></button>
                    @if (book.Part is not null)
                    {
                        <label class="bt-check small" title="Find in the whole file, not only this adventure's pages">
                            <input type="checkbox" checked="@_wholeFile" @onchange="WholeFileChangedAsync" />Whole file
                        </label>
                    }
                    @if (_find.Status.Length > 0) { <span class="bt-small bt-findstatus" role="status">@_find.Status</span> }
                </div>
                }
            </div>
            <div class="bt-reader-stage">
                @if (_showOutline && book.Outline.Count > 0)
                {
                    <nav class="bt-contents" aria-label="Contents">
                        <span class="bt-eyebrow">CONTENTS</span>
                        <ul>
                            @foreach (var line in book.Outline)
                            {
                                <li class="depth@(line.Depth) @(line.InPart ? "inpart" : "") bt-menuanchor">
                                    <button title="@line.Title" @onclick="() => GoToAsync(line.Page)" @oncontextmenu="() => _outlineMenu = line" @oncontextmenu:preventDefault="true">
                                        <span class="bt-contentstitle">@line.Title</span><span class="bt-small">@line.PageText</span>
                                    </button>
                                    @if (line.Found is { } found) { <div class="bt-small bt-contentsfound" title="Found by the AI reading this chapter">@found</div> }
                                    @if (_outlineMenu == line)
                                    {
                                        <div class="bt-backdrop fixed bt-menuback" @onclick="() => _outlineMenu = null" @oncontextmenu="() => _outlineMenu = null" @oncontextmenu:preventDefault="true"></div>
                                        <div class="bt-menu bt-menuleft" role="menu" aria-label="@line.Title">
                                            <button class="bt-menuitem" role="menuitem" @onclick="() => IndexBookmark(line)">Index as its own adventure…</button>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    </nav>
                }
                <div class="bt-pagescolumn">
                    <div class="bt-pages" @ref="_stage" tabindex="0" aria-label="@(HasPages ? "Pages" : "Picture")">
                        @if (IsPdf) { <div class="pdfViewer"></div> }
                        else if (book.Kind == ReaderKinds.Ebook) { <div class="bt-ebook"></div> }
                        else { <div class="bt-picture"></div> }
                    </div>
                    @if (!_opened) { <div class="bt-small bt-opening">Opening…</div> }
                    @* What Add page and the last note change did, with Undo, over the pages. *@
                    <div class="bt-readerbars">
                        @if (book.Item is { Banner: { } banner })
                        {
                            <ItemBanner Text="@banner" CanUsePage="book.Item.CanUsePage" UsePage="UseThisPageAsync" Dismissed="DismissBanner" />
                        }
                        <DoneNote Result="_binderDone" UndoName="Undo" Dismissed="() => _binderDone = null" />
                        <DoneNote Result="_noteDone" UndoName="Undo the note change" Dismissed="() => _noteDone = null" Undone="ReloadNotesAsync" />
                    </div>
                    @if (_notice is { } notice) { <div class="bt-notice" role="status">@notice</div> }
                </div>
                <div class="bt-strip" @ref="_strip" aria-label="Page thumbnails"></div>
                @if (_showAsk && HasPages && _ask is { On: true } ask)
                {
                    <AskPanel Book="ask" DocumentId="_book!.DocumentId" Show="ShowPhraseAsync" />
                }
                @if (_showNotes && HasPages)
                {
                    <NotesPanel Notes="_notes" GoTo="GoToNoteAsync" Edit="EditNote" Delete="DeleteNoteAsync" />
                }
            </div>
            @if (IsPdf)
            {
                <div class="bt-reader-foot">
                    <span>@PositionText</span>
                    @if (!_canCopy) { <span>This PDF doesn't allow copying its text.</span> }
                </div>
            }
        }
    </div>
}

@if (_book is { } open)
{
    @if (_noteDialog is { } note)
    {
        <NoteDialog @key="note" Draft="note" Book="open" Saved="SaveNoteAsync" Closed="() => _noteDialog = null" />
    }
    @if (_pagesDialog is { } pages)
    {
        <AddPagesDialog @key="pages" Draft="pages" Book="open" Saved="SavePagesAsync" Closed="() => _pagesDialog = null" />
    }
    @if (_partDialog is { } marking)
    {
        <AdventureDialog @key="marking" Draft="marking" Book="open" Saved="SavePartAsync" Closed="() => _partDialog = null" />
    }
}

@if (_password is { } asking)
{
    <PasswordDialog @key="asking.Answer" Title="@(_book?.Title ?? "")" Retry="asking.Retry" Ticks="_passwords.Ticks" Answered="AnswerPassword" />
}

@code {
    static readonly double[] ZoomSteps = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 2, 3, 4];

    static readonly (string Value, string Label)[] Steps =
        [.. ZoomSteps.Select(z => (z.ToString(System.Globalization.CultureInfo.InvariantCulture), z.ToString("P0", System.Globalization.CultureInfo.CurrentCulture)))];

    static readonly (string Value, string Label)[] PageZooms = [("page-width", "Fit width"), ("page-fit", "Fit page"), .. Steps];

    static readonly (string Value, string Label)[] ImageZooms = [("page-fit", "Fit to window"), .. Steps];

    // A flowing e-book's text fills the reading column at any size; only a fixed-layout one's pages are fitted.
    static readonly (string Value, string Label)[] FlowingZooms = [("page-width", "Usual size"), .. Steps];

    (string Value, string Label)[] Zooms => _book?.Kind switch
    {
        ReaderKinds.Image => ImageZooms,
        ReaderKinds.Ebook when _ebook is { FixedLayout: false } => FlowingZooms,
        _ => PageZooms,
    };

    bool IsPdf => _book?.Kind == ReaderKinds.Pdf;

    /// <summary>A file with pages of text, as a PDF or an e-book: a picture has no page box, contents or Find.</summary>
    bool HasPages => _book is not null && _book.Kind != ReaderKinds.Image;

    int PackIndex => _book is { } book ? book.Pack.ToList().FindIndex(f => f.DocumentId == book.DocumentId) : -1;

    /// <summary>An image opened from a pack, whose own card in it can be the pack's cover in place of its mosaic.</summary>
    long? PackCoverMember => _book is { Kind: ReaderKinds.Image } book && PackIndex is >= 0 and var at ? book.Pack[at].MemberEntryId : null;

    [Parameter] public long EntryId { get; set; }
    [Parameter] public long? Doc { get; set; }
    [Parameter] public int? Page { get; set; }
    [Parameter] public string? Q { get; set; }
    [Parameter] public bool? Keep { get; set; }
    [Parameter] public bool? Popout { get; set; }

    /// <summary>Opens with the Ask panel, as Ask this book in a book's details does.</summary>
    [Parameter] public bool? Ask { get; set; }

    /// <summary>A binder's item, opened at its pages, with its banner when they changed.</summary>
    [Parameter] public long? Item { get; set; }

    /// <summary>
    /// The reader inside a binder's page: the binder has the breadcrumb and Pop out, and stepping
    /// through a pack stays on the binder's page.
    /// </summary>
    [Parameter] public bool InBinder { get; set; }

    /// <summary>Where the reader is, as it opens a file and moves through it: the binder's page follows it.</summary>
    [Parameter] public EventCallback<ReaderPlace> PlaceChanged { get; set; }

    /// <summary>The open book's page notes, as they're read and changed.</summary>
    [Parameter] public EventCallback<ReaderNotes> NotesChanged { get; set; }

    /// <summary>Use this page pointed the binder's item somewhere else, so its list says so.</summary>
    [Parameter] public EventCallback ItemMoved { get; set; }

    ReaderBook? _book;
    ReaderProblem? _loadProblem;
    ReaderProblem? _problem;
    string? _problemAction;
    string? _opening;

    ElementReference _stage, _strip, _pageBox;
    IJSObjectReference? _module, _reader;
    DotNetObjectReference<ReaderView>? _self;
    bool _opened, _canCopy = true, _favorite, _showOutline, _showStrip;
    bool _stored, _kept;
    double _offlineProgress;
    int _page;
    string _pageEntry = "";
    bool _editingPage;
    string _scale = "page-width";
    int? _linkBack;
    string? _notice;
    CancellationTokenSource? _noticeTimer;
    Timer? _placeTimer;
    int? _placeToKeep;

    readonly BookFind _find = new();
    bool _wholeFile;

    ReaderNotes? _notes;
    bool _showNotes;

    AskBook? _ask;
    bool _showAsk;
    ActionResult? _noteDone;
    NoteDraft? _noteDialog;

    int _coverPage;
    ActionResult? _binderDone;
    PagesDraft? _pagesDialog;
    AdventureDraft? _partDialog;
    ReaderOutline? _outlineMenu;

    (bool Retry, TaskCompletionSource<string?> Answer)? _password;
    ReaderPasswords _passwords = default!;
    PrintedPageLinks _links = default!;

    string PositionText
    {
        get
        {
            if (_book is not { PageCount: > 0 } book || book.Kind == ReaderKinds.Image) return "";
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            var pdf = $"PDF page {(_page + 1).ToString("N0", culture)} of {book.PageCount.ToString("N0", culture)}";
            return _page < book.Labels.Count && book.Labels[_page] is { Length: > 0 } label && label.Trim() != (_page + 1).ToString(System.Globalization.CultureInfo.InvariantCulture)
                ? $"Printed p. {label.Trim()} · {pdf}"
                : pdf;
        }
    }

    protected override void OnInitialized()
    {
        _passwords = new ReaderPasswords(ReaderApi, Unlocked);
        _links = new PrintedPageLinks(ReaderApi);
    }

    protected override async Task OnParametersSetAsync()
    {
        var opening = $"{EntryId}|{Doc}|{Page}|{Q}|{Keep}|{Item}";
        if (opening == _opening) return;
        _opening = opening;
        await LoadAsync(Doc, Page, Item);
    }

    /// <summary>Opens the book at <paramref name="doc"/> and <paramref name="page"/>, or as the binder's <paramref name="item"/>.</summary>
    async Task LoadAsync(long? doc, int? page, long? item)
    {
        await CloseAsync();
        var wasImage = _book?.Kind == ReaderKinds.Image;
        _book = null;
        _loadProblem = null;
        _problem = null;
        try
        {
            _book = await ReaderApi.ReaderAsync(EntryId, doc, page, Q, Keep == true, item);
        }
        catch (ApiProblemException e) when (e.Status == System.Net.HttpStatusCode.NotFound)
        {
            _loadProblem = new ReaderProblem("This book isn't in your library any more.", "It may have been removed, or its file taken out of your library.");
            return;
        }
        catch (ApiProblemException e)
        {
            _loadProblem = new ReaderProblem("This book could not be opened.", e.Message);
            return;
        }
        catch (HttpRequestException)
        {
            _loadProblem = new ReaderProblem("This book could not be opened.", "Check your connection, then try again.");
            return;
        }
        if (!InBinder) Breadcrumb.Show(_book.Title);
        _favorite = _book.Favorite;
        _page = _book.StartPage;
        _pageEntry = ReaderPageNumbers.Display(_page, _book.Labels);
        // The next picture in a pack shows at the same zoom.
        if (!(_book.Kind == ReaderKinds.Image && wasImage)) _scale = _book.Kind == ReaderKinds.Image ? "page-fit" : "page-width";
        _linkBack = null;
        _opened = false;
        _canCopy = true;
        _passwords.Reset();
        _stored = _kept = false;
        _find.Clear();
        _notes = null;
        _noteDone = null;
        _noteDialog = null;
        _coverPage = _book.CoverPage;
        _binderDone = null;
        _pagesDialog = null;
        _partDialog = null;
        _outlineMenu = null;
        if (_book.Notice is { } notice) ShowNotice(notice);
        if (HasPages) _ = LoadNotesAsync(_book);
        _ask = null;
        if (HasPages) _ = LoadAskAsync(_book);
        ReportPlace();
    }

    /// <summary>Where the reader is in a binder's page: the file and page in view, and whether that's off the item's pages.</summary>
    public sealed record ReaderPlace(long DocumentId, int Page, string Kind, bool OutsideItem, ReaderItem? Item);

    void ReportPlace()
    {
        if (!PlaceChanged.HasDelegate || _book is not { } book) return;
        // A pack stepped to another file has left the item behind.
        var outside = book.Item is { WholeBook: false } item ? IsPdf && (_page < item.FirstPage || _page > item.LastPage) : Item is not null && book.Item is null;
        _ = PlaceChanged.InvokeAsync(new ReaderPlace(book.DocumentId, _page, book.Kind, outside, book.Item));
    }

    /// <summary>Back to this item's pages: its first page again, or the item reopened after stepping to another file of its pack.</summary>
    public async Task BackToItemAsync()
    {
        if (_book?.Item is { } item) await GoToAsync(item.FirstPage);
        else
        {
            await LoadAsync(Doc, Page, Item);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Use this page, on the banner over a binder item's pages that changed: the item opens at the page in view from
    /// now on, keeping how many pages it spans.
    /// </summary>
    async Task UseThisPageAsync()
    {
        if (_book is not { Item: { } item } book) return;
        try
        {
            var used = await BindersApi.UseBinderPageAsync(item.Id, new ReaderUsePage(book.DocumentId, _page));
            if (_book != book) return;
            _book = book with { Item = item with { FirstPage = used.FirstPage, LastPage = used.LastPage, Banner = null, CanUsePage = false } };
            _binderDone = new ActionResult(used.Message);
            ReportPlace();
            await MarkItemPagesAsync();
            await ItemMoved.InvokeAsync();
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            _binderDone = new ActionResult("That didn't work. Try again in a moment.");
        }
    }

    void DismissBanner()
    {
        if (_book is { Item: { } item } book) _book = book with { Item = item with { Banner = null, CanUsePage = false } };
    }

    /// <summary>The thumbnails mark the binder item's pages; none for a whole book.</summary>
    Task MarkItemPagesAsync() =>
        !IsPdf ? Task.CompletedTask
        : _book?.Item is { WholeBook: false } item ? CallAsync("itemPages", item.FirstPage, item.LastPage)
        : CallAsync("itemPages", null, null);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) Pins.Changed += OnPinsChanged;
        if (_starting) return;
        _starting = true;
        try
        {
            // Another file can be asked for while one is starting, as stepping through a pack quickly: it starts next.
            while (_book is { Problem: null } book && _problem is null && _reader is null && !_closing)
            {
                await StartAsync(book);
                if (_book == book) break;
            }
        }
        finally
        {
            _starting = false;
        }
