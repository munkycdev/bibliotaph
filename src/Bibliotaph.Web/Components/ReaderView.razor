    /// <summary>The page with selected text on it, or else the page in view.</summary>
    async Task<int> SelectedPageAsync(ReaderBook book)
    {
        var selected = -1;
        if (_reader is { } reader)
        {
            try
            {
                selected = await reader.InvokeAsync<int>("selectionPage");
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException)
            {
