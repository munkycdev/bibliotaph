    async Task SavePartAsync()
    {
        if (_book is not { } book || _partDialog is not { Saving: false } dialog || dialog.Title.Trim().Length == 0 || PageRange(dialog.From, dialog.To) is null) return;
        dialog.Saving = true;
        dialog.Problem = null;
        try
        {
            var added = await Api.MarkAdventureAsync(book.DocumentId, new PartEdit(dialog.Title, dialog.From, dialog.To));
            if (added.Problem is { } problem)
            {
                dialog.Problem = problem;
                return;
            }
            if (_partDialog == dialog) _partDialog = null;
            if (added.Message is { } message) ShowNotice(message);
