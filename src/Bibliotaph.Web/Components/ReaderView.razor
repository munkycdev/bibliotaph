    /// <summary>
    /// Opens a page the Ask panel found with its words marked by Find: the first match on that page, else the next one
    /// after it. Without them, or when Find can't see them, the page alone.
    /// </summary>
    async Task ShowPhraseAsync((int Page, string? Phrase) at)
    {
        if (_book is not { } book) return;
        var page = Math.Clamp(at.Page, 0, Math.Max(0, book.PageCount - 1));
        if (at.Phrase is not { Length: > 0 } phrase)
        {
            await GoToAsync(page);
            return;
        }
        ReaderFind found;
        try
        {
            found = await Api.FindInBookAsync(book.DocumentId, phrase, null, null);
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            await GoToAsync(page);
            return;
        }
        var hits = found.Pages.SelectMany(p => Enumerable.Range(0, p.Count).Select(n => (p.Page, n))).ToList();
        var next = hits.FindIndex(h => h.Page >= page);
        if (next < 0)
        {
            await GoToAsync(page);
            return;
        }
        _findText = _found = phrase;
        _hits = hits;
        await ShowMatchAsync(next);
    }

