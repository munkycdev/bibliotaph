    /// <summary>The pack's file <paramref name="by"/> places on, at its first page, in the same window.</summary>
    [JSInvokable]
    public void Step(int by) => StepPack(by);

    void StepPack(int by)
    {
        if (_book is not { Pack.Count: > 0 } book) return;
        var next = PackIndex + by;
        if (next < 0 || next >= book.Pack.Count) return;
        // In a binder the pack's next file opens in its place, without the item.
        if (InBinder)
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync(book.Pack[next].DocumentId, null, null);
                StateHasChanged();
            });
            return;
        }
        Navigation.NavigateTo(ReaderUrl.For(book.EntryId, book.Pack[next].DocumentId, popout: Popout == true), replace: true);
    }

