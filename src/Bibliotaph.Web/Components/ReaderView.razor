    /// <summary>
    /// Add pages…: From and To start at the page with selected text on it, or the page in view, the label at the
    /// bookmark there; before there is a binder, it asks for one first. A picture is added whole, as Add page does.
    /// </summary>
    async Task AddPagesAsync()
    {
        _addMenu = null;
        if (_book is not { } book) return;
        if (book.Kind == ReaderKinds.Image)
        {
            await AddPageAsync(null, null);
            return;
        }
        try
        {
            var menu = await Api.BinderMenuAsync();
            if (menu.All.Count == 0)
            {
                if (await BinderActions.CreateAsync(menu.Systems, menu.NewHeading, "Create") is null) return;
                menu = await Api.BinderMenuAsync();
                if (menu.All.Count == 0) return;
            }
            var page = await SelectedPageAsync(book);
            var shown = ReaderPageNumbers.Display(page, book.Labels);
            var label = (await Api.BookmarkAsync(book.DocumentId, page)).Title ?? "";
            if (_book != book) return;
            var dialog = new PagesDialog { From = shown, To = shown, Label = label, Binders = menu.All, BinderId = menu.All[0].Id };
            _pagesDialog = dialog;
            _focusPages = true;
            await LoadSectionsAsync(dialog);
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            _binderDone = new ActionResult(e.Message);
        }
    }

