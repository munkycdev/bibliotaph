        return Math.Clamp(selected >= 0 ? selected : _page, 0, Math.Max(0, book.PageCount - 1));
    }

    (int First, int Last)? NoteRange(NoteDialog dialog) => PageRange(dialog.From, dialog.To);

    /// <summary>From and To as typed, To left blank for one page; null when either isn't a page of the book.</summary>
    (int First, int Last)? PageRange(string from, string to)
    {
        if (_book is not { } book || ReaderPageNumbers.Find(from, book.Labels, book.PageCount) is not { } first) return null;
        var last = to.Trim().Length == 0 ? first : ReaderPageNumbers.Find(to, book.Labels, book.PageCount);
        return last is { } l ? (Math.Min(first, l), Math.Max(first, l)) : null;
    }

    bool CanSaveNote(NoteDialog dialog) => dialog.Text.Trim().Length > 0 && NoteRange(dialog) is not null;

    async Task SaveNoteAsync()
    {
        if (_book is not { } book || _noteDialog is not { } dialog || !CanSaveNote(dialog) || NoteRange(dialog) is not { } range) return;
        _noteDialog = null;
        var edit = new PageNoteEdit(range.First, range.Last, dialog.Text.Trim());
        try
        {
            var changed = dialog.Editing is { } note
                ? await Api.UpdatePageNoteAsync(book.DocumentId, note.Id, edit)
                : await Api.AddPageNoteAsync(book.DocumentId, edit);
            if (_book != book) return;
            SetNotes(changed.Notes);
            if (changed.Done.Message.Length > 0) _noteDone = changed.Done;
            if (dialog.Editing is null) (_showNotes, _showAsk) = (true, false);
            await MarkNotesAsync();
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            _noteDone = new ActionResult("The note couldn't be saved. Try again in a moment.");
            (_showNotes, _showAsk) = (true, false);
        }
    }

