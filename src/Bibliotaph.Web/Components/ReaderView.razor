    async Task CloseReaderAsync()
    {
        if (_placeToKeep is not null) await SavePlaceAsync();
        if (_password is { } asking)
        {
            _password = null;
            asking.Answer.TrySetResult(null);
        }
        if (_reader is { } reader)
        {
            _reader = null;
            await DisposeReaderAsync(reader);
        }
        _ebook?.Dispose();
        _ebook = null;
    }

    void OnPinsChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Pins.Changed -= OnPinsChanged;
        if (!InBinder) Breadcrumb.Show(null);
        _noticeTimer?.Cancel();
        if (_placeTimer is not null) await _placeTimer.DisposeAsync();
        await CloseAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going anyway.
            }
        }
        _self?.Dispose();
    }
