    // Find: Enter finds, Enter again (or F3) goes to the next match, round from the last to the
    // first; Shift+Enter and Shift+F3 go back; Esc clears. Reading an adventure, it looks in the adventure's pages.

    async Task FindKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FindAsync(!e.ShiftKey);
        else if (e.Key == "Escape") await ClearFindAsync();
    }

    async Task FindAsync(bool forward)
    {
        var text = _findText.Trim();
        if (text.Length == 0 || _book is null)
        {
            await ClearFindAsync();
            return;
        }
        if (text == _found && _hits.Count > 0)
        {
            await StepAsync(forward);
            return;
        }
        _findStatus = "Searching…";
        StateHasChanged();
        var part = _wholeFile ? null : _book.Part;
        ReaderFind found;
        try
        {
            found = await Api.FindInBookAsync(_book.DocumentId, text, part?.FirstPage, part?.LastPage);
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            _findStatus = "Find didn't finish";
            return;
        }
        _found = text;
        _hits = [.. found.Pages.SelectMany(p => Enumerable.Range(0, p.Count).Select(n => (p.Page, n)))];
        if (_hits.Count == 0)
        {
            _hitIndex = -1;
            _findStatus = part is null ? "No matches" : "No matches in this adventure";
            await CallAsync("clearFind");
            return;
        }
        // The first match from the page in view onwards, wrapping round to the start.
        var next = _hits.FindIndex(h => h.Page >= _page);
        await ShowMatchAsync(next < 0 ? 0 : next);
    }

    async Task StepAsync(bool forward)
    {
        if (_hits.Count == 0)
        {
            if (_findText.Trim().Length > 0) await FindAsync(forward);
            return;
        }
        await ShowMatchAsync(forward ? (_hitIndex + 1) % _hits.Count : (_hitIndex - 1 + _hits.Count) % _hits.Count);
    }

    async Task ShowMatchAsync(int index)
    {
        _hitIndex = index;
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        _findStatus = $"{(index + 1).ToString("N0", culture)} of {_hits.Count.ToString("N0", culture)}{(_hits.Count >= MaxMatches ? "+" : "")}";
        var (page, nth) = _hits[index];
        await CallAsync("showMatch", _found, page, nth);
        StateHasChanged();
    }

    async Task ClearFindAsync()
    {
        _findText = "";
        ClearFindState();
        await CallAsync("clearFind");
    }

    void ClearFindState()
    {
        _found = "";
        _findStatus = "";
        _hits = [];
        _hitIndex = -1;
    }

    async Task WholeFileChangedAsync(ChangeEventArgs e)
    {
        _wholeFile = e.Value is true;
        _found = "";
        _hits = [];
        if (_findText.Trim().Length > 0) await FindAsync(true);
    }

