    /// <summary>
    /// Add to binder: the page in view, or the whole picture, to the binder the menu names, or one picked or made from
    /// it; with no menu (a picture's Add pages…), to the binder worked on last, or a new one before there is any.
    /// </summary>
    async Task AddPageAsync(BinderMenu? menu, BinderMenuChoice? choice)
    {
        _addMenu = null;
        if (_book is not { } book) return;
        var picture = book.Kind == ReaderKinds.Image;
        var name = picture && PackIndex is >= 0 and var at ? book.Pack[at].Name : book.Title;
        var what = picture ? name : $"page {ReaderPageNumbers.Display(_page, book.Labels)}";
        var add = picture ? new BinderAdd([], name, book.DocumentId, WholeFile: true) : new BinderAdd([], DocumentId: book.DocumentId, Page: _page);
        try
        {
            var result = menu is not null && choice is not null
                ? await BinderActions.AddAsync(menu, choice, what, add)
                : await BinderActions.AddToCurrentAsync(what, add);
            if (result is not null) _binderDone = result;
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            _binderDone = new ActionResult(e.Message);
        }
