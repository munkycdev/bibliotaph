    Services.OpenEbook? _ebook;

    /// <summary>
    /// Cuts the e-book's bytes into the pages indexing cut it into and builds its reader page; null, with the reason
    /// shown, when it can't be read here.
    /// </summary>
    [JSInvokable]
    public async Task<EbookBuilt?> OpenEbook(byte[] bytes, string resources)
    {
        // Lets "Opening…" show before the book is cut, which takes a moment for a long one.
        await Task.Yield();
        Services.OpenEbook book;
        try
        {
            book = Services.OpenEbook.Open(bytes, resources);
        }
        catch (Exception e) when (e is Bibliotaph.Ebooks.EbookException or InvalidDataException or IOException)
        {
            ShowProblem(new ReaderProblem("This e-book could not be opened.", e.Message), "Try again");
            return null;
        }
        if (book.IsProtected || book.PageCount == 0)
        {
            var isProtected = book.IsProtected;
            book.Dispose();
            ShowProblem(isProtected
                ? new ReaderProblem("This e-book is protected.", "It has DRM, which Bibliotaph can't open. Its pages can't be searched or read here; open it in the app it came with.")
                : new ReaderProblem("This e-book has no pages.", "There's nothing in it to read. Open it in your e-book app to see what it holds."), null);
            return null;
        }
        _ebook?.Dispose();
        _ebook = book;
        StateHasChanged();
        return new EbookBuilt(book.Page, book.Nonce, book.FixedLayout);
    }

