    ReaderProblem? _linkProblem;

    const string SomethingWentWrong = "Something went wrong while opening it. Try again, and if it keeps happening, let us know from Contact us.";

    [JSInvokable]
    public async Task Failed(string kind, string message)
    {
        if (kind == "read" && _opened)
        {
            // Pages already showing stay; only the rest can't be read just now.
            ShowNotice("Bibliotaph couldn't read more of this file just now. Check your connection, then try again.");
            StateHasChanged();
            return;
        }
        (_problem, _problemAction) = kind switch
        {
            "password" => (new ReaderProblem("This PDF needs a password.", "Enter its password to read it."), "Enter password"),
            "link" => (_linkProblem ?? new ReaderProblem("The file couldn't be reached.", "Check your connection, then try again."), "Try again"),
            "invalid" => (new ReaderProblem("This book could not be opened.", "The file isn't a PDF Bibliotaph can read. It may be damaged."), "Try again"),
            "image" => (new ReaderProblem("This image could not be read.", "The file may be damaged, or still uploading."), "Try again"),
            _ => (new ReaderProblem("This book could not be opened.", SomethingWentWrong), "Try again"),
        };
        // What went wrong is for a bug report, not the page: it goes to the browser's console.
        if (kind is not ("password" or "link" or "image") && message.Length > 0) Console.Error.WriteLine($"The reader couldn't open the book ({kind}): {message}");
        await CloseAsync();
        StateHasChanged();
    }

    /// <summary>
    /// The password for pdf.js to try: one that opened it in this tab, or
    /// else a remembered one, first; then the reader is asked, again while what they type doesn't open it.
    /// </summary>
    [JSInvokable]
    public async Task<string?> AskPassword(bool retry)
    {
        if (_book is not { } book) return null;
        if (_tryingKnown is { } failed)
        {
            // The book changed its password, or a different file now has this content.
            _tryingKnown = null;
            Unlocked.Forget(book.ContentHash);
            if (failed.Remembered) _ = ForgetRememberedAsync(book.DocumentId);
            retry = false;
        }
        else if (!_knownTried)
        {
            _knownTried = true;
            var known = Unlocked.Find(book.ContentHash);
            var remembered = known is null ? await RememberedAsync(book.DocumentId) : null;
            if ((known ?? remembered) is { } password)
            {
                _tryingKnown = (password, known is null);
                return password;
            }
        }
        // A wrong password keeps the ticks; a new ask starts.
        if (!retry) (_searchable, _rememberPassword) = (true, false);
        var answer = new TaskCompletionSource<string?>();
        _password = (retry, answer);
        _passwordText = "";
        _focusPassword = true;
        StateHasChanged();
        var typed = await answer.Task;
        _entered = typed is null ? null : new ReaderPasswordUse(typed, _rememberPassword, _searchable || _rememberPassword);
        return typed;
    }

