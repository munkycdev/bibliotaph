    protected override async Task OnParametersSetAsync()
    {
        var opening = $"{EntryId}|{Doc}|{Page}|{Q}|{Keep}|{Item}";
        if (opening == _opening) return;
        _opening = opening;
        await LoadAsync(Doc, Page, Item);
    }

    /// <summary>Opens the book at <paramref name="doc"/> and <paramref name="page"/>, or as the binder's <paramref name="item"/>.</summary>
    async Task LoadAsync(long? doc, int? page, long? item)
    {
        await CloseAsync();
        var wasImage = _book?.Kind == ReaderKinds.Image;
        _book = null;
        _loadProblem = null;
        _problem = null;
        try
        {
            _book = await Api.ReaderAsync(EntryId, doc, page, Q, Keep == true, item);
        }
        catch (ApiProblemException e) when (e.Status == System.Net.HttpStatusCode.NotFound)
        {
            _loadProblem = new ReaderProblem("This book isn't in your library any more.", "It may have been removed, or its file taken out of your library.");
            return;
        }
        catch (ApiProblemException e)
        {
            _loadProblem = new ReaderProblem("This book could not be opened.", e.Message);
            return;
        }
        catch (HttpRequestException)
        {
            _loadProblem = new ReaderProblem("This book could not be opened.", "Check your connection, then try again.");
            return;
        }
        if (!InBinder) Breadcrumb.Show(_book.Title);
        _favorite = _book.Favorite;
        _page = _book.StartPage;
        _pageEntry = ReaderPageNumbers.Display(_page, _book.Labels);
        // The next picture in a pack shows at the same zoom.
        if (!(_book.Kind == ReaderKinds.Image && wasImage)) _scale = _book.Kind == ReaderKinds.Image ? "page-fit" : "page-width";
        _linkBack = null;
        _opened = false;
        _canCopy = true;
        _knownTried = false;
        _tryingKnown = null;
        _entered = null;
        _stored = _kept = false;
        ClearFindState();
        _notes = null;
        _noteDone = null;
        _noteDialog = null;
        _coverPage = _book.CoverPage;
        _addMenu = null;
        _binderDone = null;
        _pagesDialog = null;
        _partDialog = null;
        _outlineMenu = null;
        if (_book.Notice is { } notice) ShowNotice(notice);
        if (HasPages) _ = LoadNotesAsync(_book);
        _ask = null;
        if (HasPages) _ = LoadAskAsync(_book);
        ReportPlace();
    }

    /// <summary>Where the reader is in a binder's page: the file and page in view, and whether that's off the item's pages.</summary>
    public sealed record ReaderPlace(long DocumentId, int Page, string Kind, bool OutsideItem, ReaderItem? Item);

    void ReportPlace()
    {
        if (!PlaceChanged.HasDelegate || _book is not { } book) return;
        // A pack stepped to another file has left the item behind.
        var outside = book.Item is { WholeBook: false } item ? IsPdf && (_page < item.FirstPage || _page > item.LastPage) : Item is not null && book.Item is null;
        _ = PlaceChanged.InvokeAsync(new ReaderPlace(book.DocumentId, _page, book.Kind, outside, book.Item));
    }

    /// <summary>Back to this item's pages: its first page again, or the item reopened after stepping to another file of its pack.</summary>
    public async Task BackToItemAsync()
    {
        if (_book?.Item is { } item) await GoToAsync(item.FirstPage);
        else
        {
            await LoadAsync(Doc, Page, Item);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Use this page, on the banner over a binder item's pages that changed: the item opens at the page in view from
    /// now on, keeping how many pages it spans.
    /// </summary>
    async Task UseThisPageAsync()
    {
        if (_book is not { Item: { } item } book) return;
        try
        {
            var used = await Api.UseBinderPageAsync(item.Id, new ReaderUsePage(book.DocumentId, _page));
            if (_book != book) return;
            _book = book with { Item = item with { FirstPage = used.FirstPage, LastPage = used.LastPage, Banner = null, CanUsePage = false } };
            _binderDone = new ActionResult(used.Message);
            ReportPlace();
            await MarkItemPagesAsync();
            await ItemMoved.InvokeAsync();
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            _binderDone = new ActionResult("That didn't work. Try again in a moment.");
        }
    }

    void DismissBanner()
