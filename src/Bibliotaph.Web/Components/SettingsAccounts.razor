@* Settings › Members, for admins: everyone who has joined, and deleting an account, which is the same as its owner
   closing it. *@
@inject AccountClient AccountApi

<section class="bt-section bt-subsection" aria-labelledby="accounts-heading">
    <h3 class="bt-subheading" id="accounts-heading">Accounts</h3>
    <p class="bt-copy">Everyone who has joined. Deleting an account is the same as its owner closing it: their library and
        everything they've done in it go, and nothing in their storage is touched.</p>
    @if (_note is { } note)
    {
        <div class="bt-message" role="status">@note</div>
    }
    @if (_accounts is { Count: > 0 })
    {
        <table class="bt-table">
            <thead><tr><th>NAME</th><th>EMAIL</th><th>JOINED</th><th>LAST SIGNED IN</th><th></th></tr></thead>
            <tbody>
                @foreach (var account in _accounts)
                {
                    <tr>
                        <td>@account.Name@(account.IsAdmin ? " (can invite)" : "")@(account.IsYou ? " · you" : "")</td>
                        <td>@(account.Email ?? "—")</td>
                        <td>@account.Created.ToString("d MMM yyyy")</td>
                        <td>@account.LastSignIn.ToString("d MMM yyyy")</td>
                        <td>
                            @if (!account.IsYou)
                            {
                                <button class="bt-icon" title="Delete this account" aria-label="Delete @(account.Name)'s account"
                                        @onclick="() => { _deleting = account; _note = null; }"><Icon Name="Trash2" Size="14" /></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (_deleting is { } deleting)
    {
        <div class="bt-source bt-pending" role="alertdialog" aria-labelledby="delete-heading" aria-describedby="delete-detail">
            <div class="bt-sourcerow">
                <Icon Name="Trash2" />
                <div id="delete-heading">Delete @(deleting.Name)'s account?<small id="delete-detail">Bibliotaph deletes the account, its
                    library and everything done in it, and its storage connections, straight away, and from backups within 30 days.
                    They're signed out everywhere. Nothing in their storage is touched. This can't be undone.</small></div>
            </div>
            <div class="bt-actions">
                <button class="bt-button primary" disabled="@_deletingNow" @onclick="DeleteAccount"><Icon Name="Trash2" />Delete account</button>
                <button class="bt-button" disabled="@_deletingNow" @onclick="() => _deleting = null">Cancel</button>
            </div>
        </div>
    }
</section>

@code {
    IReadOnlyList<AccountInfo>? _accounts;
    AccountInfo? _deleting;
    bool _deletingNow;
    string? _note;

    protected override async Task OnInitializedAsync() => _accounts = await AccountApi.AccountsAsync();

    async Task DeleteAccount()
    {
        if (_deleting is not { } account) return;
        _deletingNow = true;
        try
        {
            _note = (await AccountApi.DeleteAccountAsync(account.Id)).Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException)
        {
            _note = ex is ApiProblemException problem ? problem.Message : $"{account.Name}'s account couldn't be deleted just now. Try again in a moment.";
        }
        _deleting = null;
        _deletingNow = false;
        _accounts = await AccountApi.AccountsAsync();
    }
}
