@* Settings › Passwords: the books whose PDF password was remembered, never the passwords, each
   with Forget, and Forget all, asked first. Forgetting one forgets it in this tab too, so the next open asks again. *@
@inject ReaderClient ReaderApi
@inject UnlockedBooks Unlocked

<section class="bt-section" aria-labelledby="passwords-heading">
    <h2 id="passwords-heading">Passwords</h2>
    <p class="bt-copy">PDF passwords you chose to remember, kept in your web library encrypted with the server's own keys and never shown.
        Bibliotaph opens these books with them, and reads them for search. Forget one and you'll be asked for it the next time you open
        the book; text already read stays searchable.</p>
    @if (_rows is null)
    {
        <div class="bt-loading">Looking for remembered passwords…</div>
    }
    else if (_rows.Count == 0)
    {
        <p class="bt-fine">No passwords are remembered.</p>
    }
    else
    {
        @foreach (var row in _rows)
        {
            <div class="bt-settingrow">
                <div class="bt-passwordbook">@row.Title</div>
                <button class="bt-button" aria-label="@($"Forget the password for {row.Title}")" @onclick="() => ForgetAsync(row)">Forget</button>
            </div>
        }
        @if (_confirming)
        {
            <div class="bt-source bt-pending" role="alertdialog" aria-label="Forget all passwords?">
                <div class="bt-sourcerow">
                    <Icon Name="Lock" />
                    <div>Forget all passwords?<small>Bibliotaph will forget @(_rows.Count == 1 ? "the remembered password" : $"all {_rows.Count:N0} remembered passwords")
                        and ask again the next time you open @(_rows.Count == 1 ? "the book" : "each book"). Your files are not touched.</small></div>
                </div>
                <div class="bt-actions">
                    <button class="bt-button primary" @onclick="ForgetAllAsync">Forget all</button>
                    <button class="bt-button" @onclick="() => _confirming = false">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="bt-actions">
                <button class="bt-button" aria-label="Forget all passwords" @onclick="() => _confirming = true">Forget all</button>
            </div>
        }
    }
    @if (_problem is not null)
    {
        <div class="bt-message" role="alert">@_problem</div>
    }
</section>

@code {
    List<RememberedPassword>? _rows;
    bool _confirming;
    string? _problem;

    protected override async Task OnInitializedAsync() => await RunAsync(() => ReaderApi.RememberedPasswordsAsync());

    Task ForgetAsync(RememberedPassword row)
    {
        Unlocked.Forget(row.ContentHash);
        return RunAsync(() => ReaderApi.ForgetRememberedPasswordAsync(row.ContentHash));
    }

    async Task ForgetAllAsync()
    {
        _confirming = false;
        foreach (var row in _rows ?? []) Unlocked.Forget(row.ContentHash);
        await RunAsync(() => ReaderApi.ForgetAllPasswordsAsync());
    }

    async Task RunAsync(Func<Task<List<RememberedPassword>>> call)
    {
        _problem = null;
        try
        {
            _rows = await call();
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException)
        {
            _rows ??= [];
            _problem = "That couldn't be done just now. Try again in a moment.";
        }
    }
}
