@* The Windows app's main window: the sidebar (.bt-sidebar) with its navigation, and the work area with its top bar. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject Theme Theme
@inject NavigationManager Navigation
@inject LibraryActivity Activity
@inject Pins Pins
@inject Breadcrumb Breadcrumb
@inject IJSRuntime JS

@if (_loading)
{
    <div class="bt-loading">Opening Bibliotaph…</div>
}
else if (_me is null)
{
    <SignInCard Problem="@SignInProblem" />
}
else if (PoppedOut)
{
    @* A reader popped out into a window of its own has no shell around it, as on Windows. *@
    <div class="bt-shell popout"><main id="bt-main">@Body</main></div>
    <CollectionDialog />
    <BinderDialog />
}
else
{
    <div class="bt-shell">
        <aside class="bt-sidebar">
            <a class="bt-brand" href="" aria-label="Bibliotaph home"><span class="bt-monogram">b.</span><span>Bibliotaph</span></a>
            <nav class="bt-navigation" aria-label="Main navigation">
                @foreach (var item in Items)
                {
                    var active = item.Href == ActiveHref;
                    <a class="bt-nav @(active ? "active" : "")" href="@item.Href" aria-current="@(active ? "page" : null)"><Icon Name="@item.Icon" />@item.Label@if (CountOf(item.Href) is { } count)
                    {
                        <span class="bt-count" aria-label="@($"{count} to review")">@count</span>
                    }</a>
                }
            </nav>
            @* Books, Favorites, collections, binders and saved searches, in order. A pin is dragged to a new place, or moved
               with Alt+Up and Alt+Down or its right-click menu, which also unpins it, and renames or deletes a saved search. *@
            <div class="bt-sidegroup bt-pins">
                <span class="bt-eyebrow">PINNED</span>
                @if (Pins.Items.Count == 0)
                {
                    <p class="bt-sample bt-nav-hint">@Pins.Hint</p>
                }
                <div role="list" aria-label="Pinned">
                    @for (var i = 0; i < Pins.Items.Count; i++)
                    {
                        var pin = Pins.Items[i];
                        var at = i;
                        var active = IsShown(pin);
                        <div class="bt-pinrow @(_dropAt == at && _dragging is not null ? "drop" : "")" role="listitem" @key="(pin.Kind, pin.Id)"
                             @ondragover="() => _dropAt = at" @ondragover:preventDefault="true" @ondrop="() => DropAsync(at)">
                            <a class="bt-nav @(active ? "active" : "") @(pin.Dimmed ? "dimmed" : "")" href="@pin.Href" title="@pin.Tip" aria-current="@(active ? "page" : null)"
                               draggable="true" @ondragstart="() => _dragging = pin" @ondragend="EndDrag"
                               @oncontextmenu="() => _pinMenu = pin" @oncontextmenu:preventDefault="true" @onkeydown="e => PinKeyAsync(pin, at, e)">
                                <Icon Name="@pin.Icon" /><span class="bt-navlabel">@pin.Label</span>
                            </a>
                            @if (_pinMenu == pin)
                            {
                                <div class="bt-backdrop fixed bt-menuback" @onclick="() => _pinMenu = null" @oncontextmenu="() => _pinMenu = null" @oncontextmenu:preventDefault="true"></div>
                                <div class="bt-menu bt-pinmenu" role="menu" aria-label="@pin.Label">
                                    <button class="bt-menuitem" role="menuitem" disabled="@(at == 0)" @onclick="() => MoveAsync(pin, at - 1)">Move up<span class="bt-gesture">Alt+Up</span></button>
                                    <button class="bt-menuitem" role="menuitem" disabled="@(at == Pins.Items.Count - 1)" @onclick="() => MoveAsync(pin, at + 1)">Move down<span class="bt-gesture">Alt+Down</span></button>
                                    <button class="bt-menuitem" role="menuitem" @onclick="() => UnpinAsync(pin)">Unpin</button>
                                    @if (pin.Kind == PinKinds.Search)
                                    {
                                        <button class="bt-menuitem" role="menuitem" @onclick='() => ActOnSearch(pin, "rename")'>Rename…</button>
                                        <button class="bt-menuitem" role="menuitem" @onclick='() => ActOnSearch(pin, "delete")'>Delete</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_dragging is not null)
                    {
                        <div class="bt-pinrow bt-pinend @(_dropAt == Pins.Items.Count ? "drop" : "")" @ondragover="() => _dropAt = Pins.Items.Count"
                             @ondragover:preventDefault="true" @ondrop="() => DropAsync(Pins.Items.Count)"></div>
                    }
                </div>
            </div>
            <div class="bt-sidebottom">
                <NavLink class="bt-nav" href="settings"><Icon Name="Settings2" />Settings</NavLink>
                @* As in the Windows app: one or two lines of what the library is doing, the whole text on hover. *@
                <div class="bt-sync" role="status" title="@Activity.Current?.Text"><span class="bt-status-dot @(Activity.Current?.Busy == true ? "busy" : "")"></span><span>@(Activity.Current?.Text ?? "Opening your library")</span></div>
            </div>
        </aside>
        <div class="bt-workarea">
            <header class="bt-topbar">
                @if (Breadcrumb.Title is { } title)
                {
                    @* A book in the reader: back to where it was opened from, and the section it belongs to before its title. *@
                    <button class="bt-icon bt-back" title="Back" aria-label="Back" @onclick="() => BrowserWindow.BackAsync(JS)"><Icon Name="ArrowLeft" Size="15" /></button>
                    <div class="bt-breadcrumb" title="@title"><a href="library" aria-label="Go to Library">Library</a><span class="bt-crumbsep">/</span>@title</div>
                }
                else
                {
                    <div class="bt-breadcrumb">@Section</div>
                }
                <label class="bt-search">
                    <Icon Name="Search" Size="15" />
                    <span class="visually-hidden">Search</span>
                    <input type="search" placeholder="Search books, topics, passages…" value="@_searchText" @oninput="OnSearchInput" @onkeydown="OnSearchKey" />
                </label>
                <button class="bt-icon" title="@Theme.Label(_theme)" aria-label="@Theme.Label(_theme)" @onclick="CycleTheme"><Icon Name="SunMoon" /></button>
            </header>
            <main id="bt-main">@Body</main>
        </div>
    </div>
    <CollectionDialog />
    <BinderDialog />
}

@code {
    static readonly (string Href, string Label, string Icon)[] Items =
    [
        ("", "Home", "House"),
        ("library", "Library", "LibraryBig"),
        ("collections", "Collections", "Folders"),
        ("binders", "Binders", "NotebookTabs"),
        ("review", "Needs review", "Inbox"),
    ];

    /// <summary>What Needs review holds, beside its name as on Windows; nothing when it's empty.</summary>
    string? CountOf(string href) =>
        href == "review" && Activity.Current is { Review: > 0 } status ? status.Review.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : null;

    static readonly TimeSpan SearchPause = TimeSpan.FromMilliseconds(300);

    bool _loading = true;
    CurrentUser? _me;
    string _theme = "system";

    /// <summary>Why the last sign-in didn't work, from the server's redirect (?problem=).</summary>
    string? SignInProblem =>
        new Uri(Navigation.Uri).Query.Contains("problem=failed", StringComparison.Ordinal)
            ? "Signing in didn't finish. Try again, or choose another way to sign in."
            : null;

    bool PoppedOut =>
        Navigation.ToBaseRelativePath(Navigation.Uri) is var path && (path.StartsWith("read/", StringComparison.Ordinal) || path.StartsWith("binders/", StringComparison.Ordinal))
        && path.Contains("popout=true", StringComparison.Ordinal);

    string Section =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("settings", StringComparison.Ordinal) ? "Settings"
            : Items.FirstOrDefault(i => i.Href == ActiveHref).Label ?? "Home";

    /// <summary>The section the page is in. A collection shows in the Library, but belongs to Collections, as on Windows.</summary>
    string? ActiveHref
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            if (path.Length == 0) return "";
            if (path.StartsWith("library", StringComparison.Ordinal) && LibraryUrl.Parse(Navigation.Uri).Collection is not null) return "collections";
            return Items.FirstOrDefault(i => i.Href != "" && path.StartsWith(i.Href, StringComparison.Ordinal)).Href;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        if (OnLibrary) _searchText = LibraryUrl.Parse(Navigation.Uri).Q ?? "";
        _me = await Session.MeAsync();
        if (_me is not null)
        {
            Activity.Changed += OnActivityChanged;
            Activity.Start();
            Pins.Changed += OnPinsChanged;
            Breadcrumb.Changed += OnPinsChanged;
            await Pins.LoadAsync();
        }
        _theme = await Theme.CurrentAsync();
        _loading = false;
    }

    async Task CycleTheme() => _theme = await Theme.CycleAsync();

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Keeps the box in step when the Library clears the search, or Back goes to another.
        if (OnLibrary && _searchDelay is null) _searchText = LibraryUrl.Parse(e.Location).Q ?? "";
        StateHasChanged();
    }

    bool OnLibrary => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("library", StringComparison.Ordinal);

    string _searchText = "";
    CancellationTokenSource? _searchDelay;

    /// <summary>As in the Windows app, a pause in typing searches; Enter searches at once and Esc clears the box.</summary>
    async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value as string ?? "";
        _searchDelay?.Cancel();
        var delay = _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchPause, delay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        SubmitSearch();
    }

    void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SubmitSearch();
        else if (e.Key == "Escape")
        {
            _searchText = "";
            SubmitSearch();
        }
    }

    /// <summary>Shows the search in the Library, keeping its filters when it's already there.</summary>
    void SubmitSearch()
    {
        _searchDelay?.Cancel();
        _searchDelay = null;
        var text = _searchText.Trim();
        if (!OnLibrary && text.Length == 0) return;
        var current = OnLibrary ? LibraryUrl.Parse(Navigation.Uri) : new LibraryQuery();
        if ((current.Q ?? "") == text) return;
        var next = text.Length == 0 ? current with { Q = null, Tab = null } : current with { Q = text };
        Navigation.NavigateTo("library" + LibraryUrl.QueryString(next, forApi: false), replace: OnLibrary);
    }

    void OnActivityChanged() => InvokeAsync(StateHasChanged);

    void OnPinsChanged() => InvokeAsync(StateHasChanged);

    PinItem? _pinMenu;
    PinItem? _dragging;
    int? _dropAt;

    /// <summary>The pin whose page is shown: the same address, as the Windows app marks the pin of the page open.</summary>
    bool IsShown(PinItem pin)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return path == pin.Href || (path.StartsWith(pin.Href + "&", StringComparison.Ordinal) && pin.Kind == PinKinds.Search);
    }

    async Task MoveAsync(PinItem pin, int index)
    {
        _pinMenu = null;
        if (index < 0 || index >= Pins.Items.Count) return;
        await Pins.MoveAsync(pin, index);
    }

    Task UnpinAsync(PinItem pin)
    {
        _pinMenu = null;
        return Pins.UnpinAsync(pin);
    }

    /// <summary>A saved search's Rename… and Delete open it, and the Library asks for the name or deletes it there, where Undo is.</summary>
    void ActOnSearch(PinItem pin, string action)
    {
        _pinMenu = null;
        Navigation.NavigateTo($"{pin.Href}&do={action}");
    }

    Task PinKeyAsync(PinItem pin, int at, KeyboardEventArgs e) =>
        !e.AltKey ? Task.CompletedTask
        : e.Key == "ArrowUp" ? MoveAsync(pin, at - 1)
        : e.Key == "ArrowDown" ? MoveAsync(pin, at + 1)
        : Task.CompletedTask;

    async Task DropAsync(int at)
    {
        var dragging = _dragging;
        EndDrag();
        if (dragging is null) return;
        var from = Pins.Items.ToList().FindIndex(p => p.Kind == dragging.Kind && p.Id == dragging.Id);
        // It lands where the line was, above the pin dropped on; the index counts the pins once it has been taken out.
        var index = at > from ? at - 1 : at;
        if (from >= 0 && index != from) await Pins.MoveAsync(dragging, index);
    }

    void EndDrag()
    {
        _dragging = null;
        _dropAt = null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Activity.Changed -= OnActivityChanged;
        Pins.Changed -= OnPinsChanged;
        Breadcrumb.Changed -= OnPinsChanged;
    }
}
