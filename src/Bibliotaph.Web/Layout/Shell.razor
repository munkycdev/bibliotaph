@* The app's frame: the sidebar (.bt-sidebar) with its navigation, and the work area with its top bar. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject ApiClient Api
@inject Theme Theme
@inject NavigationManager Navigation
@inject LibraryActivity Activity
@inject Pins Pins
@inject Breadcrumb Breadcrumb
@inject IJSRuntime JS
@inject SearchGuideModel Guide
@using Bibliotaph.Core.Search

@if (_loading && _opening is { Step: not null } opening)
{
    <div class="bt-signin" role="status" aria-live="polite">
        <div class="bt-signin-card bt-opening">
            <div class="bt-brand"><span class="bt-monogram">b.</span><span>Bibliotaph</span></div>
            <h1>@OpeningHeading(opening)</h1>
            <p class="bt-copy">@OpeningText(opening)</p>
            <div class="bt-opening-bar" aria-hidden="true"><span></span></div>
            @if (opening.Seconds >= 5)
            {
                <p class="bt-opening-time">@Elapsed(opening.Seconds) so far</p>
            }
        </div>
    </div>
}
else if (_loading)
{
    <div class="bt-loading">Opening Bibliotaph…</div>
}
else if (_me is null)
{
    <SignInCard Problem="@SignInProblem" />
}
else if (PoppedOut)
{
    @* A reader popped out into a window of its own has no shell around it. *@
    <div class="bt-shell popout"><main id="bt-main">@Body</main></div>
    <CollectionDialog />
    <BinderDialog />
}
else
{
    <div class="bt-shell @(_folded ? "folded" : "")">
        <aside class="bt-sidebar">
            @* Folded, the monogram alone. *@
            <a class="bt-brand" href="/" aria-label="Bibliotaph front page"><span class="bt-monogram">b.</span><span class="bt-brandname">Bibliotaph</span></a>
            <nav class="bt-navigation" aria-label="Main navigation">
                @foreach (var item in Items)
                {
                    var active = item.Href == ActiveHref;
                    <a class="bt-nav @(active ? "active" : "")" href="@item.Href" aria-current="@(active ? "page" : null)" title="@(_folded ? item.Label : null)" data-tour="@TourName(item.Href)"><Icon Name="@item.Icon" /><span class="bt-navlabel">@item.Label</span>@if (CountOf(item.Href) is { } count)
                    {
                        <span class="bt-count" aria-label="@($"{count} to review")">@count</span>
                    }</a>
                }
            </nav>
            @* Books, Favorites, collections, binders and saved searches, in order. A pin is dragged to a new place, or moved
               with Alt+Up and Alt+Down or its right-click menu, which also unpins it, and renames or deletes a saved search. *@
            <div class="bt-sidegroup bt-pins">
                <span class="bt-eyebrow">PINNED</span>
                @if (Pins.Items.Count == 0)
                {
                    <p class="bt-sample bt-nav-hint">@Pins.Hint</p>
                }
                <div role="list" aria-label="Pinned">
                    @for (var i = 0; i < Pins.Items.Count; i++)
                    {
                        var pin = Pins.Items[i];
                        var at = i;
                        var active = IsShown(pin);
                        <div class="bt-pinrow @(_dropAt == at && _dragging is not null ? "drop" : "")" role="listitem" @key="(pin.Kind, pin.Id)"
                             @ondragover="() => _dropAt = at" @ondragover:preventDefault="true" @ondrop="() => DropAsync(at)">
                            <a class="bt-nav @(active ? "active" : "") @(pin.Dimmed ? "dimmed" : "")" href="@pin.Href" title="@(_folded ? pin.Label : pin.Tip)" aria-current="@(active ? "page" : null)"
                               draggable="true" @ondragstart="() => _dragging = pin" @ondragend="EndDrag"
                               @oncontextmenu="() => _pinMenu = pin" @oncontextmenu:preventDefault="true" @onkeydown="e => PinKeyAsync(pin, at, e)">
                                <Icon Name="@pin.Icon" /><span class="bt-navlabel">@pin.Label</span>
                            </a>
                            @if (_pinMenu == pin)
                            {
                                <div class="bt-backdrop fixed bt-menuback" @onclick="() => _pinMenu = null" @oncontextmenu="() => _pinMenu = null" @oncontextmenu:preventDefault="true"></div>
                                <div class="bt-menu bt-pinmenu" role="menu" aria-label="@pin.Label">
                                    <button class="bt-menuitem" role="menuitem" disabled="@(at == 0)" @onclick="() => MoveAsync(pin, at - 1)">Move up<span class="bt-gesture">Alt+Up</span></button>
                                    <button class="bt-menuitem" role="menuitem" disabled="@(at == Pins.Items.Count - 1)" @onclick="() => MoveAsync(pin, at + 1)">Move down<span class="bt-gesture">Alt+Down</span></button>
                                    <button class="bt-menuitem" role="menuitem" @onclick="() => UnpinAsync(pin)">Unpin</button>
                                    @if (pin.Kind == PinKinds.Search)
                                    {
                                        <button class="bt-menuitem" role="menuitem" @onclick='() => ActOnSearch(pin, "rename")'>Rename…</button>
                                        <button class="bt-menuitem" role="menuitem" @onclick='() => ActOnSearch(pin, "delete")'>Delete</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_dragging is not null)
                    {
                        <div class="bt-pinrow bt-pinend @(_dropAt == Pins.Items.Count ? "drop" : "")" @ondragover="() => _dropAt = Pins.Items.Count"
                             @ondragover:preventDefault="true" @ondrop="() => DropAsync(Pins.Items.Count)"></div>
                    }
                </div>
            </div>
            <div class="bt-sidebottom">
                @* The fold button stays at the foot: beside Settings when open, under it when folded. *@
                <div class="bt-settingsrow">
                    <NavLink class="bt-nav" href="settings" title="@(_folded ? "Settings" : null)" data-tour="settings"><Icon Name="Settings2" /><span class="bt-navlabel">Settings</span></NavLink>
                    <button class="bt-icon bt-fold" title="@FoldLabel" aria-label="@FoldLabel" @onclick="ToggleSidebarAsync"><Icon Name="PanelLeft" /></button>
                </div>
                @* One or two lines of what the library is doing, the whole text on hover. *@
                <div class="bt-sync" role="status" title="@Activity.Current?.Text" data-tour="status"><span class="bt-status-dot @(Activity.Current?.Busy == true ? "busy" : "")"></span><span>@(Activity.Current?.Text ?? "Opening your library")</span></div>
            </div>
        </aside>
        <div class="bt-workarea">
            <header class="bt-topbar">
                @if (Breadcrumb.Title is { } title)
                {
                    @* A book in the reader: back to where it was opened from, and the section it belongs to before its title. *@
                    <button class="bt-icon bt-back" title="Back" aria-label="Back" @onclick="() => BrowserWindow.BackAsync(JS)"><Icon Name="ArrowLeft" Size="15" /></button>
                    <div class="bt-breadcrumb" title="@title"><a href="library" aria-label="Go to Library">Library</a><span class="bt-crumbsep">/</span>@title</div>
                }
                else
                {
                    <div class="bt-breadcrumb">@Section</div>
                }
                <div class="bt-searchwrap">
                    <label class="bt-search" data-tour="search">
                        <Icon Name="Search" Size="15" />
                        <span class="visually-hidden">Search</span>
                        <input type="search" placeholder="@(_asking ? AskPanelText.Placeholder : "Search books, topics, passages…")" value="@_searchText"
                               @ref="_searchBox" @oninput="OnSearchInput" @onkeydown="OnSearchKey"
                               role="combobox" aria-autocomplete="list" aria-controls="bt-guide" aria-expanded="@(GuideShown ? "true" : "false")"
                               aria-activedescendant="@(GuideShown && Guide.Highlighted >= 0 ? $"bt-guide-{Guide.Highlighted}" : null)"
                               data-guide="@(GuideShown ? "open" : null)" />
                    </label>
                    @* The search box's field guide: the fields to search by, and after a field's colon its values in the
                       library. The box keeps the keyboard; the arrow keys move the highlight and Enter or Tab picks it. *@
                    @if (GuideShown)
                    {
                        <div class="bt-guide" @onmousedown:preventDefault="true">
                            <span class="bt-eyebrow">@Guide.Heading</span>
                            @if (Guide.Hint is { } hint)
                            {
                                <div class="bt-guidehint"><strong>@hint.Field.Prefix</strong> <span class="bt-muted">@(hint.Field.Description), e.g. </span>@hint.Field.Example</div>
                            }
                            <div class="bt-guiderows" id="bt-guide" role="listbox" aria-label="Search suggestions">
                                @for (var i = 0; i < Guide.Rows.Count; i++)
                                {
                                    var row = Guide.Rows[i];
                                    var highlighted = i == Guide.Highlighted;
                                    <div class="bt-guiderow @(highlighted ? "highlighted" : "")" id="bt-guide-@i" role="option" aria-selected="@(highlighted ? "true" : "false")"
                                         aria-label="@row.Spoken" @onclick="() => PickGuideRowAsync(row)">
                                        @if (row is GuideFieldRow field)
                                        {
                                            <span><strong>@field.Field.Prefix</strong> <span class="bt-muted">@(field.Field.Description), e.g. </span>@field.Field.Example</span>
                                        }
                                        else if (row is GuideValueRow value)
                                        {
                                            <span class="bt-guidevalue">@value.Value.Label<span class="bt-muted">@value.Search</span></span>
                                            <span class="bt-muted">@value.Count</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="bt-guidesyntax">@SearchFields.Syntax</div>
                        </div>
                    }
                </div>
                @* Ask: the box takes a request in plain English, read by AI on Enter, or a question for the library on Ctrl+Enter. *@
                <button class="bt-icon bt-askbutton @(_asking ? "active" : "")" title="Ask in plain English" aria-label="Ask in plain English"
                        aria-pressed="@(_asking ? "true" : "false")" @onclick="ToggleAskAsync"><Icon Name="Sparkles" /></button>
                <button class="bt-icon" title="@Theme.Label(_theme)" aria-label="@Theme.Label(_theme)" @onclick="CycleTheme"><Icon Name="SunMoon" /></button>
            </header>
            @if (_asking)
            {
                <AskBar @ref="_askBar" Text="@_searchText" Close="CloseAsk" Search="SearchFromAsk" />
            }
            <main id="bt-main">@Body</main>
            @* The site's footer under every page but the readers, which fill the window. Its pages open in a tab of their
               own, so whatever is open here stays as it is. *@
            <footer class="bt-appfoot">
                <span class="bt-tagline">@_tagline</span>
                <nav aria-label="More about Bibliotaph">
                    @foreach (var (href, label) in Footer.Links)
                    {
                        <a href="@href" target="_blank" rel="noopener">@label</a>
                    }
                </nav>
                <span>Version @Footer.Version</span>
            </footer>
        </div>
    </div>
    <CollectionDialog />
    <BinderDialog />
    <TourOverlay />
}

@if (_shortcuts)
{
    <ShortcutsDialog Closed="() => _shortcuts = false" />
}

@code {
    readonly string _tagline = Footer.Tagline();

    static readonly (string Href, string Label, string Icon)[] Items =
    [
        ("home", "Home", "House"),
        ("library", "Library", "LibraryBig"),
        ("collections", "Collections", "Folders"),
        ("binders", "Binders", "NotebookTabs"),
        ("summary", "Summary", "ChartNoAxesColumn"),
        ("review", "Needs review", "Inbox"),
    ];

    /// <summary>The tour's name for a page's button: the Windows app's TourAnchor, as data-tour.</summary>
    static string? TourName(string href) => href switch
    {
        "library" => "library",
        "collections" => "collections",
        "binders" => "binders",
        "review" => "needs-review",
        _ => null,
    };

    /// <summary>What Needs review holds, beside its name; nothing when it's empty.</summary>
    string? CountOf(string href) =>
        href == "review" && Activity.Current is { Review: > 0 } status ? status.Review.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : null;

    static readonly TimeSpan SearchPause = TimeSpan.FromMilliseconds(300);

    bool _loading = true;
    CurrentUser? _me;
    string _theme = "system";

    /// <summary>Why the last sign-in didn't work, from the server's redirect (?problem=).</summary>
    string? SignInProblem =>
        new Uri(Navigation.Uri).Query.Contains("problem=failed", StringComparison.Ordinal)
            ? "Signing in didn't finish. Try again, or choose another way to sign in."
            : null;

    bool PoppedOut =>
        Navigation.ToBaseRelativePath(Navigation.Uri) is var path && (path.StartsWith("read/", StringComparison.Ordinal) || path.StartsWith("binders/", StringComparison.Ordinal))
        && path.Contains("popout=true", StringComparison.Ordinal);

    string Section =>
        Navigation.ToBaseRelativePath(Navigation.Uri) is var at && (at.StartsWith("settings", StringComparison.Ordinal) || at.StartsWith("connect", StringComparison.Ordinal)) ? "Settings"
            : Items.FirstOrDefault(i => i.Href == ActiveHref).Label ?? "Home";

    /// <summary>The section the page is in. A collection shows in the Library, but belongs to Collections.</summary>
    string? ActiveHref
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            if (path.StartsWith("library", StringComparison.Ordinal) && LibraryUrl.Parse(Navigation.Uri).Collection is not null) return "collections";
            return Items.FirstOrDefault(i => path.StartsWith(i.Href, StringComparison.Ordinal)).Href;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        if (OnLibrary) _searchText = LibraryUrl.Parse(Navigation.Uri).Q ?? "";
        _me = await Session.MeAsync();
        if (_me is not null)
        {
            await WaitForLibraryAsync();
            Activity.Changed += OnActivityChanged;
            Activity.Start();
            Pins.Changed += OnPinsChanged;
            Breadcrumb.Changed += OnPinsChanged;
            await Pins.LoadAsync();
            await LoadFoldAsync();
            await StartWhereChosenAsync();
        }
        _theme = await Theme.CurrentAsync();
        Theme.Changed += OnThemeChanged;
        Guide.Changed += OnGuideChanged;
        _loading = false;
    }

    LibraryOpening? _opening;

    static readonly TimeSpan OpeningPoll = TimeSpan.FromSeconds(2);

    /// <summary>
    /// After an update or a restart the server brings the library back from storage before it can answer anything, which
    /// can take minutes: longer than the browser waits on one call. So the page asks how that's going, which never waits,
    /// and only then loads what needs the library.
    /// </summary>
    async Task WaitForLibraryAsync()
    {
        while (true)
        {
            try
            {
                if (await Api.LibraryOpeningAsync() is not { Ready: false } opening) return;
                _opening = opening;
            }
            catch (Exception ex) when (ex is HttpRequestException or ApiProblemException or TaskCanceledException)
            {
                // The server itself is still starting; ask again.
            }
            StateHasChanged();
            await Task.Delay(OpeningPoll);
        }
    }

    static string OpeningHeading(LibraryOpening opening) => opening.Step switch
    {
        "restoring" => "Bringing your library back",
        "failed" => "Your library didn't open",
        _ => "Opening your library",
    };

    static string OpeningText(LibraryOpening opening) => opening.Step switch
    {
        "restoring" => "Bibliotaph was updated or restarted, so your library is coming back from storage before it opens. This can take a few minutes. The page carries on by itself.",
        "failed" => "Something went wrong opening it. Bibliotaph will try again in a moment.",
        _ => "Your library is back, and Bibliotaph is starting it.",
    };

    static string Elapsed(int seconds) => seconds < 60 ? $"{seconds} s" : $"{seconds / 60} min {seconds % 60} s";

    async Task CycleTheme() => _theme = await Theme.CycleAsync();

    bool _shortcuts;
    DotNetObjectReference<Shell>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_guideCaret is { } caret && _self is not null)
        {
            _guideCaret = null;
            try
            {
                await JS.InvokeVoidAsync("bibliotaphGuide.place", _searchBox, caret);
            }
            catch (JSException)
            {
                // The cursor stays at the end.
            }
        }
        if (_self is null && _me is not null)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("bibliotaphShell.start", _self);
            }
            catch (JSException)
            {
                // Ctrl+/ does nothing; Settings still has the list.
            }
        }
        if (!_guideAttached && _self is not null && !_loading && !PoppedOut)
        {
            // The box is drawn only once the shell is: not while opening, nor in a popped-out reader.
            _guideAttached = true;
            try
            {
                await JS.InvokeVoidAsync("bibliotaphGuide.attach", _searchBox, _self);
            }
            catch (JSException)
            {
                // The box searches without its guide.
            }
        }
    }

    bool GuideShown => Guide.IsOpen && !_asking;

    bool _guideAttached;

    /// <summary>Where the cursor goes once a pick's text is drawn in the box.</summary>
    int? _guideCaret;

    /// <summary>The guide's rows, from the box's script, which knows where the cursor is.</summary>
    [JSInvokable] public void GuideFocused(string text, int caret) { if (!_asking) Guide.Focused(text, caret); }

    [JSInvokable] public void GuideTextChanged(string text, int caret) { if (!_asking) Guide.TextChanged(text, caret); }

    [JSInvokable] public void GuideCaretMoved(string text, int caret) { if (!_asking) Guide.CaretMoved(text, caret); }

    [JSInvokable] public void GuideRequest(string text, int caret) { if (!_asking) Guide.Request(text, caret); }

    [JSInvokable] public void GuideMove(int step) => Guide.Move(step);

    [JSInvokable] public void GuideClose() => Guide.Close();

    [JSInvokable]
    public Task GuidePickAsync() => Guide.PickHighlighted() is { } edit ? ApplyGuideEditAsync(edit) : Task.CompletedTask;

    Task PickGuideRowAsync(GuideRow row) => Guide.Pick(row) is { } edit ? ApplyGuideEditAsync(edit) : Task.CompletedTask;

    /// <summary>Puts a pick in the box with the cursor after it, then searches as typing does.</summary>
    async Task ApplyGuideEditAsync(GuideEdit edit)
    {
        _searchText = edit.Text;
        _guideCaret = edit.Caret;
        Guide.TextChanged(edit.Text, edit.Caret);
        StateHasChanged();
        await OnSearchInput(new ChangeEventArgs { Value = edit.Text });
    }

    void OnGuideChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Folded to its icons, and remembered in this browser.</summary>
    bool _folded;

    const string FoldKey = "sidebar.folded";

    string FoldLabel => _folded ? "Expand the sidebar (Ctrl+B)" : "Collapse the sidebar (Ctrl+B)";

    /// <summary>Ctrl+B, from the page's script, which doesn't draw the page again by itself.</summary>
    [JSInvokable]
    public async Task ToggleSidebarFromKeyAsync()
    {
        await ToggleSidebarAsync();
        StateHasChanged();
    }

    /// <summary>The fold button.</summary>
    async Task ToggleSidebarAsync()
    {
        _folded = !_folded;
        try
        {
            await JS.InvokeVoidAsync("bibliotaphPrefs.set", FoldKey, _folded ? "1" : "");
        }
        catch (JSException)
        {
            // Folded for this visit only.
        }
    }

    async Task LoadFoldAsync()
    {
        try
        {
            _folded = await JS.InvokeAsync<string?>("bibliotaphPrefs.get", FoldKey) == "1";
        }
        catch (JSException)
        {
            // Open, as it starts.
        }
    }

    /// <summary>Ctrl+/, from the page's script: the Keyboard shortcuts popup, or away again.</summary>
    [JSInvokable]
    public void ShowShortcuts()
    {
        _shortcuts = !_shortcuts;
        StateHasChanged();
    }

    /// <summary>
    /// The Library rather than Home when Settings › Preferences says so. Only
    /// when Bibliotaph itself opens at Home: choosing Home later stays on Home.
    /// </summary>
    async Task StartWhereChosenAsync()
    {
        if (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] != "home") return;
        try
        {
            if ((await Api.StartPageAsync()).Library) Navigation.NavigateTo("library", replace: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException)
        {
            // Home it is.
        }
    }

    void OnThemeChanged(string mode)
    {
        _theme = mode;
        StateHasChanged();
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Keeps the box in step when the Library clears the search, or Back goes to another.
        if (OnLibrary && _searchDelay is null) _searchText = LibraryUrl.Parse(e.Location).Q ?? "";
        StateHasChanged();
    }

    bool OnLibrary => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("library", StringComparison.Ordinal);

    string _searchText = "";
    CancellationTokenSource? _searchDelay;

    bool _asking;
    AskBar? _askBar;
    ElementReference _searchBox;

    /// <summary>The Ask button: Ask mode on or off. On puts the keyboard in the box for the request.</summary>
    async Task ToggleAskAsync()
    {
        _asking = !_asking;
        Guide.Close();
        _searchDelay?.Cancel();
        _searchDelay = null;
        if (_asking) await _searchBox.FocusAsync();
    }

    void CloseAsk() => _asking = false;

    /// <summary>Ask's Search: the chips as query text, in the box and run, leaving Ask.</summary>
    void SearchFromAsk(string text)
    {
        _asking = false;
        _searchText = text;
        SubmitSearch();
    }

    /// <summary>As in the Windows app, a pause in typing searches; Enter searches at once and Esc clears the box.</summary>
    async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value as string ?? "";
        // In Ask mode the box holds a request, which is read on Enter rather than searched as it is typed.
        if (_asking) return;
        _searchDelay?.Cancel();
        var delay = _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchPause, delay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        SubmitSearch();
    }

    /// <summary>In Ask mode, Enter reads the request, Ctrl+Enter answers it from the library's pages, and Esc leaves Ask, keeping the text.</summary>
    async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (_asking)
        {
            if (_askBar is not { } ask) return;
            if (e.Key == "Enter" && e.CtrlKey) await ask.AnswerAsync(_searchText);
            else if (e.Key == "Enter" && !e.AltKey && !e.ShiftKey && !e.MetaKey) await ask.InterpretAsync(_searchText);
            else if (e.Key == "Escape") _asking = false;
            return;
        }
        if (e.Key == "Enter") SubmitSearch();
        else if (e.Key == "Escape")
        {
            _searchText = "";
            SubmitSearch();
        }
    }

    /// <summary>Shows the search in the Library, keeping its filters when it's already there.</summary>
    void SubmitSearch()
    {
        _searchDelay?.Cancel();
        _searchDelay = null;
        var text = _searchText.Trim();
        if (!OnLibrary && text.Length == 0) return;
        var current = OnLibrary ? LibraryUrl.Parse(Navigation.Uri) : new LibraryQuery();
        if ((current.Q ?? "") == text) return;
        var next = text.Length == 0 ? current with { Q = null, Tab = null } : current with { Q = text };
        Navigation.NavigateTo("library" + LibraryUrl.QueryString(next, forApi: false), replace: OnLibrary);
    }

    void OnActivityChanged() => InvokeAsync(StateHasChanged);

    void OnPinsChanged() => InvokeAsync(StateHasChanged);

    PinItem? _pinMenu;
    PinItem? _dragging;
    int? _dropAt;

    /// <summary>The pin whose page is shown: the same address.</summary>
    bool IsShown(PinItem pin)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return path == pin.Href || (path.StartsWith(pin.Href + "&", StringComparison.Ordinal) && pin.Kind == PinKinds.Search);
    }

    async Task MoveAsync(PinItem pin, int index)
    {
        _pinMenu = null;
        if (index < 0 || index >= Pins.Items.Count) return;
        await Pins.MoveAsync(pin, index);
    }

    Task UnpinAsync(PinItem pin)
    {
        _pinMenu = null;
        return Pins.UnpinAsync(pin);
    }

    /// <summary>A saved search's Rename… and Delete open it, and the Library asks for the name or deletes it there, where Undo is.</summary>
    void ActOnSearch(PinItem pin, string action)
    {
        _pinMenu = null;
        Navigation.NavigateTo($"{pin.Href}&do={action}");
    }

    Task PinKeyAsync(PinItem pin, int at, KeyboardEventArgs e) =>
        !e.AltKey ? Task.CompletedTask
        : e.Key == "ArrowUp" ? MoveAsync(pin, at - 1)
        : e.Key == "ArrowDown" ? MoveAsync(pin, at + 1)
        : Task.CompletedTask;

    async Task DropAsync(int at)
    {
        var dragging = _dragging;
        EndDrag();
        if (dragging is null) return;
        var from = Pins.Items.ToList().FindIndex(p => p.Kind == dragging.Kind && p.Id == dragging.Id);
        // It lands where the line was, above the pin dropped on; the index counts the pins once it has been taken out.
        var index = at > from ? at - 1 : at;
        if (from >= 0 && index != from) await Pins.MoveAsync(dragging, index);
    }

    void EndDrag()
    {
        _dragging = null;
        _dropAt = null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Activity.Changed -= OnActivityChanged;
        Pins.Changed -= OnPinsChanged;
        Breadcrumb.Changed -= OnPinsChanged;
        Theme.Changed -= OnThemeChanged;
        Guide.Changed -= OnGuideChanged;
        _self?.Dispose();
    }
}
