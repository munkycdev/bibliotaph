<Router AppAssembly="typeof(App).Assembly">
    <Found Context="route">
        <RouteView RouteData="route" DefaultLayout="typeof(Shell)" />
        <FocusOnNavigate RouteData="route" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Shell)">
            <EmptyState Title="Nothing here." Message="This page doesn't exist. It may have moved." ActionText="Return to library" ActionIcon="LibraryBig" ActionHref="library" />
        </LayoutView>
    </NotFound>
</Router>
