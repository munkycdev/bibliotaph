<UserControl x:Class="Bibliotaph.Viewer.PdfPagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bibliotaph.Viewer"
             Focusable="False">
  <UserControl.Resources>
    <!-- Boxes laid out on a page by their X and Y, in DIPs. -->
    <Style x:Key="OnCanvas" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding X}" />
      <Setter Property="Canvas.Top" Value="{Binding Y}" />
    </Style>
    <ItemsPanelTemplate x:Key="Canvas">
      <Canvas />
    </ItemsPanelTemplate>
  </UserControl.Resources>

  <ListBox x:Name="Pages"
           Background="{DynamicResource Bt.Side}"
           BorderThickness="0"
           HorizontalContentAlignment="Center"
           FocusVisualStyle="{x:Null}"
           ScrollViewer.HorizontalScrollBarVisibility="Auto"
           ScrollViewer.CanContentScroll="True"
           ScrollViewer.ScrollChanged="Pages_ScrollChanged"
           SizeChanged="Pages_SizeChanged"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling"
           VirtualizingPanel.ScrollUnit="Pixel"
           VirtualizingPanel.CacheLength="1,1"
           VirtualizingPanel.CacheLengthUnit="Page"
           AutomationProperties.Name="Pages">
    <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <ContentPresenter HorizontalAlignment="Center" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
      <DataTemplate DataType="{x:Type local:ViewerPage}">
        <!-- Every page item is exactly Height + 16 tall; PdfPagesView's layout maths relies on it. -->
        <Grid x:Name="Surface" Width="{Binding Width}" Height="{Binding Height}" Margin="0,8" Background="White" ClipToBounds="True"
              Cursor="IBeam">
          <TextBlock Text="{Binding Placeholder}" Foreground="#9A9A92" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12" />
          <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
          <!-- The tile, highlight and selection layers are only drawn: the mouse and Tab both pass through them. -->
          <ItemsControl ItemsSource="{Binding Tiles}" IsHitTestVisible="False" Focusable="False" ItemsPanel="{StaticResource Canvas}"
                        ItemContainerStyle="{StaticResource OnCanvas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PlacedImage}">
                <Image Source="{Binding Source}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False" Focusable="False" ItemsPanel="{StaticResource Canvas}"
                        ItemContainerStyle="{StaticResource OnCanvas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PageBox}">
                <Rectangle x:Name="Box" Width="{Binding Width}" Height="{Binding Height}" Fill="#66F2C230" />
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter TargetName="Box" Property="Fill" Value="#88E07A10" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Selection}" IsHitTestVisible="False" Focusable="False" ItemsPanel="{StaticResource Canvas}"
                        ItemContainerStyle="{StaticResource OnCanvas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PageBox}">
                <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#553D7BD9" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
