<Project Sdk="Microsoft.NET.Sdk">
  <!-- Worker pool, job objects, shared memory and restarts. Grown from the spike's Spike.WorkerHost. -->
  <PropertyGroup>
    <TargetFramework>$(BibTfm)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Creates the shared render buffer the worker maps. -->
    <AllowFileWrites>true</AllowFileWrites>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bibliotaph.Pdf.Contracts\Bibliotaph.Pdf.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
