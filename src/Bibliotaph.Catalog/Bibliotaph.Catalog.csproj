<Project Sdk="Microsoft.NET.Sdk">
  <!-- catalog.db: the user's work. EF Core, migrated, backed up before every migration. -->
  <PropertyGroup>
    <TargetFramework>$(BibTfm)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bibliotaph.Core\Bibliotaph.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
    <!-- Design-time only, for dotnet ef migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
