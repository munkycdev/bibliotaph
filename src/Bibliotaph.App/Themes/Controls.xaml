<!--
  Control templates after the mockup's .bt-* classes. Every colour is a DynamicResource token so
  light and dark swap at runtime. Button content can carry an icon through c:Ui.Icon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Bibliotaph.App.Controls">

  <!-- Merged here, not only in App.xaml, so StaticResource references below resolve when this file loads. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="../Icons/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Keyboard focus: a 2px accent ring, 3px outside the control (mockup :focus-visible). -->
  <Style x:Key="Bt.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Bt.Accent}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-button: quiet bordered button. Implicit, so plain Buttons get it too. -->
  <Style x:Key="Bt.Button" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Bt.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bt.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Shade" Margin="-12,-8" CornerRadius="5" Background="Black" Opacity="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:LucideIcon x:Name="Icon" Size="15" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Bt.Button}" />

  <!-- .bt-button.primary -->
  <Style x:Key="Bt.Button.Primary" TargetType="Button" BasedOn="{StaticResource Bt.Button}">
    <Setter Property="Background" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.AccentText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Shade" Margin="-12,-8" CornerRadius="5" Background="Black" Opacity="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:LucideIcon x:Name="Icon" Size="15" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- filter: brightness(.94) -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shade" Property="Opacity" Value="0.12" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-icon: a square icon-only button. Give it AutomationProperties.Name and a ToolTip. -->
  <Style x:Key="Bt.IconButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="7" SnapsToDevicePixels="True">
            <c:LucideIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-nav: navigation rail item; c:Ui.IsActive marks the current screen. -->
  <Style x:Key="Bt.NavButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10" MinHeight="38" SnapsToDevicePixels="True">
            <DockPanel VerticalAlignment="Center">
              <!-- .bt-count -->
              <TextBlock DockPanel.Dock="Right" Text="{Binding (c:Ui.Count), RelativeSource={RelativeSource TemplatedParent}}"
                         FontSize="11" FontWeight="Normal" Foreground="{DynamicResource Bt.Muted}" MinWidth="20" TextAlignment="Center"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
              <c:LucideIcon x:Name="Icon" Margin="0,0,10,0" VerticalAlignment="Center"
                            Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            </Trigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-search: the top bar's search box, with placeholder and the Ctrl K hint, which gives way to a clear
       (×) button running c:Ui.ClearCommand once there is text. The × leaves focus in the box for the next search. -->
  <Style x:Key="Bt.SearchBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                  BorderThickness="1" CornerRadius="7" Padding="10,7" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <c:LucideIcon Size="15" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource Bt.Muted}" VerticalAlignment="Center" />
              <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                         Text="{TemplateBinding Tag}" Foreground="{DynamicResource Bt.Muted}" IsHitTestVisible="False" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
              <Border x:Name="Shortcut" Grid.Column="2" Margin="8,0,0,0" Padding="4,0" CornerRadius="3" BorderThickness="1"
                      BorderBrush="{DynamicResource Bt.Line}" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Ctrl K" FontSize="9" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button x:Name="Clear" Grid.Column="2" Margin="8,-3,-4,-3" VerticalAlignment="Center" Focusable="False" Cursor="Hand"
                      Command="{Binding (c:Ui.ClearCommand), RelativeSource={RelativeSource TemplatedParent}}"
                      ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="3">
                      <c:LucideIcon x:Name="Glyph" Size="13" Data="{StaticResource Icon.X}" Foreground="{DynamicResource Bt.Muted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Bt.Text}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              <Setter TargetName="Shortcut" Property="Visibility" Value="Visible" />
              <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              <Setter TargetName="Shortcut" Property="Visibility" Value="Visible" />
              <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A thin progress bar. Indeterminate (no total yet) sweeps a short block across. -->
  <!-- .bt-field input: a plain single-line text box. -->
  <Style x:Key="Bt.TextBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                  BorderThickness="1" CornerRadius="6" Padding="9,6" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-link: a small accent-coloured text button, with an optional icon through c:Ui.Icon. -->
  <Style x:Key="Bt.Link" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <StackPanel Orientation="Horizontal" Background="Transparent" Margin="{TemplateBinding Padding}">
            <c:LucideIcon x:Name="Icon" Size="13" Margin="0,0,5,0" VerticalAlignment="Center"
                          Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Bt.ProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Bt.Line}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
              <Border x:Name="Sweep" Background="{TemplateBinding Foreground}" CornerRadius="3" Width="60" HorizontalAlignment="Left"
                      Visibility="Collapsed">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="SweepAnimation">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-60" To="640" Duration="0:0:1.8" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="SweepAnimation" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A segmented choice (Appearance: Use system / Light / Dark), after .bt-viewtoggle. -->
  <Style x:Key="Bt.Segment" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="11,6" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Panel}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
              <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-tab: tabs over a list, the active one on the soft background. -->
  <Style x:Key="Bt.Tab" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="10,6">
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Bt.SegmentGroup" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bt.Side}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- .bt-sort / .bt-field select: a quiet drop-down for filters and sort. -->
  <Style x:Key="Bt.Select" TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1"
                          CornerRadius="5" SnapsToDevicePixels="True">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0"
                          Stroke="{DynamicResource Bt.Muted}" StrokeThickness="1.4" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Muted}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="10,7,28,7" IsHitTestVisible="False" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="5"
                      Margin="0,4,0,0" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Toggle" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,6">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontWeight" Value="Medium" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    A list with no chrome of its own: the items draw everything, and keyboard focus shows on the item.
    Foreground is set because ListBox's system style uses the Windows control-text colour (black), not the window's.
  -->
  <Style x:Key="Bt.PlainList" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-chip -->
  <Style x:Key="Bt.Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bt.Side}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,3,4,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A hairline rule, .bt-rule. -->
  <Style x:Key="Bt.Rule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Bt.Line}" />
  </Style>

  <!-- .bt-empty: centred title, message and one action. -->
  <Style TargetType="c:EmptyState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:EmptyState">
          <StackPanel Margin="25,65" HorizontalAlignment="Center" MaxWidth="460">
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.H2}" TextAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Copy}" TextAlignment="Center" />
            <Button x:Name="Action" Style="{StaticResource Bt.Button.Primary}" Margin="0,24,0,0" HorizontalAlignment="Center"
                    Content="{TemplateBinding ActionText}" Command="{TemplateBinding Command}"
                    c:Ui.Icon="{TemplateBinding ActionIcon}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ActionText" Value="{x:Null}">
              <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scroll bars that suit both themes. -->
  <Style x:Key="Bt.ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource Bt.Line}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Bt.Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
            <Track.Thumb>
              <Thumb Style="{StaticResource Bt.ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                <Track.Thumb>
                  <Thumb Style="{StaticResource Bt.ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Bt.Text}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Bg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
</ResourceDictionary>
