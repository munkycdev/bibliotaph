<!--
  Control templates after the mockup's .bt-* classes. Every colour is a DynamicResource token so
  light and dark swap at runtime. Button content can carry an icon through c:Ui.Icon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Bibliotaph.App.Controls">

  <!-- Merged here, not only in App.xaml, so StaticResource references below resolve when this file loads. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="../Icons/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Keyboard focus: a 2px accent ring, 3px outside the control (mockup :focus-visible). -->
  <Style x:Key="Bt.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Bt.Accent}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-button: quiet bordered button. Implicit, so plain Buttons get it too. -->
  <Style x:Key="Bt.Button" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Bt.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bt.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Shade" Margin="-12,-8" CornerRadius="5" Background="Black" Opacity="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:LucideIcon x:Name="Icon" Size="15" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Bt.Button}" />

  <!-- .bt-button.primary -->
  <Style x:Key="Bt.Button.Primary" TargetType="Button" BasedOn="{StaticResource Bt.Button}">
    <Setter Property="Background" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.AccentText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Shade" Margin="-12,-8" CornerRadius="5" Background="Black" Opacity="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:LucideIcon x:Name="Icon" Size="15" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- filter: brightness(.94) -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Shade" Property="Opacity" Value="0.12" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-icon: a square icon-only button. Give it AutomationProperties.Name and a ToolTip. -->
  <Style x:Key="Bt.IconButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="7" SnapsToDevicePixels="True">
            <c:LucideIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-nav: navigation rail item; c:Ui.IsActive marks the current screen. -->
  <Style x:Key="Bt.NavButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10" MinHeight="38" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <c:LucideIcon x:Name="Icon" Margin="0,0,10,0" VerticalAlignment="Center"
                            Data="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            </Trigger>
            <Trigger Property="c:Ui.IsActive" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .bt-search: the top bar's search box, with placeholder and the Ctrl K hint. -->
  <Style x:Key="Bt.SearchBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                  BorderThickness="1" CornerRadius="7" Padding="10,7" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <c:LucideIcon Size="15" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource Bt.Muted}" VerticalAlignment="Center" />
              <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                         Text="{TemplateBinding Tag}" Foreground="{DynamicResource Bt.Muted}" IsHitTestVisible="False" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
              <Border Grid.Column="2" Margin="8,0,0,0" Padding="4,0" CornerRadius="3" BorderThickness="1"
                      BorderBrush="{DynamicResource Bt.Line}" VerticalAlignment="Center">
                <TextBlock Text="Ctrl K" FontSize="9" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A segmented choice (Appearance: Use system / Light / Dark), after .bt-viewtoggle. -->
  <Style x:Key="Bt.Segment" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="11,6" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Panel}" />
              <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
              <Setter Property="FontWeight" Value="Medium" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Bt.SegmentGroup" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bt.Side}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- A hairline rule, .bt-rule. -->
  <Style x:Key="Bt.Rule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Bt.Line}" />
  </Style>

  <!-- .bt-empty: centred title, message and one action. -->
  <Style TargetType="c:EmptyState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:EmptyState">
          <StackPanel Margin="25,65" HorizontalAlignment="Center" MaxWidth="460">
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.H2}" TextAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Copy}" TextAlignment="Center" />
            <Button x:Name="Action" Style="{StaticResource Bt.Button.Primary}" Margin="0,24,0,0" HorizontalAlignment="Center"
                    Content="{TemplateBinding ActionText}" Command="{TemplateBinding Command}"
                    c:Ui.Icon="{TemplateBinding ActionIcon}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ActionText" Value="{x:Null}">
              <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scroll bars that suit both themes. -->
  <Style x:Key="Bt.ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource Bt.Line}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Bt.Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
            <Track.Thumb>
              <Thumb Style="{StaticResource Bt.ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                <Track.Thumb>
                  <Thumb Style="{StaticResource Bt.ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Bt.Text}" />
    <Setter Property="Foreground" Value="{DynamicResource Bt.Bg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
</ResourceDictionary>
