<!--
  Bibliotaph dark theme: the mockup's bt-* CSS tokens (docs/bibliotaph-ui-mockups.html).
  Tokens.Light.xaml and Tokens.Dark.xaml must define the same keys. Use the brushes through DynamicResource
  so ThemeService can swap this dictionary at runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- bt-bg: Window and page background -->
  <Color x:Key="Bt.BgColor">#1d211f</Color>
  <SolidColorBrush x:Key="Bt.Bg" Color="#1d211f" />
  <!-- bt-panel: Raised surfaces: search box, cards, buttons -->
  <Color x:Key="Bt.PanelColor">#242925</Color>
  <SolidColorBrush x:Key="Bt.Panel" Color="#242925" />
  <!-- bt-side: Navigation rail and the title bar -->
  <Color x:Key="Bt.SideColor">#181d19</Color>
  <SolidColorBrush x:Key="Bt.Side" Color="#181d19" />
  <!-- bt-line: Hairlines and borders -->
  <Color x:Key="Bt.LineColor">#383f38</Color>
  <SolidColorBrush x:Key="Bt.Line" Color="#383f38" />
  <!-- bt-text: Body text -->
  <Color x:Key="Bt.TextColor">#e8ece6</Color>
  <SolidColorBrush x:Key="Bt.Text" Color="#e8ece6" />
  <!-- bt-muted: Secondary text and inactive icons -->
  <Color x:Key="Bt.MutedColor">#adb6ab</Color>
  <SolidColorBrush x:Key="Bt.Muted" Color="#adb6ab" />
  <!-- bt-accent: Primary buttons, focus rings, links -->
  <Color x:Key="Bt.AccentColor">#aec9a9</Color>
  <SolidColorBrush x:Key="Bt.Accent" Color="#aec9a9" />
  <!-- bt-accent-text: Text on the accent colour -->
  <Color x:Key="Bt.AccentTextColor">#1c3023</Color>
  <SolidColorBrush x:Key="Bt.AccentText" Color="#1c3023" />
  <!-- bt-soft: Hover and selected backgrounds -->
  <Color x:Key="Bt.SoftColor">#303e30</Color>
  <SolidColorBrush x:Key="Bt.Soft" Color="#303e30" />
  <!-- bt-warm: Warm highlights -->
  <Color x:Key="Bt.WarmColor">#433c30</Color>
  <SolidColorBrush x:Key="Bt.Warm" Color="#433c30" />
  <!-- Status dot: processing idle. Same in both modes, as in the mockup. -->
  <SolidColorBrush x:Key="Bt.StatusOk" Color="#76916b" />
  <SolidColorBrush x:Key="Bt.Shadow" Color="#40000000" />
</ResourceDictionary>
