<UserControl x:Class="Bibliotaph.App.Views.SessionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:catalog="clr-namespace:Bibliotaph.Catalog;assembly=Bibliotaph.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SessionDialogViewModel}"
             KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding Heading}">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,14,0,5" />
    </Style>

    <Style x:Key="Problem" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A pack in the picker: a row that adds to it when clicked or on Enter. -->
    <Style x:Key="ChoiceRow" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="10,7">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Side}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Side}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.15" />
    </Border.Effect>
    <StackPanel Margin="28,22,28,22">
      <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" VerticalAlignment="Top"
                ToolTip="Close (Esc)" AutomationProperties.Name="Close" Command="{Binding CancelCommand}" />
        <StackPanel>
          <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.H2}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <!-- New binder and Edit: a title and an optional date. A section: a name. -->
      <StackPanel Visibility="{Binding IsNaming, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Text="{Binding TitleLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TitleBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding TitleLabel}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <StackPanel Visibility="{Binding ShowsDate, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <TextBlock Text="Date played (optional)" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="DateBox" Style="{StaticResource Bt.TextBox}" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Date played" ToolTip="The date in your usual format. Upcoming binders list by it.">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Text="{Binding DateProblem}" Style="{StaticResource Problem}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
          <Button x:Name="SaveSession" Style="{StaticResource Bt.Button.Primary}" Content="{Binding ActionText}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Add to another binder: every pack, narrowed as you type. -->
      <StackPanel Visibility="{Binding IsPicking, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBox x:Name="FilterBox" Style="{StaticResource Bt.TextBox}" Margin="0,14,0,8" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Find a binder" ToolTip="Type part of a binder's title">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding PickFirstCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="SessionChoices" ItemsSource="{Binding Shown}" Focusable="False" AutomationProperties.Name="Binders"
                        KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type catalog:SessionPackInfo}">
                <Button Style="{StaticResource ChoiceRow}" AutomationProperties.Name="{Binding Title}"
                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <c:LucideIcon Data="{StaticResource Icon.NotebookTabs}" Size="14" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="No binder has that in its title." Style="{StaticResource Text.Small}" Margin="10,6,0,0"
                   Visibility="{Binding HasNoMatch, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Add pages…: From and To as the book numbers its pages, a label, and where they go. -->
      <StackPanel Visibility="{Binding IsPages, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="From page" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FromBox" Style="{StaticResource Bt.TextBox}" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From page">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="To page" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ToBox" Style="{StaticResource Bt.TextBox}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To page">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding PagesProblem}" Style="{StaticResource Problem}" />
        <TextBlock Text="Label" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="PagesLabel" Style="{StaticResource Bt.TextBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Label"
                 ToolTip="What you'll call these pages at the table, such as Warehouse ambush">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Binder" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="PackChoice" Style="{StaticResource Bt.Select}" ItemsSource="{Binding PackChoices}" SelectedItem="{Binding Pack}"
                      AutomationProperties.Name="Binder" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Where" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="SectionChoice" Style="{StaticResource Bt.Select}" ItemsSource="{Binding SectionChoices}" SelectedItem="{Binding Section}"
                      AutomationProperties.Name="Where in the binder" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
          <Button x:Name="AddPagesButton" Style="{StaticResource Bt.Button.Primary}" Content="{Binding ActionText}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
