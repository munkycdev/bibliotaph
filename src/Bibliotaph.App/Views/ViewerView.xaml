<UserControl x:Class="Bibliotaph.App.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:v="clr-namespace:Bibliotaph.App.Views"
             xmlns:viewer="clr-namespace:Bibliotaph.Viewer;assembly=Bibliotaph.Viewer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ViewerViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Key="F3" Command="{Binding Find.NextCommand}" />
    <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding Find.PreviousCommand}" />
    <!-- Ctrl and the + or - key on the main keyboard (with or without Shift) or the number pad, as in browsers. -->
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="NavigationCommands.IncreaseZoom" />
    <KeyBinding Key="OemPlus" Modifiers="Control+Shift" Command="NavigationCommands.IncreaseZoom" />
    <KeyBinding Key="Add" Modifiers="Control" Command="NavigationCommands.IncreaseZoom" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="NavigationCommands.DecreaseZoom" />
    <KeyBinding Key="Subtract" Modifiers="Control" Command="NavigationCommands.DecreaseZoom" />
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- A small text box in the toolbar: the page box and the find box. -->
    <Style x:Key="ToolBox" TargetType="TextBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome" Background="{DynamicResource Bt.Bg}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1"
                    CornerRadius="4" Padding="7,4" SnapsToDevicePixels="True">
              <Grid>
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Bt.Muted}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
              </Trigger>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource Bt.Line}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Style>
      <Style TargetType="Grid">
        <Setter Property="Margin" Value="0,0,42,24" />
        <Style.Triggers>
          <!-- A pop-out has no shell around it, and a binder frames the reader itself. -->
          <DataTrigger Binding="{Binding FitsFrame}" Value="True">
            <Setter Property="Margin" Value="0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- .bt-reader-head; Back is the shell's. -->
    <DockPanel Margin="0,0,0,16">
      <!-- Add page (slice 3c): the page in view to the current session; the arrow has Add pages… and the other sessions. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource Bt.CollapsedWhenTrue}}">
        <!-- A file whose first page is blank or a title sheet can show a better page on its card. -->
        <Button x:Name="UseAsCover" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Image}" Margin="0,0,8,0"
                Command="{Binding UseAsCoverCommand}" ToolTip="Use this page as the cover" ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="Use this page as the cover"
                Visibility="{Binding IsPdf, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <!-- An image in a pack can stand for the pack on its card, in place of the mosaic. -->
        <Button x:Name="UseAsPackCover" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Image}" Margin="0,0,8,0"
                Command="{Binding UseAsPackCoverCommand}" ToolTip="Use this image as the pack's cover"
                AutomationProperties.Name="Use this image as the pack's cover"
                Visibility="{Binding CanUseAsPackCover, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <!-- Mark as adventure (slice 5): pages of this file as an adventure with a card of its own. -->
        <Button x:Name="MarkPart" Content="Mark as adventure" c:Ui.Icon="{StaticResource Icon.BookOpen}" Margin="0,0,8,0"
                Command="{Binding MarkPagesCommand}" ToolTip="Give pages of this file a card of their own, as an adventure"
                AutomationProperties.Name="Mark pages as an adventure"
                Visibility="{Binding HasPages, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <!-- Note (slice 3f): a note on the page in view, or on the page with selected text. -->
        <Button x:Name="AddNote" Content="Note" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,0" Click="AddNote_Click"
                ToolTip="Add a note on the page in view" AutomationProperties.Name="Add a note on this page"
                Visibility="{Binding HasPages, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <Button x:Name="AddPage" Style="{StaticResource Bt.Button.Primary}" Content="Add page" c:Ui.Icon="{StaticResource Icon.Plus}"
                Command="{Binding AddPageCommand}" ToolTip="Add the page in view to the current binder"
                AutomationProperties.Name="Add page to binder" />
        <Button x:Name="AddPageMenu" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronDown}" Margin="2,0,0,0"
                ToolTip="Add pages, or add to another binder" AutomationProperties.Name="More ways to add to a binder" Click="AddPageMenu_Click">
          <Button.ContextMenu>
            <ContextMenu Style="{StaticResource Bt.Menu}" c:SessionMenu.Command="{Binding AddPageToSessionCommand}">
              <MenuItem x:Name="AddPagesItem" Header="Add pages…" Click="AddPages_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding Subtitle, Converter={StaticResource Bt.VisibleWhenSet}}" />
      </StackPanel>
    </DockPanel>

    <!-- .bt-reader-toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="6,6,0,0"
            Padding="9" Visibility="{Binding ShowEmptyState, Converter={StaticResource Bt.CollapsedWhenTrue}}">
      <!--
        Groups that wrap onto another row when the window is narrow (at 200% scaling, say), so nothing is cut off.
        Find comes last: on a wide window it sits at the end of the one row.
      -->
      <WrapPanel Margin="0,0,0,-4">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding HasPages, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasOutline, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.List}" ToolTip="Show or hide the contents"
                    AutomationProperties.Name="Contents" Command="{Binding ToggleOutlineCommand}" />
            <Border Style="{StaticResource Divider}" />
          </StackPanel>
          <!-- Page thumbnails along the bottom of the pages; hidden at launch, then kept as last left for the sitting. A PDF's only. -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsPdf, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button x:Name="ToggleStrip" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.PanelBottom}" c:Ui.IsActive="{Binding ShowStrip}"
                    ToolTip="{Binding StripAction}" AutomationProperties.Name="Page thumbnails" Command="{Binding ToggleStripCommand}" />
            <Border Style="{StaticResource Divider}" />
          </StackPanel>
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronLeft}" ToolTip="Previous page"
                  AutomationProperties.Name="Previous page" Command="{Binding PreviousPageCommand}" />
          <TextBlock Text="Page" FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" Margin="6,0" />
          <TextBox x:Name="PageBox" Style="{StaticResource ToolBox}" Width="54" HorizontalContentAlignment="Center"
                   Text="{Binding PageEntry, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Page"
                   ToolTip="A printed page number, or the page's place in the book" GotKeyboardFocus="PageBox_GotKeyboardFocus">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding GoToPageCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Text="{Binding PageCountText}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="6,0" />
          <!-- Opened from an adventure's card (slice 5): where the page in view is in it. -->
          <TextBlock x:Name="PartPosition" Text="{Binding PartPosition}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,6,0"
                     Visibility="{Binding IsPart, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronRight}" ToolTip="Next page"
                  AutomationProperties.Name="Next page" Command="{Binding NextPageCommand}" />
          <!-- After following a link in the book, as from its index: the way back to where it was clicked. -->
          <Button x:Name="BackFromLink" Style="{StaticResource Bt.Link}" Content="{Binding LinkBackLabel}" c:Ui.Icon="{StaticResource Icon.Undo2}"
                  Command="{Binding BackFromLinkCommand}" ToolTip="Go back to the page where you followed the link" VerticalAlignment="Center" Margin="6,0,0,0"
                  Visibility="{Binding HasLinkBack, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Border Style="{StaticResource Divider}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding HasPages, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <Button x:Name="ToggleNotes" Style="{StaticResource Bt.Link}" Content="{Binding Notes.Label}" c:Ui.Icon="{StaticResource Icon.NotebookPen}"
                  Command="{Binding ToggleNotesCommand}" ToolTip="Show or hide the notes on this book's pages" VerticalAlignment="Center" />
          <Border Style="{StaticResource Divider}" />
          <!-- Ask this book: only while AI is on (Ask plan, choice 12). -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding Ask.IsOn, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button x:Name="ToggleAsk" Style="{StaticResource Bt.Link}" Content="Ask" c:Ui.Icon="{StaticResource Icon.Sparkles}"
                    Command="{Binding ToggleAskCommand}" ToolTip="Ask this book a question" AutomationProperties.Name="Ask this book"
                    VerticalAlignment="Center" />
            <Border Style="{StaticResource Divider}" />
          </StackPanel>
        </StackPanel>
        <!-- A file from a pack, an image or a PDF: step through its files (F4 plan, choice 7). -->
        <StackPanel x:Name="PackSteps" Orientation="Horizontal" Margin="0,0,0,4">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsImage}" Value="True" />
                    <Condition Binding="{Binding IsInPack}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasPages}" Value="True" />
                    <Condition Binding="{Binding IsInPack}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronLeft}" ToolTip="{Binding PreviousStepTip}"
                  AutomationProperties.Name="{Binding PreviousStepName}" Command="{Binding PreviousImageCommand}" />
          <TextBlock Text="{Binding PackPosition}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="6,0"
                     AutomationProperties.Name="Place in pack" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronRight}" ToolTip="{Binding NextStepTip}"
                  AutomationProperties.Name="{Binding NextStepName}" Command="{Binding NextImageCommand}" />
          <Border Style="{StaticResource Divider}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Minus}" ToolTip="Zoom out (Ctrl+minus)"
                  AutomationProperties.Name="Zoom out" Command="NavigationCommands.DecreaseZoom" Margin="0,0,4,0" />
          <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding ZoomChoices}" SelectedValuePath="Value" SelectedValue="{Binding Zoom}"
                    AutomationProperties.Name="Zoom" ToolTip="Zoom (Ctrl+mouse wheel; Ctrl+0 fits the width again)" MinWidth="110" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Plus}" ToolTip="Zoom in (Ctrl+plus)"
                  AutomationProperties.Name="Zoom in" Command="NavigationCommands.IncreaseZoom" Margin="4,0,0,0" />
          <!-- The heart and the pin: the book, or the pack an image is in, as a favorite (slice 3 plan, choice 5) and in the sidebar. -->
          <Border Style="{StaticResource Divider}" />
          <Button x:Name="FavoriteButton" Style="{StaticResource Bt.HeartButton}" c:Ui.IsActive="{Binding IsFavorite}"
                  ToolTip="{Binding FavoriteAction}" AutomationProperties.Name="{Binding FavoriteAction}" Command="{Binding ToggleFavoriteCommand}" />
          <Button x:Name="PinButton" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pin}" c:Ui.IsActive="{Binding IsPinned}"
                  ToolTip="{Binding PinAction}" AutomationProperties.Name="{Binding PinAction}" Command="{Binding TogglePinCommand}" />
          <!-- Pop out: the book moves to a window of its own (one per monitor, say); a pop-out sends it back. A binder pops out whole instead. -->
          <Border Style="{StaticResource Divider}" Visibility="{Binding InBinder, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}"
                  ToolTip="Pop out into a window of its own" AutomationProperties.Name="Pop out" Command="{Binding PopOutCommand}"
                  Visibility="{Binding ShowsPopOut, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowDownLeft}"
                  ToolTip="Return to the main window" AutomationProperties.Name="Return to main window"
                  Command="{Binding ReturnToMainWindowCommand}"
                  Visibility="{Binding ShowsReturn, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </StackPanel>
        <!-- Find in book; what it found follows, and wraps on its own. -->
        <StackPanel Orientation="Horizontal" Margin="6,0,0,4" Visibility="{Binding HasPages, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <TextBox x:Name="FindBox" Style="{StaticResource ToolBox}" Width="180" Tag="Find in this book (Ctrl+F)"
                   Text="{Binding Find.Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find in this book">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding Find.FindCommand}" />
              <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding Find.PreviousCommand}" />
              <KeyBinding Key="Escape" Command="{Binding Find.ClearCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronLeft}" Margin="4,0,0,0"
                  ToolTip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match" Command="{Binding Find.PreviousCommand}" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ChevronRight}"
                  ToolTip="Next match (F3)" AutomationProperties.Name="Next match" Command="{Binding Find.NextCommand}" />
          <!-- Reading an adventure inside the file, Find looks in its pages unless this is ticked (slice 5). -->
          <CheckBox x:Name="FindWholeFile" Content="Whole file" IsChecked="{Binding Find.WholeFile}" Foreground="{DynamicResource Bt.Text}" FontSize="11"
                    VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Find in the whole file, not only this adventure's pages"
                    Visibility="{Binding IsPart, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </StackPanel>
        <TextBlock x:Name="FindStatus" Text="{Binding Find.Status}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="8,0,0,4"
                   Visibility="{Binding HasPages, Converter={StaticResource Bt.VisibleWhenTrue}}" />
      </WrapPanel>
    </Border>

    <!-- .bt-reader-stage -->
    <Border Grid.Row="2" Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1,0,1,1"
            Visibility="{Binding ShowEmptyState, Converter={StaticResource Bt.CollapsedWhenTrue}}">
      <DockPanel>
        <!-- Contents: the PDF's bookmarks, or the chapters the AI read when it has none, with what was found in each. -->
        <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,1,0"
                Visibility="{Binding OutlineVisible, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="CONTENTS" Style="{StaticResource Text.Eyebrow}" Margin="14,14,14,8" />
            <ListBox Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Outline}" AutomationProperties.Name="Contents"
                     c:ItemActivation.Command="{Binding OpenOutlineEntryCommand}" Padding="6,0,6,10"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Bt.PlainItem}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OutlineEntry}">
                  <!-- A bookmark inside the adventure being read stands out (slice 5); any can be indexed as an adventure. -->
                  <Border x:Name="Shade" BorderThickness="0">
                    <DockPanel x:Name="Row" Margin="{Binding Indent}" Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}">
                      <DockPanel.ContextMenu>
                        <ContextMenu Style="{StaticResource Bt.Menu}">
                          <MenuItem Header="Index as its own adventure…" Click="IndexBookmark_Click" />
                        </ContextMenu>
                      </DockPanel.ContextMenu>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Page}" Style="{StaticResource Text.Small}" Margin="8,5,6,5" VerticalAlignment="Top" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextTrimming="CharacterEllipsis"
                                   Margin="6,5,0,5" />
                        <!-- What the AI found reading this chapter: about the chapter, not the whole book. -->
                        <TextBlock Text="{Binding Found}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="6,-3,0,5"
                                   ToolTip="Found by the AI reading this chapter"
                                   Visibility="{Binding HasFound, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding InPart}" Value="True">
                      <Setter TargetName="Shade" Property="Background" Value="{DynamicResource Bt.Soft}" />
                      <Setter TargetName="Shade" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                      <Setter TargetName="Shade" Property="BorderThickness" Value="2,0,0,0" />
                    </DataTrigger>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bt.Soft}" />
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <!-- Ask this book (Ask plan): a question, the answer with its citations as links, and the pages it was read from, each opening its page. -->
        <Border x:Name="AskPanel" DockPanel.Dock="Right" Width="320" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                BorderThickness="1,0,0,0" DataContext="{Binding Ask}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.AskVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    <Condition Binding="{Binding DataContext.HasPages, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    <Condition Binding="{Binding IsOn}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="14,14,14,12">
              <TextBlock Text="ASK THIS BOOK" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,8" />
              <TextBox x:Name="AskBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                       AutomationProperties.Name="Your question about this book" ToolTip="Ask about something in this book, then press Enter">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <DockPanel Margin="0,8,0,0">
                <Button x:Name="AskButton" DockPanel.Dock="Left" Style="{StaticResource Bt.Button.Primary}" Content="Ask" Command="{Binding AskCommand}"
                        AutomationProperties.Name="Ask" />
                <Button x:Name="AskStop" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Stop" Command="{Binding StopCommand}"
                        ToolTip="Stop the answer here" AutomationProperties.Name="Stop answering"
                        Visibility="{Binding IsAnswering, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock x:Name="AskStep" Text="{Binding Step}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding Step, Converter={StaticResource Bt.VisibleWhenSet}}" />
              </DockPanel>
              <!-- The book's conversation so far (Ask plan, Q3), and New conversation to start again. -->
              <DockPanel Margin="0,14,0,0" Visibility="{Binding CanStartOver, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <Button x:Name="AskNewConversation" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="New conversation"
                        Command="{Binding NewConversationCommand}" ToolTip="Forget the questions asked of this book so far, and start again"
                        AutomationProperties.Name="Start a new conversation" />
                <TextBlock Text="Earlier in this conversation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Muted}" VerticalAlignment="Center"
                           Visibility="{Binding HasHistory, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              </DockPanel>
              <ItemsControl x:Name="AskHistory" ItemsSource="{Binding History}" Focusable="False" AutomationProperties.Name="Earlier in this conversation"
                            KeyboardNavigation.TabNavigation="Continue" Margin="0,6,0,0" Visibility="{Binding HasHistory, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:AskTurnRow}">
                    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Question}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LookedFor}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding LookedFor, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <TextBlock c:AnswerText.Parts="{Binding Answer}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   c:AnswerText.Command="{Binding DataContext.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Asked}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,14,0,0"
                         Visibility="{Binding Asked, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <TextBlock x:Name="AskLookedFor" Text="{Binding LookedFor}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                         Visibility="{Binding LookedFor, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <!-- The answer, checked as it streams: each [p. N] opens its page; a quotation not on its page is in italics, without its marks. -->
              <TextBlock x:Name="AskAnswer" c:AnswerText.Parts="{Binding Answer}" c:AnswerText.Command="{Binding OpenCitationCommand}" FontSize="13"
                         Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" AutomationProperties.Name="The answer"
                         Visibility="{Binding HasAnswer, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock x:Name="AskMessage" Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding Message, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <TextBlock x:Name="AskPassagesHeading" Text="{Binding PassagesHeading}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Muted}"
                         TextWrapping="Wrap" Margin="0,14,0,6" Visibility="{Binding HasPassages, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <ItemsControl x:Name="AskPassages" ItemsSource="{Binding Passages}" Focusable="False" AutomationProperties.Name="Pages that look like they answer it"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:AskPassageRow}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <StackPanel>
                        <Button x:Name="AskPassageLink" Style="{StaticResource Bt.Link}" Content="{Binding Link}" HorizontalAlignment="Left"
                                ToolTip="Open this page, with the matching word marked" AutomationProperties.Name="{Binding AccessibleName}"
                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Found}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="AskMeaning" Text="{Binding MeaningText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding MeaningText, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <TextBlock x:Name="AskCoverage" Text="{Binding CoverageText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Visibility="{Binding CoverageText, Converter={StaticResource Bt.VisibleWhenSet}}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <!-- Notes on this book's pages (slice 3f): each goes to its pages, and can be changed or deleted. -->
        <Border x:Name="NotesPanel" DockPanel.Dock="Right" Width="280" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                BorderThickness="1,0,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding NotesVisible}" Value="True" />
                    <Condition Binding="{Binding HasPages}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="NOTES ON ITS PAGES" Style="{StaticResource Text.Eyebrow}" Margin="14,14,14,8" />
            <TextBlock DockPanel.Dock="Top" Text="No notes yet. Note adds one on the page in view." Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                       Margin="14,0,14,0" Visibility="{Binding Notes.HasNotes, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl x:Name="ReaderPageNotes" ItemsSource="{Binding Notes.Items}" Focusable="False" AutomationProperties.Name="Notes on its pages"
                            KeyboardNavigation.TabNavigation="Continue" Margin="10,0,10,10">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PageNoteRow}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel>
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="EditNote" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}" MinWidth="24" MinHeight="24" Padding="3"
                                    ToolTip="Change this note" AutomationProperties.Name="Change this note"
                                    Command="{Binding DataContext.Notes.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button x:Name="DeleteNote" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Trash2}" MinWidth="24" MinHeight="24" Padding="3"
                                    ToolTip="Delete this note" AutomationProperties.Name="Delete this note"
                                    Command="{Binding DataContext.Notes.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          </StackPanel>
                          <Button x:Name="GoToNote" Style="{StaticResource Bt.Link}" Content="{Binding Pages}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ToolTip="Go to these pages" AutomationProperties.Name="{Binding Pages, StringFormat='Go to {0}'}"
                                  Command="{Binding DataContext.Notes.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding HasReason, Converter={StaticResource Bt.VisibleWhenTrue}}">
                          <c:LucideIcon x:Name="NoteReasonIcon" Data="{StaticResource Icon.TriangleAlert}" Size="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter TargetName="NoteReasonIcon" Property="Foreground" Value="{DynamicResource Bt.Accent}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <!--
          Page thumbnails: a picture of every page, scrolled sideways (the wheel too) and opened with a click or Enter. The
          page in view is outlined, a page with notes has a badge, and a binder item's pages have a bar over them. Only the
          thumbnails near the strip's view are drawn, after the pages on screen.
        -->
        <Border x:Name="StripPanel" DockPanel.Dock="Bottom" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0"
                Visibility="{Binding StripVisible, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <ListBox x:Name="PageStrip" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Strip.Pages}" AutomationProperties.Name="Page thumbnails"
                   c:ItemActivation.Command="{Binding Strip.GoToPageCommand}" Padding="6,2,6,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   VirtualizingPanel.ScrollUnit="Item" VirtualizingPanel.CacheLength="4" VirtualizingPanel.CacheLengthUnit="Item"
                   ScrollViewer.ScrollChanged="PageStrip_ScrollChanged" PreviewMouseWheel="PageStrip_PreviewMouseWheel">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource Bt.PlainItem}">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                <Setter Property="Margin" Value="3,4,3,4" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PageThumbnail}">
                <StackPanel x:Name="Thumb" Width="{Binding Width}" Margin="3,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding AccessibleName}">
                  <!-- Over the pages of the binder item in hand. -->
                  <Border x:Name="ItemBar" Height="3" CornerRadius="1.5" Margin="0,0,0,3" Background="Transparent" />
                  <Border x:Name="Frame" Height="{Binding Height}" Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}"
                          BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
                    <Grid>
                      <TextBlock Text="{Binding Page}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      <Border x:Name="NoteBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Width="18" Height="18" CornerRadius="9"
                              Background="{DynamicResource Bt.Accent}" Visibility="{Binding HasNotes, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <c:LucideIcon Data="{StaticResource Icon.NotebookPen}" Size="11" Foreground="{DynamicResource Bt.AccentText}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock x:Name="Number" Text="{Binding Page}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Bt.Muted}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding InItem}" Value="True">
                    <Setter TargetName="ItemBar" Property="Background" Value="{DynamicResource Bt.Accent}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Bt.Text}" />
                    <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <Grid>
          <viewer:PdfPagesView x:Name="PagesView" Zoom="{Binding Zoom}" CanCopy="{Binding CanCopy}"
                               Visibility="{Binding IsPdf, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <!-- An e-book's reader page: its text and pictures in a column, its pages marked in it. -->
          <v:EbookView x:Name="EbookSurface" Visibility="{Binding IsEbook, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <viewer:ImageView x:Name="ImageSurface" Source="{Binding Image}" Zoom="{Binding Zoom}"
                            Visibility="{Binding IsImage, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock Text="Opening…" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding IsOpening, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <!-- A session item's pages weren't where they were (choice 14), and what Add page did, with Undo. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="18,14,18,0" MaxWidth="560">
            <Border x:Name="SessionBanner" Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Warm}" BorderThickness="1" CornerRadius="6"
                    Padding="14,10" Margin="0,0,0,8" Visibility="{Binding SessionBanner, Converter={StaticResource Bt.VisibleWhenSet}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" Margin="8,0,0,0"
                        ToolTip="Hide" AutomationProperties.Name="Hide" Command="{Binding DismissSessionBannerCommand}" VerticalAlignment="Top" />
                <Button x:Name="UsePage" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Use this page" Padding="12,0,0,0"
                        Command="{Binding UsePageCommand}" VerticalAlignment="Center"
                        Visibility="{Binding CanUsePage, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock Text="{Binding SessionBanner}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Border Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="6" Padding="14,10"
                    Visibility="{Binding Sessions.Undo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" Margin="8,0,0,0"
                        ToolTip="Hide" AutomationProperties.Name="Hide" Command="{Binding DismissSessionMessageCommand}" />
                <Button x:Name="UndoSession" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                        Command="{Binding Sessions.Undo.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo" VerticalAlignment="Center"
                        Visibility="{Binding Sessions.Undo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock x:Name="SessionMessage" Text="{Binding Sessions.Undo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <!-- What the last page note change did, with Undo. -->
            <Border Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,8,0,0"
                    Visibility="{Binding Notes.Undo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" Margin="8,0,0,0"
                        ToolTip="Hide" AutomationProperties.Name="Hide" Command="{Binding Notes.DismissMessageCommand}" />
                <Button x:Name="UndoNote" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                        Command="{Binding Notes.Undo.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the note change" VerticalAlignment="Center"
                        Visibility="{Binding Notes.Undo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock x:Name="NoteMessage" Text="{Binding Notes.Undo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </StackPanel>
          <!-- A short message over the pages, such as why Copy did nothing. -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="12,8" CornerRadius="5"
                  Background="{DynamicResource Bt.Text}" IsHitTestVisible="False"
                  Visibility="{Binding Notice, Converter={StaticResource Bt.VisibleWhenSet}}">
            <TextBlock Text="{Binding Notice}" FontSize="11" Foreground="{DynamicResource Bt.Bg}" TextWrapping="Wrap" MaxWidth="460" />
          </Border>
        </Grid>
      </DockPanel>
    </Border>

    <!-- .bt-reader-foot -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding IsPdf, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CopyNote}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
      <TextBlock Text="{Binding PositionText, ElementName=PagesView}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" Focusable="False"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <c:EmptyState Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}" ActionText="{Binding EmptyActionText}" Command="{Binding EmptyCommand}"
                    SecondaryText="{Binding EmptySecondaryText}" SecondaryCommand="{Binding EmptySecondaryCommand}" />
    </ScrollViewer>

    <!-- Add pages… and naming a new session, as a dialog over the reader. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="4" Visibility="{Binding Sessions.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:SessionDialogView x:Name="SessionDialog" DataContext="{Binding Sessions.Dialog}" MaxWidth="480" Margin="0,24,0,24" VerticalAlignment="Top" />
      </ScrollViewer>
    </Grid>

    <!-- A note on pages (slice 3f), as a dialog over the reader. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="4" Visibility="{Binding Notes.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:PageNoteDialogView x:Name="PageNoteDialog" DataContext="{Binding Notes.Dialog}" MaxWidth="480" Margin="0,24,0,24" VerticalAlignment="Top" />
      </ScrollViewer>
    </Grid>

    <!-- Pages marked as an adventure (slice 5), as a dialog over the reader. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="4" Visibility="{Binding PartEditor, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Background="{DynamicResource Bt.Shadow}" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:PartEditorView x:Name="PartEditorDialog" DataContext="{Binding PartEditor}" MaxWidth="480" Margin="0,24,0,24" VerticalAlignment="Top" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
