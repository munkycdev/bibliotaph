<UserControl x:Class="Bibliotaph.App.Views.DownloadCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DownloadCheckViewModel}">
  <!-- Check a download (F5b): a folder or ZIP checked against the library, grouped by verdict, New first. -->
  <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,42,24">
    <TextBlock Text="Check a download." Style="{StaticResource Text.H1}" />
    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,9,0,24" TextWrapping="Wrap"
               Text="See which files in a folder or ZIP you already have before you copy them anywhere. Nothing is copied, moved or added to your library." />

    <WrapPanel>
      <Button x:Name="CheckFolder" Content="Check a folder…" c:Ui.Icon="{StaticResource Icon.Folder}" Style="{StaticResource Bt.Button.Primary}"
              Command="{Binding CheckFolderCommand}" Margin="0,0,8,8" />
      <Button x:Name="CheckZip" Content="Check a ZIP…" Command="{Binding CheckZipCommand}" Margin="0,0,8,8" />
      <Button x:Name="StopCheck" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,8"
              Visibility="{Binding IsRunning, Converter={StaticResource Bt.VisibleWhenTrue}}" />
      <Button x:Name="CopyList" Content="Copy list" Command="{Binding CopyListCommand}" Margin="0,0,8,8"
              ToolTip="The results as text, one file a line: verdict, file and the book it matched"
              Visibility="{Binding HasResults, Converter={StaticResource Bt.VisibleWhenTrue}}" />
    </WrapPanel>

    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTarget, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Row}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
      <TextBlock x:Name="CheckProgress" Text="{Binding Progress}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{DynamicResource Bt.Text}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Visibility="{Binding HasProblem, Converter={StaticResource Bt.VisibleWhenTrue}}" />
      <TextBlock Text="{Binding Copied}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,4,0,0"
                 Visibility="{Binding Copied, Converter={StaticResource Bt.VisibleWhenSet}}" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.Name="Check results">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:CheckGroupViewModel}">
          <StackPanel Margin="0,24,0,0">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.H2}" />
            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}" Margin="0,4,0,8" TextWrapping="Wrap" />
            <Border Style="{StaticResource Bt.Rule}" />
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" AutomationProperties.Name="{Binding Label}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CheckResultViewModel}">
                  <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Button Style="{StaticResource Bt.Link}" Content="Open the book" Command="{Binding OpenBookCommand}" Margin="0,0,16,0"
                                Visibility="{Binding CanOpen, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Open the book {0} matched'}" />
                        <Button Style="{StaticResource Bt.Link}" Content="Show in folder" Command="{Binding ShowInFolderCommand}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in File Explorer'}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
