<Window x:Class="Bibliotaph.App.Views.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Bibliotaph.App.Controls"
        xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
        xmlns:views="clr-namespace:Bibliotaph.App.Views"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Assets/Bibliotaph.ico"
        Width="960" Height="900" MinWidth="560" MinHeight="420"
        Background="{DynamicResource Bt.Bg}"
        Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <!--
    A pop-out reader, or a binder: the reader and its toolbar, with the binder's pages and notes around it; search and
    the library stay in the main window. Esc never closes the window (a reader's Esc clears find, set in code); Ctrl+W
    or the close button does.
  -->
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+W" Command="ApplicationCommands.Close" />
    <KeyBinding Gesture="Ctrl+K" Command="{x:Static c:ShellCommands.FocusSearch}" />
    <KeyBinding Key="OemQuestion" Modifiers="Control" Command="{x:Static c:ShellCommands.ShowShortcuts}" />
    <KeyBinding Key="Divide" Modifiers="Control" Command="{x:Static c:ShellCommands.ShowShortcuts}" />
  </Window.InputBindings>

  <!-- The app's templates pick the view: a reader's, or a binder's. -->
  <ContentControl x:Name="Host" Content="{Binding}" Focusable="False" />
</Window>
