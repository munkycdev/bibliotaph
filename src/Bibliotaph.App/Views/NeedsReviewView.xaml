<UserControl x:Class="Bibliotaph.App.Views.NeedsReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:v="clr-namespace:Bibliotaph.App.Views"
             xmlns:p="clr-namespace:Bibliotaph.Processing;assembly=Bibliotaph.Processing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NeedsReviewViewModel}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- .bt-reviewitem -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,15,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bt.Line}" />
      <Setter Property="Background" Value="{DynamicResource Bt.Panel}" />
    </Style>

    <!-- A book's title that opens it, at the evidence's page. -->
    <Style x:Key="TitleLink" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Background="Transparent" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Opens a card's book in a window of its own, so the card can be decided with the book beside it. -->
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource Bt.IconButton}">
      <Setter Property="c:Ui.Icon" Value="{StaticResource Icon.SquareArrowOutUpRight}" />
      <Setter Property="ToolTip" Value="Open in a window beside this page (Shift+Enter)" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Margin" Value="8,-4,0,0" />
    </Style>

    <!-- An offer card's ×: the card's own "don't ask again" answer, folded to its line with Undo like any answer. -->
    <Style x:Key="DismissButton" TargetType="Button" BasedOn="{StaticResource Bt.IconButton}">
      <Setter Property="c:Ui.Icon" Value="{StaticResource Icon.X}" />
      <Setter Property="Command" Value="{Binding DismissCommand}" />
      <Setter Property="ToolTip" Value="Close. Bibliotaph won't suggest this again, and Undo brings it back." />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat='Close the suggestion for {0}'}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Margin" Value="8,-8,-10,0" />
    </Style>

    <!-- A decided card: what happened, and Undo. -->
    <DataTemplate x:Key="Decided" DataType="{x:Type vm:DecidedCardViewModel}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" Command="{Binding UndoCommand}"
                VerticalAlignment="Center" Padding="12,0,0,0" />
        <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Check}" Size="14" Foreground="{DynamicResource Bt.Muted}"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{Binding DoneText}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ReviewCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <DockPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}" />
          </DockPanel>

          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <!-- .bt-reviewtitle -->
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding FieldLabel}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenInWindowCommand}" ToolTip="Open the book"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
            </DockPanel>
            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />

            <!-- .bt-reviewcompare -->
            <Grid Margin="0,16,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource Bt.Side}" CornerRadius="5" Padding="12">
                <StackPanel>
                  <TextBlock Text="{Binding CurrentLabel}" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding CurrentText}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CurrentSource}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                             Visibility="{Binding CurrentSource, Converter={StaticResource Bt.VisibleWhenSet}}" />
                </StackPanel>
              </Border>
              <c:LucideIcon Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Size="15" Foreground="{DynamicResource Bt.Muted}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasSuggestion, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <Border Grid.Column="2" Background="{DynamicResource Bt.Soft}" CornerRadius="5" Padding="12"
                      Visibility="{Binding HasSuggestion, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <StackPanel>
                  <TextBlock Text="{Binding SuggestedLabel}" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding SuggestedText}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <DockPanel Margin="0,0,0,16" Visibility="{Binding HasEvidence, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.TextSearch}" Size="13" Foreground="{DynamicResource Bt.Muted}"
                            VerticalAlignment="Top" Margin="0,1,8,0" />
              <TextBlock FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" LineHeight="18">
                <Run Text="{Binding Evidence, Mode=OneWay}" />
                <Run Text="{Binding PageText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
              </TextBlock>
            </DockPanel>

            <!-- Edit: what the inspector's editor does, in the card. -->
            <StackPanel Margin="0,0,0,4" Visibility="{Binding IsEditing, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="Your value" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{Binding FieldLabel, StringFormat='{}{0}, your value'}" c:Ui.FocusWhenVisible="True">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="{Binding EditHint}" Style="{StaticResource Text.Small}" Margin="0,5,0,0"
                         Visibility="{Binding EditHint, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,5,0,0"
                         Visibility="{Binding Resolution, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Choices}" SelectedItem="{Binding PickedChoice}" Margin="0,10,0,0"
                        AutomationProperties.Name="Pick from the list" HorizontalAlignment="Left" MinWidth="240" MaxDropDownHeight="320"
                        Visibility="{Binding UsesChoices, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource Bt.Button.Primary}" Content="Save" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- .bt-inline -->
            <WrapPanel Visibility="{Binding IsEditing, Converter={StaticResource Bt.CollapsedWhenTrue}}">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="Accept" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding AcceptCommand}"
                      Margin="0,0,8,0" Visibility="{Binding CanAccept, Converter={StaticResource Bt.VisibleWhenTrue}}"
                      AutomationProperties.Name="{Binding SuggestedText, StringFormat='Accept {0}'}" />
              <Button Content="{Binding AcceptAllLabel}" Command="{Binding AcceptAllCommand}" Margin="0,0,8,0" ToolTip="{Binding AcceptAllHint}"
                      Visibility="{Binding CanAcceptAll, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <Button Content="{Binding EditLabel}" c:Ui.Icon="{StaticResource Icon.Pencil}" Command="{Binding EditCommand}" Margin="0,0,8,0" />
              <Button Content="{Binding RejectLabel}" Command="{Binding RejectCommand}" ToolTip="{Binding RejectHint}"
                      Visibility="{Binding CanReject, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TermCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Chip}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
            <DockPanel Margin="0,14,0,0" Visibility="{Binding HasExample, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.TextSearch}" Size="13" Foreground="{DynamicResource Bt.Muted}"
                            VerticalAlignment="Top" Margin="0,1,8,0" />
              <TextBlock Text="{Binding Example}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="{Binding AddLabel}" c:Ui.Icon="{StaticResource Icon.Plus}"
                      Command="{Binding AddCommand}" Margin="0,0,8,8" />
              <Button Content="Reject" Command="{Binding RejectCommand}" Margin="0,0,16,8" ToolTip="Not a useful name; it won't be suggested again" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Label"
                          MinWidth="180" MaxDropDownHeight="320" AutomationProperties.Name="{Binding Label, StringFormat='File {0} under'}"
                          ToolTip="Another name for an existing term" Margin="0,0,8,0" />
                <Button Content="File under it" Command="{Binding MapCommand}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A file that looks like a new version of a book (F2): make it current, keep it as a copy, or a separate book. -->
    <DataTemplate DataType="{x:Type vm:VersionCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="New version?" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenFileInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenFileInWindowCommand}" ToolTip="Open this file"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
            </DockPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}" Visibility="{Binding Path, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <DockPanel Margin="0,14,0,0">
              <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.TextSearch}" Size="13" Foreground="{DynamicResource Bt.Muted}"
                            VerticalAlignment="Top" Margin="0,1,8,0" />
              <StackPanel>
                <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Style="{StaticResource Bt.Link}" Content="Open the book" Command="{Binding OpenBookCommand}" CommandParameter="{Binding}"
                          c:NewWindowGesture.Command="{Binding OpenBookInWindowCommand}" ToolTip="{Binding BookPath}" VerticalAlignment="Center" />
                  <Button Style="{StaticResource WindowButton}" Command="{Binding OpenBookInWindowCommand}" VerticalAlignment="Center" Margin="4,0,0,0"
                          AutomationProperties.Name="Open the book in a window" />
                </StackPanel>
              </StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,16,0,0">
              <!-- Neither file is the likelier current one, so no choice stands out (a dark first button read as already chosen),
                   and each names its file. -->
              <Button Content="{Binding MakeCurrentLabel}" Command="{Binding MakeCurrentCommand}" Margin="0,0,8,8" ToolTip="{Binding MakeCurrentHint}" />
              <Button Content="{Binding KeepAsCopyLabel}" Command="{Binding KeepAsCopyCommand}" Margin="0,0,8,8" ToolTip="{Binding KeepAsCopyHint}" />
              <Button Content="Separate book" Command="{Binding SeparateBookCommand}" Margin="0,0,8,8" ToolTip="{x:Static p:VersionCardText.SeparateHint}" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A new version of a book whose places need a look (slice 4h): those that do, each with Open and Use this page, and those found. -->
    <DataTemplate DataType="{x:Type vm:RevisionCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="New version" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenBookInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button x:Name="OpenRevisedBook" Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenBookCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenBookInWindowCommand}" ToolTip="Open the new version"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
            </DockPanel>
            <TextBlock x:Name="RevisionHeading" Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}" Visibility="{Binding Path, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <ItemsControl x:Name="RevisionPlaces" ItemsSource="{Binding Rows}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="Places to check"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RevisionRowViewModel}">
                  <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" AutomationProperties.Name="{Binding Heading}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="OpenPlace" Style="{StaticResource Bt.Link}" Content="Open" Command="{Binding OpenCommand}" CommandParameter="{Binding}"
                                c:NewWindowGesture.Command="{Binding OpenInWindowCommand}"
                                ToolTip="Open the new version at this page" AutomationProperties.Name="{Binding OpenName}" />
                        <Button x:Name="OpenPlaceInWindow" Style="{StaticResource WindowButton}" Command="{Binding OpenInWindowCommand}" VerticalAlignment="Center"
                                Margin="4,0,12,0" AutomationProperties.Name="{Binding OpenInWindowName}" />
                        <Button x:Name="UsePlace" Style="{StaticResource Bt.Link}" Content="Use this page" Command="{Binding UseCommand}"
                                ToolTip="This place opens at the page suggested from now on" AutomationProperties.Name="{Binding UseName}"
                                Visibility="{Binding CanUse, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                        <Button x:Name="UndoPlace" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding UndoUseCommand}"
                                AutomationProperties.Name="{Binding UndoName}" Visibility="{Binding CanUndoUse, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                      </StackPanel>
                      <c:LucideIcon x:Name="PlaceIcon" DockPanel.Dock="Left" Data="{StaticResource Icon.TriangleAlert}" Size="13" Foreground="{DynamicResource Bt.Accent}"
                                    VerticalAlignment="Top" Margin="0,1,8,0" />
                      <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                      <Setter TargetName="PlaceIcon" Property="Data" Value="{StaticResource Icon.Check}" />
                      <Setter TargetName="PlaceIcon" Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasFound, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="Found their page, nothing to do:" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Found}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,2">
                      <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Check}" Size="11" Foreground="{DynamicResource Bt.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding FoundMore}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="17,0,0,0"
                         Visibility="{Binding HasFoundMore, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A file with the title of a book owned elsewhere (F5a): Same book puts the file on the book's card. -->
    <DataTemplate DataType="{x:Type vm:ElsewhereCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Owned elsewhere" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenFileInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenFileInWindowCommand}" ToolTip="Open this file"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
            </DockPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}" Visibility="{Binding Path, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="Same book" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding SameBookCommand}" Margin="0,0,8,8"
                      ToolTip="One card: the book you own elsewhere, now opening this file. What you set on it stays." />
              <Button Content="Separate book" Command="{Binding SeparateBookCommand}" Margin="0,0,8,8"
                      ToolTip="Two cards, as now. Bibliotaph won't ask about these two again." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Cataloged wrong… left without a change (scenario review, row 8): Fix it opens the book's details to correct again. -->
    <DataTemplate DataType="{x:Type vm:CorrectionCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Cataloged wrong" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenFileInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenFileInWindowCommand}" ToolTip="Open this book"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
            </DockPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="FixIt" Style="{StaticResource Bt.Button.Primary}" Content="Fix it" c:Ui.Icon="{StaticResource Icon.Pencil}"
                      Command="{Binding FixItCommand}" Margin="0,0,8,8" AutomationProperties.Name="{Binding Title, StringFormat='Fix {0}'}"
                      ToolTip="Open its details, with the values Bibliotaph guessed marked" />
              <Button x:Name="ItsFine" Content="It's fine now" Command="{Binding ItsFineCommand}" Margin="0,0,8,8"
                      ToolTip="Leave it as it is, and take this card away" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A proposed folder rule (scenario review, row 8): the same value set on several books from one folder. -->
    <DataTemplate DataType="{x:Type vm:FolderRuleCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Button x:Name="DismissRule" Style="{StaticResource DismissButton}" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Folder rule?" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding ShowFolderCommand}" ToolTip="Show in File Explorer"
                      AutomationProperties.Name="{Binding FolderName, StringFormat='Show {0} in File Explorer'}" />
            </DockPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="UseRule" Style="{StaticResource Bt.Button.Primary}" Content="Use this rule" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding UseRuleCommand}" Margin="0,0,8,8" ToolTip="Suggest this for every file in the folder, new ones too" />
              <Button x:Name="NoRule" Content="No thanks" Command="{Binding NoRuleCommand}" Margin="0,0,8,8"
                      ToolTip="No rule. Bibliotaph won't suggest this one again." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A folder that could be a collection: Accept, Not now and Never. -->
    <DataTemplate DataType="{x:Type vm:FolderCollectionCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Button x:Name="DismissFolderCollection" Style="{StaticResource DismissButton}" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Collection?" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding ShowFolderCommand}" ToolTip="Show in File Explorer"
                      AutomationProperties.Name="{Binding Title, StringFormat='Show {0} in File Explorer'}" />
            </DockPanel>
            <TextBlock x:Name="FolderCollectionHeading" Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="AcceptFolderCollection" Style="{StaticResource Bt.Button.Primary}" Content="Accept" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding AcceptCommand}" Margin="0,0,8,8" ToolTip="Make the collection, with this folder's books" />
              <Button Content="Not now" Command="{Binding NotNowCommand}" Margin="0,0,8,8" ToolTip="Ask again the next time this list is made" />
              <Button Content="Never" Command="{Binding NeverCommand}" Margin="0,0,8,8" ToolTip="No collection. Bibliotaph won't ask about this folder again." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Books that could join a collection: the books, each opening, with Accept, Not now and Never. -->
    <DataTemplate DataType="{x:Type vm:CollectionSuggestionCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Button x:Name="DismissSuggestion" Style="{StaticResource DismissButton}" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Add to collection?" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="SuggestionHeading" Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding Books}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="Books suggested">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Style="{StaticResource Bt.Link}" Content="{Binding Title}" ToolTip="Open this book" VerticalAlignment="Center"
                            Command="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            c:NewWindowGesture.Command="{Binding DataContext.OpenBookInWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
                    <Button Style="{StaticResource WindowButton}" VerticalAlignment="Center" Margin="4,0,0,0"
                            Command="{Binding DataContext.OpenBookInWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="AcceptSuggestion" Style="{StaticResource Bt.Button.Primary}" Content="Accept" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding AcceptCommand}" Margin="0,0,8,8" ToolTip="Add these books to the collection" />
              <Button Content="Not now" Command="{Binding NotNowCommand}" Margin="0,0,8,8" ToolTip="Ask again the next time this list is made" />
              <Button Content="Never" Command="{Binding NeverCommand}" Margin="0,0,8,8"
                      ToolTip="Bibliotaph won't suggest these books for this collection again" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A file that looks like a compilation (slice 5b): its adventures, ticked, with Accept, Edit and Not split. -->
    <DataTemplate DataType="{x:Type vm:PartProposalCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Button x:Name="DismissParts" Style="{StaticResource DismissButton}" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Chip}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenFileInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenFileInWindowCommand}" ToolTip="Open this file"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}" />
            </DockPanel>
            <TextBlock x:Name="ProposalHeading" Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="Adventures proposed">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProposedPartRow}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,10,0"
                              AutomationProperties.Name="{Binding Title, StringFormat='Make a card for {0}'}" />
                    <StackPanel Grid.Column="1">
                      <StackPanel Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bt.CollapsedWhenTrue}}">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                      </StackPanel>
                      <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adventure title" />
                        <TextBox Grid.Column="1" Style="{StaticResource Bt.TextBox}" Margin="8,0,0,0" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="First page" ToolTip="First page, as the file numbers it" />
                        <TextBox Grid.Column="2" Style="{StaticResource Bt.TextBox}" Margin="8,0,0,0" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Last page" ToolTip="Last page, as the file numbers it" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Warm}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="AcceptParts" Style="{StaticResource Bt.Button.Primary}" Content="{Binding AcceptLabel}" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding AcceptCommand}" Margin="0,0,8,8" AutomationProperties.Name="Accept: make cards for the ticked adventures"
                      ToolTip="Give each ticked adventure a card of its own. The file isn't changed." />
              <Button x:Name="EditParts" Content="Edit" c:Ui.Icon="{StaticResource Icon.Pencil}" Command="{Binding EditCommand}" Margin="0,0,8,8"
                      ToolTip="Change the adventures' titles and pages" AutomationProperties.Name="Edit the adventures' titles and pages" />
              <Button x:Name="NotSplit" Content="Not split" Command="{Binding NotSplitCommand}" Margin="0,0,8,8"
                      ToolTip="It's one book. Bibliotaph won't ask about this file again." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- An adventure inside a file whose pages weren't found in the file as it is now (slice 5): set its pages, or remove it. -->
    <DataTemplate DataType="{x:Type vm:UnplacedPartCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Adventure in a file" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource WindowButton}" Command="{Binding OpenFileInWindowCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in a window'}" />
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding}"
                      c:NewWindowGesture.Command="{Binding OpenFileInWindowCommand}" ToolTip="Open its file"
                      AutomationProperties.Name="{Binding Title, StringFormat='Open the file {0} is in'}" />
            </DockPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Border Margin="0,12,0,0" Visibility="{Binding Editor, Converter={StaticResource Bt.VisibleWhenSet}}">
              <v:PartEditorView DataContext="{Binding Editor}" />
            </Border>
            <WrapPanel Margin="0,16,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Bt.CollapsedWhenTrue}}">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="Set its pages" c:Ui.Icon="{StaticResource Icon.Pencil}"
                      Command="{Binding SetPagesCommand}" Margin="0,0,8,8" ToolTip="Type its first and last pages as the file numbers them" />
              <Button Content="Remove adventure" Command="{Binding RemovePartCommand}" Margin="0,0,8,8"
                      ToolTip="Its card goes; its pages are only the file's again. Undo brings it back." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A smaller or mixed folder of images (F4): make it one card, or keep its images separate. -->
    <DataTemplate DataType="{x:Type vm:PackCardViewModel}">
      <Border Style="{StaticResource Card}">
        <Grid>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Decided}"
                            Visibility="{Binding IsDone, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <DockPanel>
              <Button x:Name="DismissPack" Style="{StaticResource DismissButton}" />
              <Border DockPanel.Dock="Right" Style="{StaticResource Bt.Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Image pack?" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
              </Border>
              <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" Command="{Binding ShowFolderCommand}" ToolTip="Show in File Explorer"
                      AutomationProperties.Name="{Binding Title, StringFormat='Show {0} in File Explorer'}" />
            </DockPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Path}" />
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" IsHitTestVisible="False" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CoverTile}">
                  <Border Width="56" Height="56" Margin="0,0,6,0" CornerRadius="4" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1"
                          ClipToBounds="True" Background="{DynamicResource Bt.Side}">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,14,0,0">
              <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.LayoutGrid}" Size="13" Foreground="{DynamicResource Bt.Muted}"
                            VerticalAlignment="Top" Margin="0,1,8,0" />
              <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="Make a pack" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding MakePackCommand}" Margin="0,0,8,8"
                      ToolTip="One card for these images. Anything set on an image is kept, and Split gives them back." />
              <Button Content="Keep separate" Command="{Binding KeepSeparateCommand}" Margin="0,0,8,8"
                      ToolTip="Each image keeps its own card. Bibliotaph won't ask about this folder again." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="A little clarification." Style="{StaticResource Text.H1}" />
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,9,0,24" />

    <!-- .bt-toolbar .bt-tabs -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" AutomationProperties.Name="Needs review">
      <RadioButton Style="{StaticResource Bt.Tab}" Content="{Binding SuggestionsTabLabel}" IsChecked="{Binding IsSuggestionsTab}" />
      <RadioButton Style="{StaticResource Bt.Tab}" Content="{Binding FilesTabLabel}" IsChecked="{Binding IsFilesTab}" />
    </StackPanel>
    <Border Style="{StaticResource Bt.Rule}" />

    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Visibility="{Binding IsSuggestionsTab, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0" Visibility="{Binding HasShowChoices, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Text="Show" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox x:Name="ReviewShow" Style="{StaticResource Bt.Select}" ItemsSource="{Binding ShowChoices}" SelectedItem="{Binding Show}" DisplayMemberPath="Label"
                  AutomationProperties.Name="Show" MinWidth="200" MaxDropDownHeight="420" />
      </StackPanel>
      <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,18,0,0"
              Visibility="{Binding HasUpdates, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Show the new list" Command="{Binding ReloadCommand}" Padding="12,0,0,0" />
          <TextBlock Text="The suggestions have changed since this list was made." FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Border Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,10" Margin="0,18,0,0"
              Visibility="{Binding BulkUndo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo all" Command="{Binding BulkUndo.UndoCommand}" Padding="12,0,0,0"
                  Visibility="{Binding BulkUndo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock Text="{Binding BulkUndo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" AutomationProperties.Name="Metadata suggestions" />

      <Button Content="{Binding MoreLabel}" Command="{Binding ShowMoreCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"
              Visibility="{Binding HasHidden, Converter={StaticResource Bt.VisibleWhenTrue}}" />

      <c:EmptyState Visibility="{Binding ShowEmpty, Converter={StaticResource Bt.VisibleWhenTrue}}" Title="Everything in its place."
                    Message="No suggestions need your attention."
                    ActionText="Return to library" ActionIcon="{StaticResource Icon.LibraryBig}" Command="{Binding ReturnToLibraryCommand}" />
    </StackPanel>

    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Visibility="{Binding IsFilesTab, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <DockPanel Margin="0,18,0,0" Visibility="{Binding CanRetryAll, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Button x:Name="RetryAll" DockPanel.Dock="Right" Content="Try all again" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Command="{Binding RetryAllCommand}" />
        <TextBlock Text="Gives every file below another go, apart from locked and protected ones, which trying again can't help." Style="{StaticResource Text.Small}"
                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
      </DockPanel>
      <ItemsControl ItemsSource="{Binding Files}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="Files needing attention">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:AttentionGroup}">
            <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Try again" c:Ui.Icon="{StaticResource Icon.RotateCcw}" VerticalAlignment="Top"
                        Visibility="{Binding CanRetry, Converter={StaticResource Bt.VisibleWhenTrue}}"
                        AutomationProperties.Name="{Binding Heading, StringFormat='Try {0} again'}"
                        Command="{Binding DataContext.RetryGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <Button DockPanel.Dock="Right" Content="Open to unlock" c:Ui.Icon="{StaticResource Icon.Lock}" VerticalAlignment="Top"
                        Visibility="{Binding CanUnlock, Converter={StaticResource Bt.VisibleWhenTrue}}"
                        AutomationProperties.Name="{Binding Heading, StringFormat='Open {0} to unlock'}"
                        Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding First}" />
                <Button DockPanel.Dock="Right" Content="Open in another app" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" VerticalAlignment="Top"
                        Visibility="{Binding CanOpenElsewhere, Converter={StaticResource Bt.VisibleWhenTrue}}"
                        AutomationProperties.Name="{Binding Heading, StringFormat='Open {0} in another app'}"
                        Command="{Binding DataContext.OpenElsewhereCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding First}" />
                <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.TriangleAlert}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Row}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,4,0,0">
                    <Button Style="{StaticResource Bt.Link}" Content="{Binding ToggleLabel}" Padding="0,0,16,0"
                            Visibility="{Binding IsMany, Converter={StaticResource Bt.VisibleWhenTrue}}"
                            Command="{Binding DataContext.ToggleFilesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource Bt.Link}" Content="{Binding CopyLabel}"
                            Visibility="{Binding IsBug, Converter={StaticResource Bt.VisibleWhenTrue}}"
                            AutomationProperties.HelpText="Copies the version and the error, without file names, to paste into a bug report."
                            Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </WrapPanel>
                  <!-- The files of a card of many, each with what helps it. -->
                  <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,6,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource Bt.VisibleWhenTrue}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type p:AttentionRow}">
                        <DockPanel Margin="0,6,0,0">
                          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Try again" Padding="12,0,0,0"
                                  Visibility="{Binding CanRetry, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Try {0} again'}"
                                  Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Open to unlock" Padding="12,0,0,0"
                                  Visibility="{Binding CanUnlock, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Open {0} to unlock'}"
                                  Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Open in another app" Padding="12,0,0,0"
                                  Visibility="{Binding CanOpenElsewhere, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Open {0} in another app'}"
                                  Command="{Binding DataContext.OpenElsewhereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Bt.Text}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:EmptyState Visibility="{Binding HasFiles, Converter={StaticResource Bt.CollapsedWhenTrue}}" Title="Everything in its place."
                    Message="Every file could be read."
                    ActionText="Return to library" ActionIcon="{StaticResource Icon.LibraryBig}" Command="{Binding ReturnToLibraryCommand}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
      <c:LucideIcon Data="{StaticResource Icon.ShieldCheck}" Size="13" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,8,0" />
      <TextBlock Text="Your corrections are preserved when books are reindexed." Style="{StaticResource Text.Small}" FontSize="10" />
    </StackPanel>
  </StackPanel>
</UserControl>
