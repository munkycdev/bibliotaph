<Window x:Class="Bibliotaph.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password needed"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bt.Panel}" Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}" FontSize="12" UseLayoutRounding="True">
  <StackPanel Margin="24">
    <TextBlock x:Name="Heading" Style="{StaticResource Text.Row}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Message" Style="{StaticResource Text.Copy}" Margin="0,8,0,16" />
    <PasswordBox x:Name="Password" Padding="8,6" FontSize="12" AutomationProperties.Name="Password"
                 Background="{DynamicResource Bt.Bg}" Foreground="{DynamicResource Bt.Text}" BorderBrush="{DynamicResource Bt.Line}" />
    <CheckBox x:Name="Searchable" Margin="0,14,0,0" Foreground="{DynamicResource Bt.Text}" IsChecked="True"
              AutomationProperties.Name="Make its text searchable"
              Content="Make its text searchable" />
    <TextBlock Style="{StaticResource Text.Small}" Margin="22,2,0,0" TextWrapping="Wrap"
               Text="Bibliotaph reads the book for search while it's open. Untick to only read it." />
    <CheckBox x:Name="Remember" Margin="0,10,0,0" Foreground="{DynamicResource Bt.Text}"
              AutomationProperties.Name="Remember it on this PC"
              Content="Remember it on this PC (in Windows Credential Manager)" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Open" IsDefault="True" Style="{StaticResource Bt.Button.Primary}" Click="Open_Click" />
    </StackPanel>
  </StackPanel>
</Window>
