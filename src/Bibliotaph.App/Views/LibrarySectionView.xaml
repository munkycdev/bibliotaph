<UserControl x:Class="Bibliotaph.App.Views.LibrarySectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibrarySectionViewModel}">
  <StackPanel>
    <TextBlock Text="Library folders" Style="{StaticResource Text.H2}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,8"
               Text="Bibliotaph reads your folders. Your books stay exactly where you put them." />

    <!-- The list grows with the section, which scrolls as a whole: a box scrolling inside it would trap the mouse wheel. -->
    <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryFolderItem}">
          <!-- .bt-source -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}"
                      ToolTip="Remove from library" AutomationProperties.Name="{Binding Path, StringFormat='Remove {0} from the library'}"
                      Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" />
              <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Folder}" Margin="0,0,10,0" VerticalAlignment="Top" />
              <StackPanel>
                <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Style="{StaticResource Bt.ProgressBar}" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,8,0,2"
                             Visibility="{Binding ShowProgress, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Visibility="{Binding HasFolders, Converter={StaticResource Bt.CollapsedWhenTrue}}"
               Style="{StaticResource Text.Small}" Margin="0,12,0,0" Text="No folders yet." />

    <!-- Picked folders: what each holds, before it is added. -->
    <ItemsControl ItemsSource="{Binding Pending}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PendingFolder}">
          <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.FolderPlus}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
              <WrapPanel Margin="0,12,0,0">
                <Button Style="{StaticResource Bt.Button.Primary}" Content="Add to library" c:Ui.Icon="{StaticResource Icon.Check}" Margin="0,0,8,0"
                        IsEnabled="{Binding CanAdd}"
                        Command="{Binding DataContext.ConfirmAddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="Cancel"
                        Command="{Binding DataContext.CancelAddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <WrapPanel Margin="0,25,0,0">
      <Button Style="{StaticResource Bt.Button.Primary}" Content="Add a folder" Margin="0,0,8,0"
              c:Ui.Icon="{StaticResource Icon.FolderPlus}" Command="{Binding AddFolderCommand}" />
      <Button Content="Look for changes" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Command="{Binding RescanCommand}"
              Visibility="{Binding HasFolders, Converter={StaticResource Bt.VisibleWhenTrue}}" />
    </WrapPanel>
    <TextBlock Style="{StaticResource Text.Small}" Margin="0,12,0,0"
               Text="Removing a folder keeps your notes, collections and corrections. Files are never deleted." />

    <!-- Start on (slice 3 plan, choice 7): Home or the Library when Bibliotaph opens. -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,20,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Start on">
            <RadioButton x:Name="StartOnHome" Style="{StaticResource Bt.Segment}" GroupName="StartOn" Content="Home" IsChecked="{Binding StartOnHome}" />
            <RadioButton x:Name="StartOnLibrary" Style="{StaticResource Bt.Segment}" GroupName="StartOn" Content="Library" IsChecked="{Binding StartOnLibrary}" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Start on" Style="{StaticResource Text.Row}" />
          <TextBlock Text="What Bibliotaph shows when it opens." Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Folder names read as labels, each of which can be switched off. -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,20,0,0">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Refresh" Command="{Binding RefreshFolderLabelsCommand}"
                  AutomationProperties.Name="Refresh folder names" />
          <TextBlock Text="Folder names" Style="{StaticResource Text.Row}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,12" TextWrapping="Wrap"
                   Text="Folder names like “D&amp;D 5e” or “Adventures” are read as suggestions for the books inside. Switch one off if a name means something else in your library. Your own corrections always win." />
        <TextBlock Style="{StaticResource Text.Small}" Text="No folder names in your library match a game system, type or other label yet."
                   Visibility="{Binding HasFolderLabels, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
        <ItemsControl ItemsSource="{Binding FolderLabels}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FolderLabelItem}">
              <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalContentAlignment="Top" Foreground="{DynamicResource Bt.Text}"
                          AutomationProperties.Name="{Binding Folder, StringFormat='Read the folder name {0} as a label'}">
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock FontSize="12" TextWrapping="Wrap">
                      <Run Text="{Binding Folder, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" → " Foreground="{DynamicResource Bt.Muted}" /><Run Text="{Binding Meaning, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
