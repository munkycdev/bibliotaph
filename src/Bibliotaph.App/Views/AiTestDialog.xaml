<Window x:Class="Bibliotaph.App.Views.AiTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Bibliotaph.App.Controls"
        xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AiTestViewModel}"
        Title="Test with a book"
        Width="560" SizeToContent="Height" MaxHeight="680" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bt.Panel}" Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Problem" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource Text.H2}" TextTrimming="CharacterEllipsis" />

    <!-- Cancel stops a test and closes; once it is done the same button is Close. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="Test again" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Command="{Binding TestAgainCommand}"
              Visibility="{Binding IsRunning, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
      <Button x:Name="CloseButton" DockPanel.Dock="Right" IsCancel="True" Click="Close_Click">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource Bt.Button.Primary}">
            <Setter Property="Content" Value="Close" />
            <Setter Property="IsDefault" Value="True" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Content" Value="Cancel" />
                <Setter Property="IsDefault" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </DockPanel>

    <Grid Margin="0,16,0,0">
      <!-- Running: the step, a sweep and the seconds so far. -->
      <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Text.Small}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Row}" TextWrapping="Wrap" />
        </DockPanel>
        <ProgressBar Style="{StaticResource Bt.ProgressBar}" IsIndeterminate="{Binding IsRunning}" Margin="0,10,0,0"
                     AutomationProperties.Name="Testing" />
        <TextBlock Text="{Binding StepDetail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding StepDetail, Converter={StaticResource Bt.VisibleWhenSet}}" />
      </StackPanel>

      <!-- Done: what it read, what it kept and what the check threw away. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                    Visibility="{Binding IsRunning, Converter={StaticResource Bt.CollapsedWhenTrue}}">
        <StackPanel>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Row}" TextWrapping="Wrap"
                     Visibility="{Binding Summary, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Text="{Binding Problem}" Style="{StaticResource Problem}" Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <ItemsControl ItemsSource="{Binding Kept}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="What the model found">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AiTestLine}">
                <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding HasDropped, Converter={StaticResource Bt.VisibleWhenTrue}}" Margin="0,16,0,0">
            <TextBlock Text="Thrown away" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Dropped}" Focusable="False" AutomationProperties.Name="What the check threw away">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AiTestLine}">
                  <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,3,0,0">
                    <Run Text="{Binding Text, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
