<UserControl x:Class="Bibliotaph.App.Views.ProcessingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:services="clr-namespace:Bibliotaph.App.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProcessingSectionViewModel}">
  <UserControl.Resources>
    <!-- A pause button that becomes Resume while its lane is paused. Tag carries the paused flag. -->
    <Style x:Key="PauseToggle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="c:Ui.Icon" Value="{StaticResource Icon.Pause}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="c:Ui.Icon" Value="{StaticResource Icon.Play}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="Processing" Style="{StaticResource Text.H2}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,8"
               Text="Only while Bibliotaph is open. Closing the app stops it; reopening resumes it." />

    <!-- With no folders there is nothing to show yet. -->
    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasFolders, Converter={StaticResource Bt.CollapsedWhenTrue}}">
      <TextBlock Style="{StaticResource Text.Small}" Text="Nothing to process until you add a folder." />
      <Button Style="{StaticResource Bt.Link}" Content="Add a folder in Library" Command="{Binding OpenLibraryCommand}"
              HorizontalAlignment="Left" Margin="0,4,0,0" AutomationProperties.Name="Open Library to add a folder" />
    </StackPanel>

    <!-- Indexing progress (spec 4.1: separate progress for each step), with pause and resume for each lane while it has work. -->
    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0"
            Visibility="{Binding HasFolders, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel>
        <TextBlock Text="{Binding Activity.Summary}" Style="{StaticResource Text.Row}" />
        <TextBlock Text="{Binding Activity.TimeLeftText}" Margin="0,4,0,0" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.TimeLeftText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Rows share their label and status widths so the bars line up; at the smallest window the bars give way, and a
             long status wraps, so the run-again buttons stay whole. -->
        <ItemsControl ItemsSource="{Binding Activity.Phases}" Focusable="False" Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type services:PhaseProgress}">
              <Grid Margin="0,6,0,0" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Status}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PhaseLabel" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PhaseStatus" />
                  <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MaxWidth="150">
                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Bt.ProgressBar}">
                      <Setter Property="Value" Value="{Binding Percent, Mode=OneWay}" />
                      <Setter Property="IsIndeterminate" Value="{Binding IsIndeterminate, Mode=OneWay}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static services:PhaseState.Done}">
                          <Setter Property="Foreground" Value="{DynamicResource Bt.StatusOk}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static services:PhaseState.Paused}">
                          <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"
                           MaxWidth="130" TextWrapping="Wrap" TextAlignment="Right" />
                <!-- Runs the step again for every book, asked first where it costs a pass over the library. -->
                <Button Grid.Column="3" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.RotateCcw}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" ToolTip="{Binding RunAgain.Hint}" AutomationProperties.Name="{Binding RunAgain.Hint}"
                        Command="{Binding DataContext.RunAgainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding RunAgain, Converter={StaticResource Bt.VisibleWhenSet}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding RunAgainNote}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding RunAgainNote, Converter={StaticResource Bt.VisibleWhenSet}}" />

        <!-- What each part is on right now, so the section shows movement even while a bar creeps. -->
        <StackPanel Margin="0,12,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.Now.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Now" Style="{StaticResource Text.Eyebrow}" />
          <ItemsControl ItemsSource="{Binding Activity.Now}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding Activity.Notes}" Margin="0,10,0,0" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.Notes}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,0"
                   Visibility="{Binding Activity.NeedsAttention, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <Hyperlink Command="{Binding OpenFilesNeedingAttentionCommand}" Foreground="{DynamicResource Bt.Accent}">See the files that need attention</Hyperlink>
        </TextBlock>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Activity.WaitingForDiskSpace, Converter={StaticResource Bt.VisibleWhenTrue}}"
                   Text="Online-only files are waiting: downloading more would leave less than 2 GB free on that drive." />
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Activity.IsAiWaiting, Converter={StaticResource Bt.VisibleWhenTrue}}"
                   Text="{Binding Activity.AiWaiting, StringFormat='Cataloguing with AI is waiting: {0}'}" />
        <WrapPanel Margin="0,12,0,0">
          <Button Style="{StaticResource PauseToggle}" Tag="{Binding Activity.IndexPaused}" Command="{Binding ToggleIndexingCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowIndexPause, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Content>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Pause indexing" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Activity.IndexPaused}" Value="True">
                        <Setter Property="Text" Value="Resume indexing" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.Content>
          </Button>
          <Button Style="{StaticResource PauseToggle}" Tag="{Binding Activity.OcrPaused}" Command="{Binding ToggleOcrCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowOcrPause, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Content>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Pause reading scans" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Activity.OcrPaused}" Value="True">
                        <Setter Property="Text" Value="Resume reading scans" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.Content>
          </Button>
          <Button Style="{StaticResource PauseToggle}" Tag="{Binding Activity.AiPaused}" Command="{Binding ToggleAiCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowAiPause, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Content>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Pause AI" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Activity.AiPaused}" Value="True">
                        <Setter Property="Text" Value="Resume AI" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.Content>
          </Button>
          <Button Content="See what the AI is reading" Command="{Binding OpenAiReadingCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowAiPause, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Files indexing downloaded from OneDrive go back to online-only, so a big cloud library fits. -->
    <CheckBox x:Name="ReturnOnlineOnly" Margin="0,20,0,0" IsChecked="{Binding ReturnOnlineOnly}" VerticalContentAlignment="Top"
              Foreground="{DynamicResource Bt.Text}" AutomationProperties.Name="Return files to online-only after indexing">
      <StackPanel Margin="4,0,0,0">
        <TextBlock Text="Return files to online-only after indexing" FontSize="12" />
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextWrapping="Wrap"
                   Text="Online-only OneDrive files download while Bibliotaph reads them. Once read, each goes back to online-only, as Free up space does in File Explorer, so a library bigger than your disk still fits. Files you keep on this device stay. Opening a book downloads it again." />
      </StackPanel>
    </CheckBox>

    <!-- Always on: where the ISBNs go, so the Looking up step above isn't a mystery. -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0">
      <StackPanel>
        <TextBlock Text="Looking up online" Style="{StaticResource Text.Row}" />
        <TextBlock x:Name="LookUpExplanation" Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="{Binding LookUpExplanation}" />
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,24,0,0" Text="Your files, notes and collections stay on this device." />
  </StackPanel>
</UserControl>
