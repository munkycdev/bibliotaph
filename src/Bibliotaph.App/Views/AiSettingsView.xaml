<UserControl x:Class="Bibliotaph.App.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiSettingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Problem" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Bt.TextBox's look, for the key. -->
    <Style x:Key="KeyBox" TargetType="PasswordBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Chrome" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                    BorderThickness="1" CornerRadius="6" Padding="9,6" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="AI" Style="{StaticResource Text.H2}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,0" TextWrapping="Wrap"
               Text="A model on this computer reads a few pages of each book (its opening pages, contents, introduction and a sample of the rest) and suggests its title, game system, type, levels and more. Each suggestion has to quote the page it came from, or it's thrown away. Your own values always win." />

    <!-- On and off -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,18" Margin="0,12,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton Style="{StaticResource Bt.Segment}" GroupName="UseAi" Content="Off" IsChecked="{Binding NoAi}" />
            <RadioButton Style="{StaticResource Bt.Segment}" GroupName="UseAi" Content="On" IsChecked="{Binding UseAi}" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Use AI" Style="{StaticResource Text.Row}" />
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Activity.AiWaiting, StringFormat='Waiting: {0}'}" Style="{StaticResource Problem}"
                     Visibility="{Binding Activity.AiWaiting, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Text="{Binding SwitchNote}" Style="{StaticResource Note}" Visibility="{Binding SwitchNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Text="{Binding SwitchProblem}" Style="{StaticResource Problem}"
                     Visibility="{Binding SwitchProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Style="{StaticResource Note}">
            <Hyperlink Command="{Binding OpenAiReadingCommand}" Foreground="{DynamicResource Bt.Accent}">See what the AI is reading</Hyperlink>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Reading whole books, chapter by chapter, after cataloging and only while nothing else wants the AI. -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,18">
      <StackPanel>
        <CheckBox x:Name="ScanWholeBooks" IsChecked="{Binding ScanWholeBooks}" VerticalContentAlignment="Top"
                  Foreground="{DynamicResource Bt.Text}" AutomationProperties.Name="Scan whole books">
          <StackPanel Margin="4,0,0,0">
            <TextBlock Text="Scan whole books" FontSize="12" />
            <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="Once a book is catalogued, the AI reads all of it, chapter by chapter, and notes each chapter's setting, environments, themes and creatures, with the page that shows them. It goes slowly, after everything else, and stops whenever you ask the AI something. The book's own details are never changed." />
          </StackPanel>
        </CheckBox>
        <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource Note}" Margin="22,4,0,0"
                   Visibility="{Binding ScanProgressText, Converter={StaticResource Bt.VisibleWhenSet}}" />
      </StackPanel>
    </Border>

    <!-- Built in or a model server (Built-in AI plan, choice 7) -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,18">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton Style="{StaticResource Bt.Segment}" GroupName="AiRunsOn" Content="Built in" IsChecked="{Binding UseBuiltIn}" />
            <RadioButton Style="{StaticResource Bt.Segment}" GroupName="AiRunsOn" Content="Use a model server" IsChecked="{Binding UseServer}" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Where the model runs" Style="{StaticResource Text.Row}" />
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Built in: Bibliotaph downloads a model once and runs it itself. A model server: Ollama, LM Studio or similar, which you install and run." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The built-in AI -->
    <StackPanel DataContext="{Binding BuiltIn}" d:DataContext="{d:DesignInstance vm:BuiltInAiViewModel}"
                Visibility="{Binding DataContext.ShowBuiltIn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <TextBlock Text="Built-in model" Style="{StaticResource Text.Row}" Margin="0,18,0,4" />
      <TextBlock Text="{Binding EngineText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding GraphicsText}" Style="{StaticResource Note}" />
      <!-- One list for every model offered, grouped by whether it fits this computer's graphics card, and a file of your own. -->
      <DockPanel Margin="0,10,0,0">
        <Button DockPanel.Dock="Right" Content="Use a model file…" Command="{Binding ChooseFileCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                AutomationProperties.Name="Use a model file on this computer" ToolTip="A .gguf model file already on this computer, used where it is" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding ModelList}" SelectedItem="{Binding Chosen}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" MaxDropDownHeight="420" AutomationProperties.Name="Built-in model">
          <ComboBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}" FontWeight="Medium" Margin="8,8,8,2" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ComboBox.GroupStyle>
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:BuiltInModelItem}">
              <DockPanel MaxWidth="480">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource Text.Small}" VerticalAlignment="Top" Margin="12,0,0,0" />
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>

      <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" Visibility="{Binding IsListedChosen, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Run Text="{Binding LicenceText, Mode=OneWay}" />
        <Hyperlink Command="{Binding OpenLicenceCommand}" Foreground="{DynamicResource Bt.Accent}">Read the licence</Hyperlink>
      </TextBlock>
      <TextBlock Text="{Binding FileText}" Style="{StaticResource Note}" Margin="0,10,0,0" TextWrapping="Wrap"
                 Visibility="{Binding FileText, Converter={StaticResource Bt.VisibleWhenSet}}" />

      <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource Bt.VisibleWhenTrue}}" Margin="0,12,0,0">
        <ProgressBar Style="{StaticResource Bt.ProgressBar}" Value="{Binding DownloadPercent, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Download progress" />
        <TextBlock Text="{Binding DownloadText}" Style="{StaticResource Note}" />
      </StackPanel>

      <WrapPanel Margin="0,14,0,0">
        <Button Style="{StaticResource Bt.Button.Primary}" Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                AutomationProperties.Name="Download model" />
        <Button Content="Pause" c:Ui.Icon="{StaticResource Icon.Pause}" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                Visibility="{Binding IsDownloading, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <Button Content="Cancel download" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                Visibility="{Binding ShowCancel, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <Button Content="Test with a book" Command="{Binding TestCommand}" Margin="0,0,8,0" />
        <Button Content="Delete model" Command="{Binding DeleteCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" Visibility="{Binding Note, Converter={StaticResource Bt.VisibleWhenSet}}" />
      <TextBlock Text="{Binding Problem}" Style="{StaticResource Problem}" Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />

      <!-- Ask this book's embedding model, run by a second engine (Ask plan, choice 3) -->
      <TextBlock Text="Ask this book" Style="{StaticResource Text.Row}" Margin="0,18,0,4" />
      <TextBlock x:Name="BuiltInEmbeddingText" Text="{Binding EmbeddingText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
      <StackPanel Visibility="{Binding CanOfferEmbedding, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Style="{StaticResource Note}">
          <Run Text="{Binding EmbeddingLicenceText, Mode=OneWay}" />
          <Hyperlink Command="{Binding OpenEmbeddingLicenceCommand}" Foreground="{DynamicResource Bt.Accent}">Read the licence</Hyperlink>
        </TextBlock>
        <WrapPanel Margin="0,10,0,0">
          <Button Content="{Binding EmbeddingDownloadLabel}" Command="{Binding DownloadEmbeddingCommand}" Margin="0,0,8,0"
                  AutomationProperties.Name="Download the embedding model" />
          <Button Content="Delete embedding model" Command="{Binding DeleteEmbeddingCommand}" />
        </WrapPanel>
      </StackPanel>
    </StackPanel>

    <!-- The model server -->
    <StackPanel Visibility="{Binding ShowBuiltIn, Converter={StaticResource Bt.CollapsedWhenTrue}}">
    <TextBlock Text="Model server" Style="{StaticResource Text.Row}" Margin="0,18,0,4" />
    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Ollama is usually at http://localhost:11434 and LM Studio at http://localhost:1234. Any server that speaks the OpenAI chat API works too." />
    <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Connect" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Command="{Binding ConnectCommand}" Margin="8,0,0,0" />
      <TextBox x:Name="EndpointBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Model server address">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
        </TextBox.InputBindings>
      </TextBox>
    </DockPanel>
    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Note}" Visibility="{Binding ConnectionText, Converter={StaticResource Bt.VisibleWhenSet}}" />
    <TextBlock Text="{Binding ConnectionProblem}" Style="{StaticResource Problem}" Visibility="{Binding ConnectionProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />

    <StackPanel Visibility="{Binding IsRemote, Converter={StaticResource Bt.VisibleWhenTrue}}" Margin="0,12,0,0">
      <TextBlock Style="{StaticResource Problem}" Margin="0"
                 Text="This address isn't on this computer or your network. Each book's excerpt, a few thousand words of its text, would be sent there, and so would the pages of a book you ask a question." />
      <CheckBox IsChecked="{Binding RemoteAllowed}" Foreground="{DynamicResource Bt.Text}" Margin="0,8,0,0" Content="Send excerpts to this server" />
    </StackPanel>

    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
    <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="Model" Visibility="{Binding HasModels, Converter={StaticResource Bt.VisibleWhenTrue}}" />
    <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model name"
             Visibility="{Binding HasModels, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
    <TextBlock Style="{StaticResource Note}"
               Text="On a graphics card with 8 GB, a model of 7 to 9 billion parameters fits. Bigger ones run, but slowly." />

    <!-- Ask this book's embedding model (Ask plan, choice 3) -->
    <TextBlock Text="Embedding model, for Ask this book" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
    <ComboBox x:Name="EmbeddingModelChoice" Style="{StaticResource Bt.Select}" ItemsSource="{Binding EmbeddingChoices}" SelectedValuePath="Value"
              SelectedValue="{Binding EmbeddingModel}" HorizontalAlignment="Stretch" AutomationProperties.Name="Embedding model"
              Visibility="{Binding HasModels, Converter={StaticResource Bt.VisibleWhenTrue}}" />
    <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Embedding model name"
             Visibility="{Binding HasModels, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
    <TextBlock Style="{StaticResource Note}"
               Text="Lets Ask this book find passages by what they mean, not only by their words. nomic-embed-text (Apache-2.0) and bge-m3 (MIT) work well: download one on the server first. Leave it empty to find passages by their words." />

    <TextBlock Text="Key, only if the server needs one" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Forget key" Command="{Binding ForgetKeyCommand}" Margin="8,0,0,0"
              Visibility="{Binding HasSavedKey, Converter={StaticResource Bt.VisibleWhenTrue}}" />
      <PasswordBox x:Name="KeyBox" Style="{StaticResource KeyBox}" PasswordChanged="OnKeyChanged" AutomationProperties.Name="Key" />
    </DockPanel>
    <TextBlock Style="{StaticResource Note}" Text="Saved in Windows Credential Manager, never in Bibliotaph's files." />
    <TextBlock Style="{StaticResource Note}" Text="A key is saved for this server." Visibility="{Binding HasSavedKey, Converter={StaticResource Bt.VisibleWhenTrue}}" />

    <WrapPanel Margin="0,18,0,0">
      <Button Style="{StaticResource Bt.Button.Primary}" Content="Save" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
      <Button Content="Test with a book" Command="{Binding TestCommand}" />
    </WrapPanel>
    <TextBlock Text="{Binding SaveNote}" Style="{StaticResource Note}" Visibility="{Binding SaveNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
    </StackPanel>

    <!-- Reclassify -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,24,0,0"
            Visibility="{Binding CanReclassify, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding ReclassifyLabel}" Command="{Binding ReclassifyCommand}" VerticalAlignment="Center" />
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Reclassify" Style="{StaticResource Text.Row}" />
          <TextBlock Text="{Binding ReclassifyText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
          <TextBlock Style="{StaticResource Note}" Visibility="{Binding HasFailed, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Hyperlink Command="{Binding OpenFailedCommand}" Foreground="{DynamicResource Bt.Accent}">See which books, and why</Hyperlink>
          </TextBlock>
          <TextBlock Style="{StaticResource Note}" Text="Values you've accepted, typed or rejected stay as they are." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Read every book again moved to the end of Cataloguing with AI's row in Processing -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Read every book again" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" TextWrapping="Wrap">
          <Run Text="To read every book again with your lists as they stand now, use the button at the end of Cataloguing with AI in" />
          <Hyperlink Command="{Binding OpenProcessingCommand}" Foreground="{DynamicResource Bt.Accent}">Processing</Hyperlink><Run Text="." />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Reading the whole library for meaning, for questions to the library -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,12,0,0"
            Visibility="{Binding HasLibraryVectors, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel>
        <TextBlock Text="Read the whole library for meaning" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,8"
                   Text="So a question to your whole library finds pages by what they mean, not only by their words. It runs slowly in the background, can take hours for a large library, pauses while you're using the AI, and carries on where it was after a restart." />
        <CheckBox x:Name="ReadLibraryForMeaning" IsChecked="{Binding ReadLibrary}" Foreground="{DynamicResource Bt.Text}"
                  Content="Read the library for meaning in the background" />
        <TextBlock x:Name="LibraryVectorsProgress" Text="{Binding LibraryVectorsText}" Style="{StaticResource Note}" />
      </StackPanel>
    </Border>

    <!-- Folders -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Library folders sent to AI" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,8"
                   Text="Untick a folder to keep its books away from the model. They keep their hints from names, and you can still fill them in yourself." />
        <TextBlock Style="{StaticResource Text.Small}" Text="No library folders yet."
                   Visibility="{Binding HasFolders, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
        <ItemsControl ItemsSource="{Binding Folders}" Focusable="False" AutomationProperties.Name="Library folders sent to AI">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AiFolderItem}">
              <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                <CheckBox IsChecked="{Binding Send}" Foreground="{DynamicResource Bt.Text}"
                          AutomationProperties.Name="{Binding Path, StringFormat='Send the books in {0} to AI'}">
                  <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- The model pilot, only when the app starts with the pilot switch (slice 2d) -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,12,0,0"
            Visibility="{Binding ShowPilot, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel DataContext="{Binding Pilot}" d:DataContext="{d:DesignInstance vm:PilotPanelViewModel}">
        <TextBlock Text="Model pilot" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,0"
                   Text="Each model reads the same books, and what they find is kept apart from your catalog. Then you answer what each book really is, without seeing which model said what, and the report scores them." />
        <TextBlock Text="{Binding BooksText}" Style="{StaticResource Note}" />
        <WrapPanel Margin="0,10,0,0">
          <Button Content="Pick books" Command="{Binding PickBooksCommand}" Margin="0,0,8,0" />
          <Button Content="Open folder" c:Ui.Icon="{StaticResource Icon.Folder}" Command="{Binding OpenFolderCommand}" />
        </WrapPanel>

        <TextBlock Text="Models, in the order they run" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
        <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Session.Models, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pilot models" />
        <TextBlock Style="{StaticResource Note}" Text="Download each in Ollama first. The run uses the model server above, and cataloguing with AI waits until it ends." />
        <WrapPanel Margin="0,10,0,0">
          <Button Style="{StaticResource Bt.Button.Primary}" Content="Start" c:Ui.Icon="{StaticResource Icon.Play}" Command="{Binding StartCommand}" Margin="0,0,8,0" />
          <Button Content="Pause" c:Ui.Icon="{StaticResource Icon.Pause}" Command="{Binding PauseCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding Session.ProgressText}" Style="{StaticResource Note}" Visibility="{Binding Session.ProgressText, Converter={StaticResource Bt.VisibleWhenSet}}" />
        <TextBlock Text="{Binding Session.Problem}" Style="{StaticResource Problem}" Visibility="{Binding Session.Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
        <TextBlock Text="{Binding ReadText}" Style="{StaticResource Note}" Visibility="{Binding ReadText, Converter={StaticResource Bt.VisibleWhenSet}}" />

        <WrapPanel Margin="0,14,0,0">
          <Button Content="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" Margin="0,0,8,0" />
          <Button Content="Make the report" Command="{Binding ReportCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" Visibility="{Binding Note, Converter={StaticResource Bt.VisibleWhenSet}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
