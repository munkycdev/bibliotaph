<UserControl x:Class="Bibliotaph.App.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiSettingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Problem" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Bt.TextBox's look, for the key. -->
    <Style x:Key="KeyBox" TargetType="PasswordBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Chrome" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}"
                    BorderThickness="1" CornerRadius="6" Padding="9,6" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="AI" Style="{StaticResource Text.H2}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,0" TextWrapping="Wrap"
               Text="A model on this computer reads a few pages of each book (its opening pages, contents, introduction and a sample of the rest) and suggests its title, game system, type, levels and more. Each suggestion has to quote the page it came from, or it's thrown away. Your own values always win." />

    <!-- On and off -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,18" Margin="0,12,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton Style="{StaticResource Bt.Segment}" GroupName="UseAi" Content="Off" IsChecked="{Binding NoAi}" />
            <RadioButton Style="{StaticResource Bt.Segment}" GroupName="UseAi" Content="On" IsChecked="{Binding UseAi}" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Use AI" Style="{StaticResource Text.Row}" />
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Activity.AiWaiting, StringFormat='Waiting: {0}'}" Style="{StaticResource Problem}"
                     Visibility="{Binding Activity.AiWaiting, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Text="{Binding SwitchNote}" Style="{StaticResource Note}" Visibility="{Binding SwitchNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Text="{Binding SwitchProblem}" Style="{StaticResource Problem}"
                     Visibility="{Binding SwitchProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The model server -->
    <TextBlock Text="Model server" Style="{StaticResource Text.Row}" Margin="0,18,0,4" />
    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Ollama is usually at http://localhost:11434 and LM Studio at http://localhost:1234. Any server that speaks the OpenAI chat API works too." />
    <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Connect" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Command="{Binding ConnectCommand}" Margin="8,0,0,0" />
      <TextBox x:Name="EndpointBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Model server address">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
        </TextBox.InputBindings>
      </TextBox>
    </DockPanel>
    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Note}" Visibility="{Binding ConnectionText, Converter={StaticResource Bt.VisibleWhenSet}}" />
    <TextBlock Text="{Binding ConnectionProblem}" Style="{StaticResource Problem}" Visibility="{Binding ConnectionProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />

    <StackPanel Visibility="{Binding IsRemote, Converter={StaticResource Bt.VisibleWhenTrue}}" Margin="0,12,0,0">
      <TextBlock Style="{StaticResource Problem}" Margin="0"
                 Text="This address isn't on this computer or your network. Each book's excerpt, a few thousand words of its text, would be sent there." />
      <CheckBox IsChecked="{Binding RemoteAllowed}" Foreground="{DynamicResource Bt.Text}" Margin="0,8,0,0" Content="Send excerpts to this server" />
    </StackPanel>

    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
    <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="Model" Visibility="{Binding HasModels, Converter={StaticResource Bt.VisibleWhenTrue}}" />
    <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model name"
             Visibility="{Binding HasModels, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
    <TextBlock Style="{StaticResource Note}"
               Text="On a graphics card with 8 GB, a model of 7 to 9 billion parameters fits. Bigger ones run, but slowly." />

    <TextBlock Text="Key, only if the server needs one" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Forget key" Command="{Binding ForgetKeyCommand}" Margin="8,0,0,0"
              Visibility="{Binding HasSavedKey, Converter={StaticResource Bt.VisibleWhenTrue}}" />
      <PasswordBox x:Name="KeyBox" Style="{StaticResource KeyBox}" PasswordChanged="OnKeyChanged" AutomationProperties.Name="Key" />
    </DockPanel>
    <TextBlock Style="{StaticResource Note}" Text="Saved in Windows Credential Manager, never in Bibliotaph's files." />
    <TextBlock Style="{StaticResource Note}" Text="A key is saved for this server." Visibility="{Binding HasSavedKey, Converter={StaticResource Bt.VisibleWhenTrue}}" />

    <WrapPanel Margin="0,18,0,0">
      <Button Style="{StaticResource Bt.Button.Primary}" Content="Save" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
      <Button Content="Test with a book" Command="{Binding TestCommand}" />
    </WrapPanel>
    <TextBlock Text="{Binding SaveNote}" Style="{StaticResource Note}" Visibility="{Binding SaveNote, Converter={StaticResource Bt.VisibleWhenSet}}" />

    <!-- Reclassify -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,24,0,0"
            Visibility="{Binding CanReclassify, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding ReclassifyLabel}" Command="{Binding ReclassifyCommand}" VerticalAlignment="Center" />
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Reclassify" Style="{StaticResource Text.Row}" />
          <TextBlock Text="{Binding ReclassifyText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
          <TextBlock Style="{StaticResource Note}" Text="Values you've accepted, typed or rejected stay as they are." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Folders -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Library folders sent to AI" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,8"
                   Text="Untick a folder to keep its books away from the model. They keep their hints from names, and you can still fill them in yourself." />
        <TextBlock Style="{StaticResource Text.Small}" Text="No library folders yet."
                   Visibility="{Binding HasFolders, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
        <ItemsControl ItemsSource="{Binding Folders}" Focusable="False" AutomationProperties.Name="Library folders sent to AI">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AiFolderItem}">
              <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                <CheckBox IsChecked="{Binding Send}" Foreground="{DynamicResource Bt.Text}"
                          AutomationProperties.Name="{Binding Path, StringFormat='Send the books in {0} to AI'}">
                  <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- The model pilot, only when the app starts with the pilot switch (slice 2d) -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,12,0,0"
            Visibility="{Binding ShowPilot, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel DataContext="{Binding Pilot}" d:DataContext="{d:DesignInstance vm:PilotPanelViewModel}">
        <TextBlock Text="Model pilot" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Note}" Margin="0,5,0,0"
                   Text="Each model reads the same books into the pilot's own database, never the catalog. Then you answer what each book really is, without seeing which model said what, and the report scores them." />
        <TextBlock Text="{Binding BooksText}" Style="{StaticResource Note}" />
        <WrapPanel Margin="0,10,0,0">
          <Button Content="Pick books" Command="{Binding PickBooksCommand}" Margin="0,0,8,0" />
          <Button Content="Open folder" c:Ui.Icon="{StaticResource Icon.Folder}" Command="{Binding OpenFolderCommand}" />
        </WrapPanel>

        <TextBlock Text="Models, in the order they run" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
        <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Session.Models, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pilot models" />
        <TextBlock Style="{StaticResource Note}" Text="Download each in Ollama first. The run uses the model server above, and the AI lane waits until it ends." />
        <WrapPanel Margin="0,10,0,0">
          <Button Style="{StaticResource Bt.Button.Primary}" Content="Start" c:Ui.Icon="{StaticResource Icon.Play}" Command="{Binding StartCommand}" Margin="0,0,8,0" />
          <Button Content="Pause" c:Ui.Icon="{StaticResource Icon.Pause}" Command="{Binding PauseCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding Session.ProgressText}" Style="{StaticResource Note}" Visibility="{Binding Session.ProgressText, Converter={StaticResource Bt.VisibleWhenSet}}" />
        <TextBlock Text="{Binding Session.Problem}" Style="{StaticResource Problem}" Visibility="{Binding Session.Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
        <TextBlock Text="{Binding ReadText}" Style="{StaticResource Note}" Visibility="{Binding ReadText, Converter={StaticResource Bt.VisibleWhenSet}}" />

        <WrapPanel Margin="0,14,0,0">
          <Button Content="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" Margin="0,0,8,0" />
          <Button Content="Make the report" Command="{Binding ReportCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" Visibility="{Binding Note, Converter={StaticResource Bt.VisibleWhenSet}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
