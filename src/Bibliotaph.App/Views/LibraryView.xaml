<UserControl x:Class="Bibliotaph.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:v="clr-namespace:Bibliotaph.App.Views"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    <KeyBinding Gesture="Ctrl+A" Command="{Binding Selection.SelectAllCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- A book title that opens its details, in search results. -->
    <Style x:Key="TitleLink" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Background="Transparent" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .bt-field: a small label over a select. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A filter that is on, as a chip whose × turns it off: above the results, and under a type-ahead filter's box. -->
    <DataTemplate x:Key="FilterChipTemplate" DataType="{x:Type vm:FilterChip}">
      <Border Style="{StaticResource Bt.Chip}" Padding="10,2,2,2" Margin="0,0,6,6" AutomationProperties.Name="{Binding Label}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
          <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" MinWidth="22" MinHeight="22" Margin="4,0,0,0"
                  Padding="2" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Command="{Binding Clear}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!--
      A value a type-ahead filter offers. The box keeps keyboard focus while the list is open, so rows don't take it:
      the arrow keys move the highlight from the box, and Enter picks it.
    -->
    <Style x:Key="SuggestionRow" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,5">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The inspector's section headings: in the text colour and a size up from the eyebrow, so they break up a long drawer. -->
    <Style x:Key="DrawerHead" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
    </Style>

    <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource DrawerHead}">
      <Setter Property="Margin" Value="0,28,0,10" />
    </Style>

    <!--
      A book in the covers or the list: Bt.PlainList's item, with Books.xaml's BookMenu on right-click (or the Menu key, or Shift+F10).
      The item is what keyboard focus lands on, so it carries the book's name for screen readers.
    -->
    <Style x:Key="BookItem" TargetType="ListBoxItem" BasedOn="{StaticResource Bt.PlainItem}">
      <Setter Property="ContextMenu" Value="{DynamicResource BookMenu}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AvailabilityLabel}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="AutomationProperties.ItemStatus" Value="Selected" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A cover: the item hugs its card rather than filling the grid's cell, so the focus ring goes round the card. -->
    <Style x:Key="CoverItem" TargetType="ListBoxItem" BasedOn="{StaticResource BookItem}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- A book's checkbox in Select mode. It only shows the tick: a click on the book ticks it. -->
    <DataTemplate x:Key="Tick" DataType="{x:Type vm:LibraryItemViewModel}">
      <Border x:Name="Box" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Muted}"
              BorderThickness="1.5" SnapsToDevicePixels="True">
        <c:LucideIcon x:Name="Mark" Data="{StaticResource Icon.Check}" Size="14" StrokeThickness="2.4" Foreground="{DynamicResource Bt.AccentText}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Box" Property="Background" Value="{DynamicResource Bt.Accent}" />
          <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
          <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--
      The page's head: its title, toolbar, filters and notices. On a short window (at 200% scaling, say) it scrolls,
      so the selection bar below it and the books keep their room; LibraryView.FitPageHead sets how tall it may be.
    -->
    <ScrollViewer x:Name="PageHead" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,42,24">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                      Visibility="{Binding ShowsLibraryActions, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button Content="Add folder" c:Ui.Icon="{StaticResource Icon.FolderPlus}" Margin="0,0,8,0" Command="{Binding AddFolderCommand}" />
            <!--
              One button for the ways in other than a folder, so the toolbar stays short: a book with no file here (by hand, or
              a whole online library), and a download checked against the library before it is copied in.
            -->
            <Button x:Name="AddMenu" Style="{StaticResource Bt.Button.Primary}" Content="Add" c:Ui.Icon="{StaticResource Icon.Plus}"
                    Click="DropDown_Click" ToolTip="Add a book you own elsewhere, or check a download">
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource Bt.Menu}">
                  <MenuItem x:Name="AddElsewhere" Header="Add a book I own elsewhere…" Command="{Binding AddElsewhereCommand}"
                            ToolTip="A book you own in print, on a virtual tabletop or on an online service, with no file here"
                            AutomationProperties.Name="Add a book I own elsewhere" />
                  <MenuItem x:Name="OnlineLibraries" Header="Import from an online library…" Command="{Binding OpenOnlineLibrariesCommand}"
                            AutomationProperties.Name="Import from an online library" />
                  <MenuItem x:Name="CheckDownload" Header="Check a download…" Command="{Binding CheckDownloadCommand}"
                            ToolTip="See which files in a folder or ZIP you already have, without adding them"
                            AutomationProperties.Name="Check a download" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </StackPanel>
          <!-- A collection's own actions (slice 3 plan, choice 9). Deleting it never deletes its books. -->
          <StackPanel x:Name="CollectionActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                      Visibility="{Binding ShowsCollectionActions, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button x:Name="NewSubCollection" Content="New collection" c:Ui.Icon="{StaticResource Icon.FolderPlus}" Margin="0,0,8,0"
                    Command="{Binding NewSubCollectionCommand}" ToolTip="Make a collection inside this one" />
            <Button x:Name="RenameCollection" Content="Rename" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,0" Command="{Binding RenameCollectionCommand}"
                    ToolTip="Change its name or description" AutomationProperties.Name="Rename the collection" />
            <Button x:Name="MoveCollection" Content="Move to…" c:Ui.Icon="{StaticResource Icon.FolderInput}" Margin="0,0,8,0" Command="{Binding MoveCollectionCommand}"
                    ToolTip="Put it inside another collection, or at the top" AutomationProperties.Name="Move the collection" />
            <Button x:Name="PinCollection" Content="{Binding PinLabel}" c:Ui.Icon="{StaticResource Icon.Pin}" Margin="0,0,8,0" Command="{Binding TogglePinCommand}"
                    ToolTip="Pinned collections show in the sidebar, on Home, and first on Collections" />
            <Button x:Name="DeleteCollection" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Trash2}" Command="{Binding DeleteCollectionCommand}"
                    ToolTip="Delete the collection. Its books stay in your library, and Undo brings it back." AutomationProperties.Name="Delete the collection" />
          </StackPanel>
          <!-- A saved search's own actions (slice 3 plan, choice 17; Pinned Views plan, choice 7). Deleting it never deletes a book. -->
          <StackPanel x:Name="ViewActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                      Visibility="{Binding SmartViews.IsView, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button x:Name="RenameView" Content="Rename" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,0" Command="{Binding SmartViews.RenameViewCommand}"
                    AutomationProperties.Name="Rename the saved search" />
            <Button x:Name="PinView" Content="{Binding PinLabel}" c:Ui.Icon="{StaticResource Icon.Pin}" Margin="0,0,8,0" Command="{Binding TogglePinCommand}"
                    ToolTip="Pinned searches show in the sidebar and on Home" AutomationProperties.Name="{Binding PinLabel, StringFormat='{}{0} the saved search'}" />
            <Button x:Name="DeleteView" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Trash2}" Command="{Binding SmartViews.DeleteViewCommand}"
                    ToolTip="Delete the saved search. Your books stay as they are, and Undo brings it back." AutomationProperties.Name="Delete the saved search" />
          </StackPanel>
          <!-- Favorites pins and unpins here (Pinned Views plan, choice 7). -->
          <StackPanel x:Name="FavoritesActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                      Visibility="{Binding IsFavoritesPage, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button x:Name="PinFavorites" Content="{Binding PinLabel}" c:Ui.Icon="{StaticResource Icon.Pin}" Command="{Binding TogglePinCommand}"
                    ToolTip="Pinned, Favorites shows in the sidebar and on Home" AutomationProperties.Name="{Binding PinLabel, StringFormat='{}{0} Favorites'}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.H1}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" />
          </StackPanel>
        </DockPanel>

        <!-- .bt-toolbar: results tabs while searching; filters, sort and layout always. -->
        <Border Grid.Row="1" Margin="0,0,42,0" Padding="0,0,0,15" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasFolders, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <!-- The tabs keep their width; the buttons wrap onto another row on a narrow window (at 200% scaling, say). -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,0,-8">
              <Border Margin="0,0,0,8" Visibility="{Binding ShowLayoutChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <Button Content="Select" c:Ui.Icon="{StaticResource Icon.CopyCheck}" Command="{Binding Selection.StartSelectingCommand}" Margin="0,0,8,0"
                        ToolTip="Tick books to edit their metadata together" AutomationProperties.Name="Select books"
                        Visibility="{Binding Selection.Books.IsActive, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
              </Border>
              <Button x:Name="SaveView" Content="Save search" c:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding SmartViews.SaveViewCommand}" Margin="0,0,8,8"
                      ToolTip="Keep this search, its filters and order, pinned in the sidebar"
                      Visibility="{Binding SmartViews.CanSaveView, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <!-- Every saved search, pinned or not, each with its pin, Rename and Delete (Pinned Views plan, choice 11). -->
              <Button x:Name="SavedSearches" Content="Saved searches" c:Ui.Icon="{StaticResource Icon.List}" Command="{Binding SmartViews.ShowSavedSearchesCommand}" Margin="0,0,8,8"
                      ToolTip="Every search you've saved, pinned or not"
                      Visibility="{Binding SmartViews.HasSavedSearches, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <Popup x:Name="SavedSearchesPopup" PlacementTarget="{Binding ElementName=SavedSearches}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                     IsOpen="{Binding SmartViews.IsSavedSearchesOpen}" Opened="SavedSearchesPopup_Opened" PreviewKeyDown="SavedSearchesPopup_PreviewKeyDown">
                <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="7" Padding="6,8"
                        Width="320" TextElement.Foreground="{DynamicResource Bt.Text}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SAVED SEARCHES" Style="{StaticResource Text.Eyebrow}" Margin="8,0,8,6" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                      <ItemsControl x:Name="SavedSearchList" ItemsSource="{Binding SmartViews.SavedSearches}" Focusable="False" AutomationProperties.Name="Saved searches">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:SavedSearchRow}">
                            <DockPanel>
                              <Button x:Name="DeleteSavedSearch" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Trash2}"
                                      ToolTip="Delete. Your books stay as they are, and Undo brings it back." AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}"
                                      Command="{Binding Searches.DeleteSavedSearchCommand}" CommandParameter="{Binding}" />
                              <Button x:Name="RenameSavedSearch" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}"
                                      ToolTip="Rename" AutomationProperties.Name="{Binding Name, StringFormat='Rename {0}'}"
                                      Command="{Binding Searches.RenameSavedSearchCommand}" CommandParameter="{Binding}" />
                              <Button x:Name="PinSavedSearch" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pin}"
                                      c:Ui.IsActive="{Binding IsPinned}" ToolTip="{Binding PinAction}" AutomationProperties.HelpText="{Binding PinAction}"
                                      Command="{Binding Searches.TogglePinSavedSearchCommand}" CommandParameter="{Binding}">
                                <AutomationProperties.Name>
                                  <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="PinAction" />
                                    <Binding Path="Name" />
                                  </MultiBinding>
                                </AutomationProperties.Name>
                              </Button>
                              <Button x:Name="OpenSavedSearch" Style="{StaticResource Bt.NavButton}" Content="{Binding Name}" c:Ui.Icon="{StaticResource Icon.SlidersHorizontal}"
                                      Margin="0" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                      Command="{Binding Searches.OpenSavedSearchCommand}" CommandParameter="{Binding}">
                                <Button.ContentTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </Button.ContentTemplate>
                              </Button>
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Popup>
              <Button x:Name="FiltersButton" Content="{Binding Filters.FiltersLabel}" c:Ui.Icon="{StaticResource Icon.SlidersHorizontal}" Command="{Binding Filters.ToggleFiltersCommand}"
                      Margin="0,0,8,8" AutomationProperties.Name="Filters" AutomationProperties.HelpText="{Binding Filters.FiltersLabel}" />
              <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortChoice}"
                        AutomationProperties.Name="Sort" Margin="0,0,8,8" />
              <Border Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center" Margin="0,0,0,8"
                      Visibility="{Binding ShowLayoutChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Bt.Segment}" IsChecked="{Binding IsGridLayout}" ToolTip="Covers" AutomationProperties.Name="Show covers">
                    <c:LucideIcon Data="{StaticResource Icon.LayoutGrid}" Size="15" />
                  </RadioButton>
                  <RadioButton Style="{StaticResource Bt.Segment}" IsChecked="{Binding IsListLayout}" ToolTip="List" AutomationProperties.Name="Show a list">
                    <c:LucideIcon Data="{StaticResource Icon.List}" Size="15" />
                  </RadioButton>
                </StackPanel>
              </Border>
              <!-- Packs as one card each, or every file in them on a card of its own; the matching pages follow it too. -->
              <Border Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center" Margin="8,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="PacksViewButton" Style="{StaticResource Bt.Segment}" IsChecked="{Binding IsPacksView}" ToolTip="Packs" AutomationProperties.Name="Show packs">
                    <c:LucideIcon Data="{StaticResource Icon.Package}" Size="15" />
                  </RadioButton>
                  <RadioButton x:Name="FilesViewButton" Style="{StaticResource Bt.Segment}" IsChecked="{Binding IsFilesView}" ToolTip="Each file" AutomationProperties.Name="Show each file">
                    <c:LucideIcon Data="{StaticResource Icon.Files}" Size="15" />
                  </RadioButton>
                </StackPanel>
              </Border>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Results"
                        Visibility="{Binding IsSearching, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <RadioButton Style="{StaticResource Bt.Tab}" Content="{Binding DocumentsTabLabel}" IsChecked="{Binding IsDocumentsTab}" />
              <RadioButton Style="{StaticResource Bt.Tab}" Content="{Binding PagesTabLabel}" IsChecked="{Binding IsPagesTab}" />
            </StackPanel>
          </Grid>
        </Border>

        <!--
          The filters: the four most books are found by first, then the rest folded under More filters in groups. Two
          rows at most before they scroll, so a short window (or 200% scaling) still has room for the books; more while
          the groups are open.
        -->
        <ScrollViewer Grid.Row="2" Margin="0,15,42,-12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Visibility="{Binding Filters.ShowFilters, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="MaxHeight" Value="140" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Filters.ShowMoreFilters}" Value="True">
                  <Setter Property="MaxHeight" Value="300" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <StackPanel>
            <WrapPanel>
              <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Game system" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.SystemChoices}" SelectedItem="{Binding Filters.SystemChoice}"
                          AutomationProperties.Name="Game system" MinWidth="180" />
              </StackPanel>
              <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.TypeChoices}" SelectedItem="{Binding Filters.TypeChoice}"
                          AutomationProperties.Name="Type" MinWidth="160" />
              </StackPanel>
              <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Character level" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.LevelChoices}" SelectedItem="{Binding Filters.LevelChoice}"
                            AutomationProperties.Name="Character level" MinWidth="110" MaxDropDownHeight="320" />
                  <CheckBox Content="Include unknown levels" IsChecked="{Binding Filters.IncludeUnknownLevels}" Margin="10,0,0,0" VerticalAlignment="Center"
                            FontSize="11" Foreground="{DynamicResource Bt.Text}"
                            Visibility="{Binding Filters.HasLevelChoice, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Players" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.PlayersChoices}" SelectedItem="{Binding Filters.PlayersChoice}"
                          AutomationProperties.Name="Players" MinWidth="130" ToolTip="Books written for this many players" />
              </StackPanel>
              <Button x:Name="MoreFilters" Style="{StaticResource Bt.Link}" Content="{Binding Filters.MoreFiltersLabel}" Command="{Binding Filters.ToggleMoreFiltersCommand}"
                      VerticalAlignment="Bottom" Margin="0,0,16,20" ToolTip="Style, duration, setting, publisher, where books live, and housekeeping" />
              <Button Content="Clear filters" Command="{Binding Filters.ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
            </WrapPanel>
            <StackPanel x:Name="MoreFilterGroups" Visibility="{Binding Filters.ShowMoreFilters, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="THE ADVENTURE" Style="{StaticResource Text.Eyebrow}" Margin="0,4,0,8" Visibility="{Binding Filters.ShowAdventureFilters, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <WrapPanel Visibility="{Binding Filters.ShowAdventureFilters, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowStyleChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Style" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.StyleChoices}" SelectedItem="{Binding Filters.StyleChoice}"
                            AutomationProperties.Name="Style" MinWidth="150" ToolTip="The kind of adventure: a heist, a dungeon crawl, a hexcrawl" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowDurationChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Duration" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.DurationChoices}" SelectedItem="{Binding Filters.DurationChoice}"
                            AutomationProperties.Name="Duration" MinWidth="150" ToolTip="How long it takes to play: a one-shot, a few sessions, a campaign" />
                </StackPanel>
              </WrapPanel>
              <!--
                Type-ahead filters for fields with too many values for a menu: typing lists the matching values with their
                counts, and picking one adds a chip under the box. A box's chips widen it; the boxes narrow together.
              -->
              <TextBlock Text="ABOUT THE BOOK" Style="{StaticResource Text.Eyebrow}" Margin="0,4,0,8" Visibility="{Binding Filters.ShowAboutFilters, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <ItemsControl x:Name="ChipFilters" ItemsSource="{Binding Filters.ChipFilters}" Focusable="False" AutomationProperties.Name="About the book"
                            KeyboardNavigation.TabNavigation="Continue" Visibility="{Binding Filters.ShowAboutFilters, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ChipFilterViewModel}">
                    <StackPanel Width="200" Margin="0,0,12,12" Visibility="{Binding IsOffered, Converter={StaticResource Bt.VisibleWhenTrue}}">
                      <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                      <TextBox x:Name="ChipFilterBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Hint}">
                        <TextBox.InputBindings>
                          <KeyBinding Key="Enter" Command="{Binding PickHighlightedCommand}" />
                          <KeyBinding Key="Down" Command="{Binding HighlightNextCommand}" />
                          <KeyBinding Key="Up" Command="{Binding HighlightPreviousCommand}" />
                          <KeyBinding Key="Escape" Command="{Binding DismissCommand}" />
                        </TextBox.InputBindings>
                      </TextBox>
                      <!-- Open while the box has focus and something matches; a popup doesn't take the window's text colour, so it is set here. -->
                      <Popup PlacementTarget="{Binding ElementName=ChipFilterBox}" Placement="Bottom" AllowsTransparency="True" Focusable="False" StaysOpen="True"
                             MinWidth="{Binding ActualWidth, ElementName=ChipFilterBox}">
                        <Popup.Style>
                          <Style TargetType="Popup">
                            <Setter Property="IsOpen" Value="False" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding HasSuggestions}" Value="True" />
                                  <Condition Binding="{Binding PlacementTarget.IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsOpen" Value="True" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Popup.Style>
                        <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="7"
                                Margin="0,4,0,0" Padding="4" MaxWidth="320" TextElement.Foreground="{DynamicResource Bt.Text}"
                                TextElement.FontFamily="{StaticResource Font.Sans}" TextElement.FontSize="11">
                          <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False" AutomationProperties.Name="{Binding Label, StringFormat='{}{0} that match'}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:ChipSuggestion}">
                                <Button Style="{StaticResource SuggestionRow}" AutomationProperties.Name="{Binding Spoken}"
                                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                  <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Text="{Binding Count}" Foreground="{DynamicResource Bt.Muted}" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Bt.Text}" />
                                  </DockPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Popup>
                      <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource FilterChipTemplate}" Focusable="False" Margin="0,6,0,0"
                                    KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="{Binding Label, StringFormat='{}{0} picked'}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="WHERE IT LIVES" Style="{StaticResource Text.Eyebrow}" Margin="0,4,0,8" />
              <WrapPanel>
                <StackPanel Margin="0,0,12,12">
                  <TextBlock Text="Source folder" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.FolderChoices}" SelectedItem="{Binding Filters.FolderChoice}"
                            AutomationProperties.Name="Source folder" MinWidth="200" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowOwnChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Also own" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.OwnChoices}" SelectedItem="{Binding Filters.OwnChoice}"
                            AutomationProperties.Name="Also own" MinWidth="150" ToolTip="Books you also own in print or on a virtual tabletop" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowStoreChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Get it from" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.StoreChoices}" SelectedItem="{Binding Filters.StoreChoice}"
                            AutomationProperties.Name="Get it from" MinWidth="150" ToolTip="Where you got it, or can get it again" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="HOUSEKEEPING" Style="{StaticResource Text.Eyebrow}" Margin="0,4,0,8" />
              <WrapPanel>
                <StackPanel Margin="0,0,12,12">
                  <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.KindChoices}" SelectedItem="{Binding Filters.KindChoice}"
                            AutomationProperties.Name="Kind" MinWidth="150" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowAiChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="AI" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.AiChoices}" SelectedItem="{Binding Filters.AiChoice}"
                            AutomationProperties.Name="Read by AI" MinWidth="150" ToolTip="Books a model has read and catalogued" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowCopiesChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Copies" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.CopiesChoices}" SelectedItem="{Binding Filters.CopiesChoice}"
                            AutomationProperties.Name="Copies" MinWidth="150" ToolTip="Books that are in more than one file" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowFoundChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Found online" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.FoundChoices}" SelectedItem="{Binding Filters.FoundChoice}"
                            AutomationProperties.Name="Found online" MinWidth="150" ToolTip="Books an online catalogue found, such as RPGGeek or Open Library, or those none found" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowPartsChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Adventures inside files" Style="{StaticResource FieldLabel}" />
                  <ComboBox x:Name="PartsFilter" Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.PartsChoices}" SelectedItem="{Binding Filters.PartsChoice}"
                            AutomationProperties.Name="Adventures inside files" MinWidth="150"
                            ToolTip="Adventures marked inside a compilation: inside their book, where a search still finds them; as cards of their own; or hidden" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Visibility="{Binding Filters.ShowCollectionChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <TextBlock Text="Collection" Style="{StaticResource FieldLabel}" />
                  <ComboBox x:Name="CollectionsFilter" Style="{StaticResource Bt.Select}" ItemsSource="{Binding Filters.CollectionChoices}"
                            SelectedItem="{Binding Filters.CollectionChoice}" AutomationProperties.Name="Collection" MinWidth="150"
                            ToolTip="Books you've put in a collection, or those in none yet" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- .bt-sectionline -->
        <StackPanel Grid.Row="3" Margin="0,23,42,0">
          <!-- The part of the library shown, such as Favorites (slice 3 plan, choice 3); its × shows the whole library. -->
          <Border x:Name="ScopeChip" Style="{StaticResource Bt.Chip}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="10,2,2,2"
                  Visibility="{Binding HasScope, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ScopeChip}" FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
              <Button x:Name="ClearScope" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" MinWidth="22" MinHeight="22"
                      Margin="4,0,0,0" Padding="2" ToolTip="Show your whole library" AutomationProperties.Name="Show your whole library"
                      Command="{Binding ClearScopeCommand}" />
            </StackPanel>
          </Border>
          <!-- The filters that are on, with the panel open or closed; each chip's × turns its filter off. -->
          <DockPanel Margin="0,0,0,6" Visibility="{Binding Filters.HasActiveFilters, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button x:Name="ClearFilterChips" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Clear filters" VerticalAlignment="Top"
                    Margin="12,4,0,0" Command="{Binding Filters.ClearFiltersCommand}" Visibility="{Binding Filters.HasSeveralFilters, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            <ItemsControl x:Name="FilterChips" ItemsSource="{Binding Filters.ActiveFilters}" ItemTemplate="{StaticResource FilterChipTemplate}" Focusable="False"
                          AutomationProperties.Name="Filters on" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </DockPanel>
          <!-- A collection's sub-collections, as cards above its books, and the switch that leaves their books out (choice 9). -->
          <StackPanel Visibility="{Binding HasSubCollections, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <ItemsControl x:Name="SubCollections" ItemsSource="{Binding SubCollections}" ItemTemplate="{StaticResource CollectionCard}"
                          Focusable="False" AutomationProperties.Name="Collections inside this one" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <CheckBox x:Name="OnlyAddedHere" Content="Only books added here" IsChecked="{Binding OnlyAddedHere}" Margin="0,0,0,14" FontSize="11"
                      Foreground="{DynamicResource Bt.Text}" ToolTip="Leave out the books that are only in the collections inside this one" />
          </StackPanel>
          <!-- A saved search whose search, filters or order were changed: keep the change in it, or as a new one. -->
          <Border x:Name="ViewChanged" Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,8" Margin="0,0,0,14"
                  Visibility="{Binding SmartViews.IsViewChanged, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UpdateView" Style="{StaticResource Bt.Button.Primary}" Content="Update saved search" Command="{Binding SmartViews.UpdateViewCommand}" Margin="0,0,8,0"
                        ToolTip="The saved search keeps the search, filters and order shown now" />
                <Button x:Name="SaveViewAsNew" Content="Save as new" Command="{Binding SmartViews.SaveViewAsNewCommand}" ToolTip="Keep both: a new saved search, and this one as it was" />
              </StackPanel>
              <TextBlock Text="You've changed this saved search." FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBlock x:Name="ViewNote" Text="{Binding SmartViews.ViewNote}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,14"
                     Visibility="{Binding SmartViews.ViewNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <!-- What the last saved search change did, with Undo. -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                  Visibility="{Binding SmartViews.ViewUndo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
            <DockPanel>
              <Button x:Name="UndoView" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                      Command="{Binding SmartViews.ViewUndo.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the saved search change"
                      Visibility="{Binding SmartViews.ViewUndo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock x:Name="ViewMessage" Text="{Binding SmartViews.ViewUndo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <!-- What the last collection change did, with Undo. -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                  Visibility="{Binding Collections.Undo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
            <DockPanel>
              <Button x:Name="UndoCollection" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                      Command="{Binding Collections.Undo.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the collection change"
                      Visibility="{Binding Collections.Undo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock x:Name="CollectionMessage" Text="{Binding Collections.Undo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <!-- What the last Add to binder did, with Undo. -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                  Visibility="{Binding Sessions.Undo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
            <DockPanel>
              <Button x:Name="UndoSession" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                      Command="{Binding Sessions.Undo.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the binder change"
                      Visibility="{Binding Sessions.Undo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock x:Name="SessionMessage" Text="{Binding Sessions.Undo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Select mode's bar and the count stay in view while the head scrolls. -->
    <StackPanel x:Name="PageFoot" Grid.Row="1" Margin="0,0,42,17">
      <!--
        Select mode: how many are ticked, Edit metadata, Clear and Done. The buttons wrap onto another row on a narrow
        window (at 200% scaling, say) rather than run off its edge.
      -->
      <Border Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,4" Margin="0,0,0,14" AutomationProperties.Name="Selection"
              Visibility="{Binding Selection.Books.IsActive, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <WrapPanel>
          <TextBlock Text="{Binding Selection.Books.Summary}" FontSize="12" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center"
                     Margin="0,4,16,4" />
          <Button Style="{StaticResource Bt.Button.Primary}" Content="Edit metadata" c:Ui.Icon="{StaticResource Icon.Pencil}"
                  Command="{Binding Selection.EditSelectedCommand}" Margin="0,4,8,4" ToolTip="Change fields on every selected book at once" />
          <Button x:Name="AddSelectedToCollection" Content="Add to collection" c:Ui.Icon="{StaticResource Icon.FolderPlus}" Margin="0,4,8,4"
                  Click="DropDown_Click" IsEnabled="{Binding Selection.Books.HasAny}" ToolTip="Add every selected book to a collection">
            <Button.ContextMenu>
              <ContextMenu Style="{StaticResource Bt.Menu}" c:CollectionMenu.Command="{Binding AddSelectedToCollectionCommand}" />
            </Button.ContextMenu>
          </Button>
          <Button x:Name="AddSelectedToSession" Content="Add to binder" c:Ui.Icon="{StaticResource Icon.NotebookPen}" Margin="0,4,8,4"
                  Click="DropDown_Click" IsEnabled="{Binding Selection.Books.HasAny}" ToolTip="Add every selected book to a binder">
            <Button.ContextMenu>
              <ContextMenu Style="{StaticResource Bt.Menu}" c:SessionMenu.Command="{Binding AddSelectedToSessionCommand}" />
            </Button.ContextMenu>
          </Button>
          <Button x:Name="JoinSelected" Content="Same book" c:Ui.Icon="{StaticResource Icon.Copy}" Margin="0,4,8,4" Command="{Binding Selection.JoinSelectedCommand}"
                  ToolTip="Join the selected cards as one book: copies, or versions of it" AutomationProperties.Name="Join the selected cards as one book"
                  Visibility="{Binding Selection.CanJoinSelected, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button x:Name="PackSelected" Content="Pack together" c:Ui.Icon="{StaticResource Icon.LayoutGrid}" Margin="0,4,8,4" Command="{Binding Selection.PackSelectedCommand}"
                  ToolTip="Put the selected images and packs into one pack" AutomationProperties.Name="Put the selected images and packs into one pack"
                  Visibility="{Binding Selection.CanPackSelected, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button x:Name="RemoveSelectedParts" Content="Remove adventures" c:Ui.Icon="{StaticResource Icon.Trash2}" Margin="0,4,8,4"
                  Command="{Binding Selection.RemoveSelectedPartsCommand}" ToolTip="Take away the selected adventures' cards. Their pages stay in their files."
                  AutomationProperties.Name="Remove the selected adventures"
                  Visibility="{Binding Selection.CanRemoveSelectedParts, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button x:Name="RemoveSelectedFromCollection" Content="Remove from collection" Margin="0,4,8,4" Command="{Binding RemoveSelectedFromCollectionCommand}"
                  ToolTip="Take the selected books out of this collection. They stay in your library."
                  Visibility="{Binding IsCollection, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button x:Name="ExportSelected" Content="Export these" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Margin="0,4,8,4"
                  Command="{Binding Selection.ExportSelectedCommand}" ToolTip="Save the selected books as a CSV file, for a spreadsheet"
                  AutomationProperties.Name="Export the selected books" />
          <Button Content="Clear" Command="{Binding Selection.ClearSelectionCommand}" Margin="0,4,8,4" AutomationProperties.Name="Clear the selection" />
          <Button Content="Done" Command="{Binding Selection.StopSelectingCommand}" Margin="0,4,0,4" ToolTip="Leave Select mode (Esc)" AutomationProperties.Name="Done selecting" />
        </WrapPanel>
      </Border>
      <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
              Visibility="{Binding Selection.Undo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
        <DockPanel>
          <Button x:Name="UndoBulk" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding Selection.Undo.UndoCommand}"
                  Padding="12,0,0,0" AutomationProperties.Name="Undo the change" Visibility="{Binding Selection.Undo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock Text="{Binding Selection.Undo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <DockPanel Visibility="{Binding IsEmpty, Converter={StaticResource Bt.CollapsedWhenTrue}}">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Coverage}" Style="{StaticResource Text.Small}" Margin="15,0,0,0"
                   Visibility="{Binding Coverage, Converter={StaticResource Bt.VisibleWhenSet}}" />
        <TextBlock FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap">
          <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="Medium" Foreground="{DynamicResource Bt.Text}" /> <Run Text="{Binding CountLabel, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
      <Border HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,5" CornerRadius="4" Background="{DynamicResource Bt.Warm}"
              Visibility="{Binding IssueText, Converter={StaticResource Bt.VisibleWhenSet}}">
        <TextBlock Text="{Binding IssueText}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="2">
      <!-- .bt-books: the cover grid. Only the covers in view are created. -->
      <ListBox x:Name="CoverGrid" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Items}" Padding="0,0,30,0"
               AutomationProperties.Name="Books" c:Ui.TourAnchor="FirstBooks" c:ItemActivation.Command="{Binding ActivateCommand}"
               c:ItemActivation.RangeCommand="{Binding Selection.SelectRangeCommand}"
               c:ItemActivation.DoubleCommand="{Binding OpenFromCardCommand}"
               ItemContainerStyle="{StaticResource CoverItem}" c:NewWindowGesture.Command="{Binding OpenBookInNewWindowCommand}"
               Visibility="{Binding ShowGrid, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <vwp:VirtualizingWrapPanel ItemSize="172,318" SpacingMode="BetweenItemsOnly" StretchItems="False" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <StackPanel x:Name="Card" Width="150" HorizontalAlignment="Left" Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.ItemStatus="{Binding AvailabilityLabel}">
              <Grid x:Name="CoverArea">
                <ContentControl x:Name="CoverBox" Height="208" Content="{Binding}" ContentTemplate="{StaticResource Cover}" Focusable="False">
                  <ContentControl.Effect>
                    <DropShadowEffect BlurRadius="7" ShadowDepth="3" Direction="270" Opacity="0.15" />
                  </ContentControl.Effect>
                </ContentControl>
                <Button x:Name="Heart" Style="{StaticResource CoverHeart}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tick}" Focusable="False" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding DataContext.Selection.Books.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              </Grid>
              <TextBlock Text="{Binding Title}" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
              <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger SourceName="CoverArea" Property="IsMouseOver" Value="True">
                <Setter TargetName="CoverArea" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="-4" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- .bt-listrow: the detail list. -->
      <ListBox x:Name="DetailList" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Items}" Padding="0,0,30,0"
               AutomationProperties.Name="Books" c:Ui.TourAnchor="FirstBooks" c:ItemActivation.Command="{Binding ActivateCommand}"
               c:ItemActivation.RangeCommand="{Binding Selection.SelectRangeCommand}"
               c:ItemActivation.DoubleCommand="{Binding OpenFromCardCommand}"
               ItemContainerStyle="{StaticResource BookItem}" c:NewWindowGesture.Command="{Binding OpenBookInNewWindowCommand}"
               Visibility="{Binding ShowList, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <Border x:Name="Row" Padding="0,14" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Background="Transparent"
                    Cursor="Hand" AutomationProperties.Name="{Binding Title}" AutomationProperties.ItemStatus="{Binding AvailabilityLabel}">
              <!--
                System, type, levels and players share the row with the title, up to their own widths: on a narrow window (at 200%
                scaling, say) they trim before the heart and the chevron at the end are pushed out of the row.
              -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="3*" MinWidth="110" />
                  <ColumnDefinition Width="1.3*" MaxWidth="130" />
                  <ColumnDefinition Width="1.1*" MaxWidth="110" />
                  <ColumnDefinition Width="0.9*" MaxWidth="90" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="27" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tick}" Focusable="False" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Visibility="{Binding DataContext.Selection.Books.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                  <ContentControl Width="46" Height="64" Content="{Binding}" ContentTemplate="{StaticResource Cover}" Focusable="False" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Byline}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SystemLabel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Game system" />
                <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Type" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding LevelsLabel}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Character levels" />
                  <TextBlock Text="{Binding PlayersLabel}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             ToolTip="Players" Visibility="{Binding PlayersLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Text.Small}" />
                  <TextBlock Text="{Binding CopiesLabel}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" ToolTip="Files of this book in your library"
                             Visibility="{Binding CopiesLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                  <TextBlock Text="{Binding AvailabilityLabel}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" ToolTip="{Binding AvailabilityTip}"
                             Visibility="{Binding AvailabilityLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                </StackPanel>
                <Button x:Name="Heart" Grid.Column="6" Style="{StaticResource CoverHeart}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" FontSize="14"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <c:LucideIcon Grid.Column="7" Data="{StaticResource Icon.ChevronRight}" Size="15" Foreground="{DynamicResource Bt.Muted}"
                              VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bt.Side}" />
                <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- .bt-hit: matching pages, grouped by book. -->
      <ListBox x:Name="PageHits" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Hits}" Padding="0,0,30,0"
               AutomationProperties.Name="Matching pages" KeyboardNavigation.TabNavigation="Continue"
               Visibility="{Binding ShowHits, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DocumentHitsViewModel}">
            <Border Padding="0,21" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Height="83" VerticalAlignment="Top" Content="{Binding Item}" ContentTemplate="{StaticResource Cover}" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                  <Button Style="{StaticResource TitleLink}" Content="{Binding Item.Title}" AutomationProperties.Name="{Binding Item.Title, StringFormat='Details for {0}'}"
                          Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Item}" />
                  <TextBlock Text="{Binding Item.Meta}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PageHitViewModel}">
                        <StackPanel Margin="0,12,0,0">
                          <DockPanel>
                            <!-- Open in new window also by middle-click or Shift+Enter on Open page. -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}"
                                    VerticalAlignment="Top" Margin="4,0,0,0" ToolTip="Open in new window (Shift+Enter)"
                                    AutomationProperties.Name="{Binding Where, StringFormat='Open {0} in new window'}"
                                    Command="{Binding DataContext.OpenPageInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Plus}"
                                    VerticalAlignment="Top" Margin="4,0,0,0" ToolTip="Add this page to the current binder"
                                    AutomationProperties.Name="{Binding Where, StringFormat='Add {0} to the binder'}"
                                    Command="{Binding DataContext.AddPageToSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="Open page" c:Ui.Icon="{StaticResource Icon.BookOpen}" VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding Where, StringFormat='Open {0}'}"
                                    Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    c:NewWindowGesture.Command="{Binding DataContext.OpenPageInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Where}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
                          </DockPanel>
                          <TextBlock c:Highlight.Snippet="{Binding Snippet}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap"
                                     LineHeight="20" Margin="0,6,0,4" />
                          <Border Style="{StaticResource Bt.Chip}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding More}" Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                             Visibility="{Binding HasMore, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsEmpty, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <c:EmptyState Margin="0,0,42,0" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}" ActionText="{Binding EmptyActionText}"
                      Command="{Binding EmptyCommand}" />
      </ScrollViewer>
    </Grid>

    <!-- .bt-drawer: the inspector, over the page. Esc, the close button or a click outside closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding Inspector, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border x:Name="DrawerShade" Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" MouseLeftButtonDown="DrawerShade_MouseLeftButtonDown"
              MouseLeftButtonUp="DrawerShade_MouseLeftButtonUp" />
      <Border x:Name="Drawer" HorizontalAlignment="Right" Width="440" Margin="0,-36,0,0" DataContext="{Binding Inspector}"
              Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1,0,0,0"
              IsVisibleChanged="Drawer_IsVisibleChanged" d:DataContext="{d:DesignInstance vm:InspectorViewModel}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.1" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="28">
            <DockPanel Margin="0,0,0,24">
              <Button x:Name="CloseDrawer" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}"
                      ToolTip="Close (Esc)" AutomationProperties.Name="Close details"
                      Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <Button x:Name="FavoriteBook" DockPanel.Dock="Right" Style="{StaticResource Bt.HeartButton}" Margin="0,0,4,0"
                      c:Ui.IsActive="{Binding Item.IsFavorite}" ToolTip="{Binding Item.FavoriteAction}" AutomationProperties.Name="{Binding Item.FavoriteAction}"
                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Item}" />
              <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
            </DockPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentControl Height="153" VerticalAlignment="Top" Content="{Binding Item}" ContentTemplate="{StaticResource Cover}" Focusable="False" />
              <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock Text="{Binding Item.KindLabel}" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6"
                           Visibility="{Binding Item.KindLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                <TextBlock Text="{Binding Item.Title}" FontFamily="{StaticResource Font.Display}" FontSize="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource Bt.Text}" />
                <TextBlock Text="{Binding Item.PublisherLabel}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                           Visibility="{Binding Item.PublisherLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                <WrapPanel Margin="0,12,0,0">
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.SystemLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.SystemLabel}" FontSize="10" Foreground="{DynamicResource Bt.Text}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.LevelsLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.LevelsLabel}" FontSize="10" Foreground="{DynamicResource Bt.Text}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.PlayersLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.PlayersLabel}" FontSize="10" Foreground="{DynamicResource Bt.Text}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}">
                    <TextBlock Text="{Binding Item.FormatLabel}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.PagesLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.PagesLabel}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
                  </Border>
                </WrapPanel>
              </StackPanel>
            </Grid>

            <!--
              The book's actions, in one row under the cover: what it opens with on the left, labelled (they wrap when there
              are many); pin, binder and Cataloged wrong… on the right, as icons.
            -->
            <DockPanel Margin="0,20,0,-8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,8">
                <Button x:Name="PinBook" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pin}" c:Ui.IsActive="{Binding IsPinned}"
                        ToolTip="{Binding PinAction}" AutomationProperties.Name="{Binding PinAction}" CommandParameter="{Binding Item}"
                        Command="{Binding DataContext.TogglePinBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <!-- Add to binder (slice 3c): the current session, another or a new one. -->
                <Button x:Name="AddToSession" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.NotebookPen}" Margin="2,0,0,0"
                        Click="DropDown_Click" ToolTip="Add to binder" AutomationProperties.Name="Add to binder">
                  <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource Bt.Menu}" c:SessionMenu.Command="{x:Static c:BookCommands.AddToSession}" />
                  </Button.ContextMenu>
                </Button>
                <!-- Cataloged wrong… (scenario review, row 8): the details below, open to correct, with the guesses marked. -->
                <Button x:Name="CatalogedWrong" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="2,0,0,0"
                        ToolTip="Cataloged wrong? Correct its details: the values Bibliotaph guessed are marked" AutomationProperties.Name="Cataloged wrong…"
                        Command="{Binding StartCorrectingCommand}" Visibility="{Binding IsCorrecting, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
              </StackPanel>
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,8" Visibility="{Binding CanOpen, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <Button x:Name="OpenBook" Style="{StaticResource Bt.Button.Primary}" Content="Open" c:Ui.Icon="{StaticResource Icon.BookOpen}"
                          AutomationProperties.Name="{Binding Item.Title, StringFormat='Open {0}'}"
                          Command="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          c:NewWindowGesture.Command="{Binding DataContext.OpenBookInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Item}" />
                  <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Margin="4,0,0,0"
                          ToolTip="Open in new window (Shift+Enter)" AutomationProperties.Name="{Binding Item.Title, StringFormat='Open {0} in new window'}"
                          Command="{Binding DataContext.OpenBookInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Item}" />
                </StackPanel>
                <!-- Online libraries (O1, O2b): the book's page where it is owned online, in the online reader. -->
                <Button x:Name="OpenOnline" Content="{Binding Item.OnlineAction}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Margin="0,0,8,8"
                        ToolTip="{Binding Item.OnlineLink}" AutomationProperties.Name="{Binding Item.OnlineAction}"
                        Command="{Binding DataContext.OpenOnlineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Item}" Visibility="{Binding Item.HasOnlineLink, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <!-- Ask this book (Ask plan, choice 11): shown only for a PDF with text while AI is on, when it can run. -->
                <Button x:Name="AskBook" Content="Ask this book" c:Ui.Icon="{StaticResource Icon.Sparkles}" Margin="0,0,8,8"
                        ToolTip="Open this book with its Ask panel, to ask it a question" AutomationProperties.Name="Ask this book"
                        Command="{Binding DataContext.AskBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Item}"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <!-- A PDF whose protection Bibliotaph can't open (4i): the user's default PDF app may. -->
                <Button x:Name="OpenElsewhere" Content="Open in another app" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Margin="0,0,8,8"
                        ToolTip="Opens the file in your default PDF app" AutomationProperties.Name="Open in another app"
                        Command="{Binding DataContext.OpenElsewhereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Item}" Visibility="{Binding Item.CanOpenElsewhere, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <!-- A book owned elsewhere has nothing to open; the user made it, so they can remove it (F5 plan, choice 5). -->
                <!-- A book with no file has no page to draw a cover from: the user can pick a picture of their own. -->
                <Button x:Name="ChooseCover" Content="Choose a cover image…" c:Ui.Icon="{StaticResource Icon.Image}" Margin="0,0,8,8"
                        ToolTip="Use a picture of your own as this book's cover" Command="{Binding ChooseCoverCommand}"
                        Visibility="{Binding CanChooseCover, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <Button x:Name="RemoveCover" Content="Remove the cover" c:Ui.Icon="{StaticResource Icon.X}" Margin="0,0,8,8"
                        ToolTip="Stop using the picture you chose as this book's cover" Command="{Binding RemoveCoverCommand}"
                        Visibility="{Binding HasChosenCover, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <Button x:Name="RemoveFromLibrary" Content="Remove from library" c:Ui.Icon="{StaticResource Icon.Trash2}" Margin="0,0,8,8"
                        ToolTip="Take this book out of your library. Undo brings it back." Command="{Binding RemoveFromLibraryCommand}"
                        Visibility="{Binding IsElsewhere, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              </WrapPanel>
            </DockPanel>
            <TextBlock Text="{Binding CoverProblem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding CoverProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <!-- Details and Notes (slice 3f): the book's own note, saved as you type, and the notes on its pages. -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0" AutomationProperties.Name="Details or notes">
              <RadioButton x:Name="DetailsTab" Style="{StaticResource Bt.Tab}" Content="Details" IsChecked="{Binding IsDetailsTab}" />
              <RadioButton x:Name="NotesTab" Style="{StaticResource Bt.Tab}" Content="{Binding Notes.TabLabel, FallbackValue=Notes}" IsChecked="{Binding IsNotesTab}" />
            </StackPanel>
            <StackPanel DataContext="{Binding Notes}" Margin="0,18,0,0"
                        Visibility="{Binding DataContext.IsNotesTab, ElementName=Drawer, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBox x:Name="EntryNote" Style="{StaticResource Bt.TextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="140" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Note on this book" ToolTip="Saved as you type. A search finds the book by its note." />
              <TextBlock Text="Saved as you type. A search finds this book by its note." Style="{StaticResource Text.Small}" Margin="0,6,0,0" />
              <TextBlock Text="ON ITS PAGES" Style="{StaticResource SectionHead}" />
              <TextBlock Text="No page notes yet. Add one in the reader with Note." Style="{StaticResource Text.Small}"
                         Visibility="{Binding HasPageNotes, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
              <ItemsControl x:Name="BookPageNotes" ItemsSource="{Binding PageNotes}" Focusable="False" AutomationProperties.Name="Notes on its pages"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PageNoteRow}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Open" VerticalAlignment="Top" Margin="10,0,0,0"
                                AutomationProperties.Name="{Binding Pages, StringFormat='Open at {0}'}" ToolTip="Open the book at these pages"
                                Command="{Binding DataContext.OpenPageNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Pages}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
                          <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                          <DockPanel Margin="0,6,0,0" Visibility="{Binding HasReason, Converter={StaticResource Bt.VisibleWhenTrue}}">
                            <c:LucideIcon x:Name="NoteReasonIcon" Data="{StaticResource Icon.TriangleAlert}" Size="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </DockPanel>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter TargetName="NoteReasonIcon" Property="Foreground" Value="{DynamicResource Bt.Accent}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding IsDetailsTab, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <!-- The collections the book is in (slice 3 plan, choice 10): a chip opens one, its × takes the book out. -->
            <DockPanel Margin="0,28,0,10">
              <Button x:Name="AddToCollection" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Add to collection"
                      c:Ui.Icon="{StaticResource Icon.FolderPlus}" Click="DropDown_Click" ToolTip="Add this book to a collection">
                <Button.ContextMenu>
                  <ContextMenu Style="{StaticResource Bt.Menu}" c:CollectionMenu.Command="{x:Static c:BookCommands.AddToCollection}" />
                </Button.ContextMenu>
              </Button>
              <TextBlock Text="COLLECTIONS" Style="{StaticResource DrawerHead}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Not in any collection yet." Style="{StaticResource Text.Small}"
                       Visibility="{Binding HasCollections, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <ItemsControl x:Name="BookCollections" ItemsSource="{Binding Collections}" Focusable="False" AutomationProperties.Name="Collections this book is in"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CollectionChip}">
                  <Border Style="{StaticResource Bt.Chip}" Padding="10,2,2,2" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Bt.Link}" Content="{Binding Name}" Foreground="{DynamicResource Bt.Text}" ToolTip="{Binding Path}"
                              AutomationProperties.Name="{Binding Path, StringFormat='Open {0}'}"
                              Command="{Binding DataContext.OpenInspectorCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" MinWidth="22" MinHeight="22" Margin="4,0,0,0" Padding="2"
                              ToolTip="{Binding Name, StringFormat='Take this book out of {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Remove from {0}'}"
                              Command="{Binding DataContext.RemoveFromInspectorCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A pack's files, images and PDFs: click one to open it, then step through the rest; or split the pack. -->
            <StackPanel Visibility="{Binding IsPack, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <DockPanel Margin="0,28,0,10">
                <Button x:Name="SplitPack" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="{Binding SplitPackLabel}"
                        ToolTip="{Binding SplitPackTip}"
                        Command="{Binding SplitPackCommand}" />
                <!-- A file chosen as the pack's cover (right-click one below): the card can go back to its mosaic. -->
                <Button x:Name="UseMosaic" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Use the mosaic" Margin="0,0,16,0"
                        ToolTip="Show the pack's first four files on its card again" Command="{Binding UseMosaicCommand}"
                        Visibility="{Binding HasPackCover, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock Text="{Binding PackImagesHeading}" Style="{StaticResource DrawerHead}" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl x:Name="PackImages" ItemsSource="{Binding PackImages}" Focusable="False" AutomationProperties.Name="{Binding PackImagesName}"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PackImageViewModel}">
                    <Button Width="88" Margin="0,0,8,10" Padding="0" Cursor="Hand" ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                            Command="{Binding DataContext.OpenPackImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                      <!-- Any file can be the pack's cover in place of the mosaic; the menu key opens this too. -->
                      <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource Bt.Menu}">
                          <MenuItem Header="Use as the pack's cover" CommandParameter="{Binding}"
                                    Visibility="{Binding IsCover, Converter={StaticResource Bt.CollapsedWhenTrue}}"
                                    Command="{Binding PlacementTarget.Tag.UsePackCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <MenuItem Header="Use the mosaic"
                                    Visibility="{Binding IsCover, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                    Command="{Binding PlacementTarget.Tag.UseMosaicCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <StackPanel Background="Transparent">
                            <Border x:Name="Thumb" Height="88" CornerRadius="4" Background="{DynamicResource Bt.Warm}" BorderBrush="{DynamicResource Bt.Line}"
                                    BorderThickness="1" ClipToBounds="True">
                              <Grid>
                                <Image Source="{Binding Tile.Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- A PDF in the pack shows its first page, marked as a PDF; it opens in the reader. -->
                                <Border Padding="4,1" Margin="4" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1"
                                        Visibility="{Binding IsPdf, Converter={StaticResource Bt.VisibleWhenTrue}}">
                                  <TextBlock Text="PDF" FontSize="10" Foreground="{DynamicResource Bt.Text}" />
                                </Border>
                                <!-- The file the pack's card shows in place of its mosaic. -->
                                <Border Padding="4,1" Margin="4" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{DynamicResource Bt.Accent}" AutomationProperties.Name="The pack's cover"
                                        Visibility="{Binding IsCover, Converter={StaticResource Bt.VisibleWhenTrue}}">
                                  <TextBlock Text="Cover" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Bt.AccentText}" />
                                </Border>
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                          </StackPanel>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                              <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Cataloged wrong…: what to do, and Done. Closing the details without a change leaves a Needs review card. -->
            <Border x:Name="CorrectingBanner" Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,10" Margin="0,24,0,0"
                    AutomationProperties.Name="Correcting this book" Visibility="{Binding IsCorrecting, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <DockPanel>
                <Button x:Name="CorrectionDone" DockPanel.Dock="Right" Content="Done" VerticalAlignment="Top" Margin="12,0,0,0"
                        Command="{Binding FinishCorrectingCommand}" AutomationProperties.Name="Done correcting" />
                <StackPanel>
                  <TextBlock Text="What's wrong?" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="Values marked Guessed came from names, the file or the AI model, and nobody has confirmed them. Edit a field, or mark a value Not right. If you leave without changing anything, Needs review keeps a reminder." />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- A correction offered to the books from the same folder that showed the same values (look-alikes). -->
            <Border x:Name="LookAlikeOffer" Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                    AutomationProperties.Name="{Binding LookAlikeQuestion}" Visibility="{Binding HasLookAlikeOffer, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <StackPanel>
                <TextBlock Text="{Binding LookAlikeQuestion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LookAlikeDetail}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="ChangeLookAlikes" Style="{StaticResource Bt.Button.Primary}" Content="Change them" Margin="0,0,8,0"
                          Command="{Binding AcceptLookAlikesCommand}" AutomationProperties.Name="Change the other books too" />
                  <Button x:Name="KeepLookAlikes" Content="No thanks" Command="{Binding DeclineLookAlikesCommand}"
                          AutomationProperties.Name="Leave the other books as they are" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Details: each field's value, where it came from, and the user's corrections. -->
            <DockPanel Margin="0,28,0,4">
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="{Binding MoreFieldsLabel}" Command="{Binding ToggleAllFieldsCommand}"
                      Visibility="{Binding HasHiddenFields, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock Text="DETAILS" Style="{StaticResource DrawerHead}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="DetailFields" ItemsSource="{Binding VisibleFields}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MetadataFieldViewModel}">
                  <Border x:Name="Row" Padding="0,10" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" AutomationProperties.Name="{Binding Label}">
                    <StackPanel>
                      <DockPanel>
                        <Button x:Name="EditButton" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}"
                                ToolTip="Edit" AutomationProperties.Name="{Binding Label, StringFormat='Edit {0}'}" Command="{Binding EditCommand}" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,0,3" />
                          <WrapPanel>
                            <TextBlock x:Name="Value" Text="{Binding Display}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border x:Name="GuessedMark" Style="{StaticResource Bt.Chip}" Background="{DynamicResource Bt.Soft}" Margin="0,0,10,0"
                                    ToolTip="Nobody has confirmed this yet" Visibility="{Binding ShowsGuessed, Converter={StaticResource Bt.VisibleWhenTrue}}">
                              <TextBlock Text="Guessed" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
                            </Border>
                            <Button x:Name="EvidenceLink" Style="{StaticResource Bt.Link}" c:Ui.Icon="{StaticResource Icon.Sparkles}"
                                    Content="{Binding EvidenceLabel}" Command="{Binding ToggleEvidenceCommand}" Padding="0"
                                    AutomationProperties.Name="{Binding Label, StringFormat='Where {0} came from'}"
                                    Visibility="{Binding HasEvidence, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                          </WrapPanel>
                          <!-- Get it from: each store's link, opened in the browser once the user says yes. -->
                          <ItemsControl ItemsSource="{Binding Links}" Focusable="False" Margin="0,2,0,0"
                                        Visibility="{Binding HasLinks, Converter={StaticResource Bt.VisibleWhenTrue}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:MetadataValueViewModel}">
                                <Button Style="{StaticResource Bt.Link}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Padding="0" Margin="0,3,0,0"
                                        HorizontalAlignment="Left" Content="{Binding LinkText}" ToolTip="{Binding Url}"
                                        AutomationProperties.Name="{Binding Text, StringFormat='Open the {0} link'}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DockPanel>

                      <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <TextBox x:Name="Editor" Style="{StaticResource Bt.TextBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding Label}" c:Ui.FocusWhenVisible="True">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding EditHint}" Style="{StaticResource Text.Small}" Margin="0,5,0,0"
                                   Visibility="{Binding EditHint, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding Resolution, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding UsesChoices, Converter={StaticResource Bt.VisibleWhenTrue}}">
                          <TextBlock Text="{Binding ChoicesLabel}" Style="{StaticResource FieldLabel}" />
                          <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Choices}" SelectedItem="{Binding PickedChoice}"
                                    AutomationProperties.Name="{Binding ChoicesLabel}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
                        </StackPanel>
                        <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Style="{StaticResource Bt.Button.Primary}" Content="Save" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}"
                                  Margin="0,0,8,0" />
                          <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                      </StackPanel>

                      <!-- .bt-evidence -->
                      <Border Margin="0,10,0,0" Padding="13" CornerRadius="6" Background="{DynamicResource Bt.Side}"
                              Visibility="{Binding ShowEvidence, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <StackPanel>
                          <ItemsControl ItemsSource="{Binding Values}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:MetadataValueViewModel}">
                                <StackPanel Margin="0,0,0,10">
                                  <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Not right" Padding="10,0,0,0"
                                            AutomationProperties.Name="{Binding Text, StringFormat='{}{0} is not right'}"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                                  </DockPanel>
                                  <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Style="{StaticResource Bt.Link}" Content="Keep this" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding KeepCommand}"
                                  AutomationProperties.Name="{Binding Label, StringFormat='Keep this {0}'}"
                                  Visibility="{Binding IsSuggested, Converter={StaticResource Bt.VisibleWhenTrue}}" />

                          <StackPanel Visibility="{Binding HasAlternatives, Converter={StaticResource Bt.VisibleWhenTrue}}">
                            <TextBlock Text="OTHER SUGGESTIONS" Style="{StaticResource Text.Eyebrow}" FontSize="9" Margin="0,10,0,8" />
                            <ItemsControl ItemsSource="{Binding Alternatives}" Focusable="False">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MetadataValueViewModel}">
                                  <StackPanel Margin="0,0,0,10">
                                    <DockPanel>
                                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource Bt.Link}" Content="Use this" Padding="10,0,0,0"
                                                AutomationProperties.Name="{Binding Text, StringFormat='Use {0}'}"
                                                Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Bt.Link}" Content="Not right" Padding="10,0,0,0"
                                                AutomationProperties.Name="{Binding Text, StringFormat='{}{0} is not right'}"
                                                Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                      </StackPanel>
                                      <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <Button Style="{StaticResource Bt.Link}" Content="Reset to suggestion" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding ResetCommand}"
                                  ToolTip="Forget what you set here and go back to what the sources suggest"
                                  Visibility="{Binding CanReset, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsKnown}" Value="False">
                      <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSuggested}" Value="False">
                      <Setter TargetName="EvidenceLink" Property="c:Ui.Icon" Value="{StaticResource Icon.TextSearch}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                      <Setter TargetName="EvidenceLink" Property="c:Ui.Icon" Value="{StaticResource Icon.TriangleAlert}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                      <Setter TargetName="EditButton" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                      <Setter TargetName="Row" Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- RPGGeek's data is credited to BoardGameGeek wherever it shows, as their terms ask. -->
            <Button Style="{StaticResource Bt.PoweredByBgg}" Margin="0,14,0,0"
                    Visibility="{Binding FromRpgGeek, Converter={StaticResource Bt.VisibleWhenTrue}}" />

            <!--
              Adventures inside a compilation (slice 5): a file lists those marked in it, each a card of its own, with Add,
              Edit range and Remove; an adventure says which file it is in. Pages are typed as the file numbers them.
            -->
            <StackPanel x:Name="FileParts" Visibility="{Binding CanMarkParts, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <DockPanel>
                <Button x:Name="AddPart" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Add" c:Ui.Icon="{StaticResource Icon.Plus}"
                        VerticalAlignment="Bottom" Margin="0,0,0,10" Command="{Binding AddPartCommand}"
                        ToolTip="Give pages of this file a card of their own, as an adventure" AutomationProperties.Name="Add an adventure in this file" />
                <TextBlock Text="{Binding PartsHeading}" Style="{StaticResource SectionHead}" />
              </DockPanel>
              <TextBlock Text="A compilation's adventures can each have a card of their own that opens at their pages. The file isn't changed."
                         Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Visibility="{Binding HasParts, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
              <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" AutomationProperties.Name="Adventures in this file">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:InspectorPart}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12" Margin="0,0,0,8" AutomationProperties.Name="{Binding Title}">
                      <StackPanel>
                        <Button Style="{StaticResource TitleLink}" Content="{Binding Title}" HorizontalAlignment="Left"
                                AutomationProperties.Name="{Binding Title, StringFormat='Details for {0}'}"
                                Command="{Binding DataContext.ShowPartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding PagesText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                          <Button Content="Edit range" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,0"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Edit the pages of {0}'}"
                                  Command="{Binding DataContext.EditPartRangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                          <Button Content="Remove" c:Ui.Icon="{StaticResource Icon.Trash2}" ToolTip="Its card goes; its pages are only the file's again"
                                  AutomationProperties.Name="{Binding Title, StringFormat='Remove the adventure {0}'}"
                                  Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel x:Name="PartOfFile" Visibility="{Binding IsPart, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="IN A FILE" Style="{StaticResource SectionHead}" />
              <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock x:Name="PartOfText" Text="{Binding PartOf}" Style="{StaticResource Text.Row}" TextWrapping="Wrap" />
                  <TextBlock Text="Values set on the file, such as its system and publisher, are this adventure's too unless it has its own."
                             Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="ShowPartFile" Content="Show the file" c:Ui.Icon="{StaticResource Icon.ArrowUpRight}" Margin="0,0,8,8"
                            Command="{Binding ShowPartFileCommand}" AutomationProperties.Name="Show the file this adventure is in" />
                    <Button x:Name="EditOwnRange" Content="Edit range" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,8"
                            Command="{Binding EditPartRangeCommand}" AutomationProperties.Name="Edit this adventure's pages" />
                    <Button x:Name="RemoveThisPart" Content="Remove adventure" c:Ui.Icon="{StaticResource Icon.Trash2}" Margin="0,0,8,8"
                            ToolTip="This card goes; its pages are only the file's again" Command="{Binding RemoveThisPartCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Margin="0,0,0,8" Visibility="{Binding PartEditor, Converter={StaticResource Bt.VisibleWhenSet}}">
              <v:PartEditorView x:Name="InspectorPartEditor" DataContext="{Binding PartEditor}" />
            </Border>
            <DockPanel Margin="0,0,0,8" Visibility="{Binding PartUndo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" Margin="8,0,0,0"
                      ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissPartMessageCommand}" />
              <Button x:Name="UndoPart" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                      Command="{Binding PartUndo.UndoCommand}" AutomationProperties.Name="Undo the change to the adventures"
                      Visibility="{Binding PartUndo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock x:Name="PartMessage" Text="{Binding PartUndo.Message}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
            </DockPanel>

            <!--
              What the AI found reading the whole book, chapter by chapter: kept apart from the book's own details, which it
              never changes, and marked as found inside the book.
            -->
            <StackPanel x:Name="FoundInside" Visibility="{Binding HasChapters, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <DockPanel>
                <Button x:Name="ScanAgain" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Scan again" c:Ui.Icon="{StaticResource Icon.RotateCcw}"
                        VerticalAlignment="Bottom" Margin="0,0,0,10" Command="{Binding ScanAgainCommand}"
                        ToolTip="Forget what the AI found in this book and read it again" AutomationProperties.Name="Scan this book again" />
                <TextBlock Text="FOUND INSIDE THE BOOK" Style="{StaticResource SectionHead}" />
              </DockPanel>
              <TextBlock Text="Found by the AI reading each chapter. These describe parts of the book, not the whole book, and don't change its details."
                         Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <ItemsControl x:Name="ChapterList" ItemsSource="{Binding Chapters}" Focusable="False" AutomationProperties.Name="Found inside the book">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:InspectorChapter}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding PagesText}" Style="{StaticResource Text.Small}" Margin="10,0,0,0" />
                          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,4,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding ChaptersMessage}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ChaptersMessage, Converter={StaticResource Bt.VisibleWhenSet}}" AutomationProperties.LiveSetting="Polite" />

            <TextBlock Text="{Binding FactsHeading}" Style="{StaticResource SectionHead}" />
            <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InspectorFact}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Margin="0,0,15,0" TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Row}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="WHERE IT IS" Style="{StaticResource SectionHead}" Visibility="{Binding IsElsewhere, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <ItemsControl ItemsSource="{Binding Locations}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InspectorLocation}">
                  <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" />
                      <TextBlock Text="{Binding State}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                                 Visibility="{Binding HasState, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                      <WrapPanel Margin="0,10,0,0">
                        <Button Content="{Binding ShowLabel}" c:Ui.Icon="{StaticResource Icon.ArrowUpRight}" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding ShowLabel}" Visibility="{Binding CanShowInExplorer, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <!-- Reprocess, with a small menu for OCR on every page. Disabled, reading Reprocessing…, while a stage waits or runs. -->
                        <Border Visibility="{Binding ShowsReprocess, Converter={StaticResource Bt.VisibleWhenTrue}}">
                          <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Button x:Name="Reprocess" Content="{Binding ReprocessLabel}" c:Ui.Icon="{StaticResource Icon.RotateCcw}"
                                    Command="{Binding ReprocessCommand}" AutomationProperties.Name="{Binding ReprocessLabel}"
                                    ToolTip="Read the file again: pages, text, cover and hints from names. What you added stays." />
                            <Button x:Name="ReprocessMenu" c:Ui.Icon="{StaticResource Icon.ChevronDown}" Padding="7,8" Margin="4,0,0,0"
                                    IsEnabled="{Binding CanReprocess}" Click="DropDown_Click"
                                    ToolTip="More ways to reprocess" AutomationProperties.Name="More ways to reprocess"
                                    Visibility="{Binding CanOcrEveryPage, Converter={StaticResource Bt.VisibleWhenTrue}}">
                              <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource Bt.Menu}">
                                  <MenuItem Header="Reprocess with OCR on every page…"
                                            AutomationProperties.Name="Reprocess with OCR on every page" Command="{Binding ReprocessWithOcrCommand}" />
                                </ContextMenu>
                              </Button.ContextMenu>
                            </Button>
                          </StackPanel>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A book only the web library has: downloaded when it's opened, or kept here to read without a connection. -->
            <StackPanel Margin="0,0,0,8" Visibility="{Binding CanKeepOffline, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <CheckBox x:Name="KeepOffline" Content="Keep offline on this PC" IsChecked="{Binding IsKeptOffline}" FontSize="11"
                        Foreground="{DynamicResource Bt.Text}" IsEnabled="{Binding CanChangeKeptOffline}"
                        ToolTip="Download the book now and keep it, so it opens without a connection" />
              <TextBlock Text="{Binding OfflineText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,4,0,0"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- The book's files when it has more than one (F2): which one opens, Make current, and Not the same book. -->
            <StackPanel Visibility="{Binding HasCopies, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="{Binding CopiesHeading}" Style="{StaticResource SectionHead}" />
              <ItemsControl ItemsSource="{Binding Copies}" Focusable="False" AutomationProperties.Name="Copies">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:InspectorCopy}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                            AutomationProperties.Name="{Binding Heading}">
                      <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding HasPath, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                        <WrapPanel Margin="0,10,0,0">
                          <Button Content="Make current" c:Ui.Icon="{StaticResource Icon.Check}" Margin="0,0,8,8"
                                  ToolTip="Open this copy: its cover, pages and page hits become the book's. No file changes."
                                  Visibility="{Binding CanMakeCurrent, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  Command="{Binding DataContext.MakeCurrentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Show in File Explorer" c:Ui.Icon="{StaticResource Icon.ArrowUpRight}" Margin="0,0,8,8"
                                  Visibility="{Binding CanShowInExplorer, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  Command="{Binding DataContext.ShowCopyInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Not the same book" Margin="0,0,8,8"
                                  ToolTip="Give this file a card of its own again. Bibliotaph won't join them again."
                                  Command="{Binding DataContext.NotSameBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasStages, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="INDEXING" Style="{StaticResource SectionHead}" />
              <ItemsControl ItemsSource="{Binding Stages}" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:InspectorStage}">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Stage" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}" Margin="0,0,15,0" TextWrapping="NoWrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Text.Row}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Add a book I own elsewhere (F5a), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding AddElsewhereDialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:AddElsewhereView x:Name="ElsewhereDialog" DataContext="{Binding AddElsewhereDialog}" MaxWidth="520" Margin="0,24,42,24" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>

    <!-- Same book (multi-select plan, M1), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding Selection.SameBookDialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:SameBookDialogView x:Name="SameBookDialog" DataContext="{Binding Selection.SameBookDialog}" MaxWidth="520" Margin="0,24,42,24" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>

    <!-- Pack together (multi-select plan, M2), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding Selection.PackDialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:PackTogetherDialogView x:Name="PackDialog" DataContext="{Binding Selection.PackDialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>

    <!-- Naming or picking a collection (slice 3b), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding Collections.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:CollectionDialogView x:Name="CollectionDialog" DataContext="{Binding Collections.Dialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>

    <!-- Naming or picking a session (slice 3c), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding Sessions.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:SessionDialogView x:Name="SessionDialog" DataContext="{Binding Sessions.Dialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>

    <!-- Naming a saved search (slice 3e), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding SmartViews.ViewDialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <!-- Scrolls when the window is too short for it (at 200% scaling, say): this page doesn't scroll itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <v:SmartViewDialogView x:Name="SmartViewDialog" DataContext="{Binding SmartViews.ViewDialog}" MaxWidth="440" Margin="0,24,42,24" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>

    <!-- The bulk editor, a dialog over the page. Esc or Cancel closes it; nothing behind it can be clicked meanwhile. -->
    <Grid Grid.RowSpan="3" Visibility="{Binding Selection.BulkEdit, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <v:BulkEditView x:Name="BulkDialog" DataContext="{Binding Selection.BulkEdit}" MaxWidth="660" Margin="0,24,42,24" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
