<UserControl x:Class="Bibliotaph.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:v="clr-namespace:Bibliotaph.App.Views"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- A book title that opens its details, in search results. -->
    <Style x:Key="TitleLink" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Background="Transparent" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .bt-field: a small label over a select. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
      <Setter Property="Margin" Value="0,28,0,10" />
    </Style>

    <!-- A book in the covers or the list: Bt.PlainList's item, with Books.xaml's BookMenu on right-click (or the Menu key, or Shift+F10). -->
    <Style x:Key="BookItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContextMenu" Value="{DynamicResource BookMenu}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="AutomationProperties.ItemStatus" Value="Selected" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A book's checkbox in Select mode. It only shows the tick: a click on the book ticks it. -->
    <DataTemplate x:Key="Tick" DataType="{x:Type vm:LibraryItemViewModel}">
      <Border x:Name="Box" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Muted}"
              BorderThickness="1.5" SnapsToDevicePixels="True">
        <c:LucideIcon x:Name="Mark" Data="{StaticResource Icon.Check}" Size="14" StrokeThickness="2.4" Foreground="{DynamicResource Bt.AccentText}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Box" Property="Background" Value="{DynamicResource Bt.Accent}" />
          <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
          <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,42,24">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                  Visibility="{Binding ShowsLibraryActions, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Button x:Name="AddElsewhere" Content="Add a book I own elsewhere" c:Ui.Icon="{StaticResource Icon.Plus}"
                Margin="0,0,8,0" Command="{Binding AddElsewhereCommand}" ToolTip="A book you own in print or on a virtual tabletop, with no file here" />
        <Button x:Name="CheckDownload" Content="Check a download" c:Ui.Icon="{StaticResource Icon.Search}"
                Margin="0,0,8,0" Command="{Binding CheckDownloadCommand}" ToolTip="See which files in a folder or ZIP you already have, without adding them" />
        <Button Content="Add folder" c:Ui.Icon="{StaticResource Icon.FolderPlus}" Command="{Binding AddFolderCommand}" />
      </StackPanel>
      <!-- A collection's own actions (slice 3 plan, choice 9). Deleting it never deletes its books. -->
      <StackPanel x:Name="CollectionActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                  Visibility="{Binding ShowsCollectionActions, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Button x:Name="NewSubCollection" Content="New collection" c:Ui.Icon="{StaticResource Icon.FolderPlus}" Margin="0,0,8,0"
                Command="{Binding NewSubCollectionCommand}" ToolTip="Make a collection inside this one" />
        <Button x:Name="RenameCollection" Content="Rename" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,0" Command="{Binding RenameCollectionCommand}"
                ToolTip="Change its name or description" AutomationProperties.Name="Rename the collection" />
        <Button x:Name="MoveCollection" Content="Move to…" c:Ui.Icon="{StaticResource Icon.FolderInput}" Margin="0,0,8,0" Command="{Binding MoveCollectionCommand}"
                ToolTip="Put it inside another collection, or at the top" AutomationProperties.Name="Move the collection" />
        <Button x:Name="PinCollection" Content="{Binding PinLabel}" c:Ui.Icon="{StaticResource Icon.Pin}" Margin="0,0,8,0" Command="{Binding TogglePinCommand}"
                ToolTip="Pinned collections show first on Collections, and on Home" />
        <Button x:Name="DeleteCollection" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Trash2}" Command="{Binding DeleteCollectionCommand}"
                ToolTip="Delete the collection. Its books stay in your library, and Undo brings it back." AutomationProperties.Name="Delete the collection" />
      </StackPanel>
      <!-- A Smart View's own actions (slice 3 plan, choice 17). Deleting it never deletes a book. -->
      <StackPanel x:Name="ViewActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                  Visibility="{Binding IsView, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Button x:Name="RenameView" Content="Rename" c:Ui.Icon="{StaticResource Icon.Pencil}" Margin="0,0,8,0" Command="{Binding RenameViewCommand}"
                AutomationProperties.Name="Rename the Smart View" />
        <Button x:Name="DeleteView" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Trash2}" Command="{Binding DeleteViewCommand}"
                ToolTip="Delete the Smart View. Your books stay as they are, and Undo brings it back." AutomationProperties.Name="Delete the Smart View" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.H1}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" />
      </StackPanel>
    </DockPanel>

    <!-- .bt-toolbar: results tabs while searching; filters, sort and layout always. -->
    <Border Grid.Row="1" Margin="0,0,42,0" Padding="0,0,0,15" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1"
            Visibility="{Binding HasFolders, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Border Visibility="{Binding ShowLayoutChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button Content="Select" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding StartSelectingCommand}" Margin="0,0,8,0"
                    ToolTip="Tick books to edit their metadata together" AutomationProperties.Name="Select books"
                    Visibility="{Binding Selection.IsActive, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
          </Border>
          <Button x:Name="SaveView" Content="Save view" c:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding SaveViewCommand}" Margin="0,0,8,0"
                  ToolTip="Keep this search, its filters and order as a Smart View in the sidebar"
                  Visibility="{Binding CanSaveView, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button Content="Filters" c:Ui.Icon="{StaticResource Icon.SlidersHorizontal}" Command="{Binding ToggleFiltersCommand}" Margin="0,0,8,0" />
          <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortChoice}"
                    AutomationProperties.Name="Sort" Margin="0,0,8,0" />
          <Border Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center"
                  Visibility="{Binding ShowLayoutChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Bt.Segment}" IsChecked="{Binding IsGridLayout}" ToolTip="Covers" AutomationProperties.Name="Show covers">
                <c:LucideIcon Data="{StaticResource Icon.LayoutGrid}" Size="15" />
              </RadioButton>
              <RadioButton Style="{StaticResource Bt.Segment}" IsChecked="{Binding IsListLayout}" ToolTip="List" AutomationProperties.Name="Show a list">
                <c:LucideIcon Data="{StaticResource Icon.List}" Size="15" />
              </RadioButton>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="Results"
                    Visibility="{Binding IsSearching, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <RadioButton Style="{StaticResource Bt.Tab}" Content="{Binding DocumentsTabLabel}" IsChecked="{Binding IsDocumentsTab}" />
          <RadioButton Style="{StaticResource Bt.Tab}" Content="{Binding PagesTabLabel}" IsChecked="{Binding IsPagesTab}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <WrapPanel Grid.Row="2" Margin="0,15,42,-12" Visibility="{Binding ShowFilters, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel Margin="0,0,12,12">
        <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding KindChoice}"
                  AutomationProperties.Name="Kind" MinWidth="150" />
      </StackPanel>
      <StackPanel Margin="0,0,12,12">
        <TextBlock Text="Source folder" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding FolderChoice}"
                  AutomationProperties.Name="Source folder" MinWidth="200" />
      </StackPanel>
      <StackPanel Margin="0,0,12,12">
        <TextBlock Text="Game system" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding SystemChoices}" SelectedItem="{Binding SystemChoice}"
                  AutomationProperties.Name="Game system" MinWidth="180" />
      </StackPanel>
      <StackPanel Margin="0,0,12,12">
        <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding TypeChoice}"
                  AutomationProperties.Name="Type" MinWidth="160" />
      </StackPanel>
      <StackPanel Margin="0,0,12,12">
        <TextBlock Text="Character level" Style="{StaticResource FieldLabel}" />
        <StackPanel Orientation="Horizontal">
          <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding LevelChoices}" SelectedItem="{Binding LevelChoice}"
                    AutomationProperties.Name="Character level" MinWidth="110" MaxDropDownHeight="320" />
          <CheckBox Content="Include unknown levels" IsChecked="{Binding IncludeUnknownLevels}" Margin="10,0,0,0" VerticalAlignment="Center"
                    FontSize="11" Foreground="{DynamicResource Bt.Text}"
                    Visibility="{Binding HasLevelChoice, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Margin="0,0,12,12" Visibility="{Binding ShowAiChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Text="AI" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding AiChoices}" SelectedItem="{Binding AiChoice}"
                  AutomationProperties.Name="Read by AI" MinWidth="150" ToolTip="Books a model has read and catalogued" />
      </StackPanel>
      <StackPanel Margin="0,0,12,12" Visibility="{Binding ShowCopiesChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Text="Copies" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding CopiesChoices}" SelectedItem="{Binding CopiesChoice}"
                  AutomationProperties.Name="Copies" MinWidth="150" ToolTip="Books that are in more than one file" />
      </StackPanel>
      <StackPanel Margin="0,0,12,12" Visibility="{Binding ShowOwnChoice, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Text="Also own" Style="{StaticResource FieldLabel}" />
        <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding OwnChoices}" SelectedItem="{Binding OwnChoice}"
                  AutomationProperties.Name="Also own" MinWidth="150" ToolTip="Books you also own in print or on a virtual tabletop" />
      </StackPanel>
      <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
    </WrapPanel>

    <!-- .bt-sectionline -->
    <StackPanel Grid.Row="3" Margin="0,23,42,17">
      <!-- The part of the library shown, such as Favorites (slice 3 plan, choice 3); its × shows the whole library. -->
      <Border x:Name="ScopeChip" Style="{StaticResource Bt.Chip}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="10,2,2,2"
              Visibility="{Binding HasScope, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ScopeChip}" FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
          <Button x:Name="ClearScope" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" MinWidth="22" MinHeight="22"
                  Margin="4,0,0,0" Padding="2" ToolTip="Show your whole library" AutomationProperties.Name="Show your whole library"
                  Command="{Binding ClearScopeCommand}" />
        </StackPanel>
      </Border>
      <!-- A collection's sub-collections, as cards above its books, and the switch that leaves their books out (choice 9). -->
      <StackPanel Visibility="{Binding HasSubCollections, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ItemsControl x:Name="SubCollections" ItemsSource="{Binding SubCollections}" ItemTemplate="{StaticResource CollectionCard}"
                      Focusable="False" AutomationProperties.Name="Collections inside this one" KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <CheckBox x:Name="OnlyAddedHere" Content="Only books added here" IsChecked="{Binding OnlyAddedHere}" Margin="0,0,0,14" FontSize="11"
                  Foreground="{DynamicResource Bt.Text}" ToolTip="Leave out the books that are only in the collections inside this one" />
      </StackPanel>
      <!-- A Smart View whose search, filters or order were changed: keep the change in it, or as a new view. -->
      <Border x:Name="ViewChanged" Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,8" Margin="0,0,0,14"
              Visibility="{Binding IsViewChanged, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="UpdateView" Style="{StaticResource Bt.Button.Primary}" Content="Update view" Command="{Binding UpdateViewCommand}" Margin="0,0,8,0"
                    ToolTip="The Smart View keeps the search, filters and order shown now" />
            <Button x:Name="SaveViewAsNew" Content="Save as new" Command="{Binding SaveViewAsNewCommand}" ToolTip="Keep both: a new Smart View, and this one as it was" />
          </StackPanel>
          <TextBlock Text="You've changed this view." FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <TextBlock x:Name="ViewNote" Text="{Binding ViewNote}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,14"
                 Visibility="{Binding ViewNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
      <!-- What the last Smart View change did, with Undo. -->
      <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
              Visibility="{Binding ViewMessage, Converter={StaticResource Bt.VisibleWhenSet}}">
        <DockPanel>
          <Button x:Name="UndoView" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                  Command="{Binding UndoViewCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the Smart View change"
                  Visibility="{Binding HasViewUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock x:Name="ViewMessage" Text="{Binding ViewMessage}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <!-- What the last collection change did, with Undo. -->
      <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
              Visibility="{Binding Collections.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
        <DockPanel>
          <Button x:Name="UndoCollection" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                  Command="{Binding Collections.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the collection change"
                  Visibility="{Binding Collections.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock x:Name="CollectionMessage" Text="{Binding Collections.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <!-- What the last Add to session did, with Undo. -->
      <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
              Visibility="{Binding Sessions.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
        <DockPanel>
          <Button x:Name="UndoSession" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                  Command="{Binding Sessions.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the session change"
                  Visibility="{Binding Sessions.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock x:Name="SessionMessage" Text="{Binding Sessions.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <!-- Select mode: how many are ticked, Edit metadata, Clear and Done. -->
      <Border Background="{DynamicResource Bt.Soft}" CornerRadius="6" Padding="14,8" Margin="0,0,0,14" AutomationProperties.Name="Selection"
              Visibility="{Binding Selection.IsActive, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource Bt.Button.Primary}" Content="Edit metadata" c:Ui.Icon="{StaticResource Icon.Pencil}"
                    Command="{Binding EditSelectedCommand}" Margin="0,0,8,0" ToolTip="Change fields on every selected book at once" />
            <Button x:Name="AddSelectedToCollection" Content="Add to collection" c:Ui.Icon="{StaticResource Icon.FolderPlus}" Margin="0,0,8,0"
                    Click="DropDown_Click" IsEnabled="{Binding Selection.HasAny}" ToolTip="Add every selected book to a collection">
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource Bt.Menu}" c:CollectionMenu.Command="{Binding AddSelectedToCollectionCommand}" />
              </Button.ContextMenu>
            </Button>
            <Button x:Name="AddSelectedToSession" Content="Add to session" c:Ui.Icon="{StaticResource Icon.NotebookPen}" Margin="0,0,8,0"
                    Click="DropDown_Click" IsEnabled="{Binding Selection.HasAny}" ToolTip="Add every selected book to a session">
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource Bt.Menu}" c:SessionMenu.Command="{Binding AddSelectedToSessionCommand}" />
              </Button.ContextMenu>
            </Button>
            <Button x:Name="RemoveSelectedFromCollection" Content="Remove from collection" Margin="0,0,8,0" Command="{Binding RemoveSelectedFromCollectionCommand}"
                    ToolTip="Take the selected books out of this collection. They stay in your library."
                    Visibility="{Binding IsCollection, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" AutomationProperties.Name="Clear the selection" />
            <Button Content="Done" Command="{Binding StopSelectingCommand}" ToolTip="Leave Select mode (Esc)" AutomationProperties.Name="Done selecting" />
          </StackPanel>
          <TextBlock Text="{Binding Selection.Summary}" FontSize="12" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="0,0,12,0" />
        </DockPanel>
      </Border>
      <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
              Visibility="{Binding BulkMessage, Converter={StaticResource Bt.VisibleWhenSet}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding UndoBulkEditCommand}"
                  Padding="12,0,0,0" AutomationProperties.Name="Undo the edit" Visibility="{Binding HasBulkUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding UndoSplitCommand}"
                  Padding="12,0,0,0" AutomationProperties.Name="Undo the split" Visibility="{Binding HasSplitUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding UndoRemoveCommand}"
                  Padding="12,0,0,0" AutomationProperties.Name="Undo the removal" Visibility="{Binding HasRemoveUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock Text="{Binding BulkMessage}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <DockPanel Visibility="{Binding IsEmpty, Converter={StaticResource Bt.CollapsedWhenTrue}}">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Coverage}" Style="{StaticResource Text.Small}" Margin="15,0,0,0"
                   Visibility="{Binding Coverage, Converter={StaticResource Bt.VisibleWhenSet}}" />
        <TextBlock FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap">
          <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="Medium" Foreground="{DynamicResource Bt.Text}" /> <Run Text="{Binding CountLabel, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
      <Border HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,5" CornerRadius="4" Background="{DynamicResource Bt.Warm}"
              Visibility="{Binding IssueText, Converter={StaticResource Bt.VisibleWhenSet}}">
        <TextBlock Text="{Binding IssueText}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="4">
      <!-- .bt-books: the cover grid. Only the covers in view are created. -->
      <ListBox x:Name="CoverGrid" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Items}" Padding="0,0,30,0"
               AutomationProperties.Name="Books" c:ItemActivation.Command="{Binding ActivateCommand}"
               c:ItemActivation.RangeCommand="{Binding SelectRangeCommand}"
               ItemContainerStyle="{StaticResource BookItem}" c:NewWindowGesture.Command="{Binding OpenBookInNewWindowCommand}"
               Visibility="{Binding ShowGrid, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <vwp:VirtualizingWrapPanel ItemSize="172,318" SpacingMode="BetweenItemsOnly" StretchItems="False" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <StackPanel x:Name="Card" Width="150" HorizontalAlignment="Left" Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.ItemStatus="{Binding AvailabilityLabel}">
              <Grid x:Name="CoverArea">
                <ContentControl x:Name="CoverBox" Height="208" Content="{Binding}" ContentTemplate="{StaticResource Cover}" Focusable="False">
                  <ContentControl.Effect>
                    <DropShadowEffect BlurRadius="7" ShadowDepth="3" Direction="270" Opacity="0.15" />
                  </ContentControl.Effect>
                </ContentControl>
                <Button x:Name="Heart" Style="{StaticResource CoverHeart}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tick}" Focusable="False" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding DataContext.Selection.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              </Grid>
              <TextBlock Text="{Binding Title}" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
              <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger SourceName="CoverArea" Property="IsMouseOver" Value="True">
                <Setter TargetName="CoverArea" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="-4" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- .bt-listrow: the detail list. -->
      <ListBox x:Name="DetailList" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Items}" Padding="0,0,30,0"
               AutomationProperties.Name="Books" c:ItemActivation.Command="{Binding ActivateCommand}"
               c:ItemActivation.RangeCommand="{Binding SelectRangeCommand}"
               ItemContainerStyle="{StaticResource BookItem}" c:NewWindowGesture.Command="{Binding OpenBookInNewWindowCommand}"
               Visibility="{Binding ShowList, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
            <Border x:Name="Row" Padding="0,14" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Background="Transparent"
                    Cursor="Hand" AutomationProperties.Name="{Binding Title}" AutomationProperties.ItemStatus="{Binding AvailabilityLabel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="160" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="27" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Tick}" Focusable="False" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Visibility="{Binding DataContext.Selection.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                  <ContentControl Width="46" Height="64" Content="{Binding}" ContentTemplate="{StaticResource Cover}" Focusable="False" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Byline}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SystemLabel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Game system" />
                <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Type" />
                <TextBlock Grid.Column="4" Text="{Binding LevelsLabel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Character levels" />
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Text.Small}" />
                  <TextBlock Text="{Binding CopiesLabel}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" ToolTip="Files of this book in your library"
                             Visibility="{Binding CopiesLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                  <TextBlock Text="{Binding AvailabilityLabel}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" ToolTip="{Binding AvailabilityTip}"
                             Visibility="{Binding AvailabilityLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                </StackPanel>
                <Button x:Name="Heart" Grid.Column="6" Style="{StaticResource CoverHeart}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" FontSize="14"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <c:LucideIcon Grid.Column="7" Data="{StaticResource Icon.ChevronRight}" Size="15" Foreground="{DynamicResource Bt.Muted}"
                              VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bt.Side}" />
                <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- .bt-hit: matching pages, grouped by book. -->
      <ListBox x:Name="PageHits" Style="{StaticResource Bt.PlainList}" ItemsSource="{Binding Hits}" Padding="0,0,30,0"
               AutomationProperties.Name="Matching pages" KeyboardNavigation.TabNavigation="Continue"
               Visibility="{Binding ShowHits, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DocumentHitsViewModel}">
            <Border Padding="0,21" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Height="83" VerticalAlignment="Top" Content="{Binding Item}" ContentTemplate="{StaticResource Cover}" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                  <Button Style="{StaticResource TitleLink}" Content="{Binding Item.Title}" AutomationProperties.Name="{Binding Item.Title, StringFormat='Details for {0}'}"
                          Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Item}" />
                  <TextBlock Text="{Binding Item.Meta}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PageHitViewModel}">
                        <StackPanel Margin="0,12,0,0">
                          <DockPanel>
                            <!-- Open in new window also by middle-click or Shift+Enter on Open page. -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}"
                                    VerticalAlignment="Top" Margin="4,0,0,0" ToolTip="Open in new window (Shift+Enter)"
                                    AutomationProperties.Name="{Binding Where, StringFormat='Open {0} in new window'}"
                                    Command="{Binding DataContext.OpenPageInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Plus}"
                                    VerticalAlignment="Top" Margin="4,0,0,0" ToolTip="Add this page to the current session"
                                    AutomationProperties.Name="{Binding Where, StringFormat='Add {0} to the session'}"
                                    Command="{Binding DataContext.AddPageToSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button DockPanel.Dock="Right" Content="Open page" c:Ui.Icon="{StaticResource Icon.BookOpen}" VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding Where, StringFormat='Open {0}'}"
                                    Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    c:NewWindowGesture.Command="{Binding DataContext.OpenPageInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Where}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
                          </DockPanel>
                          <TextBlock c:Highlight.Snippet="{Binding Snippet}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap"
                                     LineHeight="20" Margin="0,6,0,4" />
                          <Border Style="{StaticResource Bt.Chip}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding More}" Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                             Visibility="{Binding HasMore, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsEmpty, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <c:EmptyState Margin="0,0,42,0" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}" ActionText="{Binding EmptyActionText}"
                      Command="{Binding EmptyCommand}" />
      </ScrollViewer>
    </Grid>

    <!-- .bt-drawer: the inspector, over the page. Esc, the close button or a click outside closes it. -->
    <Grid Grid.RowSpan="5" Visibility="{Binding Inspector, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailsCommand}" />
        </Border.InputBindings>
      </Border>
      <Border x:Name="Drawer" HorizontalAlignment="Right" Width="440" Margin="0,-36,0,0" DataContext="{Binding Inspector}"
              Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1,0,0,0"
              IsVisibleChanged="Drawer_IsVisibleChanged" d:DataContext="{d:DesignInstance vm:InspectorViewModel}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.1" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="28">
            <DockPanel Margin="0,0,0,24">
              <Button x:Name="CloseDrawer" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}"
                      ToolTip="Close (Esc)" AutomationProperties.Name="Close details"
                      Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <Button x:Name="FavoriteBook" DockPanel.Dock="Right" Style="{StaticResource Bt.HeartButton}" Margin="0,0,4,0"
                      c:Ui.IsActive="{Binding Item.IsFavorite}" ToolTip="{Binding Item.FavoriteAction}" AutomationProperties.Name="{Binding Item.FavoriteAction}"
                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Item}" />
              <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
            </DockPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentControl Height="153" VerticalAlignment="Top" Content="{Binding Item}" ContentTemplate="{StaticResource Cover}" Focusable="False" />
              <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock Text="{Binding Item.KindLabel}" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6"
                           Visibility="{Binding Item.KindLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                <TextBlock Text="{Binding Item.Title}" FontFamily="{StaticResource Font.Display}" FontSize="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource Bt.Text}" />
                <TextBlock Text="{Binding Item.PublisherLabel}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                           Visibility="{Binding Item.PublisherLabel, Converter={StaticResource Bt.VisibleWhenSet}}" />
                <WrapPanel Margin="0,12,0,0">
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.SystemLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.SystemLabel}" FontSize="10" Foreground="{DynamicResource Bt.Text}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.LevelsLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.LevelsLabel}" FontSize="10" Foreground="{DynamicResource Bt.Text}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}">
                    <TextBlock Text="{Binding Item.FormatLabel}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
                  </Border>
                  <Border Style="{StaticResource Bt.Chip}" Visibility="{Binding Item.PagesLabel, Converter={StaticResource Bt.VisibleWhenSet}}">
                    <TextBlock Text="{Binding Item.PagesLabel}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" />
                  </Border>
                </WrapPanel>
                <!-- A book owned elsewhere has nothing to open; the user made it, so they can remove it (F5 plan, choice 5). -->
                <Button x:Name="RemoveFromLibrary" Content="Remove from library" HorizontalAlignment="Left" Margin="0,16,0,0"
                        ToolTip="Take this book out of your library. Undo brings it back." Command="{Binding RemoveFromLibraryCommand}"
                        Visibility="{Binding IsElsewhere, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding CanOpen, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <Button x:Name="OpenBook" Style="{StaticResource Bt.Button.Primary}" Content="Open" c:Ui.Icon="{StaticResource Icon.BookOpen}"
                          AutomationProperties.Name="{Binding Item.Title, StringFormat='Open {0}'}"
                          Command="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          c:NewWindowGesture.Command="{Binding DataContext.OpenBookInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Item}" />
                  <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Margin="6,0,0,0"
                          ToolTip="Open in new window (Shift+Enter)" AutomationProperties.Name="{Binding Item.Title, StringFormat='Open {0} in new window'}"
                          Command="{Binding DataContext.OpenBookInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Item}" />
                </StackPanel>
                <!-- Add to session (slice 3c): the current session, another or a new one. -->
                <Button x:Name="AddToSession" Content="Add to session" c:Ui.Icon="{StaticResource Icon.NotebookPen}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="DropDown_Click" ToolTip="Add this book to a session">
                  <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource Bt.Menu}" c:SessionMenu.Command="{x:Static c:BookCommands.AddToSession}" />
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Details and Notes (slice 3f): the book's own note, saved as you type, and the notes on its pages. -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0" AutomationProperties.Name="Details or notes">
              <RadioButton x:Name="DetailsTab" Style="{StaticResource Bt.Tab}" Content="Details" IsChecked="{Binding IsDetailsTab}" />
              <RadioButton x:Name="NotesTab" Style="{StaticResource Bt.Tab}" Content="{Binding Notes.TabLabel, FallbackValue=Notes}" IsChecked="{Binding IsNotesTab}" />
            </StackPanel>
            <StackPanel DataContext="{Binding Notes}" Margin="0,18,0,0"
                        Visibility="{Binding DataContext.IsNotesTab, ElementName=Drawer, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBox x:Name="EntryNote" Style="{StaticResource Bt.TextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="140" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Note on this book" ToolTip="Saved as you type. A search finds the book by its note." />
              <TextBlock Text="Saved as you type. A search finds this book by its note." Style="{StaticResource Text.Small}" Margin="0,6,0,0" />
              <TextBlock Text="ON ITS PAGES" Style="{StaticResource SectionHead}" />
              <TextBlock Text="No page notes yet. Add one in the reader with Note." Style="{StaticResource Text.Small}"
                         Visibility="{Binding HasPageNotes, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
              <ItemsControl x:Name="BookPageNotes" ItemsSource="{Binding PageNotes}" Focusable="False" AutomationProperties.Name="Notes on its pages"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PageNoteRow}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Open" VerticalAlignment="Top" Margin="10,0,0,0"
                                AutomationProperties.Name="{Binding Pages, StringFormat='Open at {0}'}" ToolTip="Open the book at these pages"
                                Command="{Binding DataContext.OpenPageNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Pages}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
                          <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                          <DockPanel Margin="0,6,0,0" Visibility="{Binding HasReason, Converter={StaticResource Bt.VisibleWhenTrue}}">
                            <c:LucideIcon x:Name="NoteReasonIcon" Data="{StaticResource Icon.TriangleAlert}" Size="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </DockPanel>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter TargetName="NoteReasonIcon" Property="Foreground" Value="{DynamicResource Bt.Accent}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding IsDetailsTab, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <!-- The collections the book is in (slice 3 plan, choice 10): a chip opens one, its × takes the book out. -->
            <DockPanel Margin="0,28,0,10">
              <Button x:Name="AddToCollection" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Add to collection"
                      c:Ui.Icon="{StaticResource Icon.FolderPlus}" Click="DropDown_Click" ToolTip="Add this book to a collection">
                <Button.ContextMenu>
                  <ContextMenu Style="{StaticResource Bt.Menu}" c:CollectionMenu.Command="{x:Static c:BookCommands.AddToCollection}" />
                </Button.ContextMenu>
              </Button>
              <TextBlock Text="COLLECTIONS" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Not in any collection yet." Style="{StaticResource Text.Small}"
                       Visibility="{Binding HasCollections, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <ItemsControl x:Name="BookCollections" ItemsSource="{Binding Collections}" Focusable="False" AutomationProperties.Name="Collections this book is in"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CollectionChip}">
                  <Border Style="{StaticResource Bt.Chip}" Padding="10,2,2,2" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource Bt.Link}" Content="{Binding Name}" Foreground="{DynamicResource Bt.Text}" ToolTip="{Binding Path}"
                              AutomationProperties.Name="{Binding Path, StringFormat='Open {0}'}"
                              Command="{Binding DataContext.OpenInspectorCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" MinWidth="22" MinHeight="22" Margin="4,0,0,0" Padding="2"
                              ToolTip="{Binding Name, StringFormat='Take this book out of {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Remove from {0}'}"
                              Command="{Binding DataContext.RemoveFromInspectorCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A pack's images (F4): click one to open it, then step through the rest; or split the pack. -->
            <StackPanel Visibility="{Binding IsPack, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <DockPanel Margin="0,28,0,10">
                <Button x:Name="SplitPack" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Split into separate images"
                        ToolTip="Give every image its own card again. Bibliotaph won't pack this folder again."
                        Command="{Binding SplitPackCommand}" />
                <TextBlock Text="{Binding PackImagesHeading}" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl x:Name="PackImages" ItemsSource="{Binding PackImages}" AutomationProperties.Name="Images in the pack"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PackImageViewModel}">
                    <Button Width="88" Margin="0,0,8,10" Padding="0" Cursor="Hand" ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                            Command="{Binding DataContext.OpenPackImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <StackPanel Background="Transparent">
                            <Border x:Name="Thumb" Height="88" CornerRadius="4" Background="{DynamicResource Bt.Warm}" BorderBrush="{DynamicResource Bt.Line}"
                                    BorderThickness="1" ClipToBounds="True">
                              <Image Source="{Binding Tile.Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                          </StackPanel>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                              <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Details: each field's value, where it came from, and the user's corrections. -->
            <DockPanel Margin="0,28,0,4">
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="{Binding MoreFieldsLabel}" Command="{Binding ToggleAllFieldsCommand}"
                      Visibility="{Binding HasHiddenFields, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock Text="DETAILS" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="DetailFields" ItemsSource="{Binding VisibleFields}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MetadataFieldViewModel}">
                  <Border x:Name="Row" Padding="0,10" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" AutomationProperties.Name="{Binding Label}">
                    <StackPanel>
                      <DockPanel>
                        <Button x:Name="EditButton" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}"
                                ToolTip="Edit" AutomationProperties.Name="{Binding Label, StringFormat='Edit {0}'}" Command="{Binding EditCommand}" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,0,3" />
                          <WrapPanel>
                            <TextBlock x:Name="Value" Text="{Binding Display}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button x:Name="EvidenceLink" Style="{StaticResource Bt.Link}" c:Ui.Icon="{StaticResource Icon.Sparkles}"
                                    Content="{Binding EvidenceLabel}" Command="{Binding ToggleEvidenceCommand}" Padding="0"
                                    AutomationProperties.Name="{Binding Label, StringFormat='Where {0} came from'}"
                                    Visibility="{Binding HasEvidence, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                          </WrapPanel>
                        </StackPanel>
                      </DockPanel>

                      <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <TextBox x:Name="Editor" Style="{StaticResource Bt.TextBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding Label}" c:Ui.FocusWhenVisible="True">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding EditHint}" Style="{StaticResource Text.Small}" Margin="0,5,0,0"
                                   Visibility="{Binding EditHint, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding Resolution, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding UsesChoices, Converter={StaticResource Bt.VisibleWhenTrue}}">
                          <TextBlock Text="{Binding ChoicesLabel}" Style="{StaticResource FieldLabel}" />
                          <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Choices}" SelectedItem="{Binding PickedChoice}"
                                    AutomationProperties.Name="{Binding ChoicesLabel}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
                        </StackPanel>
                        <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Style="{StaticResource Bt.Button.Primary}" Content="Save" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}"
                                  Margin="0,0,8,0" />
                          <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                      </StackPanel>

                      <!-- .bt-evidence -->
                      <Border Margin="0,10,0,0" Padding="13" CornerRadius="6" Background="{DynamicResource Bt.Side}"
                              Visibility="{Binding ShowEvidence, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <StackPanel>
                          <ItemsControl ItemsSource="{Binding Values}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:MetadataValueViewModel}">
                                <StackPanel Margin="0,0,0,10">
                                  <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Not right" Padding="10,0,0,0"
                                            AutomationProperties.Name="{Binding Text, StringFormat='{}{0} is not right'}"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                                  </DockPanel>
                                  <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Style="{StaticResource Bt.Link}" Content="Keep this" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding KeepCommand}"
                                  AutomationProperties.Name="{Binding Label, StringFormat='Keep this {0}'}"
                                  Visibility="{Binding IsSuggested, Converter={StaticResource Bt.VisibleWhenTrue}}" />

                          <StackPanel Visibility="{Binding HasAlternatives, Converter={StaticResource Bt.VisibleWhenTrue}}">
                            <TextBlock Text="OTHER SUGGESTIONS" Style="{StaticResource Text.Eyebrow}" FontSize="9" Margin="0,10,0,8" />
                            <ItemsControl ItemsSource="{Binding Alternatives}" Focusable="False">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MetadataValueViewModel}">
                                  <StackPanel Margin="0,0,0,10">
                                    <DockPanel>
                                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource Bt.Link}" Content="Use this" Padding="10,0,0,0"
                                                AutomationProperties.Name="{Binding Text, StringFormat='Use {0}'}"
                                                Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Bt.Link}" Content="Not right" Padding="10,0,0,0"
                                                AutomationProperties.Name="{Binding Text, StringFormat='{}{0} is not right'}"
                                                Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                      </StackPanel>
                                      <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <Button Style="{StaticResource Bt.Link}" Content="Reset to suggestion" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding ResetCommand}"
                                  ToolTip="Forget what you set here and go back to what the sources suggest"
                                  Visibility="{Binding CanReset, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsKnown}" Value="False">
                      <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSuggested}" Value="False">
                      <Setter TargetName="EvidenceLink" Property="c:Ui.Icon" Value="{StaticResource Icon.TextSearch}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                      <Setter TargetName="EvidenceLink" Property="c:Ui.Icon" Value="{StaticResource Icon.TriangleAlert}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                      <Setter TargetName="EditButton" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                      <Setter TargetName="Row" Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding FactsHeading}" Style="{StaticResource SectionHead}" />
            <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InspectorFact}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Margin="0,0,15,0" TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Row}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="WHERE IT IS" Style="{StaticResource SectionHead}" Visibility="{Binding IsElsewhere, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <ItemsControl ItemsSource="{Binding Locations}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InspectorLocation}">
                  <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" />
                      <TextBlock Text="{Binding State}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                                 Visibility="{Binding HasState, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                      <WrapPanel Margin="0,10,0,0">
                        <Button Content="{Binding ShowLabel}" c:Ui.Icon="{StaticResource Icon.ArrowUpRight}" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding ShowLabel}"
                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <!-- Reprocess, with a small menu for OCR on every page. Disabled, reading Reprocessing…, while a stage waits or runs. -->
                        <Border Visibility="{Binding ShowsReprocess, Converter={StaticResource Bt.VisibleWhenTrue}}">
                          <StackPanel Orientation="Horizontal" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Button x:Name="Reprocess" Content="{Binding ReprocessLabel}" c:Ui.Icon="{StaticResource Icon.RotateCcw}"
                                    Command="{Binding ReprocessCommand}" AutomationProperties.Name="{Binding ReprocessLabel}"
                                    ToolTip="Read the file again: pages, text, cover and hints from names. What you added stays." />
                            <Button x:Name="ReprocessMenu" c:Ui.Icon="{StaticResource Icon.ChevronDown}" Padding="7,8" Margin="4,0,0,0"
                                    IsEnabled="{Binding CanReprocess}" Click="DropDown_Click"
                                    ToolTip="More ways to reprocess" AutomationProperties.Name="More ways to reprocess"
                                    Visibility="{Binding CanOcrEveryPage, Converter={StaticResource Bt.VisibleWhenTrue}}">
                              <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource Bt.Menu}">
                                  <MenuItem Header="Reprocess with OCR on every page…"
                                            AutomationProperties.Name="Reprocess with OCR on every page" Command="{Binding ReprocessWithOcrCommand}" />
                                </ContextMenu>
                              </Button.ContextMenu>
                            </Button>
                          </StackPanel>
                        </Border>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The book's files when it has more than one (F2): which one opens, Make current, and Not the same book. -->
            <StackPanel Visibility="{Binding HasCopies, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="{Binding CopiesHeading}" Style="{StaticResource SectionHead}" />
              <ItemsControl ItemsSource="{Binding Copies}" Focusable="False" AutomationProperties.Name="Copies">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:InspectorCopy}">
                    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                            AutomationProperties.Name="{Binding Heading}">
                      <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding HasPath, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                        <WrapPanel Margin="0,10,0,0">
                          <Button Content="Make current" c:Ui.Icon="{StaticResource Icon.Check}" Margin="0,0,8,8"
                                  ToolTip="Open this copy: its cover, pages and page hits become the book's. No file changes."
                                  Visibility="{Binding CanMakeCurrent, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  Command="{Binding DataContext.MakeCurrentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Show in File Explorer" c:Ui.Icon="{StaticResource Icon.ArrowUpRight}" Margin="0,0,8,8"
                                  Visibility="{Binding HasPath, Converter={StaticResource Bt.VisibleWhenTrue}}"
                                  Command="{Binding DataContext.ShowCopyInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Not the same book" Margin="0,0,8,8"
                                  ToolTip="Give this file a card of its own again. Bibliotaph won't join them again."
                                  Command="{Binding DataContext.NotSameBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasStages, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="INDEXING" Style="{StaticResource SectionHead}" />
              <ItemsControl ItemsSource="{Binding Stages}" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:InspectorStage}">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Stage" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}" Margin="0,0,15,0" TextWrapping="NoWrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Text.Row}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Add a book I own elsewhere (F5a), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="5" Visibility="{Binding AddElsewhereDialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <v:AddElsewhereView x:Name="ElsewhereDialog" DataContext="{Binding AddElsewhereDialog}" MaxWidth="520" Margin="0,24,42,24" VerticalAlignment="Center" />
    </Grid>

    <!-- Naming or picking a collection (slice 3b), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="5" Visibility="{Binding Collections.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <v:CollectionDialogView x:Name="CollectionDialog" DataContext="{Binding Collections.Dialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Center" />
    </Grid>

    <!-- Naming or picking a session (slice 3c), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="5" Visibility="{Binding Sessions.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <v:SessionDialogView x:Name="SessionDialog" DataContext="{Binding Sessions.Dialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Center" />
    </Grid>

    <!-- Naming a Smart View (slice 3e), a dialog over the page. Esc or Cancel closes it. -->
    <Grid Grid.RowSpan="5" Visibility="{Binding ViewDialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <v:SmartViewDialogView x:Name="SmartViewDialog" DataContext="{Binding ViewDialog}" MaxWidth="440" Margin="0,24,42,24" VerticalAlignment="Center" />
    </Grid>

    <!-- The bulk editor, a dialog over the page. Esc or Cancel closes it; nothing behind it can be clicked meanwhile. -->
    <Grid Grid.RowSpan="5" Visibility="{Binding BulkEdit, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,0" Background="{DynamicResource Bt.Shadow}" />
      <v:BulkEditView x:Name="BulkDialog" DataContext="{Binding BulkEdit}" MaxWidth="660" Margin="0,24,42,24" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
