<UserControl x:Class="Bibliotaph.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:v="clr-namespace:Bibliotaph.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <Style x:Key="SectionLine" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,34,42,16" />
    </Style>

    <!--
      A book on Home: its cover, title and a line about it. A click or Enter opens its details in the Library; the menu
      (right-click, the Menu key or Shift+F10) also opens it, where it was left.
    -->
    <DataTemplate x:Key="HomeBook" DataType="{x:Type vm:LibraryItemViewModel}">
      <Button x:Name="Card" Width="150" Margin="0,0,22,22" Cursor="Hand" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
              ContextMenu="{DynamicResource BookMenu}" FocusVisualStyle="{StaticResource Bt.FocusVisual}"
              Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
              c:NewWindowGesture.Command="{Binding DataContext.OpenBookInNewWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <StackPanel Background="Transparent">
              <Grid x:Name="CoverArea">
                <ContentControl Height="208" Content="{Binding}" ContentTemplate="{StaticResource Cover}" Focusable="False">
                  <ContentControl.Effect>
                    <DropShadowEffect BlurRadius="7" ShadowDepth="3" Direction="270" Opacity="0.15" />
                  </ContentControl.Effect>
                </ContentControl>
                <Button x:Name="Heart" Style="{StaticResource CoverHeart}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </Grid>
              <TextBlock Text="{Binding Title}" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                         Foreground="{DynamicResource Bt.Text}" />
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
                <Setter TargetName="CoverArea" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform Y="-4" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <StackPanel>
      <!-- First run: no folders yet. Explain what Bibliotaph does and that files stay put (spec §4.1). -->
      <StackPanel Visibility="{Binding HasFolders, Converter={StaticResource Bt.CollapsedWhenTrue}}" MaxWidth="620" HorizontalAlignment="Left">
        <TextBlock Text="WELCOME TO BIBLIOTAPH" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,10" />
        <TextBlock Text="Good stories begin with something you already own." Style="{StaticResource Text.H1}" />
        <TextBlock Style="{StaticResource Text.Copy}" Margin="0,18,0,0"
                   Text="Bibliotaph builds a catalog of the RPG books, maps and handouts already on this PC, then helps you find the right book and the right page. Your files stay exactly where they are: nothing is moved, renamed or changed." />
        <Button Style="{StaticResource Bt.Button.Primary}" Margin="0,26,0,0" Content="Add a folder"
                c:Ui.Icon="{StaticResource Icon.FolderPlus}" Command="{Binding AddFolderCommand}" />
        <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
          <c:LucideIcon Data="{StaticResource Icon.ShieldCheck}" Size="13" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,8,0" />
          <TextBlock Text="Your catalog, notes and collections stay on this device." Style="{StaticResource Text.Small}" FontSize="10" />
        </StackPanel>
      </StackPanel>

      <!-- Folders added: indexing progress until the library and search arrive (slice 1b). -->
      <StackPanel Visibility="{Binding HasFolders, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <TextBlock Text="YOUR NEXT GOOD STORY" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,10" />
        <TextBlock Text="Welcome back." Style="{StaticResource Text.H1}" />
        <TextBlock Text="A familiar shelf. A few places you haven’t been." Style="{StaticResource Text.Subtitle}" />
        <!-- First run, once folders are in: AI now or later (choice 10). Everything works without it. -->
        <Border Visibility="{Binding ShowAiStep, Converter={StaticResource Bt.VisibleWhenTrue}}" Background="{DynamicResource Bt.Side}"
                CornerRadius="6" Padding="18" Margin="0,22,0,0" MaxWidth="620" HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Text="Fill in the catalog with AI?" Style="{StaticResource Text.Row}" />
            <TextBlock Style="{StaticResource Text.Copy}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="A model running on this PC, such as Ollama, can suggest each book's system, type, levels and more, quoting the page it found them on. You review the suggestions. It is off until you set it up, and you can do that later in Settings." />
            <WrapPanel Margin="0,14,0,0">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="Set up AI" Command="{Binding SetUpAiCommand}" Margin="0,0,8,0" />
              <Button Content="Not now" Command="{Binding AiLaterCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <!-- Folders added but nothing read yet: indexing progress. -->
        <c:EmptyState Title="Indexing your library." Visibility="{Binding HasBooks, Converter={StaticResource Bt.CollapsedWhenTrue}}"
                      Message="{Binding Activity.Summary, StringFormat='{}{0}. Books appear here and in the Library as they are read.'}"
                      ActionText="Manage folders" ActionIcon="{StaticResource Icon.Folder}" Command="{Binding ManageFoldersCommand}" />

        <StackPanel Visibility="{Binding HasBooks, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <!-- .bt-sectionline: Continue preparing (3c), the session pack worked on last. -->
          <StackPanel Visibility="{Binding ContinuePreparing, Converter={StaticResource Bt.VisibleWhenSet}}">
            <DockPanel Style="{StaticResource SectionLine}">
              <Button x:Name="BrowseSessions" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="All sessions"
                      c:Ui.Icon="{StaticResource Icon.ArrowRight}" Command="{Binding BrowseSessionsCommand}" />
              <TextBlock Text="Continue preparing" Style="{StaticResource Text.Row}" />
            </DockPanel>
            <ContentControl x:Name="ContinuePreparing" Content="{Binding ContinuePreparing}" ContentTemplate="{StaticResource SessionCard}" Focusable="False"
                            HorizontalAlignment="Left" />
          </StackPanel>

          <!-- .bt-sectionline: the books opened last (slice 3 plan, choice 7). -->
          <StackPanel Visibility="{Binding HasRecentlyOpened, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <DockPanel Style="{StaticResource SectionLine}">
              <Button x:Name="BrowseLibrary" DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Browse your library"
                      c:Ui.Icon="{StaticResource Icon.ArrowRight}" Command="{Binding BrowseLibraryCommand}" />
              <TextBlock Text="Recently opened" Style="{StaticResource Text.Row}" />
            </DockPanel>
            <ItemsControl x:Name="RecentlyOpened" ItemsSource="{Binding RecentlyOpened}" ItemTemplate="{StaticResource HomeBook}"
                          Focusable="False" AutomationProperties.Name="Recently opened" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <DockPanel Style="{StaticResource SectionLine}">
            <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Browse your library" c:Ui.Icon="{StaticResource Icon.ArrowRight}"
                    Command="{Binding BrowseLibraryCommand}"
                    Visibility="{Binding HasRecentlyOpened, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <TextBlock Text="Recently added" Style="{StaticResource Text.Row}" />
          </DockPanel>
          <ItemsControl x:Name="RecentlyAdded" ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource HomeBook}"
                        Focusable="False" AutomationProperties.Name="Recently added" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- What the last Add to collection did, with Undo. -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,24,42,0" HorizontalAlignment="Left" MinWidth="420"
                  Visibility="{Binding Collections.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                      Command="{Binding Collections.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the collection change"
                      Visibility="{Binding Collections.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock Text="{Binding Collections.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- What the last Add to session did, with Undo. -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="14,10" Margin="0,24,42,0" HorizontalAlignment="Left" MinWidth="420"
                  Visibility="{Binding Sessions.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                      Command="{Binding Sessions.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the session change"
                      Visibility="{Binding Sessions.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <TextBlock Text="{Binding Sessions.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- .bt-sectionline: the pinned collections (slice 3 plan, choice 7). -->
          <StackPanel Visibility="{Binding HasPinnedCollections, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <DockPanel Style="{StaticResource SectionLine}">
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="All collections" c:Ui.Icon="{StaticResource Icon.ArrowRight}"
                      Command="{Binding BrowseCollectionsCommand}" />
              <TextBlock Text="Pinned collections" Style="{StaticResource Text.Row}" />
            </DockPanel>
            <ItemsControl x:Name="PinnedCollections" ItemsSource="{Binding PinnedCollections}" ItemTemplate="{StaticResource CollectionCard}"
                          Focusable="False" AutomationProperties.Name="Pinned collections" KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <!-- Ways into the library. Smart Views join Favorites as they arrive (3e). -->
          <StackPanel Visibility="{Binding HasFavorites, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <DockPanel Style="{StaticResource SectionLine}">
              <TextBlock Text="Pick up a thread" Style="{StaticResource Text.Row}" />
            </DockPanel>
            <WrapPanel>
              <Button x:Name="OpenFavorites" Content="Your favorites" c:Ui.Icon="{StaticResource Icon.Heart}" Margin="0,0,8,8"
                      Command="{Binding OpenFavoritesCommand}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- Add to a new or another collection, from a cover's menu: a dialog over the page. Esc or Cancel closes it. -->
    <Grid Visibility="{Binding Collections.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,-36" Background="{DynamicResource Bt.Shadow}" />
      <v:CollectionDialogView DataContext="{Binding Collections.Dialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Top" />
    </Grid>

    <!-- Add to a new or another session, from a cover's menu: a dialog over the page. Esc or Cancel closes it. -->
    <Grid Visibility="{Binding Sessions.Dialog, Converter={StaticResource Bt.VisibleWhenSet}}">
      <Border Margin="-42,-36,0,-36" Background="{DynamicResource Bt.Shadow}" />
      <v:SessionDialogView DataContext="{Binding Sessions.Dialog}" MaxWidth="480" Margin="0,24,42,24" VerticalAlignment="Top" />
    </Grid>
  </Grid>
</UserControl>
