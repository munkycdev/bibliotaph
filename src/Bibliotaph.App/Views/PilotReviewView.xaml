<UserControl x:Class="Bibliotaph.App.Views.PilotReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PilotReviewViewModel}">
  <UserControl.Resources>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style x:Key="Problem" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Accent}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </UserControl.Resources>

  <StackPanel MaxWidth="720" HorizontalAlignment="Left">
    <TextBlock Text="What is this book, really?" Style="{StaticResource Text.H1}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,0" TextWrapping="Wrap"
               Text="Your answers are the key the models are scored against. The values below come from the models and your catalog, in alphabetical order, so nothing says which model gave which. Use one, type your own, or say the book doesn't state it. Leave a field blank to skip it." />
    <TextBlock Text="{Binding PositionText}" Style="{StaticResource Note}" Margin="0,12,0,0" />

    <StackPanel Visibility="{Binding Book, Converter={StaticResource Bt.VisibleWhenSet}}">
      <DockPanel Margin="0,16,0,0">
        <Button DockPanel.Dock="Right" Content="Open book" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}" Command="{Binding OpenBookCommand}"
                VerticalAlignment="Center" Margin="12,0,0,0" />
        <StackPanel>
          <TextBlock Text="{Binding Book.Title}" Style="{StaticResource Text.H2}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Book.Book.Path}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                     ToolTip="{Binding Book.Book.Path}" />
        </StackPanel>
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="Fields">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PilotFieldViewModel}">
            <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,14">
              <StackPanel>
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NotInBook}" Content="Not in this book" Foreground="{DynamicResource Bt.Text}"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            AutomationProperties.Name="{Binding Label, StringFormat='{}{0} is not in this book'}" />
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Row}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                         AutomationProperties.Name="{Binding Label, StringFormat='Your answer for {0}'}" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Note}" Visibility="{Binding Hint, Converter={StaticResource Bt.VisibleWhenSet}}" />
                <TextBlock Text="No values offered." Style="{StaticResource Note}" Visibility="{Binding HasOptions, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
                <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PilotOptionViewModel}">
                      <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="Use" Command="{Binding UseCommand}" VerticalAlignment="Top" Margin="0,0,10,0"
                                AutomationProperties.Name="{Binding Text, StringFormat='Use {0}'}" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,2,0,0"
                                     Visibility="{Binding Detail, Converter={StaticResource Bt.VisibleWhenSet}}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <CheckBox IsChecked="{Binding Session.AlsoCatalog}" Content="Also save as my values in the catalog" Foreground="{DynamicResource Bt.Text}" Margin="0,16,0,0" />
      <TextBlock Text="{Binding Problem}" Style="{StaticResource Problem}" Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
      <WrapPanel Margin="0,14,0,0">
        <Button Content="Previous" c:Ui.Icon="{StaticResource Icon.ChevronLeft}" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource Bt.Button.Primary}" Content="Save and next" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
        <Button Content="Skip" c:Ui.Icon="{StaticResource Icon.ChevronRight}" Command="{Binding SkipCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" Visibility="{Binding Note, Converter={StaticResource Bt.VisibleWhenSet}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
