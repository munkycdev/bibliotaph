<UserControl x:Class="Bibliotaph.App.Views.AddElsewhereView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AddElsewhereViewModel}"
             KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Add a book you own elsewhere">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,14,0,5" />
    </Style>
  </UserControl.Resources>

  <!-- F5 plan, choice 1: a title and the few fields most books need; the inspector opens after for the rest. -->
  <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.15" />
    </Border.Effect>
    <StackPanel Margin="28,22,28,22">
      <DockPanel Margin="0,0,0,4">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" VerticalAlignment="Top"
                ToolTip="Close (Esc)" AutomationProperties.Name="Close without adding a book" Command="{Binding CancelCommand}" />
        <StackPanel>
          <TextBlock Text="OWNED ELSEWHERE" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
          <TextBlock Text="Add a book you own elsewhere" Style="{StaticResource Text.H2}" />
          <TextBlock Text="In print or on a virtual tabletop. It gets a card with no file, so search finds it with the rest."
                     Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </DockPanel>

      <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="TitleBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Game system" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="SystemChoice" Style="{StaticResource Bt.Select}" ItemsSource="{Binding Systems}" SelectedItem="{Binding System}"
                    AutomationProperties.Name="Game system" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="TypeChoice" Style="{StaticResource Bt.Select}" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"
                    AutomationProperties.Name="Type" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Publisher" Style="{StaticResource FieldLabel}" />
      <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Publisher" />

      <TextBlock Text="Also own" Style="{StaticResource FieldLabel}" />
      <ItemsControl x:Name="Owns" ItemsSource="{Binding Owns}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OwnOption}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource Bt.Text}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Also own on {0}'}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding OtherOwn, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
               AutomationProperties.Name="Somewhere else" ToolTip="Somewhere not in the list, such as another VTT. Separate several with commas." />
      <TextBlock Text="Somewhere else, if it isn't in the list" Style="{StaticResource Text.Small}" Margin="0,5,0,0" />

      <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,12,0,0"
                 Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
        <Button x:Name="SaveButton" Style="{StaticResource Bt.Button.Primary}" Content="Add to library" c:Ui.Icon="{StaticResource Icon.Plus}"
                Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
