<UserControl x:Class="Bibliotaph.App.Views.AiReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
        xmlns:p="clr-namespace:Bibliotaph.Processing;assembly=Bibliotaph.Processing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiReadingViewModel}">
  <!-- AI reading (Built-in AI plan, choices 12 and 13): the book being read now, then the last books read. -->
  <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,42,24">
    <TextBlock Text="AI reading." Style="{StaticResource Text.H1}" />
    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,9,0,24" TextWrapping="Wrap"
               Text="{x:Static p:AiReadingText.Subtitle}" />

    <!-- Now -->
    <TextBlock Text="Now" Style="{StaticResource Text.Eyebrow}" />
    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="18" Margin="0,8,0,0"
            Visibility="{Binding HasCurrent, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Text.Row}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Book being read" />
        </DockPanel>
        <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.Name="What the AI is doing" />
        <ProgressBar Style="{StaticResource Bt.ProgressBar}" Value="{Binding ReadPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"
                     AutomationProperties.Name="How much of the excerpt has been read"
                     Visibility="{Binding ShowReadProgress, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,10,0,0" AutomationProperties.Name="The answer so far">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type p:AiTestLine}">
              <TextBlock FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,3,0,0">
                <Run Text="{Binding Text, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Detail, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding IdleText}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.Name="Nothing being read"
               Visibility="{Binding HasCurrent, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
    <WrapPanel Margin="0,12,0,0">
      <Button Content="AI settings" Command="{Binding OpenAiSettingsCommand}" />
    </WrapPanel>

    <!-- The last books read -->
    <TextBlock Text="Last read" Style="{StaticResource Text.Eyebrow}" Margin="0,28,0,0" />
    <TextBlock Text="{x:Static p:AiReadingText.NothingRead}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"
               Visibility="{Binding HasRecent, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False" AutomationProperties.Name="Books read">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type p:AiReadingDone}">
          <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,10">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,0,0,6" />
              <TextBlock Text="{Binding Problem}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                         Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <ItemsControl ItemsSource="{Binding Kept}" Focusable="False" AutomationProperties.Name="Kept">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type p:AiTestLine}">
                    <StackPanel Margin="0,0,0,6">
                      <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Dropped}" Focusable="False" AutomationProperties.Name="Thrown away">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type p:AiTestLine}">
                    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,2,0,0">
                      <Run Text="Thrown away: " /><Run Text="{Binding Text, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
