<UserControl x:Class="Bibliotaph.App.Views.RunSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RunSessionViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextItemCommand}" />
    <KeyBinding Key="Left" Modifiers="Control" Command="{Binding PreviousItemCommand}" />
    <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- A section's heading in the list. -->
    <DataTemplate DataType="{x:Type vm:SessionSectionRow}">
      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Eyebrow}" Margin="10,16,10,6" />
    </DataTemplate>

    <!-- An item in the list: its number, label and pages. The one in hand stands out; one that can't open is dimmed. -->
    <DataTemplate DataType="{x:Type vm:SessionItemRow}">
      <Button x:Name="RunItem" Cursor="Hand" FocusVisualStyle="{StaticResource Bt.FocusVisual}" AutomationProperties.Name="{Binding AccessibleName}"
              Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="10,8" Margin="0,0,0,2">
              <DockPanel x:Name="Text">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Muted}"
                           Margin="0,1,10,0" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Where}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextWrapping="Wrap"
                             Visibility="{Binding HasReason, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                <Setter TargetName="Text" Property="Opacity" Value="0.55" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Panel}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Line}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="16,14,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!--
      The items' list gives way first on a narrow window (at 200% scaling, say): the reader keeps the width its toolbar
      needs to stay on a few rows, and so the height its page needs.
    -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="150" MaxWidth="250" />
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- The header: the pack, where you are in it, and the controls. -->
    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PreviousItem" Content="Previous" c:Ui.Icon="{StaticResource Icon.ChevronLeft}" Command="{Binding PreviousItemCommand}"
                ToolTip="Previous item (Ctrl+Left)" Margin="0,0,6,0" />
        <Button x:Name="NextItem" Style="{StaticResource Bt.Button.Primary}" Content="Next" c:Ui.Icon="{StaticResource Icon.ChevronRight}"
                Command="{Binding NextItemCommand}" ToolTip="Next item (Ctrl+Right)" Margin="0,0,14,0" />
        <Button x:Name="ToggleNotes" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.PanelRight}" Command="{Binding ToggleNotesCommand}"
                ToolTip="Show or hide the binder notes" AutomationProperties.Name="Binder notes" />
        <Button x:Name="FullScreen" Style="{StaticResource Bt.Link}" Content="{Binding FullScreenLabel}" Command="{Binding ToggleFullScreenCommand}"
                ToolTip="F11" Margin="8,0,8,0" VerticalAlignment="Center" />
        <Button x:Name="PopOutItem" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SquareArrowOutUpRight}"
                Command="{Binding Viewer.PopOutCommand}" ToolTip="Open this item in a window of its own, for another screen" AutomationProperties.Name="Pop out" />
        <Button x:Name="EndSession" Content="End session" c:Ui.Icon="{StaticResource Icon.X}" Command="{Binding EndCommand}" ToolTip="Back to the binder's page (Esc)"
                Margin="10,0,0,0" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Text.Eyebrow}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock x:Name="RunTitle" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock x:Name="ItemCounter" Text="{Binding Counter}" Style="{StaticResource Text.Small}" Margin="14,0,0,0" VerticalAlignment="Center" />
          <Button x:Name="BackToItem" Style="{StaticResource Bt.Link}" Content="Back to this item's pages" Margin="12,0,0,0" VerticalAlignment="Center"
                  Command="{Binding BackToItemCommand}" Visibility="{Binding IsOutsideItem, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- The items, numbered under their sections. -->
    <Border Grid.Row="1" Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="6"
            Margin="0,0,12,0" Padding="6">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="RunItems" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Binder items"
                      KeyboardNavigation.TabNavigation="Continue" />
      </ScrollViewer>
    </Border>

    <!-- The reader for the item in hand; other pages stay reachable. -->
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Viewer}" Focusable="False" />

    <!-- The session's notes, saved as you type; the panel folds away. -->
    <Border Grid.Row="1" Grid.Column="2" Width="260" Margin="12,0,0,0" Visibility="{Binding ShowNotes, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Binder notes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" Margin="0,0,0,10" />
        <!-- The notes on the item's pages (slice 3 plan, choice 18), added in the reader with Note. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="{Binding HasItemNotes, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <TextBlock Text="On these pages" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" Margin="0,0,0,8" />
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="RunPageNotes" ItemsSource="{Binding ItemNotes}" Focusable="False" AutomationProperties.Name="Notes on these pages"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PageNoteRow}">
                  <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" AutomationProperties.Name="{Binding AccessibleName}">
                    <StackPanel>
                      <Button Style="{StaticResource Bt.Link}" Content="{Binding Pages}" HorizontalAlignment="Left"
                              ToolTip="Go to these pages" AutomationProperties.Name="{Binding Pages, StringFormat='Go to {0}'}"
                              Command="{Binding DataContext.Viewer.GoToNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                      <DockPanel Margin="0,6,0,0" Visibility="{Binding HasReason, Converter={StaticResource Bt.VisibleWhenTrue}}">
                        <c:LucideIcon x:Name="NoteReasonIcon" Data="{StaticResource Icon.TriangleAlert}" Size="12" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                      <Setter TargetName="NoteReasonIcon" Property="Foreground" Value="{DynamicResource Bt.Accent}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
        <TextBox x:Name="RunNotes" Style="{StaticResource Bt.TextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Binder notes"
                 ToolTip="Saved as you type" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
