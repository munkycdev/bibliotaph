<UserControl x:Class="Bibliotaph.App.Views.PageNoteDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PageNoteDialogViewModel}"
             KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding Heading}">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,14,0,5" />
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.15" />
    </Border.Effect>
    <StackPanel Margin="28,22,28,22">
      <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" VerticalAlignment="Top"
                ToolTip="Close (Esc)" AutomationProperties.Name="Close" Command="{Binding CancelCommand}" />
        <StackPanel>
          <TextBlock Text="PAGE NOTE" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.H2}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="From page" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="NoteFromBox" Style="{StaticResource Bt.TextBox}" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From page" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="To page (optional)" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="NoteToBox" Style="{StaticResource Bt.TextBox}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To page" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding PagesProblem}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Visibility="{Binding PagesProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />
      <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="NoteTextBox" Style="{StaticResource Bt.TextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
               TextWrapping="Wrap" MinHeight="110" MaxHeight="260" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Note" ToolTip="Ctrl+Enter saves" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
        <Button x:Name="SaveNoteButton" Style="{StaticResource Bt.Button.Primary}" Content="{Binding ActionText}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
