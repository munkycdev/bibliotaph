<Window x:Class="Bibliotaph.App.Views.OnlineBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Bibliotaph.App.Controls"
        xmlns:v="clr-namespace:Bibliotaph.App.Views"
        xmlns:s="clr-namespace:Bibliotaph.App.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance v:OnlineBrowserState}"
        Title="{Binding WindowTitle}" Width="1180" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bt.Panel}" Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}" FontSize="12" UseLayoutRounding="True">
  <!-- The in-app browser (online libraries, O2): the service's own pages, and Read this page for the one in view. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="GoBack" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowLeft}" Click="Back_Click"
                  IsEnabled="{Binding CanGoBack}" ToolTip="Back" AutomationProperties.Name="Back" Margin="0,0,4,0" />
          <Button x:Name="GoForward" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowRight}" Click="Forward_Click"
                  IsEnabled="{Binding CanGoForward}" ToolTip="Forward" AutomationProperties.Name="Forward" Margin="0,0,4,0" />
          <Button x:Name="ReloadPage" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Click="Reload_Click"
                  ToolTip="Reload the page (F5)" AutomationProperties.Name="Reload the page" Margin="0,0,12,0" />
        </StackPanel>
        <Button x:Name="SavePage" DockPanel.Dock="Right" Content="Save page…" Click="Save_Click" IsEnabled="{Binding CanSave}" Margin="12,0,0,0" VerticalAlignment="Center"
                ToolTip="Save the page as it shows now, signed in as you, to a file of your choosing. Useful when Read this page doesn't recognise it." />
        <Button x:Name="ReadPage" DockPanel.Dock="Right" Style="{StaticResource Bt.Button.Primary}" Content="Read this page" c:Ui.Icon="{StaticResource Icon.LibraryBig}"
                Click="Read_Click" IsEnabled="{Binding CanRead}" Margin="12,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding ReadsLibrary, Converter={StaticResource Bt.VisibleWhenTrue}}"
                ToolTip="Read the books on this page into a preview in Bibliotaph. Nothing is imported until you say so." />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Address" Text="{Binding Address}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Address}" />
          <TextBlock x:Name="BrowserStatus" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Store downloads (O5): each file, how far it has got, and where it went. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Padding="12,6" MaxHeight="132"
            Visibility="{Binding HasDownloads, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="BrowserDownloads" ItemsSource="{Binding Downloads}" Focusable="False" AutomationProperties.Name="Downloads">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type s:OnlineDownload}">
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Show in folder" Command="{Binding ShowInFolderCommand}" Margin="12,0,0,0"
                        Visibility="{Binding Saved, Converter={StaticResource Bt.VisibleWhenTrue}}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in its folder'}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0"
                        Visibility="{Binding InProgress, Converter={StaticResource Bt.VisibleWhenTrue}}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Cancel downloading {0}'}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" />
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <wv2:WebView2 x:Name="Web" AutomationProperties.Name="{Binding ServiceName, StringFormat='{}{0} page'}" />
  </DockPanel>
</Window>
