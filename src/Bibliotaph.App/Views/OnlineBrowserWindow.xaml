<Window x:Class="Bibliotaph.App.Views.OnlineBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Bibliotaph.App.Controls"
        xmlns:v="clr-namespace:Bibliotaph.App.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance v:OnlineBrowserState}"
        Title="{Binding WindowTitle}" Width="1180" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bt.Panel}" Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}" FontSize="12" UseLayoutRounding="True">
  <!-- The in-app browser (online libraries, O2): the service's own pages, and Read this page for the one in view. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="GoBack" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowLeft}" Click="Back_Click"
                  IsEnabled="{Binding CanGoBack}" ToolTip="Back" AutomationProperties.Name="Back" Margin="0,0,4,0" />
          <Button x:Name="GoForward" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowRight}" Click="Forward_Click"
                  IsEnabled="{Binding CanGoForward}" ToolTip="Forward" AutomationProperties.Name="Forward" Margin="0,0,4,0" />
          <Button x:Name="ReloadPage" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Click="Reload_Click"
                  ToolTip="Reload the page (F5)" AutomationProperties.Name="Reload the page" Margin="0,0,12,0" />
        </StackPanel>
        <Button x:Name="ReadPage" DockPanel.Dock="Right" Style="{StaticResource Bt.Button.Primary}" Content="Read this page" c:Ui.Icon="{StaticResource Icon.LibraryBig}"
                Click="Read_Click" IsEnabled="{Binding CanRead}" Margin="12,0,0,0" VerticalAlignment="Center"
                ToolTip="Read the books on this page into a preview in Bibliotaph. Nothing is imported until you say so." />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Address" Text="{Binding Address}" FontSize="12" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Address}" />
          <TextBlock x:Name="BrowserStatus" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <wv2:WebView2 x:Name="Web" AutomationProperties.Name="{Binding ServiceName, StringFormat='{}{0} page'}" />
  </DockPanel>
</Window>
