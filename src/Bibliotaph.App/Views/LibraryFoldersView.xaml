<UserControl x:Class="Bibliotaph.App.Views.LibraryFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:services="clr-namespace:Bibliotaph.App.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryFoldersViewModel}">
  <UserControl.Resources>
    <!-- A pause button that becomes Resume while its lane is paused. Tag carries the paused flag. -->
    <Style x:Key="PauseToggle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="c:Ui.Icon" Value="{StaticResource Icon.Pause}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="c:Ui.Icon" Value="{StaticResource Icon.Play}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <StackPanel MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="Library folders" Style="{StaticResource Text.H1}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,8"
               Text="Bibliotaph reads your folders. Your books stay exactly where you put them." />

    <!-- Indexing progress (spec 4.1: separate progress for each step), with pause and resume for each lane while it has work. -->
    <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0"
            Visibility="{Binding HasFolders, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <StackPanel>
        <TextBlock Text="{Binding Activity.Summary}" Style="{StaticResource Text.Row}" />
        <TextBlock Text="{Binding Activity.TimeLeftText}" Margin="0,4,0,0" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.TimeLeftText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Activity.Phases}" Focusable="False" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type services:PhaseProgress}">
              <Grid Margin="0,6,0,0" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Status}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" MinWidth="80" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Text}" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Bt.ProgressBar}">
                      <Setter Property="Value" Value="{Binding Percent, Mode=OneWay}" />
                      <Setter Property="IsIndeterminate" Value="{Binding IsIndeterminate, Mode=OneWay}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static services:PhaseState.Done}">
                          <Setter Property="Foreground" Value="{DynamicResource Bt.StatusOk}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static services:PhaseState.Paused}">
                          <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"
                           MinWidth="190" TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- What each part is on right now, so the page shows movement even while a bar creeps. -->
        <StackPanel Margin="0,12,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.Now.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Now" Style="{StaticResource Text.Eyebrow}" />
          <ItemsControl ItemsSource="{Binding Activity.Now}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding Activity.Notes}" Margin="0,10,0,0" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Activity.Notes}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Activity.WaitingForDiskSpace, Converter={StaticResource Bt.VisibleWhenTrue}}"
                   Text="Online-only files are waiting: downloading more would leave less than 2 GB free on that drive." />
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Activity.IsAiWaiting, Converter={StaticResource Bt.VisibleWhenTrue}}"
                   Text="{Binding Activity.AiWaiting, StringFormat='Cataloguing with AI is waiting: {0}'}" />
        <WrapPanel Margin="0,12,0,0">
          <Button Style="{StaticResource PauseToggle}" Tag="{Binding Activity.IndexPaused}" Command="{Binding ToggleIndexingCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowIndexPause, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Content>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Pause indexing" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Activity.IndexPaused}" Value="True">
                        <Setter Property="Text" Value="Resume indexing" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.Content>
          </Button>
          <Button Style="{StaticResource PauseToggle}" Tag="{Binding Activity.OcrPaused}" Command="{Binding ToggleOcrCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowOcrPause, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Content>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Pause reading scans" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Activity.OcrPaused}" Value="True">
                        <Setter Property="Text" Value="Resume reading scans" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.Content>
          </Button>
          <Button Style="{StaticResource PauseToggle}" Tag="{Binding Activity.AiPaused}" Command="{Binding ToggleAiCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Activity.ShowAiPause, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Content>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Pause AI" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Activity.AiPaused}" Value="True">
                        <Setter Property="Text" Value="Resume AI" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.Content>
          </Button>
          <Button Content="Look for changes" c:Ui.Icon="{StaticResource Icon.RotateCcw}" Command="{Binding RescanCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryFolderItem}">
          <!-- .bt-source -->
          <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}"
                      ToolTip="Remove from library" AutomationProperties.Name="{Binding Path, StringFormat='Remove {0} from the library'}"
                      Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" />
              <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Folder}" Margin="0,0,10,0" VerticalAlignment="Top" />
              <StackPanel>
                <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Style="{StaticResource Bt.ProgressBar}" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,8,0,2"
                             Visibility="{Binding ShowProgress, Converter={StaticResource Bt.VisibleWhenTrue}}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Visibility="{Binding HasFolders, Converter={StaticResource Bt.CollapsedWhenTrue}}"
               Style="{StaticResource Text.Small}" Margin="0,12,0,0" Text="No folders yet." />

    <!-- Picked folders: what each holds, before it is added. -->
    <ItemsControl ItemsSource="{Binding Pending}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PendingFolder}">
          <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.FolderPlus}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Row}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
              <WrapPanel Margin="0,12,0,0">
                <Button Style="{StaticResource Bt.Button.Primary}" Content="Add to library" c:Ui.Icon="{StaticResource Icon.Check}" Margin="0,0,8,0"
                        IsEnabled="{Binding CanAdd}"
                        Command="{Binding DataContext.ConfirmAddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="Cancel"
                        Command="{Binding DataContext.CancelAddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Style="{StaticResource Bt.Button.Primary}" Margin="0,25,0,0" Content="Add a folder"
            c:Ui.Icon="{StaticResource Icon.FolderPlus}" Command="{Binding AddFolderCommand}" />
    <TextBlock Style="{StaticResource Text.Small}" Margin="0,12,0,0"
               Text="Removing a folder keeps your notes, collections and corrections. Files are never deleted." />

    <!-- Folder names read as labels, each of which can be switched off. -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,20,0,0">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Refresh" Command="{Binding RefreshFolderLabelsCommand}"
                  AutomationProperties.Name="Refresh folder names" />
          <TextBlock Text="Folder names" Style="{StaticResource Text.Row}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,12" TextWrapping="Wrap"
                   Text="Folder names like “D&amp;D 5e” or “Adventures” are read as suggestions for the books inside. Switch one off if a name means something else in your library. Your own corrections always win." />
        <TextBlock Style="{StaticResource Text.Small}" Text="No folder names in your library match a game system, type or other label yet."
                   Visibility="{Binding HasFolderLabels, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
        <ItemsControl ItemsSource="{Binding FolderLabels}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FolderLabelItem}">
              <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalContentAlignment="Top" Foreground="{DynamicResource Bt.Text}"
                          AutomationProperties.Name="{Binding Folder, StringFormat='Read the folder name {0} as a label'}">
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock FontSize="12" TextWrapping="Wrap">
                      <Run Text="{Binding Folder, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" → " Foreground="{DynamicResource Bt.Muted}" /><Run Text="{Binding Meaning, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Start over: a development aid, to be removed before 1.0. -->
    <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,20,0,0">
      <StackPanel>
        <TextBlock Text="Start over" Style="{StaticResource Text.Row}" />
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,5,0,12" TextWrapping="Wrap"
                   Text="Forgets every folder, the index, covers, settings and remembered passwords, then restarts. Your files are not touched. Here while Bibliotaph is in development." />
        <Button Content="Start over…" c:Ui.Icon="{StaticResource Icon.RotateCcw}" HorizontalAlignment="Left"
                Command="{Binding StartOverCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
