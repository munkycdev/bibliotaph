<UserControl x:Class="Bibliotaph.App.Views.BulkEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BulkEditViewModel}"
             KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding Heading}">
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- A chip's body: clicking one that only some books have puts it on all of them. -->
    <Style x:Key="ChipBody" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="8,4,2,4">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The × on a chip. -->
    <Style x:Key="ChipRemove" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Padding="4" Margin="0,0,3,0">
              <c:LucideIcon Data="{StaticResource Icon.X}" Size="11" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Panel}" />
                <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:BulkChipViewModel}">
      <Border x:Name="Chip" CornerRadius="4" Background="{DynamicResource Bt.Side}" Margin="0,3,6,3" BorderThickness="1"
              BorderBrush="{DynamicResource Bt.Side}">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="Body" Style="{StaticResource ChipBody}" Command="{Binding ToggleAllCommand}" ToolTip="{Binding Description}"
                  AutomationProperties.Name="{Binding Description}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Text" Text="{Binding Text}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding NewNote}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource Bt.Muted}" Margin="5,0,0,0"
                         VerticalAlignment="Center" Visibility="{Binding NewNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <TextBlock x:Name="Count" Text="{Binding CountText}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" Margin="7,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ChipRemove}" Command="{Binding RemoveCommand}" ToolTip="{Binding RemoveName}"
                  AutomationProperties.Name="{Binding RemoveName}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsAdding}" Value="True">
          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bt.Soft}" />
          <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
          <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Bt.Accent}" />
          <Setter TargetName="Count" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRemoving}" Value="True">
          <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="Body" Property="Opacity" Value="0.6" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A single-value field: what the books share, or Mixed, and the value to set on all of them. -->
    <DataTemplate DataType="{x:Type vm:BulkValueFieldViewModel}">
      <Border Padding="0,12" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" AutomationProperties.Name="{Binding Label}">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Bt.Link}" Content="Back to suggestions" c:Ui.Icon="{StaticResource Icon.Undo2}" Command="{Binding ResetCommand}"
                      Margin="0,0,10,0" ToolTip="Forget what you set here on every book and go back to what the sources suggest"
                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0}: back to suggestions on every book'}"
                      Visibility="{Binding ShowReset, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}" Command="{Binding EditCommand}"
                      ToolTip="Set on every book" AutomationProperties.Name="{Binding Label, StringFormat='Set {0} on every book'}"
                      Visibility="{Binding ShowEdit, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              <Button Style="{StaticResource Bt.Link}" Content="Undo change" Command="{Binding UndoCommand}"
                      AutomationProperties.Name="{Binding Label, StringFormat='Leave {0} as it is'}"
                      Visibility="{Binding HasChange, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,0,3" />
              <TextBlock x:Name="Current" Text="{Binding Current}" FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Breakdown}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextWrapping="Wrap"
                         Visibility="{Binding Breakdown, Converter={StaticResource Bt.VisibleWhenSet}}" />
              <TextBlock Text="{Binding PendingText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Bt.Accent}" Margin="0,5,0,0"
                         TextWrapping="Wrap" Visibility="{Binding PendingText, Converter={StaticResource Bt.VisibleWhenSet}}" />
            </StackPanel>
          </DockPanel>

          <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding Label, StringFormat='{}{0} for every book'}" c:Ui.FocusWhenVisible="True">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding EditHint}" Style="{StaticResource Text.Small}" Margin="0,5,0,0"
                       Visibility="{Binding EditHint, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,5,0,0"
                       Visibility="{Binding Resolution, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <StackPanel Margin="0,10,0,0" Visibility="{Binding UsesChoices, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <TextBlock Text="Or pick from the list" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Choices}" SelectedItem="{Binding PickedChoice}"
                        AutomationProperties.Name="{Binding Label, StringFormat='Pick a {0}'}" HorizontalAlignment="Stretch" MaxDropDownHeight="280" />
            </StackPanel>
            <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{StaticResource Bt.Button.Primary}" Content="Set on every book" c:Ui.Icon="{StaticResource Icon.Check}"
                      Command="{Binding SaveCommand}" Margin="0,0,8,0" />
              <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsKnown}" Value="False">
          <Setter TargetName="Current" Property="Foreground" Value="{DynamicResource Bt.Muted}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A multi-value field: every value any book has, as a chip with a count, and a box to add one to every book. -->
    <DataTemplate DataType="{x:Type vm:BulkChipsFieldViewModel}">
      <Border Padding="0,12" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" AutomationProperties.Name="{Binding Label}">
        <StackPanel>
          <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Bt.Muted}" Margin="0,0,0,3" />
          <ItemsControl ItemsSource="{Binding Chips}" Focusable="False" AutomationProperties.Name="{Binding Label, StringFormat='{}{0} on these books'}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="Not set on any of these books" FontSize="12" Foreground="{DynamicResource Bt.Muted}"
                     Visibility="{Binding HasChips, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Add" c:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding AddTypedCommand}" Margin="8,0,0,0"
                    AutomationProperties.Name="{Binding AddLabel}" />
            <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding AddText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding AddLabel}" ToolTip="Separate values with commas">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddTypedCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
          <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,5,0,0"
                     Visibility="{Binding Resolution, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,5,0,0"
                     Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Choices}" SelectedItem="{Binding PickedChoice}" Margin="0,8,0,0"
                    AutomationProperties.Name="{Binding AddLabel, StringFormat='{}{0} from the list'}" HorizontalAlignment="Stretch" MaxDropDownHeight="280"
                    ToolTip="Add from the list" Visibility="{Binding UsesChoices, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BulkSummaryLine}">
      <Border Padding="0,10" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBlock FontSize="12" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap">
            <Run Text="{Binding Field, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
          </TextBlock>
          <DockPanel Margin="0,5,0,0" Visibility="{Binding HasWarning, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <c:LucideIcon DockPanel.Dock="Left" Data="{StaticResource Icon.TriangleAlert}" Size="13" Foreground="{DynamicResource Bt.Accent}"
                          VerticalAlignment="Top" Margin="0,1,7,0" />
            <TextBlock Text="{Binding Warning}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.15" />
    </Border.Effect>
    <DockPanel Margin="28,22,28,22">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" VerticalAlignment="Top"
                ToolTip="Close (Esc)" AutomationProperties.Name="Close without changing anything" Command="{Binding CancelCommand}" />
        <StackPanel>
          <TextBlock Text="EDIT METADATA" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.H2}" />
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Change any field but the title. What you set is confirmed on every book; fields you don't touch stay as they are."
                     Visibility="{Binding IsEditingStep, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Check what will change before it's applied. You can undo it afterwards."
                     Visibility="{Binding IsSummaryStep, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </StackPanel>
      </DockPanel>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditingStep, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Bt.Button.Primary}" Content="Review changes" c:Ui.Icon="{StaticResource Icon.ArrowRight}"
                    Command="{Binding ReviewCommand}" ToolTip="See what will change before anything is saved" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsSummaryStep, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button Content="Back" c:Ui.Icon="{StaticResource Icon.ArrowLeft}" Command="{Binding BackCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Bt.Button.Primary}" Content="{Binding ApplyLabel}" c:Ui.Icon="{StaticResource Icon.Check}"
                    Command="{Binding ApplyCommand}" AutomationProperties.Name="{Binding ApplyLabel}" c:Ui.FocusWhenVisible="True" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="0,0,16,0" Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
      </DockPanel>

      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsEditingStep, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" Margin="0,0,8,0"
                        AutomationProperties.Name="Fields" />
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsSummaryStep, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <ItemsControl ItemsSource="{Binding Summary}" Focusable="False" Margin="0,0,8,0" AutomationProperties.Name="What will change" />
        </ScrollViewer>
        <StackPanel VerticalAlignment="Center" Margin="0,30" Visibility="{Binding IsApplyingStep, Converter={StaticResource Bt.VisibleWhenTrue}}">
          <ProgressBar Style="{StaticResource Bt.ProgressBar}" IsIndeterminate="True" AutomationProperties.Name="Applying" />
          <TextBlock Text="{Binding Progress}" Style="{StaticResource Text.Small}" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
