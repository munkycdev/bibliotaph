<UserControl x:Class="Bibliotaph.App.Views.VocabularyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Bibliotaph.App.Controls"
             xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
             xmlns:catalog="clr-namespace:Bibliotaph.Catalog;assembly=Bibliotaph.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:VocabularyViewModel}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- The × on a name's chip. -->
    <Style x:Key="ChipRemove" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Padding="4">
              <c:LucideIcon Data="{StaticResource Icon.X}" Size="11" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="Vocabulary" Style="{StaticResource Text.H2}" />
    <TextBlock Style="{StaticResource Text.Copy}" Margin="0,12,0,8" TextWrapping="Wrap"
               Text="The game systems, types and other terms your books are filed under, and the other names each one goes by. Folder names, searches and what you type all go through these names." />

    <ItemsControl ItemsSource="{Binding Vocabularies}" Focusable="False" Margin="0,12,0,12" AutomationProperties.Name="Vocabularies">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:VocabularyChoice}">
          <RadioButton Style="{StaticResource Bt.Tab}" GroupName="Vocabulary" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Style="{StaticResource Bt.Rule}" />

    <StackPanel Visibility="{Binding IsTags, Converter={StaticResource Bt.CollapsedWhenTrue}}">
      <!-- New names from the AI: a card in Needs review, or straight into the list. -->
      <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,18"
              Visibility="{Binding OffersAiTerms, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource Bt.SegmentGroup}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="{x:Static vm:VocabularyViewModel.AiTermsTitle}">
              <RadioButton Style="{StaticResource Bt.Segment}" GroupName="AiTerms" Content="Ask first" IsChecked="{Binding AiTermsAsk}" />
              <RadioButton Style="{StaticResource Bt.Segment}" GroupName="AiTerms" Content="Add them" IsChecked="{Binding AiTermsAdd}" />
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{x:Static vm:VocabularyViewModel.AiTermsTitle}" Style="{StaticResource Text.Row}" />
            <TextBlock Text="{x:Static vm:VocabularyViewModel.AiTermsHelp}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AiTermsNote}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                       Visibility="{Binding AiTermsNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Find overlaps: terms that look like one thing, to combine (with Undo) or keep apart. -->
      <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,18">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static vm:VocabularyViewModel.OverlapsTitle}" c:Ui.Icon="{StaticResource Icon.Search}"
                    Command="{Binding FindOverlapsCommand}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{x:Static vm:VocabularyViewModel.OverlapsTitle}" Style="{StaticResource Text.Row}" />
              <TextBlock Text="{x:Static vm:VocabularyViewModel.OverlapsHelp}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{x:Static vm:VocabularyViewModel.OverlapsComparing}" Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                     Visibility="{Binding IsFindingOverlaps, Converter={StaticResource Bt.VisibleWhenTrue}}" />
          <TextBlock Text="{Binding OverlapsNote}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Visibility="{Binding OverlapsNote, Converter={StaticResource Bt.VisibleWhenSet}}" />

          <!-- What the last Combine or Keep apart did, with Undo. -->
          <DockPanel Margin="0,10,0,0" Visibility="{Binding OverlapUndo.Message, Converter={StaticResource Bt.VisibleWhenSet}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource Bt.Link}" Content="Undo" c:Ui.Icon="{StaticResource Icon.Undo2}"
                    Command="{Binding OverlapUndo.UndoCommand}" Padding="12,0,0,0" AutomationProperties.Name="Undo the change to the terms"
                    Visibility="{Binding OverlapUndo.HasUndo, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            <TextBlock Text="{Binding OverlapUndo.Message}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>

          <ItemsControl ItemsSource="{Binding Overlaps}" Focusable="False" Margin="0,4,0,0" AutomationProperties.Name="Terms that may be the same thing">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:OverlapGroupViewModel}">
                <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,6,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding Names}" Style="{StaticResource Text.Row}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                      <TextBlock Text="{x:Static vm:VocabularyViewModel.KeepLabel}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox Style="{StaticResource Bt.Select}" ItemsSource="{Binding Terms}" SelectedItem="{Binding Keep}"
                                AutomationProperties.Name="{x:Static vm:VocabularyViewModel.KeepLabel}" Margin="0,0,8,0" />
                      <Button Content="{x:Static vm:VocabularyViewModel.CombineLabel}" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding CombineCommand}"
                              ToolTip="{x:Static vm:VocabularyViewModel.CombineHelp}" Margin="0,0,8,0" />
                      <Button Content="{x:Static vm:VocabularyViewModel.KeepApartLabel}" Command="{Binding KeepApartCommand}"
                              ToolTip="{x:Static vm:VocabularyViewModel.KeepApartHelp}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The pairs kept apart, each with × to have it offered again. -->
          <TextBlock Text="{Binding KeptApartNote}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"
                     Visibility="{Binding KeptApartNote, Converter={StaticResource Bt.VisibleWhenSet}}" />
          <ItemsControl ItemsSource="{Binding KeptApart}" Focusable="False" AutomationProperties.Name="Pairs kept apart">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:KeptApartRowViewModel}">
                <Border Style="{StaticResource Bt.Chip}" Background="{DynamicResource Bt.Panel}" Padding="8,2,2,2">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource ChipRemove}" Margin="4,0,0,0" Command="{Binding ForgetCommand}"
                            ToolTip="{x:Static vm:VocabularyViewModel.ForgetKeptApart}" AutomationProperties.Name="{Binding Text, StringFormat='Offer {0} again'}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Add a term -->
      <TextBlock Text="{Binding AddLabel}" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Add" c:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding AddTermCommand}" Margin="8,0,0,0" />
        <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding NewTerm, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding AddLabel}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding AddTermCommand}" />
          </TextBox.InputBindings>
        </TextBox>
      </DockPanel>
      <TextBlock Text="{Binding AddProblem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Visibility="{Binding AddProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />
      <TextBlock Text="{Binding AddNote}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Visibility="{Binding AddNote, Converter={StaticResource Bt.VisibleWhenSet}}" />

      <!-- Find -->
      <TextBlock Text="Find a term" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
      <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find a term" />

      <ItemsControl ItemsSource="{Binding Terms}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="Terms">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:TermRowViewModel}">
            <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,12">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}"
                          Command="{Binding EditCommand}" VerticalAlignment="Top"
                          ToolTip="Rename, or change its other names" AutomationProperties.Name="{Binding Label, StringFormat='Edit {0}'}"
                          Visibility="{Binding IsEditing, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Row}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Detail, Converter={StaticResource Bt.VisibleWhenSet}}" />
                  </StackPanel>
                </DockPanel>

                <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EditLabel, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Name" c:Ui.FocusWhenVisible="True">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RenameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Short name, on covers" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EditShort, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Short name">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RenameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                      </StackPanel>
                    </Grid>
                    <Button Content="Save name" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding RenameCommand}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" />

                    <TextBlock Text="Other names" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                    <ItemsControl ItemsSource="{Binding Aliases}" Focusable="False" AutomationProperties.Name="Other names">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type catalog:AliasEntry}">
                          <Border Style="{StaticResource Bt.Chip}" Background="{DynamicResource Bt.Panel}" Padding="8,2,2,2">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Bt.Text}" VerticalAlignment="Center" />
                              <Button Style="{StaticResource ChipRemove}" Margin="4,0,0,0"
                                      ToolTip="Remove this name" AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}"
                                      Command="{Binding DataContext.RemoveAliasCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="None yet." Style="{StaticResource Text.Small}"
                               Visibility="{Binding HasAliases, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
                    <DockPanel Margin="0,10,0,0">
                      <Button DockPanel.Dock="Right" Content="Add name" c:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding AddAliasCommand}"
                              Margin="8,0,0,0" />
                      <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding NewAlias, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="Another name">
                        <TextBox.InputBindings>
                          <KeyBinding Key="Enter" Command="{Binding AddAliasCommand}" />
                          <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                        </TextBox.InputBindings>
                      </TextBox>
                    </DockPanel>
                    <TextBlock Text="A name another term already has as another name moves here." Style="{StaticResource Text.Small}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Note, Converter={StaticResource Bt.VisibleWhenSet}}" />
                    <Button Content="Done" Command="{Binding CloseCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource Text.Small}" Margin="0,18,0,0" TextWrapping="Wrap"
                 Text="Renaming keeps everything filed under a term. Changes reach the library in the background; books under renamed folders are read again." />
    </StackPanel>

    <!-- Your tags: each found in the books' pages by its words. -->
    <StackPanel Visibility="{Binding IsTags, Converter={StaticResource Bt.VisibleWhenTrue}}">
      <TextBlock Style="{StaticResource Text.Copy}" Margin="0,18,0,0" TextWrapping="Wrap"
                 Text="Your own tags, found in your books by the words on their pages. A book whose pages use a tag's words often enough gets the tag, marked Suggested until you keep it. A tag you reject on a book never comes back to it." />

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="New tag" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New tag">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Words that signal it, separated by commas" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding NewTagWords, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Words that signal the new tag">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </StackPanel>
      </Grid>
      <Button Content="Add tag" c:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding AddTagCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
      <TextBlock Text="Looking through your books…" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                 Visibility="{Binding IsSearching, Converter={StaticResource Bt.VisibleWhenTrue}}" />
      <TextBlock Text="{Binding AddProblem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Visibility="{Binding AddProblem, Converter={StaticResource Bt.VisibleWhenSet}}" />
      <TextBlock Text="{Binding AddNote}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Visibility="{Binding AddNote, Converter={StaticResource Bt.VisibleWhenSet}}" />

      <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="Your tags">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:UserTagRowViewModel}">
            <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="0,12">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Pencil}"
                          Command="{Binding EditCommand}" VerticalAlignment="Top"
                          ToolTip="Rename, or change its words" AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}"
                          Visibility="{Binding IsEditing, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Row}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>

                <Border Background="{DynamicResource Bt.Side}" CornerRadius="6" Padding="15" Margin="0,12,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource Bt.VisibleWhenTrue}}">
                  <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Name" c:Ui.FocusWhenVisible="True">
                      <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                      </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Words that signal it, separated by commas" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                    <TextBox Style="{StaticResource Bt.TextBox}" Text="{Binding EditWords, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Words that signal it">
                      <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                      </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource Bt.Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Problem, Converter={StaticResource Bt.VisibleWhenSet}}" />
                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Note, Converter={StaticResource Bt.VisibleWhenSet}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                      <Button Content="Save" c:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding SaveCommand}" />
                      <Button Content="Delete tag" c:Ui.Icon="{StaticResource Icon.Trash2}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                              ToolTip="Takes its suggestions away. Books where you kept it keep it." />
                      <Button Content="Done" Command="{Binding CloseCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource Text.Small}" Margin="0,18,0,0" TextWrapping="Wrap"
                 Text="{Binding TagRuleHelp}" />
    </StackPanel>
  </StackPanel>
</UserControl>
