<Window x:Class="Bibliotaph.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Bibliotaph.App.Controls"
        xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
        xmlns:services="clr-namespace:Bibliotaph.App.Services"
        xmlns:search="clr-namespace:Bibliotaph.Core.Search;assembly=Bibliotaph.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="Bibliotaph"
        Icon="pack://application:,,,/Assets/Bibliotaph.ico"
        Width="1280" Height="840" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bt.Bg}"
        Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{x:Static c:ShellCommands.FocusSearch}" />
    <KeyBinding Key="OemQuestion" Modifiers="Control" Command="{x:Static c:ShellCommands.ShowShortcuts}" />
    <KeyBinding Key="Divide" Modifiers="Control" Command="{x:Static c:ShellCommands.ShowShortcuts}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
    <KeyBinding Key="BrowserBack" Command="{Binding GoBackCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- .bt-sidebar; run mode folds it away. -->
    <Border Width="210" Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,1,0" Padding="13,27,13,18"
            Visibility="{Binding CurrentPage.IsImmersive, Converter={StaticResource Bt.CollapsedWhenTrue}}">
      <DockPanel LastChildFill="False">
        <!-- .bt-brand -->
        <Button DockPanel.Dock="Top" Command="{Binding NavigateCommand}" CommandParameter="{x:Static services:Route.Home}"
                AutomationProperties.Name="Bibliotaph home" Cursor="Hand" Margin="0,0,0,26"
                FocusVisualStyle="{StaticResource Bt.FocusVisual}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <StackPanel Orientation="Horizontal" Background="Transparent" Margin="4,0">
                <Border Width="30" Height="34" CornerRadius="3,9,3,3" Background="{DynamicResource Bt.Text}">
                  <TextBlock Text="b." FontFamily="{StaticResource Font.Display}" FontSize="31" Foreground="{DynamicResource Bt.Bg}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,3" />
                </Border>
                <TextBlock Text="Bibliotaph" FontFamily="{StaticResource Font.Display}" FontSize="23" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Bt.Text}" />
              </StackPanel>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- .bt-navigation -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}" Focusable="False"
                      AutomationProperties.Name="Main navigation">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
              <Button Style="{StaticResource Bt.NavButton}" Content="{Binding Label}" c:Ui.Icon="{Binding Icon}"
                      c:Ui.IsActive="{Binding IsActive}" c:Ui.Count="{Binding Count}" AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.ItemStatus="{Binding Count}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Route}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- .bt-sidegroup: Smart Views (slice 3 plan, choices 5 and 17): Favorites, then the saved views. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,22,0,0">
          <TextBlock Text="SMART VIEWS" Style="{StaticResource Text.Eyebrow}" Margin="10,0,0,6" />
          <ItemsControl x:Name="SmartViews" ItemsSource="{Binding SmartViews}" Focusable="False" AutomationProperties.Name="Smart views">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                <!-- A saved view renames and deletes from its right-click menu; Tag carries the shell for the menu's commands. -->
                <Button x:Name="SmartView" Content="{Binding Label}" c:Ui.Icon="{Binding Icon}"
                        c:Ui.IsActive="{Binding IsActive}" AutomationProperties.Name="{Binding Label}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Bt.NavButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsView}" Value="True">
                          <Setter Property="ToolTip" Value="Right-click to rename or delete" />
                          <Setter Property="ContextMenu">
                            <Setter.Value>
                              <ContextMenu Style="{StaticResource Bt.Menu}">
                                <MenuItem Header="Rename…" CommandParameter="{Binding}"
                                          Command="{Binding PlacementTarget.Tag.RenameViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Delete" CommandParameter="{Binding}"
                                          Command="{Binding PlacementTarget.Tag.DeleteViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                              </ContextMenu>
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- .bt-sidebottom: processing status, then Settings. -->
        <StackPanel DockPanel.Dock="Bottom">
          <!-- Opens Settings > Processing, where the details and pause buttons are. -->
          <Button x:Name="StatusButton" Margin="4" Cursor="Hand" HorizontalContentAlignment="Left"
                  FocusVisualStyle="{StaticResource Bt.FocusVisual}" Command="{Binding OpenProcessingCommand}"
                  AutomationProperties.Name="{Binding Activity.StatusName, StringFormat='{}{0}. Open processing in Settings'}"
                  ToolTip="Open processing in Settings">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="6">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <!-- Beside the first line, which a second one (folders offline) may follow. -->
              <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,5,0,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Bt.StatusOk}" />
                    <Style.Triggers>
                      <!-- Something the user can act on: a password, a damaged file. -->
                      <DataTrigger Binding="{Binding Activity.NeedsAttention}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Bt.Warm}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="{Binding Activity.Summary}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis" />
                <!-- Folders that can't be reached (4g): their books stay, dimmed and marked Offline. -->
                <TextBlock x:Name="OfflineFolders" Text="{Binding Activity.OfflineText}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding Activity.HasOfflineFolders, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Bt.NavButton}" DataContext="{Binding Settings}" Content="{Binding Label}"
                  c:Ui.Icon="{Binding Icon}" c:Ui.IsActive="{Binding IsActive}"
                  Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding Route}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- .bt-topbar; run mode has its own header instead. -->
      <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="24,15" MinHeight="68"
              Visibility="{Binding CurrentPage.IsImmersive, Converter={StaticResource Bt.CollapsedWhenTrue}}">
        <DockPanel>
          <Button DockPanel.Dock="Left" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowLeft}"
                  Command="{Binding GoBackCommand}" Margin="-8,0,6,0"
                  Visibility="{Binding CanGoBack, Converter={StaticResource Bt.VisibleWhenTrue}}"
                  ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" />
          <!-- .bt-breadcrumb: the section links to its page when it names one (Library, Settings). -->
          <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Bt.Muted}">
            <TextBlock.Resources>
              <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                <Setter Property="TextDecorations" Value="{x:Null}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                    <Setter Property="Cursor" Value="Arrow" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Resources>
            <Hyperlink Command="{Binding OpenSectionCommand}"
                       AutomationProperties.Name="{Binding Section, Mode=OneWay, StringFormat='Go to {0}'}"><Run Text="{Binding Section, Mode=OneWay}" /></Hyperlink><Run Text="  /  " Foreground="{DynamicResource Bt.Line}" /><Run Text="{Binding Title, Mode=OneWay}" />
          </TextBlock>
          <Button DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SunMoon}"
                  Command="{Binding ToggleAppearanceCommand}" Margin="15,0,0,0"
                  ToolTip="{Binding AppearanceToggleLabel}" AutomationProperties.Name="{Binding AppearanceToggleLabel}" />
          <TextBox x:Name="Search" Style="{StaticResource Bt.SearchBox}" MaxWidth="360" HorizontalAlignment="Right"
                   Margin="15,0,0,0" Width="360" Tag="Search books, topics, passages…"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" c:Ui.ClearCommand="{Binding ClearSearchCommand}"
                   AutomationProperties.Name="Search your library" PreviewKeyDown="Search_PreviewKeyDown" />
        </DockPanel>
      </Border>

      <!-- A page with its own virtualized list (the Library) scrolls itself; wrapping it here would realize every item. -->
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage.ScrollsItself}" Value="True">
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="Margin" Value="42,36,42,35" />
              <Style.Triggers>
                <!-- The list runs to the bottom edge; its own padding keeps the last row clear. -->
                <DataTrigger Binding="{Binding CurrentPage.ScrollsItself}" Value="True">
                  <Setter Property="Margin" Value="42,36,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPage.IsImmersive}" Value="True">
                  <Setter Property="Margin" Value="0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </ScrollViewer>

      <!--
        The search box's field guide: the fields you can search, and after a field's colon its values in your library.
        Its DataContext is the SearchGuideViewModel, set in code. The box keeps keyboard focus, so the rows don't take it;
        the arrow keys move the highlight from the box. A popup doesn't take the window's text colour, so it is set here.
      -->
      <Popup x:Name="SearchGuide" PlacementTarget="{Binding ElementName=Search}" Placement="Bottom" AllowsTransparency="True"
             Focusable="False" StaysOpen="True" IsOpen="{Binding IsOpen, Mode=OneWay}" Width="{Binding ActualWidth, ElementName=Search}">
        <Popup.Resources>
          <Style x:Key="Bt.GuideRow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,5">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- "system: the game system, e.g. system:5e" -->
          <DataTemplate DataType="{x:Type vm:FieldSuggestionViewModel}">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Bt.Text}">
              <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" /><Run Text=" " /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" /><Run Text="{Binding Example, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
          <!-- "Dungeons & Dragons  system:dnd    12" -->
          <DataTemplate DataType="{x:Type vm:ValueSuggestionViewModel}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" />
              <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Bt.Text}">
                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Search, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" />
              </TextBlock>
            </DockPanel>
          </DataTemplate>
        </Popup.Resources>
        <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="7"
                Margin="0,4,0,0" Padding="4" TextElement.Foreground="{DynamicResource Bt.Text}"
                TextElement.FontFamily="{StaticResource Font.Sans}" TextElement.FontSize="11">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Eyebrow}" Margin="8,4,8,3" Text="{Binding Heading, Mode=OneWay}" />
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="8,6,8,3">
              <TextBlock Style="{StaticResource Text.Small}" FontSize="10" Text="{x:Static search:SearchFields.Syntax}" />
            </Border>
            <ContentPresenter DockPanel.Dock="Top" Margin="8,5" Content="{Binding Hint, Mode=OneWay}"
                              Visibility="{Binding Hint, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <ScrollViewer x:Name="SearchGuideScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
              <ItemsControl x:Name="SearchGuideRows" ItemsSource="{Binding Suggestions, Mode=OneWay}" Focusable="False"
                            AutomationProperties.Name="Search suggestions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Bt.GuideRow}" Content="{Binding}" AutomationProperties.Name="{Binding Spoken, Mode=OneWay}"
                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Popup>

      <!--
        Screen readers hear the guide's highlighted row from this live region as the arrow keys move it, since keyboard
        focus stays in the box. It is in the tree, so it has an automation peer, but can't be seen or clicked. The window
        sets its text just before announcing it.
      -->
      <TextBlock x:Name="SearchGuideAnnouncement" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" Focusable="False"
                 HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Assertive" />
    </Grid>
  </Grid>
</Window>
