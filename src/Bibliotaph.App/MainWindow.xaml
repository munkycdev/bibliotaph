<Window x:Class="Bibliotaph.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Bibliotaph.App.Controls"
        xmlns:vm="clr-namespace:Bibliotaph.App.ViewModels"
        xmlns:services="clr-namespace:Bibliotaph.App.Services"
        xmlns:search="clr-namespace:Bibliotaph.Core.Search;assembly=Bibliotaph.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="Bibliotaph"
        Icon="pack://application:,,,/Assets/Bibliotaph.ico"
        Width="1280" Height="840" MinWidth="880" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bt.Bg}"
        Foreground="{DynamicResource Bt.Text}"
        FontFamily="{StaticResource Font.Sans}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{x:Static c:ShellCommands.FocusSearch}" />
    <KeyBinding Key="OemQuestion" Modifiers="Control" Command="{x:Static c:ShellCommands.ShowShortcuts}" />
    <KeyBinding Key="Divide" Modifiers="Control" Command="{x:Static c:ShellCommands.ShowShortcuts}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Key="BrowserBack" Command="{Binding GoBackCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- .bt-sidebar; folded (Ctrl+B), it keeps only the icons, each with its name as a tooltip. -->
    <Border x:Name="Sidebar" Background="{DynamicResource Bt.Side}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,1,0"
            c:Ui.Compact="{Binding IsSidebarCollapsed}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="210" />
          <Setter Property="Padding" Value="13,27,13,18" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
              <Setter Property="Width" Value="64" />
              <Setter Property="Padding" Value="8,27,8,18" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <!-- The brand and the foot stay put, and so does the navigation between them; the pins scroll on a short window. -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- .bt-brand; folded, the unfold button takes its place, so folding adds no height to a short window. -->
        <Grid Margin="0,0,0,26">
          <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static services:Route.Home}"
                  AutomationProperties.Name="Bibliotaph home" Cursor="Hand" HorizontalAlignment="Left"
                  FocusVisualStyle="{StaticResource Bt.FocusVisual}"
                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Bt.CollapsedWhenTrue}}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal" Background="Transparent" Margin="4,0">
                  <Border Width="30" Height="34" CornerRadius="3,9,3,3" Background="{DynamicResource Bt.Text}">
                    <TextBlock Text="b." FontFamily="{StaticResource Font.Display}" FontSize="31" Foreground="{DynamicResource Bt.Bg}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,3" />
                  </Border>
                  <TextBlock Text="Bibliotaph" FontFamily="{StaticResource Font.Display}" FontSize="23" Margin="10,0,0,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource Bt.Text}" />
                </StackPanel>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="ToggleSidebar" Style="{StaticResource Bt.IconButton}" HorizontalAlignment="Center" Command="{Binding ToggleSidebarCommand}"
                  ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}" c:Ui.Icon="{StaticResource Icon.PanelLeft}"
                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Bt.VisibleWhenTrue}}" />
        </Grid>

        <!-- The main navigation stays put; the Pinned group below it scrolls on its own (Pinned Views plan, choice 10). -->
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- .bt-navigation -->
          <ItemsControl ItemsSource="{Binding NavItems}" Focusable="False"
                        AutomationProperties.Name="Main navigation">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                <Button Style="{StaticResource Bt.NavButton}" Content="{Binding Label}" c:Ui.Icon="{Binding Icon}"
                        c:Ui.IsActive="{Binding IsActive}" c:Ui.Count="{Binding Count}" AutomationProperties.Name="{Binding Label}"
                        AutomationProperties.ItemStatus="{Binding Count}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Route}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!--
            .bt-sidegroup: Pinned (Pinned Views plan): books, Favorites, collections, binders and saved searches, in order. A pin
            is dragged to a new place, with a line where it will land, or moved with Alt+Up and Alt+Down or its menu.
          -->
          <DockPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock DockPanel.Dock="Top" Text="PINNED" Style="{StaticResource Text.Eyebrow}" Margin="10,0,0,6"
                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <TextBlock x:Name="NoPins" DockPanel.Dock="Top" Text="Right-click a book, collection or binder and choose Pin." FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Bt.Muted}" Margin="10,0,10,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Pinned.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ScrollViewer x:Name="PinnedScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl x:Name="Pinned" ItemsSource="{Binding Pinned}" Focusable="False" AutomationProperties.Name="Pinned">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type services:PinnedItemViewModel}">
                    <!--
                      Every pin moves and unpins from its right-click menu, and a saved search also renames and deletes there; Tag
                      carries the shell for the menu's commands. A long name is trimmed, with the whole name in the tooltip.
                    -->
                    <Button x:Name="Pin" Content="{Binding Label}" c:Ui.Icon="{Binding Icon}" ToolTip="{Binding Tip}"
                            c:Ui.IsActive="{Binding IsActive}" AutomationProperties.Name="{Binding Label}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding DataContext.OpenPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" AllowDrop="True"
                            PreviewMouseLeftButtonDown="Pin_MouseDown" PreviewMouseMove="Pin_MouseMove"
                            DragOver="Pin_DragOver" DragLeave="Pin_DragLeave" Drop="Pin_Drop">
                      <Button.InputBindings>
                        <KeyBinding Key="Up" Modifiers="Alt" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.MovePinUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <KeyBinding Key="Down" Modifiers="Alt" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.MovePinDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </Button.InputBindings>
                      <Button.ContentTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </Button.ContentTemplate>
                      <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource Bt.Menu}">
                          <MenuItem Header="Move up" InputGestureText="Alt+Up" CommandParameter="{Binding}"
                                    Command="{Binding PlacementTarget.Tag.MovePinUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <MenuItem Header="Move down" InputGestureText="Alt+Down" CommandParameter="{Binding}"
                                    Command="{Binding PlacementTarget.Tag.MovePinDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <MenuItem Header="Unpin" CommandParameter="{Binding}"
                                    Command="{Binding PlacementTarget.Tag.UnpinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <MenuItem Header="Rename…" CommandParameter="{Binding}"
                                    Visibility="{Binding IsSavedSearch, Converter={x:Static c:BoolToVisibility.WhenTrue}}"
                                    Command="{Binding PlacementTarget.Tag.RenameViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <MenuItem Header="Delete" CommandParameter="{Binding}"
                                    Visibility="{Binding IsSavedSearch, Converter={x:Static c:BoolToVisibility.WhenTrue}}"
                                    Command="{Binding PlacementTarget.Tag.DeleteViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Bt.NavButton}">
                          <Style.Triggers>
                            <!-- A book whose file is offline or missing keeps its pin, dimmed (choice 9). -->
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                              <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>

        <!-- .bt-sidebottom: an update ready to apply, processing status, then Settings. -->
        <StackPanel Grid.Row="2">
          <!-- Downloaded in the background (slice 4l); it waits for this click, as a game may be under way. -->
          <Button x:Name="UpdateReady" Margin="4,0,4,6" Cursor="Hand" HorizontalContentAlignment="Stretch"
                  FocusVisualStyle="{StaticResource Bt.FocusVisual}" Command="{Binding RestartToUpdateCommand}"
                  AutomationProperties.Name="Update ready: restart to update" ToolTip="Close Bibliotaph, update it and open it again"
                  Visibility="{Binding Updates.IsReady, Converter={StaticResource Bt.VisibleWhenTrue}}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{DynamicResource Bt.Soft}" CornerRadius="5" Padding="6">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Line}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <!-- A DockPanel, not a StackPanel, so the line wraps in the sidebar's width. -->
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Width="6" Height="6" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{DynamicResource Bt.Accent}" />
              <StackPanel Margin="8,0,0,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Bt.CollapsedWhenTrue}}">
                <TextBlock Text="Update ready: restart to update" FontSize="11" Foreground="{DynamicResource Bt.Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Updates.ReadyText}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </Button>
          <!-- Opens Settings > Processing, where the details and pause buttons are. -->
          <Button x:Name="StatusButton" Margin="4" Cursor="Hand" HorizontalContentAlignment="Left"
                  FocusVisualStyle="{StaticResource Bt.FocusVisual}" Command="{Binding OpenProcessingCommand}"
                  AutomationProperties.Name="{Binding Activity.StatusName, StringFormat='{}{0}. Open processing in Settings'}"
                  ToolTip="Open processing in Settings">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="6">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <!-- Beside the first line, which a second one (folders offline) may follow. -->
              <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,5,0,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Bt.StatusOk}" />
                    <Style.Triggers>
                      <!-- Something the user can act on: a password, a damaged file. -->
                      <DataTrigger Binding="{Binding Activity.NeedsAttention}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Bt.Warm}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <StackPanel Margin="8,0,0,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Bt.CollapsedWhenTrue}}">
                <TextBlock Text="{Binding Activity.Summary}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis" />
                <!-- Folders that can't be reached (4g): their books stay, dimmed and marked Offline. -->
                <TextBlock x:Name="OfflineFolders" Text="{Binding Activity.OfflineText}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding Activity.HasOfflineFolders, Converter={StaticResource Bt.VisibleWhenTrue}}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <!-- Open, the fold button sits beside Settings; folded, it moves up to where the brand was. -->
          <DockPanel>
            <Button x:Name="FoldSidebar" DockPanel.Dock="Right" Style="{StaticResource Bt.IconButton}" Margin="4,0,0,0"
                    Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}"
                    c:Ui.Icon="{StaticResource Icon.PanelLeft}" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Bt.CollapsedWhenTrue}}" />
            <Button Style="{StaticResource Bt.NavButton}" DataContext="{Binding Settings}" Content="{Binding Label}"
                    c:Ui.Icon="{Binding Icon}" c:Ui.IsActive="{Binding IsActive}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Route}" />
          </DockPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- .bt-topbar -->
      <Border BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="24,15" MinHeight="68">
        <!-- The breadcrumb takes the room the search box leaves, so a long title (an adventure in a file, say) is trimmed, not the search box. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowLeft}"
                  Command="{Binding GoBackCommand}" Margin="-8,0,6,0"
                  Visibility="{Binding CanGoBack, Converter={StaticResource Bt.VisibleWhenTrue}}"
                  ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" />
          <!-- .bt-breadcrumb: the section links to its page when it names one (Library, Settings). -->
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Bt.Muted}" TextTrimming="CharacterEllipsis">
            <TextBlock.Resources>
              <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                <Setter Property="TextDecorations" Value="{x:Null}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}" />
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Bt.Muted}" />
                    <Setter Property="Cursor" Value="Arrow" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Resources>
            <Hyperlink Command="{Binding OpenSectionCommand}"
                       AutomationProperties.Name="{Binding Section, Mode=OneWay, StringFormat='Go to {0}'}"><Run Text="{Binding Section, Mode=OneWay}" /></Hyperlink><Run Text="  /  " Foreground="{DynamicResource Bt.Line}" /><Run Text="{Binding Title, Mode=OneWay}" />
          </TextBlock>
          <!-- Ask (scenario review, row 5): the box takes a request in plain English, read by AI on Enter. -->
          <Button x:Name="PlainSearchButton" Grid.Column="3" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.Sparkles}"
                  c:Ui.IsActive="{Binding PlainSearch.IsOn}" Command="{Binding PlainSearch.ToggleCommand}" Margin="6,0,0,0"
                  ToolTip="Ask in plain English" AutomationProperties.Name="Ask in plain English" />
          <Button Grid.Column="4" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.SunMoon}"
                  Command="{Binding ToggleAppearanceCommand}" Margin="15,0,0,0"
                  ToolTip="{Binding AppearanceToggleLabel}" AutomationProperties.Name="{Binding AppearanceToggleLabel}" />
          <TextBox x:Name="Search" Grid.Column="2" Style="{StaticResource Bt.SearchBox}" MaxWidth="324" HorizontalAlignment="Right"
                   Margin="15,0,0,0" Width="324" Tag="{Binding SearchPlaceholder}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" c:Ui.ClearCommand="{Binding ClearSearchCommand}"
                   AutomationProperties.Name="Search your library" PreviewKeyDown="Search_PreviewKeyDown" />
        </Grid>
      </Border>

      <!-- A page with its own virtualized list (the Library) scrolls itself; wrapping it here would realize every item. -->
      <!--
        Ask's panel, under the top bar while Ask is on: what to do, a reading in progress, or the request read as chips
        (field and an editable value, or words to find) with notes on anything changed or left out, and Search, which
        puts the chips in the box as query text and runs it. Without AI it says Ask needs it, with a link to Settings > AI.
      -->
      <Border x:Name="PlainSearchPanel" Grid.Row="1" DataContext="{Binding PlainSearch}" Background="{DynamicResource Bt.Panel}"
              BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="24,12,18,12"
              Visibility="{Binding IsOn, Converter={StaticResource Bt.VisibleWhenTrue}}">
        <Border.Resources>
          <!-- A chip's value: an underlined box that fits its text. -->
          <Style x:Key="PlainSearch.ChipBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Bt.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Bt.Accent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                  <Border x:Name="Chrome" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,0,0,1" Padding="2,1" Background="Transparent">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bt.Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Border.Resources>
        <DockPanel>
          <Button x:Name="ClosePlainSearch" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}"
                  Command="{Binding CloseCommand}" ToolTip="Close Ask (Esc)" AutomationProperties.Name="Close Ask" />
          <c:LucideIcon DockPanel.Dock="Left" Size="15" Data="{StaticResource Icon.Sparkles}" Foreground="{DynamicResource Bt.Accent}"
                        VerticalAlignment="Top" Margin="0,8,10,0" />
          <StackPanel>
            <TextBlock x:Name="PlainSearchMessage" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"
                       Foreground="{DynamicResource Bt.Text}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="PlainSearchSetUpAi" Style="{StaticResource Bt.Link}" Content="Set AI up in Settings" c:Ui.Icon="{StaticResource Icon.Settings2}"
                    Margin="0,6,0,0" Command="{Binding OpenAiSettingsCommand}"
                    Visibility="{Binding NeedsAi, Converter={StaticResource Bt.VisibleWhenTrue}}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsReading, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <ProgressBar Style="{StaticResource Bt.ProgressBar}" IsIndeterminate="True" Width="160" VerticalAlignment="Center"
                           AutomationProperties.Name="Reading your question" />
              <Button x:Name="PlainSearchCancel" Content="Cancel" Margin="12,0,0,0" Padding="10,5" Command="{Binding CancelCommand}" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsInterpreted, Converter={StaticResource Bt.VisibleWhenTrue}}">
              <ItemsControl x:Name="PlainSearchParts" ItemsSource="{Binding Parts}" Focusable="False" AutomationProperties.Name="What will be searched for"
                            KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PlainSearchPartViewModel}">
                    <Border Style="{StaticResource Bt.Chip}" Padding="8,2,2,2" Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Style="{StaticResource PlainSearch.ChipBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding ValueName}" />
                        <Button Style="{StaticResource Bt.IconButton}" c:Ui.Icon="{StaticResource Icon.X}" MinWidth="22" MinHeight="22" Margin="4,0,0,0" Padding="2"
                                ToolTip="{Binding RemoveName}" AutomationProperties.Name="{Binding RemoveName}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl x:Name="PlainSearchNotes" ItemsSource="{Binding Notes}" Focusable="False" AutomationProperties.Name="Notes on how your question was read">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,4">
                      <c:LucideIcon DockPanel.Dock="Left" Size="12" Data="{StaticResource Icon.TriangleAlert}" Foreground="{DynamicResource Bt.Muted}"
                                    VerticalAlignment="Top" Margin="0,1,6,0" />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Bt.Muted}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,6,0,0" Visibility="{Binding HasParts, Converter={StaticResource Bt.VisibleWhenTrue}}">
                <Button x:Name="PlainSearchRun" DockPanel.Dock="Left" Style="{StaticResource Bt.Button.Primary}" Content="Search" c:Ui.Icon="{StaticResource Icon.Search}"
                        Padding="12,6" Command="{Binding SearchCommand}" ToolTip="Put this in the search box and search" />
                <TextBlock x:Name="PlainSearchQueryText" Text="{Binding QueryText}" FontSize="11" Foreground="{DynamicResource Bt.Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding QueryText}" />
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage.ScrollsItself}" Value="True">
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="Margin" Value="42,36,42,35" />
              <Style.Triggers>
                <!-- The list runs to the bottom edge; its own padding keeps the last row clear. -->
                <DataTrigger Binding="{Binding CurrentPage.ScrollsItself}" Value="True">
                  <Setter Property="Margin" Value="42,36,0,0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </ScrollViewer>

      <!--
        The search box's field guide: the fields you can search, and after a field's colon its values in your library.
        Its DataContext is the SearchGuideViewModel, set in code. The box keeps keyboard focus, so the rows don't take it;
        the arrow keys move the highlight from the box. A popup doesn't take the window's text colour, so it is set here.
      -->
      <Popup x:Name="SearchGuide" PlacementTarget="{Binding ElementName=Search}" Placement="Bottom" AllowsTransparency="True"
             Focusable="False" StaysOpen="True" IsOpen="{Binding IsOpen, Mode=OneWay}" Width="{Binding ActualWidth, ElementName=Search}">
        <Popup.Resources>
          <Style x:Key="Bt.GuideRow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Bt.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,5">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bt.Soft}" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- "system: the game system, e.g. system:5e" -->
          <DataTemplate DataType="{x:Type vm:FieldSuggestionViewModel}">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Bt.Text}">
              <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" /><Run Text=" " /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" /><Run Text="{Binding Example, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
          <!-- "Dungeons & Dragons  system:dnd    12" -->
          <DataTemplate DataType="{x:Type vm:ValueSuggestionViewModel}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" />
              <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Bt.Text}">
                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Search, Mode=OneWay}" Foreground="{DynamicResource Bt.Muted}" />
              </TextBlock>
            </DockPanel>
          </DataTemplate>
        </Popup.Resources>
        <Border Background="{DynamicResource Bt.Panel}" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="1" CornerRadius="7"
                Margin="0,4,0,0" Padding="4" TextElement.Foreground="{DynamicResource Bt.Text}"
                TextElement.FontFamily="{StaticResource Font.Sans}" TextElement.FontSize="11">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Eyebrow}" Margin="8,4,8,3" Text="{Binding Heading, Mode=OneWay}" />
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bt.Line}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="8,6,8,3">
              <TextBlock Style="{StaticResource Text.Small}" FontSize="10" Text="{x:Static search:SearchFields.Syntax}" />
            </Border>
            <ContentPresenter DockPanel.Dock="Top" Margin="8,5" Content="{Binding Hint, Mode=OneWay}"
                              Visibility="{Binding Hint, Converter={StaticResource Bt.VisibleWhenSet}}" />
            <ScrollViewer x:Name="SearchGuideScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
              <ItemsControl x:Name="SearchGuideRows" ItemsSource="{Binding Suggestions, Mode=OneWay}" Focusable="False"
                            AutomationProperties.Name="Search suggestions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Bt.GuideRow}" Content="{Binding}" AutomationProperties.Name="{Binding Spoken, Mode=OneWay}"
                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Popup>

      <!--
        Screen readers hear the guide's highlighted row from this live region as the arrow keys move it, since keyboard
        focus stays in the box. It is in the tree, so it has an automation peer, but can't be seen or clicked. The window
        sets its text just before announcing it.
      -->
      <TextBlock x:Name="SearchGuideAnnouncement" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" Focusable="False"
                 HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Assertive" />
    </Grid>
  </Grid>
</Window>
