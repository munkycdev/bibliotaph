<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shell, screens, view models, theme and DI composition. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BibTfm)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Bibliotaph</AssemblyName>
    <RootNamespace>Bibliotaph.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon (Explorer, shortcuts). MainWindow sets the same .ico for its title bar and taskbar button. -->
    <ApplicationIcon>Assets\Bibliotaph.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bibliotaph.Core\Bibliotaph.Core.csproj" />
    <ProjectReference Include="..\Bibliotaph.Catalog\Bibliotaph.Catalog.csproj" />
    <ProjectReference Include="..\Bibliotaph.Index\Bibliotaph.Index.csproj" />
    <ProjectReference Include="..\Bibliotaph.Processing\Bibliotaph.Processing.csproj" />
    <ProjectReference Include="..\Bibliotaph.Classification\Bibliotaph.Classification.csproj" />
    <ProjectReference Include="..\Bibliotaph.Pdf.Contracts\Bibliotaph.Pdf.Contracts.csproj" />
    <ProjectReference Include="..\Bibliotaph.Pdf.Host\Bibliotaph.Pdf.Host.csproj" />
    <ProjectReference Include="..\Bibliotaph.Viewer\Bibliotaph.Viewer.csproj" />
    <BundledExe Include="..\Bibliotaph.PdfWorker\Bibliotaph.PdfWorker.csproj" Folder="pdfworker" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="VirtualizingWrapPanel" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\Bibliotaph.ico" />
    <!-- Link, not LinkBase: LinkBase applies only to files outside the project folder, so these landed in Fonts\. -->
    <None Include="Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\fonts\%(Filename)%(Extension)" />
    <None Include="Icons\LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE-lucide.txt" />
    <!-- Bibliotaph's own licence and notices, which the About popup reads (as .txt so Notepad opens the licence too). -->
    <None Include="$(RepoRoot)LICENSE" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE.txt" Visible="false" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Link="licenses\THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>
</Project>
