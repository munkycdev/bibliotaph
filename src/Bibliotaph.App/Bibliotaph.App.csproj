<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shell, screens, view models, theme and DI composition. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BibTfm)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Bibliotaph</AssemblyName>
    <RootNamespace>Bibliotaph.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon (Explorer, shortcuts). MainWindow sets the same .ico for its title bar and taskbar button. -->
    <ApplicationIcon>Assets\Bibliotaph.ico</ApplicationIcon>
    <!-- Program.Main, not the Main WPF generates from App.xaml: Velopack must run before anything else (slice 4l). -->
    <StartupObject>Bibliotaph.App.Program</StartupObject>
    <!--
      Where an installed build looks for updates (slice 4l): this repository's GitHub Releases. The release workflow
      passes the repository it ran in, so a fork's builds update from the fork's own releases.
    -->
    <ReleasesUrl Condition="'$(ReleasesUrl)' == ''">https://github.com/munkycdev/bibliotaph</ReleasesUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleasesUrl" Value="$(ReleasesUrl)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bibliotaph.Core\Bibliotaph.Core.csproj" />
    <ProjectReference Include="..\Bibliotaph.Catalog\Bibliotaph.Catalog.csproj" />
    <ProjectReference Include="..\Bibliotaph.Index\Bibliotaph.Index.csproj" />
    <ProjectReference Include="..\Bibliotaph.Processing\Bibliotaph.Processing.csproj" />
    <ProjectReference Include="..\Bibliotaph.Ebooks\Bibliotaph.Ebooks.csproj" />
    <ProjectReference Include="..\Bibliotaph.Classification\Bibliotaph.Classification.csproj" />
    <ProjectReference Include="..\Bibliotaph.Pdf.Contracts\Bibliotaph.Pdf.Contracts.csproj" />
    <ProjectReference Include="..\Bibliotaph.Pdf.Host\Bibliotaph.Pdf.Host.csproj" />
    <ProjectReference Include="..\Bibliotaph.Viewer\Bibliotaph.Viewer.csproj" />
    <BundledExe Include="..\Bibliotaph.PdfWorker\Bibliotaph.PdfWorker.csproj" Folder="pdfworker" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="VirtualizingWrapPanel" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <!-- The e-book reader page's own stylesheet and script, served to it from memory. -->
    <EmbeddedResource Include="Assets\Ebook\*" LogicalName="Bibliotaph.App.Ebook.%(Filename)%(Extension)" />
    <Resource Include="Assets\Bibliotaph.ico" />
    <!-- Link, not LinkBase: LinkBase applies only to files outside the project folder, so these landed in Fonts\. -->
    <None Include="Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\fonts\%(Filename)%(Extension)" />
    <None Include="Icons\LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE-lucide.txt" />
    <None Include="Engine\LICENSE-llama.cpp.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE-llama.cpp.txt" />
    <!-- The built-in AI's engine, llama.cpp's llama-server, which build/fetch-engine.ps1 downloads and checks (Built-in
         AI plan, choice 3). A build without it runs, and Settings > AI says the engine isn't installed. -->
    <None Include="$(RepoRoot)artifacts\aiworker\**" Link="aiworker\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- The engine's libomp.dll comes with its licence, which About lists with the others. -->
    <None Include="$(RepoRoot)artifacts\aiworker\LICENSE-LLVM-OpenMP" Condition="Exists('$(RepoRoot)artifacts\aiworker\LICENSE-LLVM-OpenMP')"
          Link="licenses\LICENSE-LLVM-OpenMP.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- Bibliotaph's own licence and notices, which the About popup reads (as .txt so Notepad opens the licence too). -->
    <None Include="$(RepoRoot)LICENSE" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE.txt" Visible="false" />
    <None Include="$(RepoRoot)LICENSE-EXCEPTION.md" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE-EXCEPTION.md" Visible="false" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Link="licenses\THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>
</Project>
