<Project>
  <!-- Central package management: every package version lives here and nowhere else. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!-- The .NET 11 band (runtime, EF Core, Extensions). Move to the GA version in November 2026. -->
    <DotNetPackagesVersion Condition="'$(DotNetPackagesVersion)' == ''">11.0.0-rc.2.26504.105</DotNetPackagesVersion>
  </PropertyGroup>

  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotNetPackagesVersion)" />
    <!-- In the .NET 11 shared framework; referenced only when building for net10.0 locally. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="App">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <PackageVersion Include="PDFiumCore" Version="156.0.8076" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="VirtualizingWrapPanel" Version="2.5.4" />
    <!-- The in-app browser for online libraries (BSD-3-Clause; needs the Edge WebView2 Runtime, which Windows 11 has). -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- MIT. The installer and updates (slice 4l); build/release.yml installs the vpk tool at this same version. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Server">
    <!-- The web app's server and its Blazor WebAssembly client (MIT), in the .NET 11 band. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(DotNetPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetPackagesVersion)" />
    <!-- MIT. Data Protection keys in Blob storage, wrapped by a Key Vault key, reached with the app's managed identity. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <!-- OCR bake-off only; the app ships whichever engine wins. -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp brings 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); NuGet audit fails the
         restore on them. Pinned to the .NET 11 band, which has the fix. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(DotNetPackagesVersion)" />
  </ItemGroup>
</Project>
