# Build output
bin/
obj/
.vs/
*.user
*.suo

# Spike leftovers
spikes/pdf-feasibility/.probe
spikes/pdf-feasibility/corpus/generated/*.pdf

# Purchased books, and anything cut from them, never belong in the repo. Tests generate their PDFs at run time.
# For a deliberately synthetic file, use git add -f and say so in the PR.
*.pdf
*.epub
*.mobi
*.prc
*.azw
*.azw3
*.kfx
*.cbz
*.cbr

# Local app data never belongs in the repo
*.db
*.db-wal
*.db-shm

# Test output
TestResults/
artifacts/

# WPF writes a temporary project beside the real one while it compiles XAML.
*_wpftmp.csproj

# The web server's local data folder in development (accounts.db, libraries, keys).
src/Bibliotaph.Server/App_Data/
