<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A stand-in for the app process in the "worker dies when the app dies" test: it starts a worker,
    prints the worker's process ID, and waits to be killed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BibTfm)</TargetFramework>
    <AllowFileWrites>true</AllowFileWrites>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bibliotaph.Pdf.Host\Bibliotaph.Pdf.Host.csproj" />
  </ItemGroup>
</Project>
