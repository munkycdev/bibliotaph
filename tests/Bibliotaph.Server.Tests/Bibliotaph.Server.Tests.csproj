<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BibTfm)</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bibliotaph.Server\Bibliotaph.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="PDFsharp" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Bibliotaph.Pdf.Host.Tests\SyntheticPdfs.cs" Link="SyntheticPdfs.cs" />
    <Compile Include="..\Bibliotaph.Pdf.Host.Tests\GlyphOutlines.cs" Link="GlyphOutlines.cs" />
    <Compile Include="..\..\src\Bibliotaph.App\Services\SmokePdfs.cs" Link="SmokePdfs.cs" />
    <EmbeddedResource Include="..\..\src\Bibliotaph.App\Fonts\DMSans-Regular.ttf" LogicalName="DMSans-Regular.ttf" />
    <!-- Made-up online library pages, saved as a browser saves them, with their images beside them. -->
    <None Include="..\fixtures\online\**\*" Link="online\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <BundledExe Include="..\..\src\Bibliotaph.PdfWorker\Bibliotaph.PdfWorker.csproj" Folder="pdfworker" />
  </ItemGroup>
</Project>
