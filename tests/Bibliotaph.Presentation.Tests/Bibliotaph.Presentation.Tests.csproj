<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app's view models that need no window: dialogs, Needs review's cards, the bulk editor's fields, selection and
    navigation. They use no UI framework, so these run anywhere.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BibTfm)</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bibliotaph.Presentation\Bibliotaph.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
