<Project>
  <!--
    Build rules for every project under src/, tests/ and tools/.
    The spike under spikes/ keeps its own props and is not part of this build.
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!--
      .NET 11 RC until GA ships in November 2026 (see README.md).
      Override with -p:BibTfm=net10.0 to compile on an older SDK; that is a convenience, not a supported target.
    -->
    <BibTfm Condition="'$(BibTfm)' == ''">net11.0</BibTfm>

    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unused usings) in the build; XML docs are not required on every member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>

    <Company>Bibliotaph</Company>
    <Product>Bibliotaph</Product>
    <!--
      MAJOR.MINOR.0 for local builds; a release takes its version from its tag. From 1.2 a release is MAJOR.MINOR.N,
      where N is the number of commits on main at the release commit (release.yml checks it). Before 1.0 it was 0.N.0
      while slice N was built. The SDK appends the commit to the informational version (1.3.0+<sha>), which the About
      popup shows, so every build says exactly where it came from.
    -->
    <Version>1.3.0</Version>
  </PropertyGroup>
  <!--
    WPF compiles a XAML project twice: a throwaway assembly so the markup compiler can see the project's own types, then
    the real one. Analyzers on the throwaway pass repeat what the real pass reports and cost the App about ten seconds.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
